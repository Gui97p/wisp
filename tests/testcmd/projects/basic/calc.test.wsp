import "calc";

#test("an internal function is visible to the file next to it")
func internalVisible() ! {
  if calc.secret(2) != 14 {
    calc.divide(1, 0)!;
  }
}

#test
func failsWithError() ! {
  calc.divide(4, 0)!;
}

#test("an index out of range aborts")
func aborts() {
  [3]int a;
  int i = 5;
  a[i] = 1;
}
