{
    "name": "Wisp",
    "scopeName": "source.wisp",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#characters"
        },
        {
            "include": "#function-signature"
        },
        {
            "include": "#declarations"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#types"
        },
        {
            "include": "#constants"
        },
        {
            "include": "#builtins"
        },
        {
            "include": "#members"
        },
        {
            "include": "#calls"
        },
        {
            "include": "#enum-values"
        },
        {
            "include": "#type-names"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#delimiters"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.documentation.wisp",
                    "begin": "///",
                    "end": "$",
                    "patterns": [
                        {
                            "include": "#todo"
                        }
                    ]
                },
                {
                    "name": "comment.line.double-slash.wisp",
                    "begin": "//",
                    "end": "$",
                    "patterns": [
                        {
                            "include": "#todo"
                        }
                    ]
                },
                {
                    "name": "comment.block.wisp",
                    "begin": "/\\*",
                    "end": "\\*/",
                    "patterns": [
                        {
                            "include": "#todo"
                        }
                    ]
                }
            ]
        },
        "todo": {
            "name": "keyword.other.todo.wisp",
            "match": "\\b(TODO|FIXME|NOTE|HACK|XXX)\\b"
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.wisp",
                    "begin": "\"",
                    "end": "\"|$",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.wisp"
                        }
                    },
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.wisp"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#escapes"
                        }
                    ]
                }
            ]
        },
        "characters": {
            "patterns": [
                {
                    "name": "constant.character.wisp",
                    "begin": "'",
                    "end": "'|$",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.wisp"
                        }
                    },
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.wisp"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#escapes"
                        }
                    ]
                }
            ]
        },
        "escapes": {
            "name": "constant.character.escape.wisp",
            "match": "\\\\(x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\}|.)"
        },
        "declarations": {
            "patterns": [
                {
                    "match": "\\b(struct|enum|type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "storage.type.struct.wisp"
                        },
                        "2": {
                            "name": "entity.name.type.wisp"
                        }
                    }
                },
                {
                    "begin": "\\b(let|const)\\s+([A-Za-z_][A-Za-z0-9_]*)",
                    "beginCaptures": {
                        "1": {
                            "name": "storage.modifier.wisp"
                        },
                        "2": {
                            "name": "variable.other.readwrite.wisp"
                        }
                    },
                    "end": "(?=[=;{}()])|$",
                    "patterns": [
                        {
                            "include": "#declarator-tail"
                        }
                    ]
                },
                {
                    "begin": "\\b(u?int(?:8|16|32|64)?|float(?:32|64)|bool|char|string|map)((?:\\s*\\[[^\\]]*\\])*)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*[=;,)])",
                    "beginCaptures": {
                        "1": {
                            "name": "storage.type.primitive.wisp"
                        },
                        "2": {
                            "patterns": [
                                {
                                    "include": "#delimiters"
                                },
                                {
                                    "include": "#numbers"
                                }
                            ]
                        },
                        "3": {
                            "name": "variable.other.readwrite.wisp"
                        }
                    },
                    "end": "(?=[=;{}()])|$",
                    "patterns": [
                        {
                            "include": "#declarator-tail"
                        }
                    ]
                },
                {
                    "begin": "\\b([A-Z][A-Za-z0-9_]*)((?:\\s*\\[[^\\]]*\\])*)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*[=;,)])",
                    "beginCaptures": {
                        "1": {
                            "name": "entity.name.type.wisp"
                        },
                        "2": {
                            "patterns": [
                                {
                                    "include": "#delimiters"
                                },
                                {
                                    "include": "#numbers"
                                }
                            ]
                        },
                        "3": {
                            "name": "variable.other.readwrite.wisp"
                        }
                    },
                    "end": "(?=[=;{}()])|$",
                    "patterns": [
                        {
                            "include": "#declarator-tail"
                        }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.hex.wisp",
                    "match": "\\b0[xX][0-9A-Fa-f][0-9A-Fa-f_]*\\b"
                },
                {
                    "name": "constant.numeric.binary.wisp",
                    "match": "\\b0[bB][01][01_]*\\b"
                },
                {
                    "name": "constant.numeric.octal.wisp",
                    "match": "\\b0[oO][0-7][0-7_]*\\b"
                },
                {
                    "name": "constant.numeric.float.wisp",
                    "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*(?:[eE][+-]?\\d+)?\\b|\\b\\d[\\d_]*[eE][+-]?\\d+\\b"
                },
                {
                    "name": "constant.numeric.integer.wisp",
                    "match": "\\b\\d[\\d_]*\\b"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "storage.modifier.wisp",
                    "match": "\\b(let|const)\\b"
                },
                {
                    "name": "storage.type.function.wisp",
                    "match": "\\bfunc\\b"
                },
                {
                    "name": "storage.type.struct.wisp",
                    "match": "\\b(struct|type|enum)\\b"
                },
                {
                    "name": "keyword.control.conditional.wisp",
                    "match": "\\b(if|else|switch|case|default)\\b"
                },
                {
                    "name": "keyword.control.loop.wisp",
                    "match": "\\b(for|in|loop|until)\\b"
                },
                {
                    "name": "keyword.control.flow.wisp",
                    "match": "\\b(return|break|continue)\\b"
                },
                {
                    "name": "keyword.control.import.wisp",
                    "match": "\\b(import|export|as)\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "storage.type.primitive.wisp",
                    "match": "\\b(int|uint|int8|uint8|int16|uint16|int32|uint32|int64|uint64|float32|float64|bool|char|string|map)\\b"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.wisp",
                    "match": "\\b(true|false|null)\\b"
                }
            ]
        },
        "builtins": {
            "patterns": [
                {
                    "name": "support.function.builtin.wisp",
                    "match": "\\b(emit|emitf|len|random|malloc|realloc|free)\\b(?=\\s*\\()"
                }
            ]
        },
        "members": {
            "patterns": [
                {
                    "match": "(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)\\b(?!\\s*\\()",
                    "captures": {
                        "1": {
                            "name": "punctuation.accessor.wisp"
                        },
                        "2": {
                            "name": "variable.other.property.wisp"
                        }
                    }
                }
            ]
        },
        "calls": {
            "patterns": [
                {
                    "name": "entity.name.function.wisp",
                    "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
                }
            ]
        },
        "enum-values": {
            "patterns": [
                {
                    "name": "variable.other.constant.wisp",
                    "match": "\\b[A-Z][A-Z0-9_]+\\b"
                }
            ]
        },
        "type-names": {
            "patterns": [
                {
                    "name": "entity.name.type.wisp",
                    "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.arrow.wisp",
                    "match": "=>"
                },
                {
                    "name": "keyword.operator.bitwise.shift.wisp",
                    "match": "(<<=|>>=|<<|>>)"
                },
                {
                    "name": "keyword.operator.comparison.wisp",
                    "match": "(==|!=|<=|>=|<|>)"
                },
                {
                    "name": "keyword.operator.assignment.wisp",
                    "match": "(\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|=)"
                },
                {
                    "name": "keyword.operator.arithmetic.wisp",
                    "match": "(\\+\\+|--|\\+|-|\\*|/|%)"
                },
                {
                    "name": "keyword.operator.logical.wisp",
                    "match": "(&&|\\|\\||!)"
                },
                {
                    "name": "keyword.operator.bitwise.wisp",
                    "match": "(\\||\\^|~)"
                },
                {
                    "name": "keyword.operator.address.wisp",
                    "match": "&"
                }
            ]
        },
        "delimiters": {
            "patterns": [
                {
                    "name": "keyword.operator.variadic.wisp",
                    "match": "\\.\\.\\."
                },
                {
                    "name": "keyword.operator.range.wisp",
                    "match": "\\.\\."
                },
                {
                    "name": "punctuation.accessor.wisp",
                    "match": "\\."
                },
                {
                    "name": "punctuation.separator.comma.wisp",
                    "match": ","
                },
                {
                    "name": "punctuation.terminator.statement.wisp",
                    "match": ";"
                },
                {
                    "name": "punctuation.separator.colon.wisp",
                    "match": ":"
                },
                {
                    "name": "keyword.operator.ternary.wisp",
                    "match": "\\?"
                },
                {
                    "name": "punctuation.bracket.wisp",
                    "match": "[(){}\\[\\]]"
                }
            ]
        },
        "declarator-tail": {
            "patterns": [
                {
                    "include": "#comments"
                },
                {
                    "match": "(,)\\s*([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "punctuation.separator.comma.wisp"
                        },
                        "2": {
                            "name": "variable.other.readwrite.wisp"
                        }
                    }
                }
            ]
        },
        "function-signature": {
            "begin": "\\b(func)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(\\()",
            "beginCaptures": {
                "1": {
                    "name": "storage.type.function.wisp"
                },
                "2": {
                    "name": "entity.name.function.wisp"
                },
                "3": {
                    "name": "punctuation.bracket.wisp"
                }
            },
            "end": "\\)",
            "endCaptures": {
                "0": {
                    "name": "punctuation.bracket.wisp"
                }
            },
            "patterns": [
                {
                    "include": "#comments"
                },
                {
                    "match": "\\b(u?int(?:8|16|32|64)?|float(?:32|64)|bool|char|string|map)((?:\\s*\\[[^\\]]*\\])*)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
                    "captures": {
                        "1": {
                            "name": "storage.type.primitive.wisp"
                        },
                        "2": {
                            "patterns": [
                                {
                                    "include": "#delimiters"
                                },
                                {
                                    "include": "#numbers"
                                }
                            ]
                        },
                        "3": {
                            "name": "variable.other.readwrite.wisp"
                        }
                    }
                },
                {
                    "match": "\\b([A-Z][A-Za-z0-9_]*)((?:\\s*\\[[^\\]]*\\])*)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
                    "captures": {
                        "1": {
                            "name": "entity.name.type.wisp"
                        },
                        "2": {
                            "patterns": [
                                {
                                    "include": "#delimiters"
                                },
                                {
                                    "include": "#numbers"
                                }
                            ]
                        },
                        "3": {
                            "name": "variable.other.readwrite.wisp"
                        }
                    }
                },
                {
                    "include": "#types"
                },
                {
                    "name": "variable.other.readwrite.wisp",
                    "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*[,)])"
                },
                {
                    "include": "#numbers"
                },
                {
                    "include": "#delimiters"
                }
            ]
        }
    }
}