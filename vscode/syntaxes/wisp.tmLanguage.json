{
    "name": "Wisp",
    "scopeName": "source.wisp",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#characters"
        },
        {
            "include": "#function-signature"
        },
        {
            "include": "#declarations"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#types"
        },
        {
            "include": "#constants"
        },
        {
            "include": "#builtins"
        },
        {
            "include": "#members"
        },
        {
            "include": "#calls"
        },
        {
            "include": "#type-names"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#delimiters"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.documentation.wisp",
                    "begin": "///",
                    "end": "$",
                    "patterns": [
                        {
                            "include": "#todo"
                        }
                    ]
                },
                {
                    "name": "comment.line.double-slash.wisp",
                    "begin": "//",
                    "end": "$",
                    "patterns": [
                        {
                            "include": "#todo"
                        }
                    ]
                },
                {
                    "name": "comment.block.wisp",
                    "begin": "/\\*",
                    "end": "\\*/",
                    "patterns": [
                        {
                            "include": "#todo"
                        }
                    ]
                }
            ]
        },
        "todo": {
            "name": "keyword.other.todo.wisp",
            "match": "\\b(TODO|FIXME|NOTE|HACK|XXX)\\b"
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.wisp",
                    "begin": "\"",
                    "end": "\"|$",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.wisp"
                        }
                    },
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.wisp"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#escapes"
                        }
                    ]
                },
                {
                    "name": "string.quoted.other.raw.wisp",
                    "begin": "`",
                    "end": "`",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.wisp"
                        }
                    },
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.wisp"
                        }
                    }
                },
                {
                    "name": "string.quoted.other.lines.wisp",
                    "match": "(\\\\\\\\).*$",
                    "captures": {
                        "1": {
                            "name": "punctuation.definition.string.begin.wisp"
                        }
                    }
                }
            ]
        },
        "characters": {
            "patterns": [
                {
                    "name": "constant.character.wisp",
                    "begin": "'",
                    "end": "'|$",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.wisp"
                        }
                    },
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.wisp"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#escapes"
                        }
                    ]
                }
            ]
        },
        "escapes": {
            "name": "constant.character.escape.wisp",
            "match": "\\\\(x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\}|.)"
        },
        "declarations": {
            "patterns": [
                {
                    "begin": "\\b(const|let)\\s*(?:\\b(u?int(?:8|16|32|64)?|float(?:32|64)?|bool|byte|string)\\b|\\b([A-Z][A-Za-z0-9_]*)\\b)?\\s*(\\{)",
                    "beginCaptures": {
                        "1": {
                            "name": "storage.modifier.wisp"
                        },
                        "2": {
                            "name": "storage.type.primitive.wisp"
                        },
                        "3": {
                            "name": "entity.name.type.wisp"
                        },
                        "4": {
                            "name": "punctuation.bracket.wisp"
                        }
                    },
                    "end": "\\}",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.bracket.wisp"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#comments"
                        },
                        {
                            "begin": "(?:\\b(u?int(?:8|16|32|64)?|float(?:32|64)?|bool|byte|string)\\s+|\\b([A-Z][A-Za-z0-9_]*)\\s+)?\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?==)",
                            "beginCaptures": {
                                "1": {
                                    "name": "storage.type.primitive.wisp"
                                },
                                "2": {
                                    "name": "entity.name.type.wisp"
                                },
                                "3": {
                                    "name": "variable.other.readwrite.wisp"
                                }
                            },
                            "end": ";",
                            "patterns": [
                                {
                                    "include": "#comments"
                                },
                                {
                                    "include": "#strings"
                                },
                                {
                                    "include": "#characters"
                                },
                                {
                                    "include": "#numbers"
                                },
                                {
                                    "include": "#keywords"
                                },
                                {
                                    "include": "#types"
                                },
                                {
                                    "include": "#constants"
                                },
                                {
                                    "include": "#builtins"
                                },
                                {
                                    "include": "#members"
                                },
                                {
                                    "include": "#calls"
                                },
                                {
                                    "include": "#type-names"
                                },
                                {
                                    "include": "#operators"
                                },
                                {
                                    "include": "#delimiters"
                                }
                            ]
                        }
                    ]
                },
                {
                    "match": "\\b(struct|enum|type|interface)\\s+([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "storage.type.struct.wisp"
                        },
                        "2": {
                            "name": "entity.name.type.wisp"
                        }
                    }
                },
                {
                    "begin": "\\b(let|const)\\s+([A-Za-z_][A-Za-z0-9_]*)",
                    "beginCaptures": {
                        "1": {
                            "name": "storage.modifier.wisp"
                        },
                        "2": {
                            "name": "variable.other.readwrite.wisp"
                        }
                    },
                    "end": "(?=[=;{}()])|$",
                    "patterns": [
                        {
                            "include": "#declarator-tail"
                        }
                    ]
                },
                {
                    "begin": "((?:\\[[^\\]]*\\]\\s*|\\*\\s*)*)\\b(u?int(?:8|16|32|64)?|float(?:32|64)?|bool|byte|string|void)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*[=;,)])",
                    "beginCaptures": {
                        "1": {
                            "patterns": [
                                {
                                    "include": "#delimiters"
                                },
                                {
                                    "include": "#numbers"
                                }
                            ]
                        },
                        "2": {
                            "name": "storage.type.primitive.wisp"
                        },
                        "3": {
                            "name": "variable.other.readwrite.wisp"
                        }
                    },
                    "end": "(?=[=;{}()])|$",
                    "patterns": [
                        {
                            "include": "#declarator-tail"
                        }
                    ]
                },
                {
                    "begin": "((?:\\[[^\\]]*\\]\\s*|\\*\\s*)*)\\b([A-Z][A-Za-z0-9_]*)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*[=;,)])",
                    "beginCaptures": {
                        "1": {
                            "patterns": [
                                {
                                    "include": "#delimiters"
                                },
                                {
                                    "include": "#numbers"
                                }
                            ]
                        },
                        "2": {
                            "name": "entity.name.type.wisp"
                        },
                        "3": {
                            "name": "variable.other.readwrite.wisp"
                        }
                    },
                    "end": "(?=[=;{}()])|$",
                    "patterns": [
                        {
                            "include": "#declarator-tail"
                        }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.hex.wisp",
                    "match": "\\b0[xX][0-9A-Fa-f][0-9A-Fa-f_]*\\b"
                },
                {
                    "name": "constant.numeric.binary.wisp",
                    "match": "\\b0[bB][01][01_]*\\b"
                },
                {
                    "name": "constant.numeric.octal.wisp",
                    "match": "\\b0[oO][0-7][0-7_]*\\b"
                },
                {
                    "name": "constant.numeric.float.wisp",
                    "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*(?:[eE][+-]?\\d+)?\\b|\\b\\d[\\d_]*[eE][+-]?\\d+\\b"
                },
                {
                    "name": "constant.numeric.integer.wisp",
                    "match": "\\b\\d[\\d_]*\\b"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "storage.modifier.wisp",
                    "match": "\\b(let|const)\\b"
                },
                {
                    "name": "storage.type.function.wisp",
                    "match": "\\bfunc\\b"
                },
                {
                    "name": "storage.type.struct.wisp",
                    "match": "\\b(struct|type|enum|interface)\\b"
                },
                {
                    "name": "keyword.other.implements.wisp",
                    "match": "\\bimplements\\b"
                },
                {
                    "match": "\\b(match)\\s+(type)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.conditional.wisp"
                        },
                        "2": {
                            "name": "keyword.control.conditional.wisp"
                        }
                    }
                },
                {
                    "name": "storage.type.primitive.wisp",
                    "match": "\\b(signed|unsigned)\\b(?=\\s*(?:[A-Za-z_]\\w*\\s*)?(?:=>|,))"
                },
                {
                    "name": "keyword.control.conditional.wisp",
                    "match": "\\b(if|else|match|each)\\b"
                },
                {
                    "name": "keyword.control.loop.wisp",
                    "match": "\\b(for|in|loop|until)\\b"
                },
                {
                    "name": "keyword.control.flow.wisp",
                    "match": "\\b(return|break|continue|yield)\\b"
                },
                {
                    "name": "keyword.control.defer.wisp",
                    "match": "\\bdefer!?"
                },
                {
                    "name": "keyword.control.directive.wisp",
                    "match": "(?<![\\w\\\"'])#[A-Za-z_][A-Za-z0-9_]*"
                },
                {
                    "name": "keyword.control.import.wisp",
                    "match": "\\b(import|public|internal|private|extern|inline|var|as)\\b"
                },
                {
                    "begin": "(\\bnative\\b)((?:\\s*<[^<>]*>)?[^{};]*)(\\{)",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.other.native.wisp"
                        },
                        "2": {
                            "patterns": [
                                {
                                    "include": "#types"
                                },
                                {
                                    "name": "entity.name.function.wisp",
                                    "match": "[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
                                }
                            ]
                        },
                        "3": {
                            "name": "punctuation.definition.block.begin.wisp"
                        }
                    },
                    "end": "\\}",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.block.end.wisp"
                        }
                    },
                    "name": "meta.native.block.wisp",
                    "patterns": [
                        {
                            "include": "#comments"
                        },
                        {
                            "match": "^\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*:",
                            "captures": {
                                "1": {
                                    "name": "entity.name.label.wisp"
                                }
                            }
                        },
                        {
                            "match": "(?:^|(?<=;)|(?<=:))\\s*(?:(rep|repe|repne|repz|repnz|lock)\\s+)?([A-Za-z_][A-Za-z0-9_]*)(?=\\s*(?:;|\\s|$))",
                            "captures": {
                                "1": {
                                    "name": "keyword.other.instruction.prefix.wisp"
                                },
                                "2": {
                                    "name": "keyword.other.instruction.wisp"
                                }
                            }
                        },
                        {
                            "name": "variable.language.register.wisp",
                            "match": "\\b(?:[re]?[abcd]x|[abcd][lh]|[re]?(?:si|di|bp|sp)|[sd]il|[bs]pl|r(?:8|9|1[0-5])[dwb]?|[xy]mm(?:1[0-5]|[0-9])|rip|fs|gs)\\b"
                        },
                        {
                            "name": "storage.type.size.wisp",
                            "match": "\\b(?:byte|word|dword|qword|tword|oword|yword|zword|rel)\\b"
                        },
                        {
                            "include": "#numbers"
                        }
                    ]
                },
                {
                    "name": "keyword.control.static.wisp",
                    "match": "\\bstatic\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "storage.type.primitive.wisp",
                    "match": "\\b(int|uint|int8|uint8|int16|uint16|int32|uint32|int64|uint64|float|float32|float64|bool|byte|string|void)\\b"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.wisp",
                    "match": "\\b(true|false|null)\\b"
                }
            ]
        },
        "builtins": {
            "patterns": [
                {
                    "name": "support.function.builtin.wisp",
                    "match": "\\b(emit|len|panic|sizeof|alignof|offsetof|staticAssert|truncate|saturate)\\b(?=\\s*\\()"
                }
            ]
        },
        "members": {
            "patterns": [
                {
                    "match": "(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)\\b(?!\\s*\\()",
                    "captures": {
                        "1": {
                            "name": "punctuation.accessor.wisp"
                        },
                        "2": {
                            "name": "variable.other.property.wisp"
                        }
                    }
                }
            ]
        },
        "calls": {
            "patterns": [
                {
                    "name": "entity.name.function.wisp",
                    "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
                }
            ]
        },
        "type-names": {
            "patterns": [
                {
                    "name": "entity.name.type.wisp",
                    "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.arrow.wisp",
                    "match": "=>"
                },
                {
                    "name": "keyword.operator.bitwise.shift.wisp",
                    "match": "(<<=|>>=|<<|>>)"
                },
                {
                    "name": "keyword.operator.comparison.wisp",
                    "match": "(==|!=|<=|>=|<|>)"
                },
                {
                    "name": "keyword.operator.assignment.wisp",
                    "match": "(\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|=)"
                },
                {
                    "name": "keyword.operator.arithmetic.wisp",
                    "match": "(\\+\\+|--|\\+|-|\\*|/|%)"
                },
                {
                    "name": "keyword.operator.logical.wisp",
                    "match": "(&&|\\|\\||!)"
                },
                {
                    "name": "keyword.operator.bitwise.wisp",
                    "match": "(\\||\\^|~)"
                },
                {
                    "name": "keyword.operator.address.wisp",
                    "match": "&"
                },
                {
                    "name": "keyword.operator.dereference.wisp",
                    "match": "@"
                }
            ]
        },
        "delimiters": {
            "patterns": [
                {
                    "name": "keyword.operator.variadic.wisp",
                    "match": "\\.\\.\\."
                },
                {
                    "name": "keyword.operator.range.wisp",
                    "match": "\\.\\.=?"
                },
                {
                    "name": "punctuation.accessor.wisp",
                    "match": "\\."
                },
                {
                    "name": "punctuation.separator.comma.wisp",
                    "match": ","
                },
                {
                    "name": "punctuation.terminator.statement.wisp",
                    "match": ";"
                },
                {
                    "name": "punctuation.separator.colon.wisp",
                    "match": ":"
                },
                {
                    "name": "storage.modifier.optional.wisp",
                    "match": "(?<![\\w)\\]?])\\?(?=[*\\[(A-Za-z_])"
                },
                {
                    "name": "keyword.operator.unwrap.wisp",
                    "match": "\\?"
                },
                {
                    "name": "punctuation.bracket.wisp",
                    "match": "[(){}\\[\\]]"
                }
            ]
        },
        "declarator-tail": {
            "patterns": [
                {
                    "include": "#comments"
                },
                {
                    "match": "(,)\\s*([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "punctuation.separator.comma.wisp"
                        },
                        "2": {
                            "name": "variable.other.readwrite.wisp"
                        }
                    }
                }
            ]
        },
        "function-signature": {
            "begin": "\\b(func)\\s+(?:(\\()\\s*(\\*+)?\\s*([A-Za-z_][A-Za-z0-9_]*)(<[^()]*>)?(?:\\s+([A-Za-z_][A-Za-z0-9_]*))?\\s*(\\))\\s+)?([A-Za-z_][A-Za-z0-9_]*)\\s*(<[^()]*>)?\\s*(\\()",
            "beginCaptures": {
                "1": {
                    "name": "storage.type.function.wisp"
                },
                "2": {
                    "name": "punctuation.bracket.wisp"
                },
                "3": {
                    "name": "keyword.operator.address.wisp"
                },
                "4": {
                    "name": "entity.name.type.wisp"
                },
                "5": {
                    "patterns": [
                        {
                            "include": "#type-param-list"
                        }
                    ]
                },
                "6": {
                    "name": "variable.other.readwrite.wisp"
                },
                "7": {
                    "name": "punctuation.bracket.wisp"
                },
                "8": {
                    "name": "entity.name.function.wisp"
                },
                "9": {
                    "patterns": [
                        {
                            "include": "#type-param-list"
                        }
                    ]
                },
                "10": {
                    "name": "punctuation.bracket.wisp"
                }
            },
            "end": "\\)",
            "endCaptures": {
                "0": {
                    "name": "punctuation.bracket.wisp"
                }
            },
            "patterns": [
                {
                    "include": "#comments"
                },
                {
                    "name": "storage.modifier.wisp",
                    "match": "\\bconst\\b"
                },
                {
                    "match": "((?:\\[[^\\]]*\\]\\s*|\\*\\s*)*)\\b(u?int(?:8|16|32|64)?|float(?:32|64)?|bool|byte|string|void)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
                    "captures": {
                        "1": {
                            "patterns": [
                                {
                                    "include": "#delimiters"
                                },
                                {
                                    "include": "#numbers"
                                }
                            ]
                        },
                        "2": {
                            "name": "storage.type.primitive.wisp"
                        },
                        "3": {
                            "name": "variable.other.readwrite.wisp"
                        }
                    }
                },
                {
                    "match": "((?:\\[[^\\]]*\\]\\s*|\\*\\s*)*)\\b([A-Z][A-Za-z0-9_]*)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
                    "captures": {
                        "1": {
                            "patterns": [
                                {
                                    "include": "#delimiters"
                                },
                                {
                                    "include": "#numbers"
                                }
                            ]
                        },
                        "2": {
                            "name": "entity.name.type.wisp"
                        },
                        "3": {
                            "name": "variable.other.readwrite.wisp"
                        }
                    }
                },
                {
                    "include": "#types"
                },
                {
                    "name": "variable.other.readwrite.wisp",
                    "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*[,)])"
                },
                {
                    "include": "#numbers"
                },
                {
                    "include": "#delimiters"
                }
            ]
        },
        "type-param-list": {
            "patterns": [
                {
                    "name": "punctuation.bracket.wisp",
                    "match": "[<>]"
                },
                {
                    "name": "punctuation.separator.wisp",
                    "match": ","
                },
                {
                    "name": "storage.modifier.wisp",
                    "match": "\\bconst\\b"
                },
                {
                    "name": "storage.type.primitive.wisp",
                    "match": "\\b(?:u?int(?:8|16|32|64)?|float(?:32|64)?|bool|byte|string)\\b(?=\\s+[A-Za-z_])"
                },
                {
                    "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
                    "captures": {
                        "1": {
                            "name": "entity.name.type.wisp"
                        },
                        "2": {
                            "name": "entity.name.type.parameter.wisp"
                        }
                    }
                },
                {
                    "name": "entity.name.type.parameter.wisp",
                    "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
                }
            ]
        }
    }
}
