{
    "Main Function": {
        "prefix": "main",
        "body": [
            "func main() {",
            "\t$0",
            "}"
        ],
        "description": "Main Function"
    },
    "Function": {
        "prefix": "func",
        "body": [
            "func ${1:name}(${2}) {",
            "\t$0",
            "}"
        ],
        "description": "Declares a function"
    },
    "if": {
        "prefix": "if",
        "body": [
            "if ${1:condition} {",
            "\t$0",
            "}"
        ],
        "description": "Conditional if"
    },
    "if else": {
        "prefix": "ifelse",
        "body": [
            "if ${1:condition} {",
            "\t$2",
            "} else {",
            "\t$0",
            "}"
        ],
        "description": "Conditional if with else"
    },
    "match (expression)": {
        "prefix": "matchexpr",
        "body": [
            "let ${1:name} = match ${2:value} {",
            "\t${3:A} => ${4:x};",
            "\t_ => ${5:y};",
            "};"
        ],
        "description": "Match as expression, attributed to a variable"
    },
    "match (statement)": {
        "prefix": "match",
        "body": [
            "match ${1:value} {",
            "\t${2:A} => $3;",
            "\t_ => $0;",
            "}"
        ],
        "description": "Match as a statement"
    },
    "match (type)": {
        "prefix": "matchtype",
        "body": [
            "match type ${1:value} {",
            "\t${2:int} ${3:v} => $4;",
            "\t_ => $0;",
            "}"
        ],
        "description": "Match on the type of an any value"
    },
    "each": {
        "prefix": "each",
        "body": [
            "each {",
            "\t${1:condition} => $2;",
            "\t_ => $0;",
            "}"
        ],
        "description": "Run every arm whose condition holds, in order"
    },
    "method": {
        "prefix": "method",
        "body": [
            "func (*${1:Type} ${2:self}) ${3:name}(${4}) {",
            "\t$0",
            "}"
        ],
        "description": "Declares a method with a pointer receiver"
    },
    "enum (with values)": {
        "prefix": "enumvals",
        "body": [
            "enum ${1:Name} {",
            "\t${2:A} = ${3:0},",
            "\t${4:B},",
            "\t$0",
            "}"
        ],
        "description": "Declares an enum with explicit values"
    },
    "struct literal": {
        "prefix": "structlit",
        "body": [
            "${1:Name}{${2:field}: ${3:value}}"
        ],
        "description": "Struct literal"
    },
    "pointer declaration": {
        "prefix": "ptr",
        "body": [
            "*${1:int} ${2:name};"
        ],
        "description": "Pointer declaration"
    },
    "array declaration": {
        "prefix": "arr",
        "body": [
            "${1:int}[${2:5}] ${3:name};"
        ],
        "description": "Fixed-size array declaration"
    },
    "slice declaration": {
        "prefix": "slice",
        "body": [
            "${1:int}[] ${2:name};"
        ],
        "description": "Slice declaration"
    },
    "import": {
        "prefix": "import",
        "body": [
            "import \"${1:path}\";"
        ],
        "description": "Import a module"
    },
    "import (with alias)": {
        "prefix": "importas",
        "body": [
            "import \"${1:path}\" as ${2:alias};"
        ],
        "description": "Import a module with an explicit alias"
    },
    "native": {
        "prefix": "native",
        "body": [
            "native {${0}}};"
        ],
        "description": "Backend-native statement"
    },
    "function without body": {
        "prefix": "funcdecl",
        "body": [
            "func ${1:name}(${2});"
        ],
        "description": "Function declaration without a body"
    },
    "for (range)": {
        "prefix": "for",
        "body": [
            "for ${1:i} in ${2:0}..${3:10} {",
            "\t$0",
            "}"
        ],
        "description": "For loop in an internal"
    },
    "loop": {
        "prefix": "loop",
        "body": [
            "loop {",
            "\t$0",
            "}"
        ],
        "description": "Infinite Loop"
    },
    "interface": {
        "prefix": "interface",
        "body": [
            "interface ${1:Name} {",
            "\tfunc ${2:method}(${3}) ${4};",
            "\t$0",
            "}"
        ],
        "description": "Declares an interface"
    },
    "struct": {
        "prefix": "struct",
        "body": [
            "struct ${1:Name} {",
            "\t$0",
            "}"
        ],
        "description": "Declares a struct"
    },
    "enum": {
        "prefix": "enum",
        "body": [
            "enum ${1:Name} {",
            "\t$0",
            "}"
        ],
        "description": "Declares an enum"
    }
}