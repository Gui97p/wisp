#standalone
// Tour - Basics: constants, variables and operators.
//
// Every file in this tour exports a `demo` function. main.wsp imports them
// all and calls them in order, so you can run the whole tour with:
//
//     wisp run
//
// Each demo prints what it computes, so reading the output next to the code
// is the way through. Printing comes from the standard library:
//
//     import "std/fmt";
//     fmt.println("limit is {}", limit);
//
// `printf` copies its text and puts the next argument where each `{}` is.
// printing.wsp shows what else it can do.
//
// A few functions need no import because the compiler knows them: `emit`
// writes a string and a newline, `len` measures arrays, slices and strings,
// `panic` stops the program with a message, and `sizeof` measures a type.
// Memory comes from the `std/mem` module (see pointers.wsp). Declaring a function with
// one of these names in your own module shadows the builtin.
//
// A comment starts with `//` and is for whoever reads the code, as this whole
// tour is. A comment that starts with `///` is documentation instead: written
// right above a declaration, a struct field, an enum member or an interface
// method, it is what the editor shows when you hover over that name and what
// `wisp doc` prints. A plain `//` line between the two does not break the
// link, but a blank line does.

import "std/fmt";

// A top-level constant. It is visible to the whole file and can never be
// assigned again.
/// The best score there is. Hover over `MaxScore` to read this line.
const MaxScore = 100;

// Several constants can share one declaration. A visibility or a type written
// before the braces applies to every member, and a member can use the ones
// above it.
const int{
	MinScore = 0;
	Range = MaxScore - MinScore;
}

// Without a type before the braces, each member can carry its own, written
// first as everywhere else. Members that do not name one are inferred.
const {
	uint Mask = 0xFF;
	float Ratio = 0.5;
	Label = "score";
}

public func demo() {
	// `let` infers the type from the value; an explicit type works too. The
	// type always comes first, as in `int limit`.
	let total = 2 + 3;
	int limit = 10;

	// Compound assignment and increment.
	limit += 2;
	limit *= 2;
	total++;
	fmt.println("total = {}", total);
	fmt.println("limit = {}", limit);
	fmt.println("MaxScore = {}", MaxScore);
	fmt.println("Range = {}", Range);
	fmt.println("{} mask {}, ratio {}", Label, Mask, Ratio);

	// A variable declared without a value starts zeroed.
	int zeroed;
	fmt.println("zeroed = {}", zeroed);

	// Several variables can be declared together.
	int first, second = 4, 5;
	fmt.println("first + second = {}", first + second);

	// `const` also works inside a function.
	const Greeting = "hi";
	fmt.println("Greeting = {}", Greeting);

	// Integer division truncates toward zero, and `%` keeps the sign of the
	// dividend, so (a / b) * b + a % b is always a. Dividing by zero is not a
	// compile error when the divisor is only known at run time: it panics.
	fmt.println("17 / 5 = {}", 17 / 5);
	fmt.println("-17 / 5 = {}", -17 / 5);
	fmt.println("17 % 5 = {}", 17 % 5);
	fmt.println("-17 % 5 = {}", -17 % 5);

	// Bitwise operators: & | ^ ~ << >>. They only work on integers.
	// `~` is unary (bitwise not), so there is no `~=`.
	int a = 6;
	int b = 3;
	fmt.println("a = {}, b = {}", a, b);
	fmt.println("a & b = {}", a & b);
	fmt.println("a | b = {}", a | b);
	fmt.println("a ^ b = {}", a ^ b);
	fmt.println("~a = {}", ~a);
	fmt.println("a << 1 = {}", a << 1);
	fmt.println("a >> 1 = {}", a >> 1);

	// Every binary bitwise operator has a compound form.
	int flags = 6;
	flags &= 2;
	flags |= 8;
	flags ^= 1;
	flags <<= 1;
	flags >>= 1;
	fmt.println("flags after &= 2, |= 8, ^= 1, <<= 1, >>= 1: {}", flags);

	// Comparisons give a bool, and `&&`, `||` and `!` combine them. The
	// right side of `&&` and `||` is only evaluated when it has to be.
	fmt.println("a > b && !(a == b) = {}", a > b && !(a == b));

	// The ternary operator.
	int bigger = 1 > 2 ? 42 : 21;
	fmt.println("1 > 2 ? 42 : 21 = {}", bigger);
}
