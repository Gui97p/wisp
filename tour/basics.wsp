// Tour - Basics: constants, variables and operators.
//
// Every file in this tour exports a `demo` function. main.wsp imports them
// all and calls them in order, so you can run the whole tour with:
//
//     wisp run
//
// Each demo prints what it computes, so reading the output next to the code
// is the way through. Printing comes from the standard library:
//
//     import "std/fmt";
//     fmt.printf("limit is {}\n", limit);
//
// `printf` copies its text and puts the next argument where each `{}` is.
// printing.wsp shows what else it can do.
//
// A few functions need no import because the compiler knows them: `emit`
// writes a string and a newline, `len` measures arrays, slices and strings,
// `panic` stops the program with a message, and `malloc`, `realloc`, `free`
// and `sizeof` handle memory (see pointers.wsp). Declaring a function with
// one of these names in your own module shadows the builtin.

import "std/fmt";

// A top-level constant. It is visible to the whole file and can never be
// assigned again.
const MaxScore = 100;

export func demo() {
  // `let` infers the type from the value; an explicit type works too. The
  // type always comes first, as in `int limit`.
  let total = 2 + 3;
  int limit = 10;

  // Compound assignment and increment.
  limit += 2;
  limit *= 2;
  total++;
  fmt.printf("total = {}\n", total);
  fmt.printf("limit = {}\n", limit);
  fmt.printf("MaxScore = {}\n", MaxScore);

  // A variable declared without a value starts zeroed.
  int zeroed;
  fmt.printf("zeroed = {}\n", zeroed);

  // Several variables can be declared together.
  int first, second = 4, 5;
  fmt.printf("first + second = {}\n", first + second);

  // `const` also works inside a function.
  const Greeting = "hi";
  fmt.printf("Greeting = {}\n", Greeting);

  // Integer division truncates toward zero, and `%` keeps the sign of the
  // dividend, so (a / b) * b + a % b is always a. Dividing by zero is not a
  // compile error when the divisor is only known at run time: it panics.
  fmt.printf("17 / 5 = {}\n", 17 / 5);
  fmt.printf("-17 / 5 = {}\n", -17 / 5);
  fmt.printf("17 % 5 = {}\n", 17 % 5);
  fmt.printf("-17 % 5 = {}\n", -17 % 5);

  // Bitwise operators: & | ^ ~ << >>. They only work on integers.
  // `~` is unary (bitwise not), so there is no `~=`.
  int a = 6;
  int b = 3;
  fmt.printf("a = {}, b = {}\n", a, b);
  fmt.printf("a & b = {}\n", a & b);
  fmt.printf("a | b = {}\n", a | b);
  fmt.printf("a ^ b = {}\n", a ^ b);
  fmt.printf("~a = {}\n", ~a);
  fmt.printf("a << 1 = {}\n", a << 1);
  fmt.printf("a >> 1 = {}\n", a >> 1);

  // Every binary bitwise operator has a compound form.
  int flags = 6;
  flags &= 2;
  flags |= 8;
  flags ^= 1;
  flags <<= 1;
  flags >>= 1;
  fmt.printf("flags after &= 2, |= 8, ^= 1, <<= 1, >>= 1: {}\n", flags);

  // Comparisons give a bool, and `&&`, `||` and `!` combine them. The
  // right side of `&&` and `||` is only evaluated when it has to be.
  fmt.printf("a > b && !(a == b) = {}\n", a > b && !(a == b));

  // The ternary operator.
  int bigger = 1 > 2 ? 42 : 21;
  fmt.printf("1 > 2 ? 42 : 21 = {}\n", bigger);
}
