// Tour - Compile time: sizeof, alignof, offsetof, staticAssert and `static`.
//
// Some things are known before the program runs, and the compiler can check
// them for you. `sizeof(T)`, `alignof(T)` and `offsetof(T, field)` are
// constants, so they can size an array, feed another constant, or be asserted
// with `staticAssert(condition, "message")`: when the condition is false the
// compilation stops with the message. A `staticAssert` can be written at the
// top of a file, or inside a function.
//
// A `static { }` block computes a constant with ordinary code. It is a block
// that gives a value, and the compiler runs it while it compiles. It sees
// numbers, booleans, floats, strings, arrays and structs, and its own
// variables and constants, and it can use `if`, `switch`, `for i in a..b`,
// `for x in array`, `loop`, labeled breaks, `len`, indexing, string slices and
// calls to ordinary functions, recursive ones included. It cannot reach a
// variable of the function around it, a pointer, memory or a type used as a
// value: the compiler says so where it happens. A loop that never ends is
// stopped after a few million steps.
//
// A constant can hold an array or a struct. It lives in the read-only data of
// the program, costs nothing at run time, and can be indexed in a `staticAssert`.
// When a `static` block yields an array, that is a table computed by the
// compiler, like the CRC-32 table below.
//
// A constant that measures a struct can size a field of another struct, in
// any order, as long as the structs do not need each other's size.

import "std/fmt";

struct Header {
  uint8 kind;
  int length;
  uint16 flags;
}

struct Wrapper {
  uint8 tag;
  Header inner;
}

const HEADER_SIZE = sizeof(Header);
const FLAGS_AT = offsetof(Header, flags);

staticAssert(HEADER_SIZE == 24, "Header is padded to 24 bytes");
staticAssert(offsetof(Header, kind) == 0, "kind comes first");

struct Frame {
  [HEADER_SIZE * 2]byte payload;
}

inline func triangle(int n) int {
  int total = 0;
  for i in 1..n {
    total += i;
  }
  return total;
}

const TRIANGLE_10 = static { yield triangle(10); };

const FIRST_BIG_SQUARE = static {
  int n = 1;
  loop n * n < 500 {
    n++;
  }
  yield n;
};

const [3]int PRIMES = [2, 3, 5];
const Header DEFAULT = Header{kind: 1, length: 8, flags: 0};

func fib(int n) int {
  if n < 2 {
    return n;
  }
  return fib(n - 1) + fib(n - 2);
}

const FIB_20 = static { yield fib(20); };

const [256]uint32 CRC = static {
  [256]uint32 table;
  for i in 0..255 {
    uint32 c = uint32(i);
    for _step in 0..7 {
      if (c & 1) != 0 {
        c = 0xEDB88320 ^ (c >> 1);
      } else {
        c = c >> 1;
      }
    }
    table[i] = c;
  }
  yield table;
};

staticAssert(CRC[1] == 0x77073096, "this is the CRC-32 table");

func crc(string text) uint32 {
  uint32 c = 0xFFFFFFFF;
  for _i, b in text {
    c = CRC[(c ^ uint32(b)) & 255] ^ (c >> 8);
  }
  return c ^ 0xFFFFFFFF;
}

const KIND_NAME = static {
  string name = "";
  switch DEFAULT.kind {
    case 0: name = "none";
    case 1: name = "data";
    default: name = "other";
  }
  yield name;
};

public func demo() {
  fmt.printf("Header: size {}, alignment {}\n", HEADER_SIZE, alignof(Header));
  fmt.printf("length is at {}, flags at {}\n", offsetof(Header, length), FLAGS_AT);
  fmt.printf("a path works too: {}\n", offsetof(Wrapper, inner.flags));
  fmt.printf("a Frame has {} bytes\n", sizeof(Frame));

  [HEADER_SIZE]byte raw;
  fmt.printf("an array sized by sizeof has {} bytes\n", len(raw));

  fmt.printf("1 + 2 + ... + 10 = {}\n", TRIANGLE_10);
  fmt.printf("the first n with n * n >= 500 is {}\n", FIRST_BIG_SQUARE);

  // A static block can also sit in the middle of a function. Here it looks
  // for a factor of 91.
  int factor = static {
    int found = 0;
    :search for i in 2..50 {
      for j in 2..50 {
        if i * j == 91 {
          found = i;
          break :search;
        }
      }
    }
    yield found;
  };
  fmt.printf("a factor of 91: {}\n", factor);

  fmt.printf("constants: {} primes, {} bytes by default, fib(20) = {}\n", len(PRIMES), DEFAULT.length, FIB_20);
  fmt.printf("a default Header is {}\n", KIND_NAME);
  fmt.printf("crc(\"123456789\") = {x}\n", crc("123456789"));
}
