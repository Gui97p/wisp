#standalone
#allow unused_variables, dead_code
// Tour - Compile time: sizeof, alignof, offsetof, staticAssert and `static`.
//
// Some things are known before the program runs, and the compiler can check
// them for you. The comment at the end of a line shows the value that line
// gives.

// ---------------------------------------------------------------------------
// 1. Measuring types
// ---------------------------------------------------------------------------
//
// `sizeof(T)`, `alignof(T)` and `offsetof(T, field)` are constants, so they can
// size an array, feed another constant, or be asserted. A constant that
// measures a struct can size a field of another struct, in any order, as long as
// the structs do not need each other's size.

struct Header {
	uint8 kind;
	int length;
	uint16 flags;
}

struct Wrapper {
	uint8 tag;
	Header inner;
}

const HEADER_SIZE = sizeof(Header);
const FLAGS_AT = offsetof(Header, flags);

struct Frame {
	[HEADER_SIZE * 2]byte payload;
}

func measuring() {
	int size = HEADER_SIZE;  // 24
	int alignment = alignof(Header);  // 8
	int lengthAt = offsetof(Header, length);  // 8
	int flagsAt = FLAGS_AT;  // 16
	int deepAt = offsetof(Wrapper, inner.flags);  // 24
	int frameSize = sizeof(Frame);  // 48

	[HEADER_SIZE]byte raw;
	int rawLength = len(raw);  // 24
}

// ---------------------------------------------------------------------------
// 2. Asserting
// ---------------------------------------------------------------------------
//
// `staticAssert(condition, "message")` stops the compilation with the message
// when the condition is false. It can be written at the top of a file, or
// inside a function.

staticAssert(HEADER_SIZE == 24, "Header is padded to 24 bytes");
staticAssert(offsetof(Header, kind) == 0, "kind comes first");

// ---------------------------------------------------------------------------
// 3. Constants computed by code
// ---------------------------------------------------------------------------
//
// A `static { }` block computes a constant with ordinary code. It is a block
// that gives a value, and the compiler runs it while it compiles. It sees
// numbers, booleans, floats, strings, arrays and structs, and its own variables
// and constants, and it can use `if`, `switch`, `for i in a..b`, `for x in
// array`, `loop`, labeled breaks, `len`, indexing, string slices and calls to
// ordinary functions, recursive ones included.
//
// It cannot reach a variable of the function around it, a pointer, memory or a
// type used as a value: the compiler says so where it happens. A loop that never
// ends is stopped after a few million steps.

inline func triangle(int n) int {
	int total = 0;
	for i in 1..=n {
		total += i;
	}
	return total;
}

const TRIANGLE_10 = static { yield triangle(10); };

const FIRST_BIG_SQUARE = static {
	int n = 1;
	loop n * n < 500 {
		n++;
	}
	yield n;
};

func fib(int n) int {
	if n < 2 {
		return n;
	}
	return fib(n - 1) + fib(n - 2);
}

const FIB_20 = static { yield fib(20); };

func computing() {
	int triangle10 = TRIANGLE_10;  // 55
	int bigSquare = FIRST_BIG_SQUARE;  // 23
	int fib20 = FIB_20;  // 6765

	// A static block can also sit in the middle of a function. Here it looks for
	// a factor of 91.
	int factor = static {
		int found = 0;
		:search for i in 2..=50 {
			for j in 2..=50 {
				if i * j == 91 {
					found = i;
					break :search;
				}
			}
		}
		yield found;
	};  // 7
}

// ---------------------------------------------------------------------------
// 4. Constants that hold arrays and structs
// ---------------------------------------------------------------------------
//
// A constant can hold an array or a struct. It lives in the read-only data of
// the program, costs nothing at run time, and can be indexed in a
// `staticAssert`.

const [3]int PRIMES = .{2, 3, 5};
const Header DEFAULT = Header{kind: 1, length: 8, flags: 0};

const KIND_NAME = static {
	yield switch DEFAULT.kind {
		case 0 => "none";
		case 1 => "data";
		default => "other";
	};
};

func holding() {
	int primeCount = len(PRIMES);  // 3
	int defaultLength = DEFAULT.length;  // 8
	string kind = KIND_NAME;  // "data"
}

// ---------------------------------------------------------------------------
// 5. Tables made by the compiler
// ---------------------------------------------------------------------------
//
// When a `static` block yields an array, that is a table computed by the
// compiler, like the CRC-32 table below. The program only reads it.

const [256]uint32 CRC = static {
	[256]uint32 table;
	for i in 0..=255 {
		uint32 c = uint32(i);
		for _step in 0..=7 {
			if (c & 1) != 0 {
				c = 0xEDB88320 ^ (c >> 1);
			} else {
				c = c >> 1;
			}
		}
		table[i] = c;
	}
	yield table;
};

staticAssert(CRC[1] == 0x77073096, "this is the CRC-32 table");

func crc(string text) uint32 {
	uint32 c = 0xFFFFFFFF;
	for _i, b in text {
		c = CRC[(c ^ uint32(b)) & 255] ^ (c >> 8);
	}
	return c ^ 0xFFFFFFFF;
}

func tables() {
	uint32 check = crc("123456789");  // 3421780262
}

public func demo() {
	measuring();
	computing();
	holding();
	tables();
}
