// Tour - Variadic functions.
//
// A variadic parameter is written `type ...name`. Inside the body it is a
// real span: indexable, iterable and measurable with `len`. Callers pass any
// number of arguments, including none.
//
// A slice goes into a variadic with `...` after it, as in `sum(numbers...)`,
// as long as its elements are the type the variadic takes. Loose values can
// come before it, `sum(1, 2, numbers...)`, and a function can pass its own
// variadic on, `sum(values...)`. An array is spread through a slice of it,
// `sum(array[:]...)`.
//
// Do not confuse this with a C variadic such as C's printf, which is declared
// with `extern`.

import "std/fmt";

func sum(int ...values) int {
  int total;
  for _, v in values {
    total += v;
  }
  return total;
}

func twiceTheSum(int ...values) int {
  return sum(values...) * 2;
}

public func demo() {
  fmt.printf("sum(1, 2, 3, 4) = {}\n", sum(1, 2, 3, 4));
  fmt.printf("sum() = {}\n", sum());

  []int numbers = .{10, 20, 30};
  fmt.printf("sum(numbers...) = {}\n", sum(numbers...));
  fmt.printf("sum(1, 2, numbers...) = {}\n", sum(1, 2, numbers...));
  fmt.printf("twiceTheSum(5, 6) = {}\n", twiceTheSum(5, 6));
}
