// Tour - Variadic functions.
//
// A variadic parameter is written `type ...name`. Inside the body it is a
// real span: indexable, iterable and measurable with `len`. Callers pass any
// number of arguments, including none.
//
// Do not confuse this with a C variadic such as C's printf, which is declared
// with `extern`.

import "std/fmt";

func sum(int ...values) int {
  int total;
  for _, v in values {
    total += v;
  }
  return total;
}

public func demo() {
  fmt.printf("sum(1, 2, 3, 4) = {}\n", sum(1, 2, 3, 4));
  fmt.printf("sum() = {}\n", sum());
}
