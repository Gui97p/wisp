#standalone
// Tour - Generics: functions, structs and methods that work for any type.
//
// A type parameter goes between `<>` after the name: `func biggest<T>(...)`,
// `struct List<T>`. Inside, `T` is a type like any other, and the compiler
// writes a copy of the declaration for every type it is used with: `List<int>`
// and `List<string>` are two different structs, as if each had been written by
// hand.
//
// The body of a generic is checked once, against what its type parameter is
// promised to have, so an error shows up where the generic is written and not
// in some use of it. A bare `T` can only be copied, passed on and returned. To
// add, compare or call something, say so with a constraint written before the
// name: `Number T` is a `T` that is one of the types of `Number`, and `Writer W`
// is a `W` that declares `implements Writer` (see the interfaces page).
//
// Calls infer the type from the arguments, and `f<int>(x)` names it when it
// cannot be inferred. A struct always names its types: `List<int> numbers`.
//
// A method of a generic struct lists the type parameters in its receiver:
// `func (*List<T> l) push(T value)`. The names between `<>` there are new each
// time, so a method may call its parameter `E` if it likes. A method can also
// have type parameters of its own, after its name, with constraints like any
// other: `func (*List<T> l) fold<U>(...)`. They are inferred from the arguments
// or named at the call: `list.fold<int>(0, add)`.
//
// A parameter can also be a value that is known at compile time, written with
// `const`: `struct Ring<T, const int N>`. It works as a constant in the
// declaration, it can size an array, and it can be inferred from an array.
//
// A generic function can be a value too, as long as every type is named:
// `let f = biggest<int>`. A `type` and an enum with data take parameters the
// same way, and a generic type keeps its own identity per argument, also inside
// an `any`: a `*Maybe<int>` and a `*Maybe<string>` are different cases of a
// `switch type`.

import "std/fmt";

interface Number { int | int64 | float | float32 | byte }
interface Ordered { int | int64 | float | string }

struct List<Number T> {
	[8]T items;
	int count;
}

func (*List<T> l) push(T value) {
	l.items[l.count] = value;
	l.count++;
}

func (*List<T> l) sum() T {
	T total;
	for i in 0..l.count - 1 {
		total += l.items[i];
	}
	return total;
}

func (*List<T> l) fold<U>(U start, (U, T) => U step) U {
	U acc = start;
	for i in 0..l.count {
		acc = step(acc, l.items[i]);
	}
	return acc;
}

func addLength(int acc, int n) int => acc * 10 + n;

struct Pair<A, B> {
	A first;
	B second;
}

func swap<A, B>(Pair<A, B> p) Pair<B, A> {
	return Pair<B, A>{first: p.second, second: p.first};
}

func biggest<Ordered T>(T a, T b) T {
	return a > b ? a : b;
}

func apply<T, U>(T value, (T) => U f) U {
	return f(value);
}

func square(int x) int => x * x;

struct Ring<T, const int N> {
	[N]T slots;
	int head;
}

func (*Ring<T, N> r) put(T value) {
	r.slots[r.head % N] = value;
	r.head++;
}

func capacity<T, const int N>(Ring<T, N> _ring) int {
	return N;
}

// `switch type` on a value that is not an `any` is decided by the compiler:
// each copy keeps only the case of its own type, and the other cases are not
// even analysed, so a case may do what only its type can do. `case signed v`
// and `case unsigned v` stand for every integer of that kind.
func describe<T>(T value) string {
	switch type value {
		case string text => return text;
		case signed _number => return "an integer";
		case bool => return "a bool";
		default => return "something else";
	}
}

// The subject of a `switch type` can be the type parameter itself, and the
// switch can be an expression: only the case of the chosen type survives.
func bytesOf<T>() int {
	return switch type T {
		case byte => 1;
		case int, uint => 8;
		case string => 16;
		default => 0;
	};
}

// A `type` gives a name to another type for each argument. As for any `type`,
// the new type is distinct from the one it is made of.
type Step<T>(T) => T;

func twice<T>(T value, Step<T> step) T {
	return step(step(value));
}

func increment(int x) int => x + 1;

// An enum with data takes parameters when its variants use them. The variants
// are written after the type with its arguments, or with just a dot where the
// type is known from the context.
enum Maybe<T> {
	Nothing,
	Just{T value;}
}

func (*Maybe<T> m) orElse(T fallback) T {
	switch m {
		case .Just j => return j.value;
		default => return fallback;
	}
}

public func demo() {
	List<int> numbers;
	numbers.push(3);
	numbers.push(4);
	List<float> weights;
	weights.push(1.5);
	weights.push(2.5);
	fmt.printf("sum of the numbers {}, of the weights {}\n", numbers.sum(), weights.sum());

	fmt.printf("folded: {}\n", numbers.fold(0, addLength));

	Pair<int, string> pair = Pair<int, string>{first: 1, second: "one"};
	Pair<string, int> flipped = swap(pair);
	fmt.printf("swapped: {} and {}\n", flipped.first, flipped.second);

	fmt.printf("biggest(3, 9) = {}, biggest<float>(1.5, 0.5) = {}\n", biggest(3, 9), biggest<float>(1.5, 0.5));
	fmt.printf("apply(7, square) = {}\n", apply(7, square));

	Ring<byte, 4> ring;
	ring.put(1);
	fmt.printf("a ring of {} slots, {} bytes in all\n", capacity(ring), sizeof(ring));

	fmt.printf("{}, {}, {}, {}\n", describe("text"), describe(42), describe(true), describe(1.5));

	fmt.printf("sizes: {} {} {}\n", bytesOf<byte>(), bytesOf<int>(), bytesOf<string>());

	let step = increment;
	fmt.printf("twice(5) = {}\n", twice(5, step));
	let pick = biggest<int>;
	fmt.printf("pick(2, 8) = {}\n", pick(2, 8));

	Maybe<int> found = Maybe < int > .Just{value: 7};
	Maybe<int> missing = .Nothing;
	fmt.printf("{} and {}\n", found.orElse(0), missing.orElse(-1));
}
