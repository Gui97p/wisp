#standalone
#allow unused_variables, dead_code
// Tour - Floating point numbers.
//
// The language has float32 and float64, with `float` as another name for
// float64 (the way `int` is for int64). A literal with a decimal point or an
// exponent (`2.5`, `1e3`, `4.5e-7`) is a float, and an integer literal turns
// into one where a float is expected. The comment at the end of a line shows
// the value that line gives.

import "std/fmt";

// ---------------------------------------------------------------------------
// 1. Literals and arithmetic
// ---------------------------------------------------------------------------
//
// Division keeps the fraction, and the operators work on assignments too.

func arithmetic() {
	float ratio = 2.5;
	bool twice = ratio * 2 == 5.0;  // true
	bool scientific = 25e-1 == ratio;  // true
	bool between = ratio > 2 && ratio < 3;  // true

	float back = 7.0 / 2.0 * 2.0;  // 7
	float total = 10.0;
	total += 2.5;  // 12.5
	total *= 2.0;  // 25
	float negated = -ratio;  // -2.5
}

// ---------------------------------------------------------------------------
// 2. Floats and integers
// ---------------------------------------------------------------------------
//
// An integer converts to a float and back by naming the type. Going back drops
// the fraction, toward zero.

func conversions() {
	int whole = 3;
	float widened = float(whole);  // 3
	bool half = widened / 2 == 1.5;  // true

	int cut = int(3.9);  // 3
	int cutNegative = int(-3.9);  // -3
}

// ---------------------------------------------------------------------------
// 3. The two widths
// ---------------------------------------------------------------------------
//
// A float32 widens to float on its own, and float and float64 are the same type
// for every purpose. Each width prints the shortest text for its own precision:
// the float32 below is the nearest float32 to 1.1, and it still prints as 1.1.

func widths() {
	float32 small = 1.5;
	float64 big = small;
	float same = big;  // 1.5

	float32 narrow = 1.1;  // 1.1
}

// ---------------------------------------------------------------------------
// 4. Not a number, and infinity
// ---------------------------------------------------------------------------
//
// NaN is not equal to anything, itself included, and every ordering comparison
// with it is false. `!=` is the only one that holds. Dividing by zero does not
// stop a float program: it gives infinity, or NaN for zero over zero.

func specials() {
	float zero = 0.0;
	float nan = zero / zero;  // NaN
	float infinite = 1.0 / zero;  // inf

	bool equal = nan == nan;  // false
	bool different = nan != nan;  // true
	bool less = nan < 1.0;  // false
	bool greater = nan > 1.0;  // false
}

// ---------------------------------------------------------------------------
// 5. How a float prints
// ---------------------------------------------------------------------------
//
// With `{}` a float prints as the shortest text that reads back as the same
// number. `.N` writes N digits after the point, rounded to nearest on the exact
// value, `f` is six digits as in C, `e` is scientific, and a leading 0 pads
// with zeros after the sign. printing.wsp has the whole spec. The comment on
// these lines is what they print.

func printing() {
	float pi = 3.141592653589793;

	fmt.println("[{pi:.2f}] [{pi:f}] [{pi:e}] [{pi:.3e}] [{-pi:010.3f}]");  // [3.14] [3.141593] [3.141593e+00] [3.142e+00] [-00003.142]
	fmt.println("[{1e21}] [{0.00001}] [{0.000001}]");  // [1e+21] [0.00001] [1e-06]
}

// ---------------------------------------------------------------------------
// 6. Floats in functions and structs
// ---------------------------------------------------------------------------

struct Vec {
	float x;
	float y;
}

func average(float a, float b) float {
	return (a + b) / 2.0;
}

func bounds(float a, float b) (float, float) {
	return if a < b => a : b, if a < b => b : a;
}

func dot(Vec a, Vec b) float {
	return a.x * b.x + a.y * b.y;
}

func using() {
	float mean = average(2.0, 5.0);  // 3.5
	let low, high = bounds(4.5, 1.5);  // 1.5, 4.5

	Vec a = Vec{x: 1.5, y: 2.0};
	Vec b = Vec{x: 2.0, y: 4.0};
	float product = dot(a, b);  // 11
}

public func demo() {
	arithmetic();
	conversions();
	widths();
	specials();
	printing();
	using();
}
