#standalone
#allow unused_variables, dead_code
// Tour - Error handling.
//
// A function that can fail says so in its signature, and the caller has to
// decide what to do about it: pass the error up, use a default, or handle it
// where it happened. The comment at the end of a line shows the value that line
// gives.

import "std/errors";
import "std/mem";

// ---------------------------------------------------------------------------
// 1. Failing
// ---------------------------------------------------------------------------
//
// An enum is the family of an error: each member is one kind of failure. The
// member's number is the exit code if the error ends the program, so the first
// member is written `= 1`: code 0 would read as success.
//
// A `!` before the return list marks a function that can fail. Inside it,
// `return value` succeeds and `return Error(Enum.Member)` fails. The error keeps
// its enum, the member, a message (the member's name unless you give one) and the
// file and line where it was raised.

enum DivError {
	DivByZero = 1
}

func divide(int a, b) !int {
	if b == 0 {
		return Error(DivError.DivByZero, "cannot divide by zero");
	}
	return a / b;
}

// ---------------------------------------------------------------------------
// 2. A default when it fails
// ---------------------------------------------------------------------------
//
// `??` unwraps the result, falling back to a default value on failure.
// `?? |e| value` computes the fallback from the error.

func defaults() {
	int ok = divide(10, 2) ?? -1;  // 5
	int fallback = divide(10, 0) ?? -1;  // -1
	int code = divide(10, 0) ?? |e| e.code;  // 1
}

// ---------------------------------------------------------------------------
// 3. Passing the error up
// ---------------------------------------------------------------------------
//
// A postfix `!` passes the error up: if the call fails, this function fails with
// the very same error. It is only legal inside a fallible function.

func halveThenDouble(int a, b) !int {
	let half = divide(a, b)!;
	return half * 2;
}

func passing() {
	int worked = halveThenDouble(10, 2) ?? -1;  // 10
	int failed = halveThenDouble(10, 0) ?? -1;  // -1
}

// ---------------------------------------------------------------------------
// 4. Handlers that leave
// ---------------------------------------------------------------------------
//
// A handler block runs on failure and has to leave: `return` here returns from
// `describe` itself. A handler does not have to name the error. `?? { ... }` runs
// a block, and the short forms `?? return value`, `?? break` and `?? continue`
// leave the function or the loop on a failure.

func describe(int a, b) string {
	let n = divide(a, b) ?? |e| {
		return e.message;
	};
	if n > 0 {
		return "positive";
	}
	return "zero";
}

func halfOr(int a, b) int {
	int n = divide(a, b) ?? return -1;
	return n;
}

func sumGood(int a, int b) int {
	int total = 0;
	for i in 0..=1 {
		int n = divide(10, i == 0 ? a : b) ?? continue;
		total += n;
	}
	return total;
}

func leaving() {
	string zero = describe(10, 0);  // "cannot divide by zero"
	string positive = describe(10, 5);  // "positive"

	int half = halfOr(10, 2);  // 5
	int none = halfOr(10, 0);  // -1

	int first = sumGood(2, 0);  // 5
	int second = sumGood(0, 5);  // 2
}

// ---------------------------------------------------------------------------
// 5. Handlers that give a value
// ---------------------------------------------------------------------------
//
// `yield value` leaves the handler block with a value, and that value is what the
// `??` gives. It lets a handler do some work and carry on. `return` leaves the
// function, `yield` only the handler.
//
// A handler can also be a `match` expression. It picks what to do by the error:
// an arm gives a value, or leaves with `return`, `continue` or `break`. `_`
// catches the rest. To run statements, write a block and put a `match`
// statement inside it.

func divideOr(int a, b, fallback) int {
	int n = divide(a, b) ?? |e| {
		yield fallback;
	};
	return n;
}

func codeOf(int a, int b) int {
	int n = divide(a, b) ?? |e| match e {
		DivError.DivByZero => -1;
		_ => return -2;
	};
	return n;
}

func yielding() {
	int rescued = divideOr(10, 0, 99);  // 99
	int divided = divideOr(10, 2, 99);  // 5

	int byZero = codeOf(10, 0);  // -1
	int fine = codeOf(10, 2);  // 5
}

// ---------------------------------------------------------------------------
// 6. Looking at the error
// ---------------------------------------------------------------------------
//
// Destructuring gives the value and the error. The value is zero on failure, and
// an error you never read is a compile error (bind it to `_` to drop it on
// purpose).
//
// An error compares with null and with enum members, so a match can sort
// failures out. The member is written in full here: an Error does not know which
// enum to look in, so `.DivByZero` would be ambiguous.
//
// An error prints with `{}` as its message, and `{err:v}` adds the enum and where
// it was raised. An error that is null prints as <null error>.

func inspecting() {
	let value, e = divide(10, 0);
	int zero = value;  // 0
	bool failed = e != null;  // true

	let _, err = divide(7, 0);
	string what = match err {
		null => "no error";
		DivError.DivByZero => "divided by zero";
		_ => err.message;
	};  // "divided by zero"
}

// ---------------------------------------------------------------------------
// 7. Errors without an enum
// ---------------------------------------------------------------------------
//
// An error does not have to belong to an enum. `Error("message")` is a plain
// error: no enum, the code 1, and the message. It compares with null and with
// other errors, and an error kept in a global works as a sentinel to look for:
// two errors are equal when they are the very same record.

Error missing = Error("nothing there");

func lookup(int key) !int {
	return missing if key == 0;
	return Error("the key is negative") if key < 0;
	return key * 2;
}

func plain() {
	let _, gone = lookup(0);
	let _, negative = lookup(-4);

	string goneMessage = gone.message;  // "nothing there"
	string negativeMessage = negative.message;  // "the key is negative"
	bool sentinel = gone == missing;  // true
	bool other = negative == missing;  // false
}

// ---------------------------------------------------------------------------
// 8. Messages made at run time
// ---------------------------------------------------------------------------
//
// An Error is a constant, so a message that holds a value, such as a path, is
// made at run time instead: `errors.errorf("no file {path}")` is a plain error
// with the values written into its message, and `errors.annotate(e, "loading
// {path}: {e}")` gives an error a new message and keeps its kind, and where it was
// raised. `errors.annotate(Error(Kind.NotFound), "no file {path}")` makes an error
// of a kind with a message of its own.
//
// An error made at run time is valid until eight more like it are made, which is
// plenty to handle it or pass it up. To keep one longer, `errors.keep` copies it
// into an allocator, and an arena clears it with everything else.

func open(string path) !int {
	return errors.errorf("cannot open {path}") if len(path) == 0;
	return errors.annotate(Error(errors.Kind.NotFound), "no file {path}") if path == "missing.txt";
	return len(path);
}

func openAndLoad(string path) !int {
	let n = open(path) ?? |e| return errors.annotate(e, "loading {path}: {e}");
	return n;
}

func runtime() {
	let _, notThere = openAndLoad("missing.txt");
	string message = notThere.message;  // "loading missing.txt: no file missing.txt"
	bool notFound = notThere == errors.Kind.NotFound;  // true

	mem.Arena arena;
	defer arena.release();
	Error saved = errors.keep(&arena, notThere);
	for _ in 0..20 {
		let _, _ = openAndLoad("missing.txt");
	}
	string kept = saved.message;  // "loading missing.txt: no file missing.txt"
}

// ---------------------------------------------------------------------------
// 9. The failures every program shares
// ---------------------------------------------------------------------------
//
// std/errors has the failures that every program shares, as the enum
// errors.Kind (NoSpace, OutOfMemory, Busy, Invalid, Range, Overflow, Unsupported,
// NotFound, Exists, Permission, Interrupted, WouldBlock and BrokenPipe), and
// helpers that save writing `if !ok { return Error(...) }`. `ensure` returns the
// error when its condition is false. `ensureMessage` adds a message. The kind has
// to be written out, because an Error is a constant record made at the place it
// is raised.
//
// A function with no result hands its error to `let`, which holds null when it
// worked. `temporary` and `missing` tell families of kinds apart: a temporary
// failure (Busy, Interrupted, WouldBlock) is worth trying again, and a missing
// one is NotFound. Both answer false for null.

func store(int used, int size) ! {
	errors.ensure(used <= size, errors.Kind.NoSpace)!;
}

func storeNamed(int used, int size) ! {
	errors.ensureMessage(used <= size, errors.Kind.NoSpace, "the buffer is full")!;
}

func shared() {
	let fits = store(2, 4);
	let tight = store(9, 4);
	let named = storeNamed(9, 4);

	bool worked = fits == null;  // true
	bool noSpace = tight == errors.Kind.NoSpace;  // true
	string message = named.message;  // "the buffer is full"
	bool temporary = errors.temporary(tight);  // false
	bool notFound = errors.missing(fits);  // false
}

// `errors.assert(condition, message)` is for a mistake in the program itself: it
// does not return an error, it stops the program with the message, and so do
// `errors.unreachable(message)` for a place that must never run and
// `errors.todo(message)` for code that is not written yet.

// ---------------------------------------------------------------------------
// 10. Dropping an error on purpose
// ---------------------------------------------------------------------------
//
// A call that returns no value has nothing to fall back to, so its handler may
// simply end. This is how a failure that nobody can act on is dropped on purpose,
// and the only way to handle a call inside a `defer`, which cannot return from
// the function:
//
//     defer close(fd) ?? {};
//     defer close(fd) ?? |e| { log("close failed: {e.message}"); };
//
// `main` can be fallible too: `func main() !int`. If it ends in an error, the
// program prints it and exits with the error's code.

public func demo() {
	defaults();
	passing();
	leaving();
	yielding();
	inspecting();
	plain();
	runtime();
	shared();
}
