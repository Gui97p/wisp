#standalone
#allow unused_variables, dead_code
// Tour - Types: named types, enums, characters, strings and conversions.
//
// The sizes of the number types are in basics.wsp. The comment at the end of a
// line shows the value that line gives.

// ---------------------------------------------------------------------------
// 1. Named types
// ---------------------------------------------------------------------------
//
// `type` creates a new nominal type. UserID and int are different types, so
// mixing them needs an explicit conversion. The new type keeps what the type it
// is made of can do: a `type Meters int` adds, compares and shifts like an int,
// a `type Row [3]int` is indexed, measured with `len` and walked with `for`,
// and a `type Name string` is indexed too. Two different defined types still do
// not mix, so `meters + seconds` is an error, and the methods of the original
// type are not inherited.

type UserID int;
type Meters int;
type Row[3] int;

func named() {
	// An untyped literal adapts to the named type directly...
	UserID uid = 42;

	// ...but going back to int needs a conversion: the type name used as a function.
	int raw = int(uid);  // 42

	Meters walked = 5;
	walked += 3;
	int meters = int(walked);  // 8
	Row marks;
	marks[1] = int(walked) * 2;  // 16
	int length = len(marks);  // 3
}

// ---------------------------------------------------------------------------
// 2. Enums
// ---------------------------------------------------------------------------
//
// An enum is a nominal type with named members, written Color.Green. Numbering
// starts at 0 and continues from the last explicit value. Where the enum is
// known (an assignment, an argument, a return, a comparison, a case) the type
// name can be left out: `.Green`.
//
// Every enum also has a `name()` method that returns the member name of a value,
// or "?" when it holds none. Writing your own `name` method on the enum replaces
// it.

enum Color {
	Red,
	Green,
	Blue,
	Alpha = 10,
	Beta
}

func enums() {
	Color favorite = .Green;
	string name = favorite.name();  // "Green"
	int number = int(favorite);  // 1
	int blue = int(Color.Blue);  // 2
	int alpha = int(Color.Alpha);  // 10
	int beta = int(Color.Beta);  // 11
	bool same = favorite == Color.Green;  // true
}

// ---------------------------------------------------------------------------
// 3. Bytes and characters
// ---------------------------------------------------------------------------
//
// `byte` is another name for `uint8`: a string is made of bytes, and so are
// buffers. A character literal such as 'w' is a byte. It takes the same escapes
// as a string: \n, \r, \t, \\, \', \", \0 and \xHH for a byte in hexadecimal.
// `'\0'` is the zero byte that ends a C string.

func characters() {
	byte letter = 'w';  // 119
	bool zero = '\0' == '\x00';  // true
	int newline = int('\n');  // 10
}

// ---------------------------------------------------------------------------
// 4. Strings that span lines
// ---------------------------------------------------------------------------
//
// Text between backticks is a raw string: it can span lines, and a backslash is
// just a backslash (only \` stands for a backtick).
//
// Lines that start with `\\` make a multi-line string too, one that does not
// care how the code around it is indented. The text of a line is whatever
// follows the two backslashes, as it is written (the `;` goes on a line of its
// own), and the lines are joined with a newline, none after the last.

func strings() {
	string path = `C:\temp\new
second line`;
	int pathBytes = len(path);  // 23

	string usage =
		\\usage: tour [flags]
		\\
		\\  --verbose  say more
	;
	int usageBytes = len(usage);  // 42
}

// ---------------------------------------------------------------------------
// 5. Changing the width of an integer
// ---------------------------------------------------------------------------
//
// Integers have a width, and `+%` wraps at it (the overflow page has the other
// ways to handle going past it). A widening conversion is implicit; any other
// conversion names the type. `int8(100)` is for a value that fits, and
// `truncate(int8, 300)` keeps the low bits on purpose.

func widths() {
	int8 small = 127;
	small +%= 1;  // -128

	uint8 top = 255;
	top +%= 1;  // 0

	int8 narrow = 5;
	int64 wide = narrow;  // 5

	int big = 300;
	int8 fits = int8(100);  // 100
	int8 cut = truncate(int8, big);  // 44
}

public func demo() {
	named();
	enums();
	characters();
	strings();
	widths();
}
