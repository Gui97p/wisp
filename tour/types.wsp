// Tour - Types: aliases, enums, sizes and conversions.

import "std/fmt";

// `type` creates a new nominal type. UserID and int are different types, so
// mixing them needs an explicit conversion.
type UserID int;

// An enum is a nominal type with named members, written Color.Green. Numbering
// starts at 0 and continues from the last explicit value. Where the enum is
// known (an assignment, an argument, a return, a comparison, a case) the type
// name can be left out: `.Green`.
//
// Every enum also has a `name()` method that returns the member name of a
// value, or "?" when it holds none. Writing your own `name` method on the enum
// replaces it.
enum Color {
  Red,
  Green,
  Blue,
  Alpha = 10,
  Beta
}

export func demo() {
  // An untyped literal adapts to the alias directly...
  UserID uid = 42;

  // ...but going back to int needs a conversion: the type name used as a function.
  int raw = int(uid);
  fmt.printf("the UserID as an int: {}\n", raw);

  Color favorite = .Green;
  fmt.printf("favorite is {}, number {}\n", favorite.name(), int(favorite));
  fmt.printf("Color.Blue is {}\n", int(Color.Blue));
  fmt.printf("Color.Alpha is {} and Color.Beta is {}\n", int(Color.Alpha), int(Color.Beta));
  fmt.printf("favorite == Color.Green: {}\n", favorite == Color.Green);

  // Primitive types: int, uint, int8..int64, uint8..uint64, float, float32,
  // float64, bool, char and string. `int` and `uint` are 64 bits wide, and
  // `float` is another name for float64, the way `int` is for int64.
  bool ready = true;
  char letter = 'w';
  fmt.printf("ready is {} and letter is {}\n", ready, letter);

  // A char takes the same escapes as a string: \n, \r, \t, \\, \', \", \0 and
  // \xHH for a byte in hexadecimal. `'\0'` is the zero byte that ends a C string.
  fmt.printf("'\\0' == '\\x00': {}\n", '\0' == '\x00');
  fmt.printf("'\\n' is the byte {}\n", int('\n'));

  // Integers wrap at their width.
  int8 small = 127;
  small++;
  fmt.printf("int8 127 + 1 wraps to {}\n", small);

  uint8 byte = 255;
  byte++;
  fmt.printf("uint8 255 + 1 wraps to {}\n", byte);

  // A widening conversion is implicit; any other conversion names the type.
  int8 narrow = 5;
  int64 wide = narrow;
  fmt.printf("int8 {} widens to int64 {}\n", narrow, wide);
  int big = 300;
  fmt.printf("int8(300) keeps the low bits: {}\n", int8(big));

  // `sizeof` takes a type or an expression and gives its size in bytes.
  fmt.printf("sizeof int8, int32, int: {}, {}, {}\n", sizeof(int8), sizeof(int32), sizeof(int));
}
