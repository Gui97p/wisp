#standalone
#allow unused_variables, dead_code
// Tour - Reading and writing numbers.
//
// `std/conv` turns text into numbers and numbers into text. It never hides a
// failure: a text that is not a number is an `Invalid` error, and a number that
// does not fit is `Overflow`. The comment at the end of a line shows the value
// that line gives.

import "std/conv";
import "std/errors";
import "std/mem";
import "std/strings";

// ---------------------------------------------------------------------------
// 1. Reading integers
// ---------------------------------------------------------------------------
//
// Reading takes a `string`. `parseInt` and `parseUint` take a base from 2 to 36,
// and `atoi` and `atou` are the base 10 forms.

func integers() {
	int plain = conv.atoi("1234")!!;  // 1234
	int hex = conv.parseInt("ff", 16)!!;  // 255
	int binary = conv.parseInt("-101", 2)!!;  // -5

	let _, notNumber = conv.atoi("12x");
	let _, tooBig = conv.atoi("99999999999999999999");
	bool invalid = notNumber == errors.Kind.Invalid;  // true
	bool overflow = tooBig == errors.Kind.Overflow;  // true
}

// ---------------------------------------------------------------------------
// 2. Reading floats
// ---------------------------------------------------------------------------
//
// `parseFloat` reads a decimal number with a point and an exponent, or `inf` and
// `nan`. The result is the float nearest to the text, so what a float prints as
// reads back as the same number.

func floats() {
	float tenth = conv.parseFloat("0.1")!!;  // 0.1
	float thousands = conv.parseFloat("-2.5e3")!!;  // -2500
	float tiny = conv.parseFloat("1e-7")!!;  // 1e-07
	float infinite = conv.parseFloat("inf")!!;  // inf

	let _, hexFloat = conv.parseFloat("0x10");
	let _, huge = conv.parseFloat("1e309");
	bool notAFloat = hexFloat == errors.Kind.Invalid;  // true
	bool tooLarge = huge == errors.Kind.Overflow;  // true
}

// ---------------------------------------------------------------------------
// 3. Writing into a string
// ---------------------------------------------------------------------------
//
// `format*` and the short forms `itoa`, `utoa` and `ftoa` return a new string made
// with the allocator you give, which you free with `mem.free`, or leave to an
// arena. They take the base where there is one. For everyday text, `fmt` is
// shorter: `{255:x}` is `formatInt(a, 255, 16, false)`.

func text() {
	mem.Arena arena;
	defer arena.release();

	string negative = conv.itoa(&arena, -42)!!;  // "-42"
	string hex = conv.formatInt(&arena, 255, 16, true)!!;  // "FF"
	string binary = conv.formatUint(&arena, 10, 2, false)!!;  // "1010"
	string fixed = conv.formatFixed(&arena, 3.14159, 2)!!;  // "3.14"
	string scientific = conv.formatExp(&arena, 1500.0, 1, false)!!;  // "1.5e+03"
}

// ---------------------------------------------------------------------------
// 4. Writing into a builder
// ---------------------------------------------------------------------------
//
// `write*` puts the text in anything that can be written to, and returns how many
// bytes it wrote. A `strings.Builder` is how a line is made piece by piece.

func builders() {
	strings.Builder line;
	defer line.release();

	conv.writeInt(&line, 7, 10, false)!!;
	conv.writeFloat(&line, 0.5)!!;
	conv.writeFixed(&line, 2.0, 3)!!;
	string built = line.text();  // "70.52.000"
}

public func demo() {
	integers();
	floats();
	text();
	builders();
}
