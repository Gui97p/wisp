#standalone
#allow unused_variables, dead_code
// Tour - Integer overflow: wrapping, saturating and truncating.
//
// An integer has a fixed size, and the result of an operation can be too big for
// it. `+`, `-` and `*` treat that as a bug: in the `debug` and `release`
// profiles the program stops with the place of the operation, and in `fast` the
// result simply wraps. When overflow is what you want, say so with the operator
// that matches:
//
//     wrap around    +%   -%   *%     hashes, checksums, counters
//     stop at limit  +|   -|   *|     volume, brightness, clamped counts
//
// Both exist with `=` too (`+%=`, `-|=`, ...), and only for integers. The
// comment at the end of a line shows the value that line gives.

import "std/math";

// ---------------------------------------------------------------------------
// 1. Wrapping around
// ---------------------------------------------------------------------------
//
// Unsigned numbers go from the top back to zero, and the other way around.
// Signed numbers go from the maximum to the minimum.

func wrapping() {
	uint8 volume = 250;
	uint8 wrapped = volume +% 10;  // 4

	uint8 low = 3;
	uint8 below = low -% 5;  // 254

	int8 top = 127;
	int8 over = top +% 1;  // -128
}

// A hash is the usual reason: FNV-1a keeps multiplying and wants the wrapped
// result, in the same 32 bits on every run.

func hashing() {
	uint32 hash = 2166136261;
	string word = "wisp";
	for _, c in word {
		hash ^= c;
		hash *%= 16777619;
	}
	uint32 result = hash;  // 39303838
}

// ---------------------------------------------------------------------------
// 2. Cutting a number down
// ---------------------------------------------------------------------------
//
// `truncate(type, value)` keeps the low bits, which is how a byte is taken out
// of a bigger number. A plain conversion such as `uint8(x)` is for values that
// fit, and stops the program the same way `+` does when they do not.

func truncating() {
	uint32 color = 0x336699;
	uint8 red = truncate(uint8, color >> 16);  // 51
	uint8 green = truncate(uint8, color >> 8);  // 102
	uint8 blue = truncate(uint8, color);  // 153

	uint8 cut = truncate(uint8, 300);  // 44
}

// ---------------------------------------------------------------------------
// 3. Stopping at the limit
// ---------------------------------------------------------------------------
//
// Saturating stops at the limits instead of coming back around. `saturate` does
// the same for a conversion, from an integer or a float.

func saturating() {
	uint8 loud = 250;
	uint8 capped = loud +| 10;  // 255
	uint8 quiet = 3;
	uint8 floor = quiet -| 10;  // 0

	int8 gain = 100;
	int8 up = gain *| 3;  // 127
	int8 down = gain *| -3;  // -128

	int wide = 1000;
	uint8 asByte = saturate(uint8, wide);  // 255
	int8 asInt8 = saturate(int8, wide);  // 127

	float level = -3.7;
	uint8 levelByte = saturate(uint8, level);  // 0
	int8 levelInt8 = saturate(int8, level);  // -3
}

// ---------------------------------------------------------------------------
// 4. Finding out
// ---------------------------------------------------------------------------
//
// When going past the limit is something to find out and not to hide, the
// `checked` functions of `std/math` give the result, or `null` when it does not
// fit. They are optionals, so `??` and `if x |v|` take them from there.

func checking() {
	?int fits = math.checkedAdd(math.MAX_INT - 1, 1);
	?int overflows = math.checkedAdd(math.MAX_INT, 1);
	bool fitsFits = fits != null;  // true
	bool overflowsFits = overflows != null;  // false

	int orMinusOne = math.checkedAdd(math.MAX_INT, 1) ?? -1;  // -1

	int result = 0;
	if math.checkedMul(1 << 40, 1 << 20) |product| {
		result = product;  // 1152921504606846976
	}

	int unchanged = 0;
	if math.checkedMul(1 << 40, 1 << 30) |product| {
		unchanged = product;
	} else {
		unchanged = -1;  // -1
	}
}

public func demo() {
	wrapping();
	hashing();
	truncating();
	saturating();
	checking();
}
