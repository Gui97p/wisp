#standalone
#allow unused_variables, dead_code
// Tour - Functions.
//
// A function is declared with `func`: its name, its parameters with the type
// first, and its result after the parameter list. The comment at the end of a
// line shows the value that line gives.
//
// Variadic parameters are in variadics.wsp, and function values are in
// lambdas.wsp.

import "std/fmt";

// ---------------------------------------------------------------------------
// 1. Parameters and results
// ---------------------------------------------------------------------------
//
// The type of a parameter comes first, and `a, b` share the type written before
// them. A function made of a single expression can use `=>` instead of a block.

func add(int a, b) int {
	return a + b;
}

func square(int x) int => x * x;

// A function can be declared after the code that calls it.
func later() int => 7;

func basics() {
	int sum = add(2, 3);  // 5
	int squared = square(7);  // 49
	int seven = later();  // 7
}

// ---------------------------------------------------------------------------
// 2. Several results
// ---------------------------------------------------------------------------
//
// A function can give back more than one value, and the caller names them all
// with `let`.

func minmax(int a, b) (int, int) {
	if a < b {
		return a, b;
	}
	return b, a;
}

func results() {
	let low, high = minmax(9, 4);  // 4, 9
}

// ---------------------------------------------------------------------------
// 3. Returning what another call gives
// ---------------------------------------------------------------------------
//
// `return call();` gives back whatever the call gives, however many values that
// is: two, one, or none.

func swapped(int a, b) (int, int) {
	return minmax(b, a);
}

// So a function that returns nothing can end with `return other();` when
// `other` returns nothing too, and it works after `=>` as well:
// `if quiet => return log("x");`.

func announce(string text) {
	fmt.println("{text}");
}

func announceTwice(string text) {
	announce(text);
	return announce(text);
}

func forwarding() {
	let first, second = swapped(1, 5);  // 1, 5

	// This line writes `twice` two times.
	announceTwice("twice");
}

public func demo() {
	basics();
	results();
	forwarding();
}
