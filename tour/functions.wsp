// Tour - Functions.

import "std/fmt";

// The parameter type comes first. `a, b` share the type written before them.
func add(int a, b) int {
  return a + b;
}

// A function made of a single expression can use `=>`.
func square(int x) int => x * x;

// Multiple return values.
func minmax(int a, b) (int, int) {
  if a < b {
    return a, b;
  }
  return b, a;
}

// `return call();` gives back whatever the call gives, however many values
// that is: two, one, or none. So a function that returns nothing can end with
// `return other();` when `other` returns nothing too, and the guard form works:
// `return log("x") if quiet;`.
func announce(string text) {
  fmt.printf("{}\n", text);
}

func announceTwice(string text) {
  announce(text);
  return announce(text);
}

func swapped(int a, b) (int, int) {
  return minmax(b, a);
}

// A function can be declared after the code that calls it.
func later() int => 7;

public func demo() {
  fmt.printf("add(2, 3) = {}\n", add(2, 3));
  fmt.printf("square(7) = {}\n", square(7));

  let low, high = minmax(9, 4);
  fmt.printf("minmax(9, 4) = {}, {}\n", low, high);
  let first, second = swapped(1, 5);
  fmt.printf("swapped(1, 5) = {}, {}\n", first, second);
  announceTwice("twice");

  fmt.printf("later() = {}\n", later());

  // Variadic parameters are in variadics.wsp, function values in lambdas.wsp.
}
