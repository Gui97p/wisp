// Tour - Functions.

import "std/fmt";

// The parameter type comes first. `a, b` share the type written before them.
func add(int a, b) int {
  return a + b;
}

// A function made of a single expression can use `=>`.
func square(int x) int => x * x;

// Multiple return values.
func minmax(int a, b) (int, int) {
  if a < b {
    return a, b;
  }
  return b, a;
}

// A function can be declared after the code that calls it.
func later() int => 7;

public func demo() {
  fmt.printf("add(2, 3) = {}\n", add(2, 3));
  fmt.printf("square(7) = {}\n", square(7));

  let low, high = minmax(9, 4);
  fmt.printf("minmax(9, 4) = {}, {}\n", low, high);

  fmt.printf("later() = {}\n", later());

  // Variadic parameters are in variadics.wsp. Function values exist in the
  // language, but the x86-64 backend does not generate them yet: see
  // _pending/lambdas.wsp.
}
