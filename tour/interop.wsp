// Tour - Native code.
//
// `native` embeds code written for one backend. The name after `native`
// picks the backend: `lua`, or a machine target such as `linux_x64`. Blocks
// for other backends are skipped, so one function can carry an
// implementation for each target. A function with no block for the target
// being built just runs its plain code, so a port you did not write does
// nothing.
//
// The bindings in parentheses say which Wisp variables the block reads
// (`in`), writes (`out`) or both (`inout`). A mode covers the names after it
// until the next one: `in a, b, out c`. They are checked like any other use
// of a variable: they must exist, and an `out` can't be a constant.
//
// In Lua the native code uses the variable names directly. For x86-64 the
// code refers to a binding with `{name}`, which becomes a sized memory
// operand, and `;` separates instructions. A string also has parts you can
// name: `{s.ptr}` and `{s.len}`. A struct field is `{p.x}`, and `{&name}` is
// the address of any variable, for `lea`. Globals work the same way as
// locals. Text in backticks is a raw block:
// it can span lines, and `;` starts a comment instead of separating.
//
// Calling functions written in C is a separate feature, `extern`; see the
// _c folder.

import "std/fmt";

public func abs(int x) int {
  int r;
  native lua(out r, in x) "r = x < 0 and -x or x";
  native linux_x64(in x, out r) "mov rax, {x}; mov rcx, rax; sar rcx, 63; xor rax, rcx; sub rax, rcx; mov {r}, rax";
  return r;
}

public func demo() {
  fmt.printf("abs(-5) = {}, abs(5) = {}\n", abs(-5), abs(5));
}
