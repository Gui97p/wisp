// Tour - Arrays, slices and strings.
//
// Maps are part of the language too, but the x86-64 backend does not
// generate them yet: see _pending/maps.wsp.

import "std/fmt";

// The size of an array is a number or a constant expression, so a constant
// can name it, even one that comes from another module.
const Cells = 3;

func total(int[] values) int {
  int sum;
  for _, v in values {
    sum += v;
  }
  return sum;
}

public func demo() {
  // A fixed-size array: the size is part of the type.
  int[5] nums = [124, 512, 1, 5, 2];

  int[Cells * 2] sized;
  fmt.printf("an array of Cells * 2 has {} elements\n", len(sized));

  // A partial literal fills the rest with zero values.
  int[5] partial = [7, 8];
  fmt.printf("a partial literal: {}, {}, {}\n", partial[0], partial[1], partial[2]);

  // Elements can be assigned, incremented and updated in place.
  nums[0] = 999;
  nums[1]++;
  nums[2] += 10;
  fmt.printf("nums now starts with {}, {}, {}\n", nums[0], nums[1], nums[2]);

  // `len` works on arrays, slices and strings.
  fmt.printf("len(nums) = {}\n", len(nums));

  // Slicing is [start:end]. The end is exclusive and both ends are optional.
  // A slice is a view: it shares the elements of the array.
  int[] middle = nums[1:3];
  int[] head = nums[:2];
  int[] tail = nums[3:];
  fmt.printf("nums[1:3] has {} elements and starts with {}\n", len(middle), middle[0]);
  fmt.printf("nums[:2] ends with {}, nums[3:] starts with {}\n", head[1], tail[0]);

  middle[0] = 1;
  fmt.printf("after middle[0] = 1, nums[1] is {}\n", nums[1]);

  // An array variable goes where a slice is expected without writing `[:]`.
  // It is the same view of the same elements: `total(nums)` is
  // `total(nums[:])`. Only something that has an address converts, so a
  // fresh array literal does not, and `[a:b]` is still how you take a part.
  fmt.printf("total(nums) = {}\n", total(nums));

  // Strings slice the same way, and compare in dictionary order.
  string greeting = "hello world";
  fmt.printf("greeting[:5] = {}, greeting[6:] = {}\n", greeting[:5], greeting[6:]);
  fmt.printf("len(greeting) = {}\n", len(greeting));
  fmt.printf("greeting[0] = {}\n", greeting[0]);
  fmt.printf("\"apple\" < \"apricot\": {}\n", "apple" < "apricot");
  fmt.printf("\"b\" > \"abc\": {}\n", "b" > "abc");

  // `in` asks whether a string holds another, or whether a collection holds
  // an element.
  fmt.printf("\"ell\" in greeting: {}\n", "ell" in greeting);
  fmt.printf("512 in nums: {}\n", 512 in nums);

  // `[]` is an empty slice, or an array of zeros. It has no element type of its
  // own: it takes the one of whatever receives it, a declaration, an argument,
  // a field or a `return`. It holds no memory, so `free` accepts it.
  int[] nothing = [];
  fmt.printf("len([]) = {}\n", len(nothing));

  // Indexing is checked: going outside an array, slice or string stops the
  // program with a panic that names the line.
}
