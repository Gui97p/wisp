#standalone
#allow unused_variables, dead_code
// Tour - Branching: `if`, `match`, `each` and blocks.
//
// A program takes different paths depending on its values. This page covers
// the four tools for that: `if`, `match`, `each`, and blocks that give a value.
// The comment at the end of a line shows the value that line gives.

// ---------------------------------------------------------------------------
// 1. `if`
// ---------------------------------------------------------------------------
//
// The condition needs no parentheses, and the braces are always there.

func ifs() {
	int limit = 12;
	string kind = "";
	if limit >= 10 {
		kind = "at least ten";  // "at least ten"
	} else {
		kind = "below ten";
	}
}

// ---------------------------------------------------------------------------
// 2. `if` with `=>`
// ---------------------------------------------------------------------------
//
// When the body is one statement, `=>` takes the place of the braces, and the
// `;` of the statement ends the `if`. A check that leaves the function takes
// one line this way. The same `=>` works after `for` and `loop`. Braces after
// `=>` are not needed, and the compiler says so.
//
// An `if` with `=>` has no `else` word. Its other side comes after a colon, and
// it is a statement too: `if c => a() : b();`. The first statement has no `;`
// of its own, the one at the end closes the whole line. The other side can be
// another `if` with `=>`, which makes a chain, and only the side that is chosen
// runs. The body of an `if c =>` cannot be another `if`: join the conditions
// with `&&`, or use braces.

func clamp(int n) int {
	if n < 0 => return 0;
	if n > 100 => return 100;
	return n;
}

func total(int n) int {
	int sum = 0;
	for i in 0..n => sum += i;
	return sum;
}

func kind(int n) string {
	string name = "";
	if n < 0 => name = "negative" : if n == 0 => name = "zero" : name = "positive";
	return name;
}

func arrows() {
	int low = clamp(-4);  // 0
	int middle = clamp(40);  // 40
	int high = clamp(400);  // 100
	int sum = total(5);  // 10 (0 + 1 + 2 + 3 + 4)
	string below = kind(-4);  // "negative"
	string none = kind(0);  // "zero"
	string above = kind(9);  // "positive"
}

// ---------------------------------------------------------------------------
// 3. `match` as a statement
// ---------------------------------------------------------------------------
//
// An arm is `value => statement;`, or a block `value => { ... }` when it takes
// several statements. There is no fallthrough: only the arm that matches runs.
// A range like `11..=20` includes both ends, and `_` catches the rest.

func bucket(int n) int {
	int result = 0;
	match n {
		10 => result = 1;
		11..=20 => {
			result = 2;
			result += 10;
		}
		_ => result = 3;
	}
	return result;
}

func statements() {
	int ten = bucket(10);  // 1
	int teens = bucket(15);  // 12
	int other = bucket(99);  // 3
}

// ---------------------------------------------------------------------------
// 4. `match` as an expression
// ---------------------------------------------------------------------------
//
// Arms use `=>` again, and what follows is a value that ends with `;`, not a
// statement. `_` is mandatory here, because the expression has to give a value
// whatever it is matched on. The same word is a statement at the start of a
// line, and an expression wherever a value is expected: after `=`, in a
// `return`, or as an argument.

func label(int n) string {
	return match n {
		10 => "ten";
		_ => "other";
	};
}

func expressions() {
	string a = label(10);  // "ten"
	string b = label(12);  // "other"

	int limit = 12;
	int doubled = 0;
	doubled = match limit {
		12 => 24;
		_ => 0;
	};  // 24

	// An arm can give several values, which `let a, b = match ...` receives, or
	// leave with `return`, `break` or `continue` instead of giving a value.
	let low, high = match limit {
		10 => 0, 10;
		11..=20 => 11, 20;
		_ => return;
	};  // 11, 20
}

// ---------------------------------------------------------------------------
// 5. `match` with no value
// ---------------------------------------------------------------------------
//
// Without a value after `match`, each arm holds a condition and the first
// one that is true wins. A comma between conditions means "or". It works as a
// statement and as an expression, and the expression still needs `_`.

func conditions() {
	int limit = 12;

	string size = match {
		limit < 10 => "small";
		limit < 100 => "medium";
		_ => "large";
	};  // "medium"

	string note = match {
		limit < 10 => "under ten";
		limit < 20, limit == 100 => "under twenty or exactly one hundred";
		_ => "twenty or more";
	};  // "under twenty or exactly one hundred"
}

// ---------------------------------------------------------------------------
// 6. `match` on an enum
// ---------------------------------------------------------------------------
//
// A `match` on an enum has to name every member, or end with `_`. A member
// added later makes every match that forgot it stop compiling, which is how you
// find the places to update. Writing `_` opts out of that check on purpose.

enum Light {
	Red,
	Yellow,
	Green
}

func advice(Light light) string {
	return match light {
		.Red => "stop";
		.Yellow, .Green => "go carefully";
	};
}

func enums() {
	string red = advice(.Red);  // "stop"
	string green = advice(.Green);  // "go carefully"
}

// ---------------------------------------------------------------------------
// 7. `each`: every arm that holds
// ---------------------------------------------------------------------------
//
// `each` replaces a row of `if`s that are not alternatives. Its arms hold
// conditions, like a `match` with no value, but every arm that is true runs, in
// the order written. A condition is read when its turn comes, so an arm can
// change what the next one sees. `_` runs only when no arm did, and `break`
// leaves the whole `each`. It is a statement only: it gives no value.

func notes(int n) int {
	int total = 0;
	each {
		n > 0 => total += 1;
		n % 2 == 0 => total += 10;
		n > 100 => {
			total += 100;
			break;
		}
		n > 1000 => total += 1000;
		_ => total = -1;
	}
	return total;
}

func everyArm() {
	int odd = notes(3);  // 1
	int even = notes(4);  // 11
	int huge = notes(200);  // 111 (the arm for 1000 is never read)
	int none = notes(-3);  // -1
}

// ---------------------------------------------------------------------------
// 8. Blocks
// ---------------------------------------------------------------------------
//
// A block is a statement of its own: it opens a scope, and a `defer` in it runs
// when it ends. With a value after `=`, it is an expression: it runs its
// statements and gives what `yield` says, so a value that needs a few steps
// does not need a helper function.

func blocks() {
	int limit = 12;
	{
		int limit = 1;  // 1 (a new variable, only inside the block)
	}
	int rounded = {
		int step = 5;
		yield limit / step * step;
	};  // 10
}

// A label before a block, `#name { ... }`, lets `yield #name;` leave it from
// anywhere inside, even from a loop in the middle, and the `defer`s of the
// blocks it crosses run on the way out. On a block that gives a value,
// `yield #name value;` leaves with that value, the way a plain `yield` does at
// the end.
//
// A label belongs to a loop or to a block: loops are left with `break` and
// `continue`, blocks with `yield`, so the two are never mixed up.

func labeledBlocks() {
	int limit = 12;

	int found = -1;
	#search {
		for i in 0..=limit {
			if i * i == 49 => yield #search;
			found = i;  // 0, 1, 2, 3, 4, 5, 6
		}
		found = -2;
	}
	int stoppedAt = found;  // 6 (it left before 7)

	int first = #pick {
		for i in 0..=limit {
			if i * i > 30 => yield #pick i;
		}
		yield -1;
	};  // 6
}

public func demo() {
	ifs();
	arrows();
	statements();
	expressions();
	conditions();
	enums();
	everyArm();
	blocks();
	labeledBlocks();
}
