#standalone
// Tour - Branching: `if` and `switch`.

import "std/fmt";

enum Light {
	Red,
	Yellow,
	Green
}

// A `switch` on an enum has to name every member, or end with a `default`. A
// member added later makes every switch that forgot it stop compiling, which
// is how you find the places to update. Writing `default` opts out of that
// check on purpose.
func advice(Light light) string {
	return switch light {
		case .Red => "stop";
		case .Yellow, .Green => "go, carefully";
	};
}

// A guard puts the condition after a jump, so a check that leaves the
// function takes one line: `return`, `break`, `continue` and `yield` accept
// `if` after them.
func clamp(int n) int {
	return 0 if n < 0;
	return 100 if n > 100;
	return n;
}

public func demo() {
	int limit = 12;

	// `if` needs no parentheses around the condition.
	if limit >= 10 {
		fmt.println("{} is at least ten", limit);
	} else {
		fmt.println("{} is below ten", limit);
	}

	// `switch` as a statement. A case is `value => statement;`, or a block
	// `value => { ... }` when it takes several statements. There is no
	// fallthrough, and a range like `11..=20` includes both ends.
	switch limit {
		case 10 => fmt.println("ten");
		case 11..=20 => {
			fmt.println("{} is between eleven and twenty", limit);
			fmt.println("so it is a block of two statements");
		}
		default => fmt.println("something else");
	}

	// `switch` as an expression. Cases also use `=>`, and what follows is a value
	// that ends with `;`, not a statement. `default` is mandatory, because the expression must always produce a
	// value. It can be written wherever an expression can.
	let label = switch limit {
		case 10 => "ten";
		default => "other";
	};
	fmt.println("the label of {} is {}", limit, label);

	int doubled;
	doubled = switch limit {
		case 12 => 24;
		default => 0;
	};
	fmt.println("doubled is {}", doubled);

	// A case can give several values, which `let a, b = switch ...` receives, or
	// leave with `return`, `break` or `continue` instead of giving a value.
	let low, high = switch limit {
		case 10 => 0, 10;
		case 11..=20 => 11, 20;
		default => return;
	};
	fmt.println("the range of {} is {}..{}", limit, low, high);

	// A `switch` with no value puts a condition in each case, and the first one
	// that is true wins. A comma between conditions means "or". It works as a
	// statement and as an expression, and the expression still needs `default`.
	switch {
		case limit < 10 => fmt.println("under ten");
		case limit < 20, limit == 100 => fmt.println("under twenty, or exactly one hundred");
		default => fmt.println("twenty or more");
	}

	string size = switch {
		case limit < 10 => "small";
		case limit < 100 => "medium";
		default => "large";
	};
	fmt.println("{} is {}", limit, size);

	fmt.println("advice: {} / {}", advice(.Red), advice(.Green));
	fmt.println("clamp: {} {} {}", clamp(-4), clamp(40), clamp(400));

	// A block is a statement of its own: it opens a scope, and a `defer` in it
	// runs when it ends. With a value after `=`, it is an expression: it runs its
	// statements and gives what `yield` says, so a value that needs a few steps
	// does not need a helper function.
	{
		int limit = 1;
		fmt.println("inside the block limit is {}", limit);
	}
	int rounded = {
		int step = 5;
		yield limit / step * step;
	};
	fmt.println("{} rounded down to a multiple of five is {}", limit, rounded);

	// A label before a block, `:name { ... }`, lets `yield :name;` leave it from
	// anywhere inside, even from a loop in the middle, and the `defer`s of the
	// blocks it crosses run on the way out. On a block that gives a value,
	// `yield :name value;` leaves with that value, the way a plain `yield` does
	// at the end. A label belongs to a loop or to a block: loops are left with
	// `break` and `continue`, blocks with `yield`, so the two are never mixed up.
	int found = -1;
	:search{
		for i in 0..=limit{
			yield :search if i * i == 49;
			found = i;
		}
		found = -2;
	}
	fmt.println("the search stopped after {}", found);

	int first = :pick{
		for i in 0..=limit{
			yield :pick i if i * i > 30;
		}
		yield -1;
	};
	fmt.println("the first square above thirty is the square of {}", first);
}
