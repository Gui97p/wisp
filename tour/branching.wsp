// Tour - Branching: `if` and `switch`.

import "expect";

export func demo() {
  int limit = 12;

  // `if` needs no parentheses around the condition.
  if limit >= 10 {
    expect.expect(true, "limit is at least ten");
  } else {
    expect.expect(false, "limit is below ten");
  }

  // `switch` as a statement. Cases end with `:`, there is no fallthrough,
  // and a range like `11..20` includes both ends.
  switch limit {
    case 10:
      expect.expect(false, "ten");
    case 11..20:
      expect.expect(true, "between eleven and twenty");
    default:
      expect.expect(false, "something else");
  }

  // `switch` as an expression. Cases use `=>` and `default` is mandatory,
  // because the expression must always produce a value. It is only valid as
  // the direct right-hand side of `let`, `const`, `return` or an assignment.
  let label = switch limit {
    case 10 => "ten",
    default => "other",
  };
  expect.expect(label == "other", "a switch expression yields a string");

  int doubled;
  doubled = switch limit {
    case 12 => 24,
    default => 0,
  };
  expect.expect(doubled == 24, "a switch expression yields an integer");
}
