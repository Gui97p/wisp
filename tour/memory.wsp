#standalone
#allow unused_variables, dead_code
// Tour - Allocators.
//
// `mem.heap` hands out one block at a time, and the blocks are freed one by one.
// When many blocks live and die together, an allocator type hands them out and
// takes them all back at once. None of them needs an `init`: the zero value of
// each is ready to use.
//
// Every block comes back aligned for its size, up to 16 bytes. `alloc` clears the
// block and `allocDirty` skips the clearing, for memory you are about to
// overwrite anyway. The comment at the end of a line shows the value that line
// gives.

import "std/errors";
import "std/mem";

struct Pair {
	int first, second;
}

// ---------------------------------------------------------------------------
// 1. A buffer of your own
// ---------------------------------------------------------------------------
//
// `mem.Fixed` hands out pieces of a buffer you give it. It never asks the heap
// for anything, so it works anywhere there is an array, and when the buffer is
// full it fails with errors.Kind.NoSpace instead of growing. `reset` forgets every
// block at once and starts over from the beginning.

func buffers() ! {
	[128]byte storage;
	mem.Fixed fixed = mem.fixed(storage);

	*int numbers = fixed.alloc(sizeof(int) * 4)!;
	numbers[0] = 11;
	numbers[3] = 44;
	int first = numbers[0];  // 11
	int second = numbers[1];  // 0
	int last = numbers[3];  // 44
	bool usedEnough = fixed.used() >= 32;  // true
	bool leftLess = fixed.remaining() <= 96;  // true

	let _, failure = fixed.alloc(1000);
	bool noSpace = failure == errors.Kind.NoSpace;  // true

	fixed.reset();
	int usedAgain = fixed.used();  // 0
	int leftAgain = fixed.remaining();  // 128
}

// ---------------------------------------------------------------------------
// 2. Slices and values, not bytes
// ---------------------------------------------------------------------------
//
// Asking for bytes and casting is the low level. `mem.make`, `mem.makeDirty` and
// `mem.create` do the arithmetic and give the type back, for any allocator: a
// type that implements `mem.Allocator`. They are always spelled with the
// allocator in the first place, because nothing in Wisp allocates behind your
// back. The heap is the one allocator with no state, and it is a value,
// `mem.heap`, that you pass where an allocator is asked for.
//
// `mem.make<Type>(allocator, count)` is a slice of `count` zeroed elements and
// `mem.create<Type>(allocator)` is one zeroed value, as a pointer. Both can fail
// like the allocator does, so they take the same `!`. `mem.makeDirty` is
// `mem.make` for memory you are about to overwrite: it does not clear the
// elements, so it is a little cheaper, and what it holds before you write is not
// defined.

func making() ! {
	[256]byte storage;
	mem.Fixed fixed = mem.fixed(storage);

	[]int slots = mem.make<int>(&fixed, 6)!;
	slots[5] = 50;
	int count = len(slots);  // 6
	int top = slots[5];  // 50
	int bottom = slots[0];  // 0

	*Pair pair = mem.create<Pair>(&fixed)!;
	pair.second = 8;
	int pairFirst = pair.first;  // 0
	int pairSecond = pair.second;  // 8

	[]byte dirty = mem.makeDirty<byte>(&fixed, 8)!;
	for i in 0..=7 {
		dirty[i] = byte(i * 3);
	}
	int written = dirty[3];  // 9
}

// ---------------------------------------------------------------------------
// 3. An arena
// ---------------------------------------------------------------------------
//
// `mem.Arena` grows by asking the heap for large chunks, so it has no limit other
// than memory itself. Blocks are never freed one by one: `release` returns all the
// chunks, which `defer` does at the end of the scope.
//
// `mark` remembers where the arena is, and `rewind` goes back to it, dropping
// everything allocated since. It is a scratch scope: the work inside uses memory
// freely and none of it outlives the block.
//
// `reset` drops every block but keeps one chunk for the next round, which suits a
// loop that builds something, uses it, and starts again.

func arenas() ! {
	mem.Arena arena;
	defer arena.release();

	*int first = arena.alloc(sizeof(int) * 100)!;
	first[99] = 7;
	int start = first[0];  // 0
	int end = first[99];  // 7

	mem.Mark scratch = arena.mark();
	*int temporary = arena.alloc(sizeof(int) * 1000)!;
	temporary[0] = 1;
	arena.rewind(scratch);

	*int again = arena.alloc(sizeof(int) * 1000)!;
	bool reused = again == temporary;  // true

	for round in 0..=2 {
		arena.reset();
		*int items = arena.alloc(sizeof(int) * 10)!;
		items[0] = round;
		int head = items[0];  // 0, 1, 2
		int tail = items[9];  // 0, 0, 0
	}
}

// ---------------------------------------------------------------------------
// 4. Allocators are values
// ---------------------------------------------------------------------------
//
// An allocator is a value, so it can be passed around: `&arena` and `&fixed` are
// allocators, and `mem.heap` is the global one. An arena can take its memory from
// another allocator instead of the heap, by setting `parent`, and `free` on an
// arena changes nothing: only `release` gives its chunks back.
//
// `mem.resize(allocator, slice, count)` grows or shrinks a slice. The old size
// comes from the slice itself, the new elements are zeroed, and an arena extends
// its last block in place instead of copying it.

func passing() ! {
	mem.Arena arena;
	defer arena.release();

	mem.Arena inner = mem.arena(&arena);
	[]byte text = mem.make<byte>(&inner, 40)!;
	int textLength = len(text);  // 40
	inner.release();

	[]int onHeap = mem.make<int>(mem.heap, 3)!;
	onHeap[0] = 1;
	onHeap[2] = 3;
	onHeap = mem.resize(mem.heap, onHeap, 6)!;
	int grown = len(onHeap);  // 6
	int kept = onHeap[2];  // 3
	int added = onHeap[5];  // 0
	mem.free(mem.heap, onHeap);
}

// ---------------------------------------------------------------------------
// 5. Allocators that wrap another one
// ---------------------------------------------------------------------------
//
// `Counting` keeps the numbers, `Failing` refuses after `after` calls (to test the
// error paths), and `Debug` checks what the program does with its blocks: double
// frees, writes past the end or into a freed block, and leaks, which `report`
// prints with the line that allocated them. `Pool` serves blocks of a single size.

func wrapping() ! {
	mem.Counting counting;
	mem.Debug debug = mem.Debug{parent: &counting};
	[]int tracked = mem.make<int>(&debug, 5)!;
	int liveBlocks = counting.blocks();  // 1
	mem.free(&debug, tracked);
	int leaks = debug.report();  // 0
	debug.release();

	mem.Failing failing = mem.failingAfter(mem.heap, 1);
	[]int head = mem.make<int>(&failing, 2)!;
	let _, problem = mem.make<int>(&failing, 2);
	bool refused = problem == errors.Kind.OutOfMemory;  // true
	mem.free(&failing, head);

	mem.Pool pool = mem.Pool{size: 32};
	*int slot = pool.alloc(8)!;
	pool.free(slot);
	bool sameBlock = pool.alloc(8)! == slot;  // true
	pool.release();
}

public func demo() ! {
	buffers()!;
	making()!;
	arenas()!;
	passing()!;
	wrapping()!;
}
