// Tour - Allocators.
//
// `mem.alloc` and `mem.free` talk to the heap one block at a time. When many
// blocks live and die together, an allocator type hands them out and takes
// them all back at once. There are two, and neither needs an `init`: the
// zero value of each is ready to use.
//
// Every block comes back aligned to 16 bytes. `alloc` clears the block and
// `allocDirty` skips the clearing, for memory you are about to overwrite
// anyway.

import "std/errors";
import "std/fmt";
import "std/mem";

public func demo() ! {
  // `mem.Fixed` hands out pieces of a buffer you give it. It never asks the
  // heap for anything, so it works anywhere there is an array, and when the
  // buffer is full it fails with errors.Kind.NoSpace instead of growing.
  [128]char storage;
  mem.Fixed fixed = mem.Fixed{buffer: storage};
  *int numbers = fixed.alloc(sizeof(int) * 4)!;
  numbers[0] = 11;
  numbers[3] = 44;
  fmt.printf("numbers: {}, {}, {}\n", numbers[0], numbers[1], numbers[3]);
  fmt.printf("used {} bytes, {} left\n", fixed.used(), fixed.remaining());

  let more, failure = fixed.alloc(1000);
  fmt.printf("a block that does not fit: {}, no space: {}\n", more == null, failure == errors.Kind.NoSpace);

  // `reset` forgets every block at once and starts over from the beginning.
  fixed.reset();
  fmt.printf("after reset: used {}, {} left\n", fixed.used(), fixed.remaining());

  // `mem.Arena` grows by asking the heap for large chunks, so it has no limit
  // other than memory itself. Blocks are never freed one by one: `free`
  // returns all the chunks, which `defer` does at the end of the scope.
  mem.Arena arena;
  defer arena.free();

  *int first = arena.alloc(sizeof(int) * 100)!;
  first[99] = 7;
  fmt.printf("first[0] = {}, first[99] = {}\n", first[0], first[99]);

  // `mark` remembers where the arena is, and `rewind` goes back to it,
  // dropping everything allocated since. It is a scratch scope: the work
  // inside uses memory freely and none of it outlives the block.
  mem.Mark scratch = arena.mark();
  *int temporary = arena.alloc(sizeof(int) * 1000)!;
  temporary[0] = 1;
  arena.rewind(scratch);

  *int again = arena.alloc(sizeof(int) * 1000)!;
  fmt.printf("the same space is reused after rewind: {}\n", again == temporary);

  // `reset` drops every block but keeps one chunk for the next round, which
  // suits a loop that builds something, uses it, and starts again.
  for round in 0..2 {
    arena.reset();
    *int items = arena.alloc(sizeof(int) * 10)!;
    items[0] = round;
    fmt.printf("round {}: items[0] = {}, items[9] = {}\n", round, items[0], items[9]);
  }
}
