#standalone
// Tour - Allocators.
//
// `mem.heap` hands out one block at a time, and the blocks are freed one by
// one. When many blocks live and die together, an allocator type hands them
// out and takes them all back at once. None of them needs an `init`: the zero
// value of each is ready to use.
//
// Every block comes back aligned to 16 bytes. `alloc` clears the block and
// `allocDirty` skips the clearing, for memory you are about to overwrite
// anyway.
//
// Asking for bytes and casting is the low level. `mem.make`, `mem.makeDirty`
// and `mem.create` do the arithmetic and give the type back, for any
// allocator: a type that implements `mem.Allocator`. They are always spelled
// with the allocator in the first place, because nothing in Wisp allocates
// behind your back. The heap is the one allocator with no state, and it is a
// value, `mem.heap`, that you pass where an allocator is asked for.

import "std/errors";
import "std/fmt";
import "std/mem";

struct Pair {
	int first, second;
}

public func demo() ! {
	// `mem.Fixed` hands out pieces of a buffer you give it. It never asks the
	// heap for anything, so it works anywhere there is an array, and when the
	// buffer is full it fails with errors.Kind.NoSpace instead of growing.
	[128]byte storage;
	mem.Fixed fixed = mem.Fixed{buffer: storage};
	*int numbers = fixed.alloc(sizeof(int) * 4)!;
	numbers[0] = 11;
	numbers[3] = 44;
	fmt.printf("numbers: {}, {}, {}\n", numbers[0], numbers[1], numbers[3]);
	fmt.printf("used {} bytes, {} left\n", fixed.used(), fixed.remaining());

	// `mem.make<Type>(allocator, count)` is a slice of `count` zeroed elements
	// and `mem.create<Type>(allocator)` is one zeroed value, as a pointer. Both
	// can fail like the allocator does, so they take the same `!`.
	fixed.reset();
	[]int slots = mem.make<int>(&fixed, 6)!;
	slots[5] = 50;
	*Pair pair = mem.create<Pair>(&fixed)!;
	pair.second = 8;
	fmt.printf("a slice of {} ints, slots[5] = {}, slots[0] = {}\n", len(slots), slots[5], slots[0]);

	// `mem.makeDirty` is `mem.make` for memory you are about to overwrite: it does not
	// clear the elements, so it is a little cheaper, and what it holds before
	// you write is not defined.
	[]byte dirty = mem.makeDirty<byte>(&fixed, 8)!;
	for i in 0..=7 {
		dirty[i] = byte(i * 3);
	}
	fmt.printf("a dirty slice that was written: {}, {}, {}\n", dirty[0], dirty[3], dirty[7]);
	fmt.printf("a pair: {} and {}\n", pair.first, pair.second);
	fixed.reset();

	let _, failure = fixed.alloc(1000);
	fmt.printf("a block that does not fit: no space {}\n", failure == errors.Kind.NoSpace);

	// `reset` forgets every block at once and starts over from the beginning.
	fixed.reset();
	fmt.printf("after reset: used {}, {} left\n", fixed.used(), fixed.remaining());

	// `mem.Arena` grows by asking the heap for large chunks, so it has no limit
	// other than memory itself. Blocks are never freed one by one: `release`
	// returns all the chunks, which `defer` does at the end of the scope.
	mem.Arena arena;
	defer arena.release();

	*int first = arena.alloc(sizeof(int) * 100)!;
	first[99] = 7;
	fmt.printf("first[0] = {}, first[99] = {}\n", first[0], first[99]);

	// `mark` remembers where the arena is, and `rewind` goes back to it,
	// dropping everything allocated since. It is a scratch scope: the work
	// inside uses memory freely and none of it outlives the block.
	mem.Mark scratch = arena.mark();
	*int temporary = arena.alloc(sizeof(int) * 1000)!;
	temporary[0] = 1;
	arena.rewind(scratch);

	*int again = arena.alloc(sizeof(int) * 1000)!;
	fmt.printf("the same space is reused after rewind: {}\n", again == temporary);

	// `reset` drops every block but keeps one chunk for the next round, which
	// suits a loop that builds something, uses it, and starts again.
	for round in 0..=2 {
		arena.reset();
		*int items = arena.alloc(sizeof(int) * 10)!;
		items[0] = round;
		fmt.printf("round {}: items[0] = {}, items[9] = {}\n", round, items[0], items[9]);
	}

	// An allocator is a value, so it can be passed around: `&arena` and
	// `&fixed` are allocators, and `mem.heap` is the global one. An arena can
	// take its memory from another allocator instead of the heap, by setting
	// `parent`, and `free` on an arena changes nothing: only `release` gives
	// its chunks back.
	[]int onHeap = mem.make<int>(mem.heap, 3)!;
	onHeap[0] = 1;
	onHeap[2] = 3;
	mem.Arena inner = mem.Arena{parent: &arena};
	[]byte text = mem.make<byte>(&inner, 40)!;
	fmt.printf("a block of {} bytes from an arena that lives inside another one\n", len(text));

	// `mem.resize(allocator, slice, count)` grows or shrinks a slice. The old size
	// comes from the slice itself, the new elements are zeroed, and an arena
	// extends its last block in place instead of copying it.
	onHeap = mem.resize(mem.heap, onHeap, 6)!;
	fmt.printf("grown to {}: {}, {}, {}, {}\n", len(onHeap), onHeap[0], onHeap[2], onHeap[3], onHeap[5]);
	mem.free(mem.heap, onHeap);
	inner.release();

	// Allocators that wrap another one. `Counting` keeps the numbers, `Failing`
	// refuses after `after` calls (to test the error paths), and `Debug` checks
	// what the program does with its blocks: double frees, writes past the end
	// or into a freed block, and leaks, which `report` prints with the line that
	// allocated them. `Pool` serves blocks of a single size.
	mem.Counting counting;
	mem.Debug debug = mem.Debug{parent: &counting};
	[]int tracked = mem.make<int>(&debug, 5)!;
	fmt.printf("live: {} blocks, {} bytes\n", counting.blocks(), counting.bytes());
	mem.free(&debug, tracked);
	fmt.printf("leaks: {}\n", debug.report());
	debug.release();

	mem.Failing failing = mem.Failing{after: 1};
	[]int head = mem.make<int>(&failing, 2)!;
	let _, problem = mem.make<int>(&failing, 2);
	fmt.printf("the second allocation fails: {}\n", problem == errors.Kind.OutOfMemory);
	mem.free(&failing, head);

	mem.Pool pool = mem.Pool{size: 32};
	*int slot = pool.alloc(8)!;
	pool.free(slot);
	fmt.printf("the pool hands the same block back: {}\n", pool.alloc(8)! == slot);
	pool.release();
}
