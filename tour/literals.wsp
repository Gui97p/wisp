#standalone
#allow unused_variables, dead_code
// Tour - Literals: `T{...}`, `.{...}` and `[_]`.
//
// A literal builds a value, and a brace always means construction. Brackets stay
// for types, indexing and slicing, and a block never starts with a dot, so a
// literal is never mistaken for one. The comment at the end of a line shows the
// value that line gives.

// ---------------------------------------------------------------------------
// 1. Two ways to write a literal
// ---------------------------------------------------------------------------
//
//   Point{x: 1, y: 2}     names the type, so it works anywhere
//   .{x: 1, y: 2}         takes the type from what receives it
//
// What receives it is a declaration with a type, an assignment, an argument, a
// `return`, a field of another literal or an element of an array. Where nothing
// receives it, as in `let p = .{x: 1}`, the compiler asks you to name the type.

struct Point {
	int x;
	int y;
}

struct Segment {
	Point from;
	Point to;
}

func norm(Point p) int {
	return p.x * p.x + p.y * p.y;
}

func middle() Point {
	return .{x: 5, y: 5};
}

func structs() {
	Point a = .{x: 3, y: 4};
	Point b = Point{x: 6, y: 8};
	int aNorm = norm(a);  // 25
	int bNorm = norm(b);  // 100

	// The same goes for an argument and a `return`, and literals nest.
	int argument = norm(.{x: 1, y: 2});  // 5
	int result = norm(middle());  // 50

	Segment line = .{from: .{x: 0, y: 0}, to: .{x: 2, y: 3}};
	int endX = line.to.x;  // 2
	int endY = line.to.y;  // 3
}

// ---------------------------------------------------------------------------
// 2. Empty and partial literals
// ---------------------------------------------------------------------------
//
// An empty literal is the zero value of the type that receives it. A field left
// out of a struct literal is zero too, when zero makes sense for it. Values are
// positional for arrays and `name: value` for structs, and fewer values than the
// array holds leave the rest at zero.

func zeros() {
	Point origin = .{};
	int originX = origin.x;  // 0

	[4]int none = .{};
	int noneLength = len(none);  // 4

	[5]int some = .{7, 8};
	int first = some[0];  // 7
	int second = some[1];  // 8
	int third = some[2];  // 0
}

// ---------------------------------------------------------------------------
// 3. Letting the compiler count
// ---------------------------------------------------------------------------
//
// An array literal names its type like any other: `[3]int{1, 2, 3}`. The size
// can be `_` when the values can be counted: `[_]int{1, 2, 3}`. It works on the
// literal, on the declaration and on any array value, since all it needs is
// something to count.

func counting() {
	let letters = [_]byte{'a', 'b', 'c'};
	[_]int primes = .{2, 3, 5, 7};
	[_]int copy = primes;

	int letterCount = len(letters);  // 3
	int primeCount = len(primes);  // 4
	int copyCount = len(copy);  // 4
}

// ---------------------------------------------------------------------------
// 4. Arrays where a slice is expected
// ---------------------------------------------------------------------------
//
// An array literal goes where a slice is expected, as a temporary array on the
// stack. It lives as long as the function, like a local array would.

func sum([]int values) int {
	int total = 0;
	for _, v in values {
		total += v;
	}
	return total;
}

func slices() {
	int total = sum(.{1, 2, 3});  // 6
}

// ---------------------------------------------------------------------------
// 5. Arrays of arrays and of structs
// ---------------------------------------------------------------------------
//
// They name the type once, outside, and `in` takes any array, so a literal that
// names its type works there too. A literal can also build an optional, a field
// or a constant.

func nested() {
	[2][2]int grid = .{ .{1, 2}, .{3, 4}};
	[2]Point corners = .{ .{x: 1, y: 1}, .{x: 9, y: 9}};
	int cell = grid[1][0];  // 3
	int corner = corners[1].x;  // 9

	bool inList = 5 in [_]int{1, 5, 9};  // true

	?Point maybe = .{x: 1, y: 1};
	int held = 0;
	if maybe |p| {
		held = p.x;  // 1
	}
}

public func demo() {
	structs();
	zeros();
	counting();
	slices();
	nested();
}
