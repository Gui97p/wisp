#standalone
#allow unused_variables, dead_code
// Tour - Files, paths and the environment.
//
// `std/os` is the way into the system and `std/paths` is for the names of files.
// Both work the same on every system, and what differs is hidden inside: a path
// on Windows may start with a drive (`C:\`) and use either slash, but the
// functions below do the same thing there.
//
// Failures are errors, as everywhere else: a function that can fail is marked
// with `!`, and `errors.Kind` says what went wrong. The comment at the end of a
// line shows the value that line gives.

import "std/errors";
import "std/io";
import "std/mem";
import "std/os";
import "std/paths";

// ---------------------------------------------------------------------------
// 1. Arguments and the environment
// ---------------------------------------------------------------------------
//
// `os.args()` is the list of arguments, the program's own name first. `env`
// looks one variable up, `environ` walks all of them. The strings point into
// memory the system owns, and are valid until the next call.

func environment() {
	int arguments = len(os.args());  // at least 1

	?string search = os.env("PATH");
	bool isSet = search != null;  // true
	bool notEmpty = len(search ?? "") > 0;  // true

	os.Environ env = os.environ();
	int variables = 0;
	loop env.next() |_variable| {
		variables++;
	}
	env.close();
	bool hasVariables = variables > 0;  // true
}

// ---------------------------------------------------------------------------
// 2. Taking a path apart
// ---------------------------------------------------------------------------
//
// Anything that only looks at a path (`base`, `dir`, `ext`, `stem`) returns a
// piece of the path itself, so it never allocates.

func taking() {
	string file = "/tmp/wisp_tour_files/notes.tar.gz";

	string base = paths.base(file);  // "notes.tar.gz"
	string dir = paths.dir(file);  // "/tmp/wisp_tour_files"
	string ext = paths.ext(file);  // ".gz"
	string stem = paths.stem(file);  // "notes.tar"
}

// ---------------------------------------------------------------------------
// 3. Putting a path together
// ---------------------------------------------------------------------------
//
// Anything that builds new text asks you for the memory: `paths.join` and
// `paths.clean` take an allocator and give back a new string, which an arena frees
// all at once. `clean` also resolves `.` and `..`.

func joining() ! {
	mem.Arena arena;
	defer arena.release();

	string root = paths.join(&arena, "/tmp", "wisp_tour_files")!;  // "/tmp/wisp_tour_files"
	string messy = paths.clean(&arena, "/tmp/./wisp_tour_files/../wisp_tour_files/")!;
	bool same = root == messy;  // true
}

// ---------------------------------------------------------------------------
// 4. Folders and files
// ---------------------------------------------------------------------------
//
// `create` opens a file for writing, and `defer` closes it when the function ends.
// `readFile` allocates the content with the allocator you give, so the memory is
// yours to free. Renaming, and asking a folder what is in it: the order of the
// entries depends on the system, so this only counts them. A missing file is an
// error value you can compare, not a crash.

func writeNotes(string file) ! {
	os.File out = os.create(file)!;
	defer out.close() ?? {};
	io.writeString(&out, "one line\n")!;
	io.writeString(&out, "and another\n")!;
}

func files() ! {
	mem.Arena arena;
	defer arena.release();

	string root = paths.join(&arena, "/tmp", "wisp_tour_files")!;
	os.createDir(root)!;

	string first = paths.join(&arena, root, "first.txt")!;
	writeNotes(first)!;

	let info = os.stat(first)!;
	int size = info.size;  // 21
	bool isFile = info.kind == .File;  // true

	[]byte content = os.readFile(mem.heap, first)!;
	defer mem.free(mem.heap, content);
	int length = len(content);  // 21
	string start = string(content[..8]);  // "one line"

	string second = paths.join(&arena, root, "second.txt")!;
	os.rename(first, second)!;
	bool firstExists = os.exists(first);  // false
	bool secondExists = os.exists(second);  // true

	os.Dir folder = os.openDir(root)!;
	int entries = 0;
	for _ in folder! {
		entries++;  // 1
	}
	folder.close()!;

	let _data, failure = os.readFile(mem.heap, "/tmp/wisp_tour_files/missing.txt");
	bool notFound = failure == errors.Kind.NotFound;  // true

	os.remove(second)!;
	os.removeDir(root)!;
}

public func demo() ! {
	environment();
	taking();
	joining()!;
	files()!;
}
