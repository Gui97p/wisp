#standalone
// Tour - Files, paths and the environment.
//
// `std/os` is the way into the system and `std/path` is for the names of
// files. Both work the same on every system, and what differs is hidden
// inside: a path on Windows may start with a drive (`C:\`) and use either
// slash, but the functions below do the same thing there.
//
// Anything that builds new text asks you for the memory: `paths.join` and
// `paths.clean` write into a buffer you pass and give back a slice of it. The
// buffer is yours, so it can live on the stack and nothing is allocated.
// Anything that only looks at a path (`base`, `dir`, `ext`, `stem`) returns a
// piece of the path itself.
//
// Failures are errors, as everywhere else: a function that can fail is marked
// with `!`, and `errors.Kind` says what went wrong.

import "std/errors";
import "std/fmt";
import "std/io";
import "std/mem";
import "std/os";
import "std/paths";

func writeNotes(string file) ! {
	os.File out = os.create(file)!;
	defer out.close() ?? {};
	io.writeString(&out, "one line\n")!;
	io.writeString(&out, "and another\n")!;
}

public func demo() ! {
	// `os.args()` is the list of arguments, the program's own name first.
	fmt.println("started with {} argument(s)", len(os.args()));

	// `env` looks one variable up, `environ` walks all of them. The strings
	// point into memory the system owns, and are valid until the next call.
	?string search = os.env("PATH");
	fmt.println("PATH is set: {}, and not empty: {}", search != null, len(search ?? "") > 0);

	os.Environ env = os.environ();
	int variables;
	loop env.next() |_variable| {
		variables++;
	}
	env.close();
	fmt.println("the environment has variables: {}", variables > 0);

	// Taking a path apart never allocates.
	string file = "/tmp/wisp_tour_files/notes.tar.gz";
	fmt.println("base {}, dir {}, ext {}, stem {}", paths.base(file), paths.dir(file), paths.ext(file), paths.stem(file));

	// Putting one together takes memory from the allocator you give it, here an
	// arena that is released when the function ends. `clean` also resolves `.`
	// and `..`.
	mem.Arena arena;
	defer arena.release();
	string root = paths.join(&arena, "/tmp", "wisp_tour_files")!;
	string messy = paths.clean(&arena, "/tmp/./wisp_tour_files/../wisp_tour_files/")!;
	fmt.println("the same folder from two spellings: {}", root == messy);

	// Folders and files. `mkdirAll` creates every missing level, `create`
	// opens a file for writing, and `defer` closes it when the function ends.
	os.createDir(root)!;

	string first = paths.join(&arena, root, "first.txt")!;
	writeNotes(first)!;

	let info = os.stat(first)!;
	fmt.println("first.txt is {} bytes, a file: {}", info.size, info.kind == .File);

	// `readFile` allocates the content, so the memory is yours to free.
	[]byte content = os.readFile(first)!;
	defer mem.free(mem.heap, content);
	fmt.println("it reads back {} bytes, starting with \"{}\"", len(content), string(content[..8]));

	// Renaming, and asking a folder what is in it. The order of the entries
	// depends on the system, so this only counts them.
	string second = paths.join(&arena, root, "second.txt")!;
	os.rename(first, second)!;
	fmt.println("after the rename: first {}, second {}", os.exists(first), os.exists(second));

	os.Dir folder = os.openDir(root)!;
	int entries;
	for _ in folder! {
		entries++;
	}
	folder.close()!;
	fmt.println("the folder has {} entry", entries);

	// A missing file is an error value you can compare, not a crash.
	let _data, failure = os.readFile("/tmp/wisp_tour_files/missing.txt");
	fmt.println("a missing file: not found {}", failure == errors.Kind.NotFound);

	os.remove(second)!;
	os.removeDir(root)!;
}
