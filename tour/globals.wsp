#standalone
#allow unused_variables
// Tour - Global variables.
//
// A declaration outside any function is a global: one variable for the whole
// program, alive from the start. Its initializer must be a constant expression
// (literals, constants, enum members, and arrays or structs made of those), so
// nothing has to run before `main` and the order of declarations does not matter.
// Without an initializer it starts zeroed. The comment at the end of a line shows
// the value that line gives.

struct Settings {
	int retries;
	bool verbose;
}

int counter = 0;
string name = "wisp";
[3]int table = .{1, 2, 3};
Settings settings = Settings{retries: 3, verbose: true};
int untouched;

// `public` makes a global visible to other modules, which can read it and write
// it.
public int total = 100;

// A global that only some targets or profiles have takes a selector, like any
// other declaration. `let` infers the type from its value, and `var` names the
// type, so it can start zeroed: `let<debug> level = 3;` and
// `var<debug> [64]int history;`. A pointer starts as a converted null,
// `(*Settings)(null)`, or just zeroed with `var`.

func bump() int {
	counter++;
	return counter;
}

func globals() {
	int zero = untouched;  // 0
	int first = bump();  // 1
	int second = bump();  // 2

	table[1] = counter;
	int stored = table[1];  // 2

	settings.retries += 1;
	int retries = settings.retries;  // 4

	name = "other";
	string renamed = name;  // "other"

	total = total + 1;  // 101
}

// A global that nothing uses gets a warning, unless its name starts with an
// underscore. That goes for any unused variable or constant. Public globals are
// never reported, since other modules may use them.

public func demo() {
	globals();
}
