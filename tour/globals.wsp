// Tour - Global variables.
//
// A declaration outside any function is a global: one variable for the whole
// program, alive from the start. Its initializer must be a constant
// expression (literals, constants, enum members, and arrays or structs made
// of those), so nothing has to run before `main` and the order of
// declarations does not matter. Without an initializer it starts zeroed.

import "std/fmt";

struct Settings {
  int retries;
  bool verbose;
}

int counter = 0;
string name = "wisp";
int[3] table = [1, 2, 3];
Settings settings = Settings{retries: 3, verbose: true};
int untouched;

// `public` makes a global visible to other modules, which can read it and
// write it.
public int total = 100;

func bump() int {
  counter++;
  return counter;
}

public func demo() {
  fmt.printf("untouched starts at {}\n", untouched);
  fmt.printf("bump() = {}\n", bump());
  fmt.printf("bump() = {}\n", bump());

  table[1] = counter;
  settings.retries += 1;
  name = "other";
  fmt.printf("table[1] = {}, retries = {}, name = {}\n", table[1], settings.retries, name);

  total = total + 1;
  fmt.printf("the public total is now {}\n", total);

  // A global that nothing uses gets a warning, unless its name starts with an
  // underscore. That goes for any unused variable or constant. Public
  // globals are never reported, since other modules may use them.
}
