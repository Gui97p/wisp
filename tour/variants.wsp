// Tour - Enums with data.
//
// An enum member can carry data of its own. The members are the variants of
// one type, and each variant lists its fields the way a struct does:
//
//     enum Shape {
//       Circle { float radius; },
//       Rect { float w, h; },
//       Empty
//     }
//
// A variant with no braces carries nothing. The value holds one variant at a
// time, in the space of the largest one, so a `Shape` is as big as the
// biggest variant plus a tag. An enum with no data at all is the plain enum of
// the types page, numbers and all: numbering is only for those.
//
// Make a value like a struct literal, with the variant after the type, or
// with just a dot where the type is known from the context:
// `Shape.Circle{radius: 2}`, `.Rect{w: 3, h: 4}`, `Shape.Empty`, `.Empty`.
// Leaving a field out gives it its zero value, as in a struct.
//
// A value of the enum is never compared with another one, because that would
// have to compare data. Asking which variant it is does work: `shape ==
// .Circle` ignores the data. To see the data, use a `switch`.

import "std/fmt";

enum Shape {
  Circle { float radius; },
  Rect { float w, h; },
  Empty
}

// Each case names the data of its variant, and inside it the name has the
// fields of that variant only. The switch has to cover every variant, or end
// with a `default`, the same rule as for any enum: add a variant later and
// every switch that forgot it stops compiling.
//
// The name is a copy when the switch is on a value, and a pointer to the data
// inside when it is on a pointer. The demo below shows both.
func area(Shape shape) float {
  return switch shape {
    case .Circle c => 3.14 * c.radius * c.radius;
    case .Rect r => r.w * r.h;
    case .Empty => 0;
	default => -1;
  };
}

// Methods work as on a struct. A `switch` can also be an expression, one value
// per case, and with every variant covered it needs no `default`.
func (*Shape shape) grow(float factor) {
  switch shape {
    case .Circle c => c.radius *= factor;
    case .Rect r => {
      r.w *= factor;
      r.h *= factor;
    }
    case .Empty => {}
  }
}

func (Shape shape) label() string {
  return switch shape {
    case .Circle => "circle";
    case .Rect => "rectangle";
    case .Empty => "nothing";
  };
}

public func demo() {
  Shape circle = Shape.Circle{radius: 2};
  Shape rect = .Rect{w: 3, h: 4};
  Shape none = .Empty;
  fmt.printf("areas: {} {} {}\n", area(circle), area(rect), area(none));
  fmt.printf("labels: {} {} {}\n", circle.label(), rect.label(), none.label());

  // `name()` gives the variant's name, as for every enum.
  fmt.printf("the variant of rect is {}\n", rect.name());

  // The variant test, and the data changed through a pointer receiver.
  fmt.printf("circle is a circle: {}, rect is a circle: {}\n", circle == .Circle, rect == .Circle);
  rect.grow(2);
  fmt.printf("the grown rectangle has area {}\n", area(rect));

  // A field left out of the literal is zero, and so is a value never written:
  // the first variant with its data at zero.
  Shape partial = .Rect{w: 5};
  Shape first;
  fmt.printf("a rectangle with no height has area {}\n", area(partial));
  fmt.printf("the zero value is a {}\n", first.label());

  // Switching on a value gives the case a copy: this changes nothing.
  Shape box = .Rect{w: 2, h: 5};
  switch box {
    case .Rect r => r.w = 100;
    default => {}
  }
  fmt.printf("after changing a copy the area is still {}\n", area(box));

  // Switching on a pointer gives the case a pointer to the data inside: this
  // changes the box itself.
  switch &box {
    case .Rect r => r.w = 100;
    default => {}
  }
  fmt.printf("after changing through a pointer the area is {}\n", area(box));
}
