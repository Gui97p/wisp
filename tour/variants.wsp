#standalone
#allow unused_variables, dead_code
// Tour - Enums with data.
//
// An enum member can carry data of its own. The members are the variants of one
// type, and each variant lists its fields the way a struct does. A variant with
// no braces carries nothing. The comment at the end of a line shows the value
// that line gives.

// ---------------------------------------------------------------------------
// 1. Declaring and making variants
// ---------------------------------------------------------------------------
//
// The value holds one variant at a time, in the space of the largest one, so a
// `Shape` is as big as the biggest variant plus a tag. An enum with no data at
// all is the plain enum of the types page, numbers and all: numbering is only
// for those.
//
// Make a value like a struct literal, with the variant after the type, or with
// just a dot where the type is known from the context: `Shape.Circle{radius: 2}`,
// `.Rect{w: 3, h: 4}`, `Shape.Empty`, `.Empty`. Leaving a field out gives it its
// zero value, as in a struct.

enum Shape {
	Circle{float radius;},
	Rect{float w, h;},
	Empty
}

// ---------------------------------------------------------------------------
// 2. Looking at the data
// ---------------------------------------------------------------------------
//
// Each case of a `switch` names the data of its variant, and inside it the name
// has the fields of that variant only. The switch has to cover every variant, or
// end with a `default`, the same rule as for any enum: add a variant later and
// every switch that forgot it stops compiling. A `switch` can also be an
// expression, one value per case, and with every variant covered it needs no
// `default`.

func area(Shape shape) float {
	return switch shape {
		case .Circle c => 3.14 * c.radius * c.radius;
		case .Rect r => r.w * r.h;
		case .Empty => 0;
		default => -1;
	};
}

func (Shape shape) label() string {
	return switch shape {
		case .Circle => "circle";
		case .Rect => "rectangle";
		case .Empty => "nothing";
	};
}

func looking() {
	Shape circle = Shape.Circle{radius: 2};
	Shape rect = .Rect{w: 3, h: 4};
	Shape none = .Empty;

	float circleArea = area(circle);  // 12.56
	float rectArea = area(rect);  // 12
	float noneArea = area(none);  // 0

	string circleLabel = circle.label();  // "circle"
	string rectLabel = rect.label();  // "rectangle"
	string noneLabel = none.label();  // "nothing"

	// `name()` gives the variant's name, as for every enum.
	string variant = rect.name();  // "Rect"
}

// ---------------------------------------------------------------------------
// 3. Asking which variant it is
// ---------------------------------------------------------------------------
//
// A value of the enum is never compared with another one, because that would
// have to compare data. Asking which variant it is does work: `shape == .Circle`
// ignores the data. To see the data, use a `switch`.

func asking() {
	Shape circle = Shape.Circle{radius: 2};
	Shape rect = .Rect{w: 3, h: 4};

	bool circleIsCircle = circle == .Circle;  // true
	bool rectIsCircle = rect == .Circle;  // false
}

// ---------------------------------------------------------------------------
// 4. Changing the data
// ---------------------------------------------------------------------------
//
// Methods work as on a struct. The name in a case is a copy when the switch is
// on a value, and a pointer to the data inside when it is on a pointer, so a
// method with a pointer receiver can change the variant it holds.

func (*Shape shape) grow(float factor) {
	switch shape {
		case .Circle c => c.radius *= factor;
		case .Rect r => {
			r.w *= factor;
			r.h *= factor;
		}
		case .Empty => {}
	}
}

func changing() {
	Shape rect = .Rect{w: 3, h: 4};
	rect.grow(2);
	float grown = area(rect);  // 48

	// Switching on a value gives the case a copy: this changes nothing.
	Shape box = .Rect{w: 2, h: 5};
	switch box {
		case .Rect r => r.w = 100;
		default => {}
	}
	float copied = area(box);  // 10

	// Switching on a pointer gives the case a pointer to the data inside: this
	// changes the box itself.
	switch &box {
		case .Rect r => r.w = 100;
		default => {}
	}
	float through = area(box);  // 500
}

// ---------------------------------------------------------------------------
// 5. Zero values
// ---------------------------------------------------------------------------
//
// A field left out of the literal is zero, and so is a value never written: the
// first variant with its data at zero.

func zeros() {
	Shape partial = .Rect{w: 5};
	float noHeight = area(partial);  // 0

	Shape first;
	string zeroLabel = first.label();  // "circle"
}

public func demo() {
	looking();
	asking();
	changing();
	zeros();
}
