// The entry point of the tour. `wisp run` finds the single `main` in the
// project on its own, no `entry` setting needed, and runs it on the host
// x86-64 target.
//
// What each page teaches, in the order they run:
//
//   basics        constants, variables, operators
//   printing      fmt: printf and its format specs
//   branching     if, switch (exhaustive on enums), guards `return x if c;`,
//                 blocks `{ }`, blocks that give a value, labeled blocks
//   loops         for, loop, ranges, labels, break and continue
//   functions     parameters, several results, `=>`, any order
//   lambdas       function values, function literals, named function types
//   inlining      inline functions, const parameters
//   variadics     `type ...name`, any number of arguments
//   anyargs       `...name` of any type, `switch type`, signed and unsigned
//   cleanup       defer and defer!
//   types         type aliases, enums, sizes, conversions
//   variants      enums with data: variants, switch with names, `x == .Name`
//   overflow      `+ - *` stop on overflow, `+% -% *%` wrap, `+| -| *|` clamp, `truncate`, `saturate`
//   floats        float32 and float64, formatting
//   structs       structs, methods, literals
//   collections   arrays, slices, strings
//   errors        `!` functions, Error, `!`, `??`, `|e|`, handlers
//   optionals     `?T`, null, `??`, `!!`, `if x |v|`, `loop x |v|`
//   assertions    `!!` on a call that cannot fail here
//   pointers      `*T`, `&`, `@`, indexing and slicing pointers
//   memory        allocators: Fixed, Arena, marks and reset
//   files         os, path, the environment
//   globals       global variables and constants
//   interop       native blocks and functions (assembly)
//   platform      #target, per-system files and declarations
//   geometry/     modules: public, internal and imported names
//   _c/           calling C with extern (a project of its own)
//
// Every file is its own module. `import "basics"` loads basics.wsp and binds
// it to the name `basics`; `as` picks another name. A module reaches the
// others through the project root, so even files in subfolders write their
// imports the same way. Two modules may import each other, since every
// declaration is known before any body is checked.

import "basics";
import "printing";
import "branching";
import "loops";
import "functions";
import "lambdas";
import "inlining";
import "variadics";
import "anyargs";
import "cleanup";
import "types";
import "variants";
import "overflow";
import "floats";
import "structs";
import "collections";
import "errors";
import "optionals";
import "assertions";
import "pointers";
import "memory";
import "files";
import "globals";
import "interop";
import "platform";
import "std/fmt";
import "geometry" as geo;

// `!` marks `main` as fallible: `pointers.demo()!` passes any error up, and if
// `main` ends in an error the program prints it and exits with its code.
func main() !int {
  fmt.printf("== basics ==\n");
  basics.demo();

  fmt.printf("\n== printing ==\n");
  printing.demo();

  fmt.printf("\n== branching ==\n");
  branching.demo();

  fmt.printf("\n== loops ==\n");
  loops.demo();

  fmt.printf("\n== functions ==\n");
  functions.demo();

  fmt.printf("\n== function values ==\n");
  lambdas.demo();

  fmt.printf("\n== inline functions ==\n");
  inlining.demo();

  fmt.printf("\n== variadics ==\n");
  variadics.demo();

  fmt.printf("\n== any arguments ==\n");
  anyargs.demo();

  fmt.printf("\n== defer ==\n");
  cleanup.demo();

  fmt.printf("\n== types ==\n");
  types.demo();

  fmt.printf("\n== enums with data ==\n");
  variants.demo();

  fmt.printf("\n== integer overflow ==\n");
  overflow.demo();

  fmt.printf("\n== floats ==\n");
  floats.demo();

  fmt.printf("\n== structs ==\n");
  structs.demo();

  fmt.printf("\n== collections ==\n");
  collections.demo();

  fmt.printf("\n== errors ==\n");
  errors.demo();

  fmt.printf("\n== optionals ==\n");
  optionals.demo();

  fmt.printf("\n== assertions ==\n");
  assertions.demo();

  fmt.printf("\n== pointers ==\n");
  pointers.demo()!;

  fmt.printf("\n== allocators ==\n");
  memory.demo()!;

  fmt.printf("\n== files and paths ==\n");
  files.demo()!;

  fmt.printf("\n== globals ==\n");
  globals.demo();
  fmt.printf("another module reads the public global: {}\n", globals.total);

  fmt.printf("\n== interop ==\n");
  interop.demo();

  fmt.printf("\n== target ==\n");
  platform.demo();

  fmt.printf("\n== modules ==\n");
  fmt.printf("geo.area(3, 4) = {}\n", geo.area(3, 4));
  fmt.printf("geo.Sides = {}\n", geo.Sides);
  fmt.printf("geo.perimeter(5) = {}\n", geo.perimeter(5));

  geo.Rect rect = geo.newRect(3, 4);
  fmt.printf("rect is {} by {}, its area is {}\n", rect.width, rect.height, rect.area());

  return 0;
}
