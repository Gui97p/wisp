// The entry point of the tour. `wisp run` finds the single `main` in the
// project on its own, no `entry` setting needed, and runs it on the host
// x86-64 target.
//
// What each page teaches, in the order they run:
//
//   basics        constants, variables, operators
//   printing      fmt: printf and its format specs
//   branching     if, switch (exhaustive on enums), guards `return x if c;`,
//                 blocks `{ }`, blocks that give a value, labeled blocks
//   loops         for, loop, ranges, labels, break and continue
//   functions     parameters, several results, `=>`, any order
//   lambdas       function values, function literals, named function types
//   inlining      inline functions, const parameters
//   variadics     `type ...name`, any number of arguments
//   anyargs       `...name` of any type, `switch type`, signed and unsigned
//   cleanup       defer and defer!
//   types         type aliases, enums, sizes, conversions
//   variants      enums with data: variants, switch with names, `x == .Name`
//   overflow      `+ - *` stop on overflow, `+% -% *%` wrap, `+| -| *|` clamp, `truncate`, `saturate`
//   compiletime   `sizeof`, `alignof`, `offsetof`, `staticAssert`, `static { }` blocks
//   floats        float32 and float64, formatting
//   structs       structs, methods, literals
//   literals      `T{...}`, `.{...}`, `[_]`: how every value is written
//   generics      `<T>` on functions, structs and methods, value parameters, `switch type` on `T`
//   interfaces    `interface`, `implements`, interface values, `<Shape S>`, type sets, `Comparable`
//   collections   arrays, slices, strings
//   errors        `!` functions, Error, `!`, `??`, `|e|`, handlers
//   optionals     `?T`, null, `??`, `.?`, `if x |v|`, `loop x |v|`
//   assertions    `!!` on a call that cannot fail here
//   pointers      `*T`, `&`, `@`, indexing and slicing pointers
//   memory        allocators: Fixed, Arena, marks and reset, `mem.make`, `mem.makeDirty`, `mem.create`
//   files         os, path, the environment
//   globals       global variables and constants
//   interop       native blocks and functions (assembly)
//   tags          `#packed`, `#naked`, `#noreturn`, `#deprecated`, `#must_use`, `#test`
//   platform      #target, per-system files and declarations
//   geometry/     a folder as a module: public, internal and imported names
//   _c/           calling C with extern (a project of its own)
//
// A folder is a module: its files see each other's names with no import, and
// the folder is imported by its path (`import "geometry"`). A file that starts
// with `#standalone` is a module of its own instead, which is how the lessons
// next to this file are written: `import "basics"` loads basics.wsp and binds
// it to the name `basics`; `as` picks another name. Imports start at the
// project root, so even files in subfolders write them the same way. Two
// modules may import each other, since every declaration is known before any
// body is checked.

import "std/fmt";
import "anyargs";
import "assertions";
import "basics";
import "branching";
import "cleanup";
import "collections";
import "compiletime";
import "errors";
import "files";
import "floats";
import "functions";
import "generics";
import "geometry" as geo;
import "globals";
import "inlining";
import "interfaces";
import "interop";
import "lambdas";
import "literals";
import "loops";
import "memory";
import "optionals";
import "overflow";
import "platform";
import "pointers";
import "printing";
import "structs";
import "tags";
import "types";
import "variadics";
import "variants";

// `!` marks `main` as fallible: `pointers.demo()!` passes any error up, and if
// `main` ends in an error the program prints it and exits with its code.
func main() !int {
	fmt.println("== basics ==");
	basics.demo();

	fmt.println("\n== printing ==");
	printing.demo();

	fmt.println("\n== branching ==");
	branching.demo();

	fmt.println("\n== loops ==");
	loops.demo();

	fmt.println("\n== functions ==");
	functions.demo();

	fmt.println("\n== function values ==");
	lambdas.demo();

	fmt.println("\n== inline functions ==");
	inlining.demo();

	fmt.println("\n== variadics ==");
	variadics.demo();

	fmt.println("\n== any arguments ==");
	anyargs.demo();

	fmt.println("\n== defer ==");
	cleanup.demo();

	fmt.println("\n== types ==");
	types.demo();

	fmt.println("\n== enums with data ==");
	variants.demo();

	fmt.println("\n== integer overflow ==");
	overflow.demo();

	fmt.println("\n== compile time ==");
	compiletime.demo();

	fmt.println("\n== floats ==");
	floats.demo();

	fmt.println("\n== structs ==");
	structs.demo();

	fmt.println("\n== literals ==");
	literals.demo();

	fmt.println("\n== generics ==");
	generics.demo();

	fmt.println("\n== interfaces ==");
	interfaces.demo();

	fmt.println("\n== collections ==");
	collections.demo();

	fmt.println("\n== errors ==");
	errors.demo();

	fmt.println("\n== optionals ==");
	optionals.demo();

	fmt.println("\n== assertions ==");
	assertions.demo();

	fmt.println("\n== pointers ==");
	pointers.demo()!;

	fmt.println("\n== allocators ==");
	memory.demo()!;

	fmt.println("\n== files and paths ==");
	files.demo()!;

	fmt.println("\n== globals ==");
	globals.demo();
	fmt.println("another module reads the public global: {}", globals.total);

	fmt.println("\n== interop ==");
	interop.demo();

	fmt.println("\n== tags ==");
	tags.demo();

	fmt.println("\n== target ==");
	platform.demo();

	fmt.println("\n== modules ==");
	fmt.println("geo.area(3, 4) = {}", geo.area(3, 4));
	fmt.println("geo.Sides = {}", geo.Sides);
	fmt.println("geo.perimeter(5) = {}", geo.perimeter(5));

	geo.Rect rect = geo.newRect(3, 4);
	fmt.println("rect is {} by {}, its area is {}", rect.width, rect.height, rect.area());

	return 0;
}
