// The entry point of the tour. `wisp run` finds the single `main` in the
// project on its own, no `entry` setting needed, and runs it on the host
// x86-64 target.
//
// Every file is its own module. `import "basics"` loads basics.wsp and binds
// it to the name `basics`; `as` picks another name. A module reaches the
// others through the project root, so even files in subfolders write their
// imports the same way. Two modules may import each other, since every
// declaration is known before any body is checked.

import "basics";
import "printing";
import "branching";
import "loops";
import "functions";
import "variadics";
import "anyargs";
import "cleanup";
import "types";
import "structs";
import "collections";
import "errors";
import "assertions";
import "pointers";
import "globals";
import "interop";
import "std/fmt";
import "geometry" as geo;

// `!` marks `main` as fallible: `pointers.demo()!` passes any error up, and if
// `main` ends in an error the program prints it and exits with its code.
func main() !int {
  fmt.printf("== basics ==\n");
  basics.demo();

  fmt.printf("\n== printing ==\n");
  printing.demo();

  fmt.printf("\n== branching ==\n");
  branching.demo();

  fmt.printf("\n== loops ==\n");
  loops.demo();

  fmt.printf("\n== functions ==\n");
  functions.demo();

  fmt.printf("\n== variadics ==\n");
  variadics.demo();

  fmt.printf("\n== any arguments ==\n");
  anyargs.demo();

  fmt.printf("\n== defer ==\n");
  cleanup.demo();

  fmt.printf("\n== types ==\n");
  types.demo();

  fmt.printf("\n== structs ==\n");
  structs.demo();

  fmt.printf("\n== collections ==\n");
  collections.demo();

  fmt.printf("\n== errors ==\n");
  errors.demo();

  fmt.printf("\n== assertions ==\n");
  assertions.demo();

  fmt.printf("\n== pointers ==\n");
  pointers.demo()!;

  fmt.printf("\n== globals ==\n");
  globals.demo();
  fmt.printf("another module reads the public global: {}\n", globals.total);

  fmt.printf("\n== interop ==\n");
  interop.demo();

  fmt.printf("\n== modules ==\n");
  fmt.printf("geo.area(3, 4) = {}\n", geo.area(3, 4));
  fmt.printf("geo.Sides = {}\n", geo.Sides);
  fmt.printf("geo.perimeter(5) = {}\n", geo.perimeter(5));

  geo.Rect rect = geo.newRect(3, 4);
  fmt.printf("rect is {} by {}, its area is {}\n", rect.width, rect.height, rect.area());

  return 0;
}
