// The entry point of the tour. `wisp run` finds the single `main` in the
// project on its own, no `entry` setting needed, and runs it on the host
// x86-64 target.
//
// Every file is its own module. `import "basics"` loads basics.wsp and binds
// it to the name `basics`; `as` picks another name. A module reaches the
// others through the project root, so even files in subfolders write their
// imports the same way.

import "basics";
import "branching";
import "loops";
import "functions";
import "variadics";
import "anyargs";
import "cleanup";
import "types";
import "structs";
import "collections";
import "errors";
import "assertions";
import "pointers";
import "globals";
import "interop";
import "expect";
import "geometry" as geo;

// `!` marks `main` as fallible: `pointers.demo()!` passes any error up, and if
// `main` ends in an error the program prints it and exits with its code.
func main() !int {
  emit("== basics ==");
  basics.demo();

  emit("== branching ==");
  branching.demo();

  emit("== loops ==");
  loops.demo();

  emit("== functions ==");
  functions.demo();

  emit("== variadics ==");
  variadics.demo();

  emit("== any arguments ==");
  anyargs.demo();

  emit("== defer ==");
  cleanup.demo();

  emit("== types ==");
  types.demo();

  emit("== structs ==");
  structs.demo();

  emit("== collections ==");
  collections.demo();

  emit("== errors ==");
  errors.demo();

  emit("== assertions ==");
  assertions.demo();

  emit("== pointers ==");
  pointers.demo()!;

  emit("== globals ==");
  globals.demo();
  expect.expect(globals.shared == 101, "another module reads an exported global");

  emit("== interop ==");
  interop.demo();

  emit("== modules ==");
  expect.expect(geo.area(3, 4) == 12, "a function from a package");
  expect.expect(geo.Sides == 4, "a constant re-exported by the package");

  return 0;
}
