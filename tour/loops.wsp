// Tour - Loops: `for` and `loop`.

import "std/fmt";

export func demo() {
  // A range includes both ends: this visits 1, 2, 3.
  int sum;
  for i in 1..3 {
    fmt.printf("i = {}\n", i);
    sum += i;
  }
  fmt.printf("the sum of 1..3 is {}\n", sum);

  // `:4` after the range is the step. This visits 1, 5, 9.
  int stepped;
  for i in 1..10:4 {
    fmt.printf("stepping: {}\n", i);
    stepped += i;
  }
  fmt.printf("the sum of 1..10:4 is {}\n", stepped);

  // Without a variable, `for` just repeats.
  int repeats;
  for 2 {
    repeats++;
  }
  fmt.printf("for 2 ran {} times\n", repeats);

  // `loop <condition>` is a while loop.
  int left = 3;
  int passes;
  loop left != 0 {
    passes++;
    left--;
  }
  fmt.printf("the while loop ran {} times\n", passes);

  // A `loop` with `until` at the end is a do-while: the body runs first.
  int tries = 0;
  loop {
    tries++;
  } until tries == 3;
  fmt.printf("the do-while stopped at {}\n", tries);

  // The condition after `until` sees what the body declared, so it can test a
  // value the body just computed. That only holds when the body has no
  // `continue`, which could skip the declaration.
  int guess = 1;
  loop {
    int doubled = guess * 2;
    guess = doubled;
  } until doubled >= 100;
  fmt.printf("doubling stopped at {}\n", guess);

  // A bare `loop` runs until something breaks out of it.
  int n = 0;
  int kept;
  loop {
    n++;
    if n == 2 {
      continue;
    }
    if n > 4 {
      break;
    }
    kept += n;
  }
  fmt.printf("skipping 2 and stopping after 4 kept {}\n", kept);

  // Labels start with `:` and let `break` and `continue` target an outer loop.
  int visits;
  :outer loop {
    loop {
      visits++;
      break outer;
    }
  }
  fmt.printf("break outer left both loops after {} visit\n", visits);

  // `for ... in` walks any collection. With two names you get the index
  // (or the key, for a map) and the element; with a single name you get
  // just the index. A variable you never use is reported, and a name that is
  // just `_` (or starts with one) says you meant to leave it out.
  int[3] values = [10, 20, 30];
  int total;
  for index, v in values {
    fmt.printf("values[{}] = {}\n", index, v);
    total += v;
  }
  fmt.printf("the elements add up to {}\n", total);

  int indexes;
  for i in values {
    indexes += i;
  }
  fmt.printf("the indexes add up to {}\n", indexes);
}
