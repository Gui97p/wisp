// Tour - Loops: `for` and `loop`.

import "expect";

export func demo() {
  // A range includes both ends: this visits 1, 2, 3.
  int sum;
  for i in 1..3 {
    sum += i;
  }
  expect.expect(sum == 6, "a range includes both ends");

  // `:4` after the range is the step. This visits 1, 5, 9.
  int stepped;
  for i in 1..10:4 {
    stepped += i;
  }
  expect.expect(stepped == 15, "the step skips values");

  // Without a variable, `for` just repeats.
  int repeats;
  for 2 {
    repeats++;
  }
  expect.expect(repeats == 2, "for with a count");

  // `loop <condition>` is a while loop.
  int left = 3;
  int passes;
  loop left != 0 {
    passes++;
    left--;
  }
  expect.expect(passes == 3, "loop with a condition");

  // A `loop` with `until` at the end is a do-while: the body runs first.
  int tries = 0;
  loop {
    tries++;
  } until tries == 3;
  expect.expect(tries == 3, "do-while with until");

  // A bare `loop` runs until something breaks out of it.
  int n = 0;
  int kept;
  loop {
    n++;
    if n == 2 {
      continue;
    }
    if n > 4 {
      break;
    }
    kept += n;
  }
  expect.expect(kept == 8, "break and continue");

  // Labels start with `:` and let `break` and `continue` target an outer loop.
  int visits;
  :outer loop {
    loop {
      visits++;
      break outer;
    }
  }
  expect.expect(visits == 1, "break with a label leaves both loops");

  // `for ... in` walks any collection. With two names you get the index
  // (or the key, for a map) and the element; with a single name you get
  // just the index. A variable you never use is reported, and a name that is
  // just `_` (or starts with one) says you meant to leave it out.
  int[3] values = [10, 20, 30];
  int total;
  for _, v in values {
    total += v;
  }
  expect.expect(total == 60, "for in with index and element");

  int indexes;
  for i in values {
    indexes += i;
  }
  expect.expect(indexes == 3, "for in with the index only");
}
