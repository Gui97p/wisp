// Tour - Variadics of any type.
//
// `...name` with no type before it takes any number of arguments of any type.
// There is no type to write for what comes in, so a value of that kind lives
// only inside the function: `args` is a sequence you can measure with `len`,
// index, and loop over, and its elements are inspected with a `switch`.
// Arguments that cannot be held, such as a struct (pass a pointer), are an
// error at the call.
//
// This is how `fmt.printf` itself is written: its `...args` is read with a
// `switch type` on each argument.
//
// `switch type args[i] { ... }` dispatches on the type of the value, and each
// case names it with the type it matched: `case int v:` gives a `v` that is
// an `int`, `case string s:` an `s` that is a `string`. The name is optional,
// `case bool:` just tests. A case is exactly the type it names, so `case int`
// is only `int`, and `case int8`, `case Color` (an enum) or `case Meters` (a
// type of your own, such as `type Meters int`) are each their own case, in any
// order. Two groups cover the integers that arrive in any size: `case signed v`
// matches every signed integer and `case unsigned v` every unsigned one, and
// `v` is an `int` or a `uint`. A group is the one thing that depends on order:
// put a specific case before the group that contains it. `signed` and
// `unsigned` are not reserved words, a type of your own may use them.
// `default` runs for anything else and has no name.
//
// `rest...` passes a variadic on to another function that takes `...name`.

import "std/fmt";

enum Color {
  Red,
  Green,
}

func describe(...args) int {
  int total;
  for _, arg in args {
    switch type arg {
      case Color => {
        fmt.printf("a Color adds 100\n");
        total += 100;
      }
      case signed v => {
        fmt.printf("the integer {} adds {}\n", v, v);
        total += v;
      }
      case string v => {
        fmt.printf("the string \"{}\" adds its length, {}\n", v, len(v));
        total += len(v);
      }
      case bool v => {
        fmt.printf("the bool {} adds {}\n", v, v ? 1 : 0);
        total += v ? 1 : 0;
      }
    }
  }
  return total;
}

func twice(...args) int {
  return describe(args...) * 2;
}

public func demo() {
  fmt.printf("describe(10, \"abc\", true) = {}\n", describe(10, "abc", true));
  fmt.printf("describe(Color.Green, 1) = {}\n", describe(Color.Green, 1));
  fmt.printf("twice(1, \"ab\") = {}\n", twice(1, "ab"));
  fmt.printf("describe() = {}\n", describe());
}
