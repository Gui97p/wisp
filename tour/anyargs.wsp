#standalone
#allow unused_variables, dead_code
// Tour - Variadics of any type.
//
// `...name` with no type before it takes any number of arguments of any type.
// There is no type to write for what comes in, so a value of that kind lives
// only inside the function: `args` is a sequence you can measure with `len`,
// index, and loop over, and its elements are inspected with a `match`.
// Arguments that cannot be held, such as a struct (pass a pointer), are an
// error at the call.
//
// This is how `fmt.format` itself is written: its `...args` is read with a
// `match type` on each argument. The comment at the end of a line shows the
// value that line gives.

// ---------------------------------------------------------------------------
// 1. Looking at the type of a value
// ---------------------------------------------------------------------------
//
// `match type args[i] { ... }` dispatches on the type of the value, and each
// arm names it with the type it matched: `int v =>` gives a `v` that is an
// `int`, `string s =>` an `s` that is a `string`. The name is optional,
// `bool =>` just tests. `_` runs for anything else and has no name.
//
// An arm is exactly the type it names, so `int` is only `int`, and `int8`,
// `Color` (an enum) or `Meters` (a type of your own, such as `type Meters int`)
// are each their own arm, in any order.
//
// Two groups cover the integers that arrive in any size: `signed v` matches
// every signed integer and `unsigned v` every unsigned one, and `v` is an `int`
// or a `uint`. A group is the one thing that depends on order: put a specific
// arm before the group that contains it. `signed` and
// `unsigned` are not reserved words, a type of your own may use them.

enum Color {
	Red,
	Green,
}

// A `Color` adds 100, an integer adds itself, a string adds its length and a
// bool adds 1 or 0. Anything else adds nothing.
func describe(...args) int {
	int total = 0;
	for _, arg in args {
		match type arg {
			Color => total += 100;
			signed v => total += v;
			string v => total += len(v);
			bool v => total += if v => 1 : 0;
		}
	}
	return total;
}

func dispatching() {
	int mixed = describe(10, "abc", true);  // 14
	int color = describe(Color.Green, 1);  // 101
	int none = describe();  // 0
}

// ---------------------------------------------------------------------------
// 2. Passing them on
// ---------------------------------------------------------------------------
//
// `rest...` passes a variadic on to another function that takes `...name`.

func twice(...args) int {
	return describe(args...) * 2;
}

func passing() {
	int doubled = twice(1, "ab");  // 6
}

public func demo() {
	dispatching();
	passing();
}
