// Tour - Variadics of any type.
//
// `...name` with no type before it takes any number of arguments of any type.
// There is no type to write for what comes in, so a value of that kind lives
// only inside the function: `args` is a sequence you can measure with `len`,
// index, and loop over, and its elements are inspected with a `switch`.
// Arguments that cannot be held, such as a struct (pass a pointer), are an
// error at the call.
//
// This is how `fmt.printf` itself is written: its `...args` is read with a
// `switch` on the type of each argument.
//
// `switch let v = args[i] { ... }` names the value once, and `v` has the type
// of the case that matched. `case int` matches every signed integer and
// `case uint` every unsigned one; a more specific case such as `case int8`
// has to come first. An enum is an int, and `case Color` matches it before
// the group does. A type of your own, such as `type Meters int`, matches only
// its own case. `default` runs for anything else, and `v` stays untyped there.
//
// `rest...` passes a variadic on to another function that takes `...name`.

import "std/fmt";

enum Color {
  Red,
  Green,
}

func describe(...args) int {
  int total;
  for _, arg in args {
    switch let v = arg {
      case Color:
        fmt.printf("a Color adds 100\n");
        total += 100;
      case int:
        fmt.printf("the int {} adds {}\n", v, v);
        total += v;
      case string:
        fmt.printf("the string \"{}\" adds its length, {}\n", v, len(v));
        total += len(v);
      case bool:
        fmt.printf("the bool {} adds {}\n", v, v ? 1 : 0);
        total += v ? 1 : 0;
    }
  }
  return total;
}

func twice(...args) int {
  return describe(args...) * 2;
}

public func demo() {
  fmt.printf("describe(10, \"abc\", true) = {}\n", describe(10, "abc", true));
  fmt.printf("describe(Color.Green, 1) = {}\n", describe(Color.Green, 1));
  fmt.printf("twice(1, \"ab\") = {}\n", twice(1, "ab"));
  fmt.printf("describe() = {}\n", describe());
}
