#standalone
// Tour - Defer.
//
// `defer` runs a statement when the block it is written in is left, however
// it is left: reaching the end, `return`, `break`, `continue` or an error
// passed up with `!`. Deferred statements run in reverse order, the last one
// written first. `defer!` runs only when the function leaves with an error,
// which is what a constructor needs: free what it allocated unless it
// succeeds. `defer! |e| ...` also names the error that is leaving, so the
// cleanup can report it. A deferred statement can also pass an error up with
// `!`, in a function that can fail: if the function was succeeding, that error
// becomes its error, and if it was already failing the first error is kept.
// The other deferred statements run either way.
//
import "std/fmt";
import "std/os";

enum Fail {
	Ok,
	Boom,
}

func order() {
	defer fmt.printf("  deferred first, runs last\n");
	defer fmt.printf("  deferred second, runs first\n");
	fmt.printf("  the body runs before both\n");
}

// The returned value is computed before the deferred statements run, and a
// deferred statement sees the variables as they are when the block is left.
func early(bool leave) int {
	int value = 5;
	defer fmt.printf("  early is over, value is {}\n", value);
	if leave {
		defer value = 99;
		return value;
	}
	return 6;
}

func build(bool fail) !int {
	defer !|e| fmt.printf("  build failed ({}), cleaning up\n", e.message);
	defer fmt.printf("  build is over\n");
	if fail {
		return Error(Fail.Boom);
	}
	return 10;
}

// `defer` cleans up when a block is left. To clean up when the whole program
// ends, `os.atExit` registers a function that runs after `main` returns, when
// `os.exit` is called, and when a panic ends the program. Hooks run in the
// opposite order of the registration, up to 32 of them. A crash by a signal, such
// as a stack overflow, runs none.
func goodbye() {
	fmt.printf("the program is over, so the exit hook runs now\n");
}

struct Resource {
	bool broken;
}

func (*Resource r) close() ! {
	return Error(Fail.Boom) if r.broken;
}

func use(*Resource r) ! {
	defer r.close()!;
	fmt.printf("  using the resource\n");
}

public func demo() {
	let _ = os.atExit(goodbye);

	fmt.printf("order():\n");
	order();

	fmt.printf("early(true):\n");
	int got = early(true);
	fmt.printf("  it returned {}\n", got);

	fmt.printf("build(false):\n");
	let value, _ = build(false);
	fmt.printf("  it returned {}\n", value);

	fmt.printf("build(true):\n");
	let _, _ = build(true);

	Resource sound, broken = Resource{}, Resource{broken: true};
	let first = use(&sound);
	fmt.printf("use(sound): failed {}\n", first != null);
	let second = use(&broken);
	fmt.printf("use(broken): failed {}\n", second != null);

// A deferred statement cannot leave its block: no return and no break out of
// it. In a function that cannot fail, a failure has to be handled where it
// happens, for instance with `??`.
}
