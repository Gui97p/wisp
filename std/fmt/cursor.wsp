struct Cursor {
	string text;
	int pos;
}

inline func (*Cursor c) peekAt(int k) byte {
	if c.pos + k >= len(c.text) || k < 0 => return '\0';
	return c.text[c.pos + k];
}

inline func (*Cursor c) peek() byte => c.peekAt(0);

inline func (*Cursor c) advance() {
	c.pos++;
}

inline func (*Cursor c) advanceN(int n) {
	c.pos += n;
}

func (*Cursor c) advanceIf(byte ch) bool {
	if c.peek() == ch {
		c.advance();
		return true;
	}
	return false;
}

func (*Cursor c) advanceUntil(byte ...chs) bool {
	loop !(c.peek() in chs) {
		if c.done() => return false;
		c.advance();
	}
	return true;
}

inline func (*Cursor c) since(int mark) string => c.text[mark..c.pos];

inline func (*Cursor c) done() bool => c.pos >= len(c.text);

struct Number {
	int value;
	bool fits;
}

func (*Cursor c) number() ?Number {
	const digits = "0123456789";

	int count;
	int n;
	bool fits = true;
	loop c.peek() in digits {
		if fits {
			n = n * 10 + c.peek() - '0';
			fits = n <= 65535;
		}
		c.advance();
		count++;
	}

	if count == 0 => return null;
	return Number{value: n, fits: fits};
}
