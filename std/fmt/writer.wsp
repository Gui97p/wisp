import "std/io";
import "std/math";

/// A type that writes itself in a format: `{}` calls its `display` with the writer
/// the text is going to, and what it writes counts in the bytes `format` returns.
/// The type has to be declared with `implements Display`, and a pointer to it or
/// the value itself can be given. It takes no spec: `{:x}` on it is a `WrongType`.
/// Inside `display`, `fprint(w, ...)` writes with the same format rules.
#dynamic
public interface Display {
	func display(io.Writer w) !;
}

/// The problems `format` reports: `Unmatched` is a `{` or `}` without its pair,
/// `BadSpec` is a spec that cannot be parsed, `WrongType` is a spec that does not
/// fit the type of its argument, `UnsupportedType` is an argument of a type that
/// cannot be formatted, and `ExtraArgument` is an argument no `{}` used. A `{}`
/// with no argument left is written as it is and is not an error.
public enum FormatError {
	Unmatched = 1,
	BadSpec,
	WrongType,
	UnsupportedType,
	ExtraArgument
}

/// Counts the bytes that go through it to `out`, which is how `format` knows what
/// it wrote, including what a `Display` wrote.
struct Sink implements io.Writer {
	io.Writer out;
	int total;
	Scratch scratch;
}

public func (*Sink w) write([]byte data) !int {
	int n = w.out.write(data)!;
	w.total += n;
	return n;
}

func (*Sink w) text(string s) ! {
	w.write([]byte(s))!;
}

func (*Sink w) char(byte c) ! {
	[1]byte one = .{c};
	w.write(one[..])!;
}

func (*Sink w) fill(byte c, int n) ! {
	for n {
		w.char(c)!;
	}
}

inline func plain(Spec s) bool => s.width == 0 && s.precision == -1 && s.kind == 0 && !s.alt && !s.zero && s.align == Align.Default && s.fill == ' ';

func (*Sink w) writePiece(Piece p, Spec s, bool numeric) ! {
	int used = len(p.sign) + len(p.radix) + len(p.body);
	int pad = math.max(0, s.width - used);

	if s.zero && numeric {
		w.text(p.sign)!;
		w.text(p.radix)!;
		w.fill('0', pad)!;
		w.text(p.body)!;
	} else {
		if s.align == .Default {
			s.align = numeric ? Align.Right : Align.Left;
		}
		switch s.align {
			case .Left => {
				w.text(p.sign)!;
				w.text(p.radix)!;
				w.text(p.body)!;
				w.fill(s.fill, pad)!;
			}
			case .Right => {
				w.fill(s.fill, pad)!;
				w.text(p.sign)!;
				w.text(p.radix)!;
				w.text(p.body)!;
			}
			case .Center => {
				w.fill(s.fill, pad / 2)!;
				w.text(p.sign)!;
				w.text(p.radix)!;
				w.text(p.body)!;
				w.fill(s.fill, pad - pad / 2)!;
			}
			case .Default => {}
		}
	}
}

func (*Sink w) putInt(int v, Spec s) !bool {
	validate(s, Value.Int) ?? return false;
	Piece piece = w.renderInt(v, s)!;
	w.writePiece(piece, s, true)!;
	return true;
}

func (*Sink w) putUint(uint v, Spec s) !bool {
	validate(s, Value.Uint) ?? return false;
	Piece piece = w.renderUint(v, s)!;
	w.writePiece(piece, s, true)!;
	return true;
}

func (*Sink w) putBool(bool v, Spec s) !bool {
	validate(s, Value.Bool) ?? return false;
	Piece piece = renderBool(v);
	w.writePiece(piece, s, false)!;
	return true;
}

func (*Sink w) putString(string v, Spec s) !bool {
	validate(s, Value.String) ?? return false;
	Piece piece = renderString(v, s);
	w.writePiece(piece, s, false)!;
	return true;
}

func (*Sink w) putPointer(*void v, Spec s) !bool {
	validate(s, Value.Pointer) ?? return false;
	Piece piece = w.renderPointer(v, s)!;
	w.writePiece(piece, s, true)!;
	return true;
}

func (*Sink w) putFloat(float x, Spec s, bool single) !bool {
	validate(s, Value.Float) ?? return false;
	Piece piece = w.renderFloat(x, s, single)!;
	Spec copy = s;
	if !math.isFinite(x) {
		copy.zero = false;
	}
	w.writePiece(piece, copy, true)!;
	return true;
}

func (*Sink w) putDisplay(Display d, Spec s) !bool {
	return false if !plain(s);
	d.display(w)!;
	return true;
}

func (*Sink w) putError(Error e, Spec s) !bool {
	validate(s, Value.Error) ?? return false;
	if e == null {
		w.text("<null error>")!;
		return true;
	}
	switch s.kind {
		case 0 => {
			Piece piece = renderString(e.message, s);
			w.writePiece(piece, s, false)!;
		}
		default => {
			if len(e.domain) == 0 {
				w.text("error: ")!;
			} else {
				w.text("error[")!;
				w.text(e.domain)!;
				w.text("]: ")!;
			}
			w.text(e.message)!;
			w.text(" (")!;
			w.text(e.file)!;
			w.char(':')!;
			Piece piece = w.renderInt(e.line, Spec{fill: ' ', precision: -1})!;
			w.writePiece(piece, s, false)!;
			w.char(')')!;
		}
	}
	return true;
}

/// Writes `pattern` to `out`, replacing each `{}` or `{:spec}` with the next argument; `{{`
/// and `}}` write a brace. A spec is
/// `[[fill]align][#][0][width][.precision][type]`: `fill` is any byte, `align` is
/// `<`, `>` or `^` (text is left by default and numbers right), `#` adds a prefix
/// like `0x`, `0` pads numbers with zeros after the sign, `precision` is the
/// digits after the point of a float or the most bytes of a string, and `type` is
/// one of `d x X b o c p e E f v`. Integers, bools, strings, pointers, floats,
/// `Error` and null can be formatted; a spec that does not fit the argument is
/// written as it is. Returns the number of bytes written. All the text is written
/// even after a problem, then it fails with the first `FormatError` found.
#format
public func format(io.Writer out, string pattern, ...args) !int {
	Sink w = Sink{out: out};
	int argIndex;
	Error problem;
	Cursor c = Cursor{text: pattern};

	loop !c.done() {
		int start = c.pos;
		c.advanceUntil('{', '}');
		w.text(c.since(start))!;

		break if c.done();

		if c.peekAt(1) == c.peek() {
			w.char(c.peek())!;
			c.advanceN(2);
			continue;
		}

		if c.peek() == '}' {
			w.char('}')!;
			if problem == null {
				problem = Error(FormatError.Unmatched);
			}
			c.advance();
			continue;
		}

		int open = c.pos;
		c.advance();
		int inner = c.pos;

		if !c.advanceUntil('}') {
			w.text(c.since(open))!;
			if problem == null {
				problem = Error(FormatError.Unmatched);
			}
			break;
		}

		string text = c.since(inner);
		c.advance();
		string all = c.since(open);

		Spec s = parse(text) ?? {
			w.text(all)!;
			argIndex++;
			if problem == null {
				problem = Error(FormatError.BadSpec);
			}
			continue;
		};

		if argIndex >= len(args) {
			w.text(all)!;
			continue;
		}

		bool ok;
		Error bad = Error(FormatError.WrongType);
		switch type args[argIndex] {
			case Display v => ok = w.putDisplay(v, s)!;
			case signed v => ok = w.putInt(v, s)!;
			case unsigned v => ok = w.putUint(v, s)!;
			case bool v => ok = w.putBool(v, s)!;
			case string v => ok = w.putString(v, s)!;
			case *void v => ok = w.putPointer(v, s)!;
			case float64 v => ok = w.putFloat(v, s, false)!;
			case float32 v => ok = w.putFloat(v, s, true)!;
			case Error v => ok = w.putError(v, s)!;
			case null => ok = w.putString("null", s)!;
			default => bad = Error(FormatError.UnsupportedType);
		}
		argIndex++;
		if !ok {
			w.text(all)!;
			if problem == null {
				problem = bad;
			}
		}
	}

	if argIndex < len(args) && problem == null {
		problem = Error(FormatError.ExtraArgument);
	}

	return problem if problem != null;

	return w.total;
}
