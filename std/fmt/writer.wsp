import "std/conv";
import "std/errors";
import "std/math";
import "std/mem";
import "std/os";

/// The problems `Writer.format` reports: `Unmatched` is a `{` or `}` without its
/// pair, `BadSpec` is a spec that cannot be parsed, `WrongType` is a spec that
/// does not fit the type of its argument, `UnsupportedType` is an argument of a
/// type that cannot be formatted, and `ExtraArgument` is an argument no `{}`
/// used. A `{}` with no argument left is written as it is and is not an error.
public enum FormatError {
	Unmatched = 1,
	BadSpec,
	WrongType,
	UnsupportedType,
	ExtraArgument
}

/// When a `Writer` sends its buffer to the file: `None` writes at once and does
/// not use the buffer, `Line` flushes after a write that holds a newline, and
/// `Full` flushes only when the buffer fills or on `flush`.
public enum BufMode {
	None,
	Line,
	Full
}

/// Writes bytes to a file descriptor through a buffer you provide. With `fd` set
/// to -1 there is no file: the bytes are collected in `buf` and writing fails
/// with `NoSpace` when it is full. With an `fd`, `mode` decides when the buffer
/// is flushed, a write bigger than the buffer goes straight to the file, and an
/// empty `buf` writes at once. Call `flush` at the end, since `Line` and `Full`
/// can leave bytes in the buffer.
public struct Writer {
	public int fd;
	public []byte buf;
	public BufMode mode;
	int len, total;
}

func (*Writer w) put(*byte c, int n) ! {
	return if n == 0;

	if w.fd < 0 {
		errors.ensure(len(w.buf) - w.len >= n, errors.Kind.NoSpace)!;
		mem.copy((*byte)(w.buf) + w.len, c, n);
		w.total += n;
		w.len += n;
		return;
	}

	if w.mode == .None || len(w.buf) == 0 {
		w.total += os.writeBytes(w.fd, c[0:n])!;
		return;
	}

	if n > len(w.buf) {
		w.flush()!;
		w.total += os.writeBytes(w.fd, c[0:n])!;
		return;
	}

	if w.len + n > len(w.buf) {
		w.flush()!;
	}

	mem.copy((*byte)(w.buf) + w.len, c, n);
	w.total += n;
	w.len += n;

	switch w.mode {
		case .Line => {
			if '\n' in c[0:n] {
				w.flush()!;
			}
		}
		case .Full => {
			if w.len == len(w.buf) {
				w.flush()!;
			}
		}
		case .None => {}
	}
}

/// Writes the bytes of a string.
public func (*Writer w) write(string s) ! {
	w.put((*byte)(s), len(s))!;
}
/// Writes one byte.
public func (*Writer w) writeByte(byte c) ! {
	w.put(&c, 1)!;
}
/// Writes the bytes of a slice.
public func (*Writer w) writeBytes([]byte data) ! {
	w.put((*byte)(data), len(data))!;
}
/// Writes the byte `c`, `n` times. Nothing is written when `n` is zero or less.
public func (*Writer w) fill(byte c, int n) ! {
	for n {
		w.put(&c, 1)!;
	}
}

/// The number of bytes in the buffer that were not sent yet.
public func (*Writer w) buffered() int { return w.len; }
/// The number of bytes accepted since the start, whether sent or still in the
/// buffer.
public func (*Writer w) written() int { return w.total; }

/// Sends the buffered bytes to the file. It does nothing for a writer without a
/// file, whose bytes stay in `buf`.
public func (*Writer w) flush() ! {
	if w.fd < 0 || w.len == 0 {
		return;
	}
	os.writeBytes(w.fd, w.buf[:w.len])!;
	w.len = 0;
}

func (*Writer w) writePiece(Piece p, Spec s, bool numeric) ! {
	int used = len(p.sign) + len(p.radix) + len(p.body);
	int pad = math.max(0, s.width - used);

	if s.zero && numeric {
		w.write(p.sign)!;
		w.write(p.radix)!;
		w.fill('0', pad)!;
		w.write(p.body)!;
	} else {
		if s.align == .Default {
			s.align = numeric ? Align.Right : Align.Left;
		}
		switch s.align {
			case .Left => {
				w.write(p.sign)!;
				w.write(p.radix)!;
				w.write(p.body)!;
				w.fill(s.fill, pad)!;
			}
			case .Right => {
				w.fill(s.fill, pad)!;
				w.write(p.sign)!;
				w.write(p.radix)!;
				w.write(p.body)!;
			}
			case .Center => {
				w.fill(s.fill, pad / 2)!;
				w.write(p.sign)!;
				w.write(p.radix)!;
				w.write(p.body)!;
				w.fill(s.fill, pad - pad / 2)!;
			}
			case .Default => {}
		}
	}
}

func (*Writer w) putInt([]byte buf, int v, Spec s) !bool {
	validate(s, Value.Int) ?? return false;
	Piece piece = renderInt(buf, v, s)!;
	w.writePiece(piece, s, true)!;
	return true;
}

func (*Writer w) putUint([]byte buf, uint v, Spec s) !bool {
	validate(s, Value.Uint) ?? return false;
	Piece piece = renderUint(buf, v, s)!;
	w.writePiece(piece, s, true)!;
	return true;
}

func (*Writer w) putBool(bool v, Spec s) !bool {
	validate(s, Value.Bool) ?? return false;
	Piece piece = renderBool(v);
	w.writePiece(piece, s, false)!;
	return true;
}

func (*Writer w) putString(string v, Spec s) !bool {
	validate(s, Value.String) ?? return false;
	Piece piece = renderString(v, s);
	w.writePiece(piece, s, false)!;
	return true;
}

func (*Writer w) putPointer([]byte buf, *void v, Spec s) !bool {
	validate(s, Value.Pointer) ?? return false;
	Piece piece = renderPointer(buf, v, s)!;
	w.writePiece(piece, s, true)!;
	return true;
}

func (*Writer w) putFloat([]byte buf, float x, Spec s, bool single) !bool {
	validate(s, Value.Float) ?? return false;
	Piece piece = renderFloat(buf, x, s, single)!;
	Spec copy = s;
	if !math.isFinite(x) {
		copy.zero = false;
	}
	w.writePiece(piece, copy, true)!;
	return true;
}

func (*Writer w) putError([]byte buf, Error e, Spec s) !bool {
	validate(s, Value.Error) ?? return false;
	if e == null {
		w.write("<null error>")!;
		return true;
	}
	switch s.kind {
		case 0 => {
			Piece piece = renderString(e.message, s);
			w.writePiece(piece, s, false)!;
		}
		default => {
			w.write("error[")!;
			w.write(e.domain)!;
			w.write("]: ")!;
			w.write(e.message)!;
			w.write(" (")!;
			w.write(e.file)!;
			w.writeByte(':')!;
			Piece piece = renderInt(buf, e.line, Spec{fill: ' ', precision: -1})!;
			w.writePiece(piece, s, false)!;
			w.writeByte(')')!;
		}
	}
	return true;
}

/// Writes `format`, replacing each `{}` or `{spec}` with the next argument; `{{`
/// and `}}` write a brace. A spec is
/// `[[fill]align][#][0][width][.precision][type]`: `fill` is any byte, `align` is
/// `<`, `>` or `^` (text is left by default and numbers right), `#` adds a prefix
/// like `0x`, `0` pads numbers with zeros after the sign, `precision` is the
/// digits after the point of a float or the most bytes of a string, and `type` is
/// one of `d x X b o c p e E f v`. Integers, bools, strings, pointers, floats,
/// `Error` and null can be formatted; a spec that does not fit the argument is
/// written as it is. Returns the number of bytes written. All the text is written
/// even after a problem, then it fails with the first `FormatError` found.
public func (*Writer w) format(string format, ...args) !int {
	[conv.MaxDigits]byte buf;
	int argIndex;
	Error problem;
	Cursor c = Cursor{text: format};
	int start = w.total;

	loop !c.done() {
		int start = c.pos;
		c.advanceUntil('{', '}');
		w.write(c.since(start))!;

		break if c.done();

		if c.peekAt(1) == c.peek() {
			w.writeByte(c.peek())!;
			c.advanceN(2);
			continue;
		}

		if c.peek() == '}' {
			w.writeByte('}')!;
			if problem == null {
				problem = Error(FormatError.Unmatched);
			}
			c.advance();
			continue;
		}

		int open = c.pos;
		c.advance();
		int inner = c.pos;

		if !c.advanceUntil('}') {
			w.write(c.since(open))!;
			if problem == null {
				problem = Error(FormatError.Unmatched);
			}
			break;
		}

		string text = c.since(inner);
		c.advance();
		string all = c.since(open);

		Spec s = parse(text) ?? {
			w.write(all)!;
			argIndex++;
			if problem == null {
				problem = Error(FormatError.BadSpec);
			}
			continue;
		};

		if argIndex >= len(args) {
			w.write(all)!;
			continue;
		}

		bool ok;
		Error bad = Error(FormatError.WrongType);
		switch type args[argIndex] {
			case signed v => ok = w.putInt(buf, v, s)!;
			case unsigned v => ok = w.putUint(buf, v, s)!;
			case bool v => ok = w.putBool(v, s)!;
			case string v => ok = w.putString(v, s)!;
			case *void v => ok = w.putPointer(buf, v, s)!;
			case float64 v => { [conv.MaxFloat]byte fBuf; ok = w.putFloat(fBuf, v, s, false)!; }
			case float32 v => { [conv.MaxFloat]byte fBuf; ok = w.putFloat(fBuf, v, s, true)!; }
			case Error v => ok = w.putError(buf, v, s)!;
			case null => ok = w.putString("null", s)!;
			default => bad = Error(FormatError.UnsupportedType);
		}
		argIndex++;
		if !ok {
			w.write(all)!;
			if problem == null {
				problem = bad;
			}
		}
	}

	if argIndex < len(args) && problem == null {
		problem = Error(FormatError.ExtraArgument);
	}

	return problem if problem != null;

	return w.total - start;
}
