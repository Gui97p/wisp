import "std/fmt/cursor";
import "std/fmt/render";
import "std/fmt/spec";
import "std/conv";
import "std/os";
import "std/mem";
import "std/math";
import "std/errors";

public enum FormatError {
	Unmatched = 1,
	BadSpec,
	WrongType,
	UnsupportedType,
	ExtraArgument
}

public enum BufMode {
	None,
	Line,
	Full
}

public struct Writer {
	int fd;
	[]byte buf;
	BufMode mode;
	internal int len, total;
}

func (*Writer w) put(*byte c, int n) ! {
	if n == 0 {
		return;
	}

	if w.fd < 0 {
		errors.ensure(len(w.buf) - w.len >= n, errors.Kind.NoSpace)!;
		mem.copy((*byte)(w.buf) + w.len, c, n);
		w.total += n;
		w.len += n;
		return;
	}

	if w.mode == .None || len(w.buf) == 0 {
		w.total += os.writeBytes(w.fd, c[0:n])!;
		return;
	}

	if n > len(w.buf) {
		w.flush()!;
		w.total += os.writeBytes(w.fd, c[0:n])!;
		return;
	}

	if w.len + n > len(w.buf) {
		w.flush()!;
	}

	mem.copy((*byte)(w.buf) + w.len, c, n);
	w.total += n;
	w.len += n;

	switch w.mode {
		case .Line:
			if '\n' in c[0:n] {
				w.flush()!;
			}
		case .Full:
			if w.len == len(w.buf) {
				w.flush()!;
			}
	}
}

public func (*Writer w) write(string s) ! {
	w.put((*byte)(s), len(s))!;
}
public func (*Writer w) writeByte(byte c) ! {
	w.put(&c, 1)!;
}
public func (*Writer w) writeBytes([]byte data) ! {
	w.put((*byte)(data), len(data))!;
}
public func (*Writer w) fill(byte c, int n) ! {
	for n {
		w.put(&c, 1)!;
	}
}

public func (*Writer w) buffered() int { return w.len; }
public func (*Writer w) written() int { return w.total; }

public func (*Writer w) flush() ! {
	if w.fd < 0 || w.len == 0 {
		return;
	}
	os.writeBytes(w.fd, w.buf[:w.len])!;
	w.len = 0;
}

func (*Writer w) writePiece(render.Piece p, spec.Spec s, bool numeric) ! {
	int used = len(p.sign) + len(p.radix) + len(p.body);
	int pad = math.max(0, s.width - used);

	if s.zero && numeric {
		w.write(p.sign)!;
		w.write(p.radix)!;
		w.fill('0', pad)!;
		w.write(p.body)!;
	} else {
		if s.align == .Default {
			s.align = numeric ? spec.Align.Right : spec.Align.Left;
		}
		switch s.align {
			case .Left:
				w.write(p.sign)!;
				w.write(p.radix)!;
				w.write(p.body)!;
				w.fill(s.fill, pad)!;
			case .Right:
				w.fill(s.fill, pad)!;
				w.write(p.sign)!;
				w.write(p.radix)!;
				w.write(p.body)!;
			case .Center:
				w.fill(s.fill, pad/2)!;
				w.write(p.sign)!;
				w.write(p.radix)!;
				w.write(p.body)!;
				w.fill(s.fill, pad-pad/2)!;
		}
	}
}

func (*Writer w) putInt([]byte buf, int v, spec.Spec s) !bool {
	spec.validate(s, spec.Value.Int) ?? return false;
	render.Piece piece = render.renderInt(buf, v, s)!;
	w.writePiece(piece, s, true)!;
	return true;
}

func (*Writer w) putUint([]byte buf, uint v, spec.Spec s) !bool {
	spec.validate(s, spec.Value.Uint) ?? return false;
	render.Piece piece = render.renderUint(buf, v, s)!;
	w.writePiece(piece, s, true)!;
	return true;
}

func (*Writer w) putChar([]byte buf, byte v, spec.Spec s) !bool {
	spec.validate(s, spec.Value.Char) ?? return false;
	render.Piece piece = render.renderChar(buf, v, s)!;
	w.writePiece(piece, s, false)!;
	return true;
}

func (*Writer w) putBool(bool v, spec.Spec s) !bool {
	spec.validate(s, spec.Value.Bool) ?? return false;
	render.Piece piece = render.renderBool(v);
	w.writePiece(piece, s, false)!;
	return true;
}

func (*Writer w) putString(string v, spec.Spec s) !bool {
	spec.validate(s, spec.Value.String) ?? return false;
	render.Piece piece = render.renderString(v, s);
	w.writePiece(piece, s, false)!;
	return true;
}

func (*Writer w) putPointer([]byte buf, *void v, spec.Spec s) !bool {
	spec.validate(s, spec.Value.Pointer) ?? return false;
	render.Piece piece = render.renderPointer(buf, v, s)!;
	w.writePiece(piece, s, true)!;
	return true;
}

func (*Writer w) putFloat([]byte buf, float x, spec.Spec s, bool single) !bool {
	spec.validate(s, spec.Value.Float) ?? return false;
	render.Piece piece = render.renderFloat(buf, x, s, single)!;
	spec.Spec copy = s;
	if !math.isFinite(x) {
		copy.zero = false;
	}
	w.writePiece(piece, copy, true)!;
	return true;
}

func (*Writer w) putError([]byte buf, Error e, spec.Spec s) !bool {
	spec.validate(s, spec.Value.Error) ?? return false;
	if e == null {
		w.write("<null error>")!;
		return true;
	}
	switch s.kind {
		case 0:
			render.Piece piece = render.renderString(e.message, s);
			w.writePiece(piece, s, false)!;
		default:
			w.write("error[")!;
			w.write(e.domain)!;
			w.write("]: ")!;
			w.write(e.message)!;
			w.write(" (")!;
			w.write(e.file)!;
			w.writeByte(':')!;
			render.Piece piece = render.renderInt(buf, e.line, spec.Spec{fill: ' ', precision: -1})!;
			w.writePiece(piece, s, false)!;
			w.writeByte(')')!;
	}
	return true;
}

public func (*Writer w) format(string format, ...args) !int {
	[conv.MaxDigits]byte buf;
	int argIndex;
	Error problem;
	cursor.Cursor c = cursor.Cursor{text: format};
	int start = w.total;

	loop !c.done() {
		int start = c.pos;
		c.advanceUntil('{', '}');
		w.write(c.since(start))!;

		if c.done() {
			break;
		}

		if c.peekAt(1) == c.peek() {
			w.writeByte(c.peek())!;
			c.advanceN(2);
			continue;
		}

		if c.peek() == '}' {
			w.writeByte('}')!;
			if problem == null {
				problem = Error(FormatError.Unmatched);
			}
			c.advance();
			continue;
		}

		int open = c.pos;
		c.advance();
		int inner = c.pos;

		if !c.advanceUntil('}') {
			w.write(c.since(open))!;
			if problem == null {
				problem = Error(FormatError.Unmatched);
			}
			break;
		}

		string text = c.since(inner);
		c.advance();
		string all = c.since(open);

		spec.Spec s = spec.parse(text) ?? {
			w.write(all)!;
			argIndex++;
			if problem == null {
				problem = Error(FormatError.BadSpec);
			}
			continue;
		};

		if argIndex >= len(args) {
			w.write(all)!;
			continue;
		}

		bool ok;
		Error bad = Error(FormatError.WrongType);
		switch let v = args[argIndex] {
			case int:   ok = w.putInt(buf, v, s)!;
			case uint:  ok = w.putUint(buf, v, s)!;
			case byte:  ok = w.putChar(buf, v, s)!;
			case bool:  ok = w.putBool(v, s)!;
			case string: ok = w.putString(v, s)!;
			case *void: ok = w.putPointer(buf, v, s)!;
			case float64: [conv.MaxFloat]byte fBuf; ok = w.putFloat(fBuf, v, s, false)!;
			case float32: [conv.MaxFloat]byte fBuf; ok = w.putFloat(fBuf, v, s, true)!;
			case Error: ok = w.putError(buf, v, s)!;
			default:    bad = Error(FormatError.UnsupportedType);
		}
		argIndex++;
		if !ok {
			w.write(all)!;
			if problem == null {
				problem = bad;
			}
		}
	}

	if argIndex < len(args) && problem == null {
		problem = Error(FormatError.ExtraArgument);
	}

	if problem != null {
		return problem;
	}

	return w.total - start;
}
