enum Align {
	Default,
	Left,
	Right,
	Center
}

struct Spec {
	byte fill;
	Align align;
	bool alt;
	bool zero;
	int width;
	int precision;
	byte kind;
}

enum SpecError {
	UnknownType = 1,
	BadNumber,
	Trailing,
	NotForType,
	NoColon
}

enum Value {
	Int,
	Uint,
	Bool,
	String,
	Pointer,
	Float,
	Error
}

func parse(string braces) !Spec {
	Spec spec = Spec{fill: ' ', precision: -1};
	if len(braces) == 0 => return spec;
	if braces[0] != ':' => return Error(SpecError.NoColon);
	string text = braces[1..];
	if len(text) == 0 => return spec;
	[3]byte aligns = .{'<', '>', '^'};
	const kinds = "dxXbocpeEfv";

	Cursor c = Cursor{text: text};

	bool align = match {
		c.peekAt(1) in aligns => {
			spec.fill = c.peek();
			c.advance();
			yield true;
		};
		c.peek() in aligns => true;
		_ => false;
	};
	if align {
		spec.align = match c.peek() {
			'<' => .Left;
			'>' => .Right;
			'^' => .Center;
			_ => .Default;
		};
		c.advance();
	}

	if c.advanceIf('#') => spec.alt = true;
	if c.advanceIf('0') => spec.zero = true;

	if c.number() |width| {
		if !width.fits => return Error(SpecError.BadNumber);
		spec.width = width.value;
	}

	if c.advanceIf('.') {
		Number precision = c.number() ?? return Error(SpecError.BadNumber);
		if !precision.fits => return Error(SpecError.BadNumber);
		spec.precision = precision.value;
	}

	if !c.done() {
		byte k = c.peek();
		if !(k in kinds) => return Error(SpecError.UnknownType);
		spec.kind = k;
		c.advance();
	}

	if !c.done() => return Error(SpecError.Trailing);

	return spec;
}

func validate(Spec s, Value v) ! {
	match v {
		.Int, .Uint => {
			if s.kind in "pv" ||
				(s.zero && s.kind == 'c') ||
				(s.alt && !(s.kind in "xXbop")) ||
				s.precision >= 0 {
				return Error(SpecError.NotForType);
			}
		}
		.Bool => {
			if s.kind != 0 || s.zero || s.alt || s.precision >= 0 => return Error(SpecError.NotForType);
		}
		.String => {
			if s.kind != 0 || s.zero || s.alt => return Error(SpecError.NotForType);
		}
		.Pointer => {
			if (s.kind != 0 && s.kind != 'p') || s.alt || s.precision >= 0 {
				return Error(SpecError.NotForType);
			}
		}
		.Float => {
			if !(s.kind == 0 || s.kind in "eEf") || s.alt || s.precision > 1000 {
				return Error(SpecError.NotForType);
			}
		}
		.Error => {
			if (s.kind != 0 && s.kind != 'v') || s.zero || s.alt || s.precision >= 0 || (s.kind == 'v' && s.width > 0) {
				return Error(SpecError.NotForType);
			}
		}
	}
}
