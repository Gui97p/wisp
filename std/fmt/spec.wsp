import "std/fmt/cursor";

internal enum Align {
	Default,
	Left,
	Right,
	Center
}

internal struct Spec {
	char fill;
	Align align;
	bool alt;
	bool zero;
	int width;
	int precision;
	char kind;
}

internal enum SpecError {
	UnknownType = 1,
	BadNumber,
	Trailing,
	NotForType
}

internal enum Value {
	Int,
	Uint,
	Char,
	Bool,
	String,
	Pointer,
	Float,
	Error
}

internal func parse(string text) !Spec {
	Spec spec = Spec{fill: ' ', precision: -1};
	if len(text) == 0 {
		return spec;
	}
	[3]char aligns = ['<', '>', '^'];
	const kinds = "dxXbocpeEfv";
	
	cursor.Cursor c = cursor.Cursor{text: text};

	bool align;
	switch {
		case c.peekAt(1) in aligns:
			spec.fill = c.peek();
			c.advance();
			align = true;
		case c.peek() in aligns:
			align = true;
	}
	if align {
		spec.align = switch c.peek() {
			case '<' => .Left;
			case '>' => .Right;
			case '^' => .Center;
			default => .Default;
		};
		c.advance();
	}

	if c.advanceIf('#') {
		spec.alt = true;
	}
	if c.advanceIf('0') {
		spec.zero = true;
	}

	let n, digits, fits = c.number();
	if !fits {
		return Error(SpecError.BadNumber);
	}
	if digits > 0 {
		spec.width = n;
	}

	if c.advanceIf('.') {
		n, digits, fits = c.number();
		if digits == 0 || !fits {
			return Error(SpecError.BadNumber);
		}
		spec.precision = n;
	}

	if !c.done() {
		char k = c.peek();
		if !(k in kinds) {
			return Error(SpecError.UnknownType);
		}
		spec.kind = k;
		c.advance();
	}

	if !c.done() {
		return Error(SpecError.Trailing);
	}

	return spec;
}

internal func validate(Spec s, Value v) ! {
	switch v {
		case .Int, .Uint:
			if s.kind in "pv" ||
			(s.zero && s.kind == 'c') ||
			(s.alt && !(s.kind in "xXbop")) ||
			s.precision >= 0 {
				return Error(SpecError.NotForType);
			}
		case .Char:
			if !(s.kind == 0 || s.kind in "cdx") ||
			(s.zero && !(s.kind in "dx")) ||
			(s.alt && s.kind != 'x') ||
			s.precision >= 0 {
				return Error(SpecError.NotForType);
			}
		case .Bool:
			if s.kind != 0 || s.zero || s.alt || s.precision >= 0 {
				return Error(SpecError.NotForType);
			}
		case .String:
			if s.kind != 0 || s.zero || s.alt {
				return Error(SpecError.NotForType);
			}
		case .Pointer:
			if (s.kind != 0 && s.kind != 'p') || s.alt || s.precision >= 0 {
				return Error(SpecError.NotForType);
			}
		case .Float:
			if !(s.kind == 0 || s.kind in "eEf") || s.alt || s.precision > 1000 {
				return Error(SpecError.NotForType);
			}
		case .Error:
			if (s.kind != 0 && s.kind != 'v') || s.zero || s.alt || s.precision >= 0 || (s.kind == 'v' && s.width > 0) {
				return Error(SpecError.NotForType);
			}
	}
}
