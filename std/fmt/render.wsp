import "std/conv";
import "std/fmt/spec";
import "std/errors";

internal struct Piece {
	string sign;
	string radix;
	string body;
}

func number([]byte buf, uint mag, bool neg, spec.Spec s) !Piece {
	Piece piece;
	int base = switch s.kind {
		case 'x', 'X' => 16;
		case 'b' => 2;
		case 'o' => 8;
		default => 10;
	};
	piece.body = conv.formatUint(buf, mag, base, s.kind == 'X')!;
	piece.sign = neg ? "-" : "";
	if s.alt {
		piece.radix = switch s.kind {
			case 'x' => "0x";
			case 'X' => "0X";
			case 'b' => "0b";
			case 'o' => "0o";
			default => "";
		};
	}
	return piece;
}

internal func renderInt([]byte buf, int v, spec.Spec s) !Piece {
	if s.kind == 'c' {
		Piece piece;
		errors.ensure(v in 0..255, errors.Kind.Range)!;
		buf[0] = byte(v);
		piece.body = string(buf[:1]);
		return piece;
	}

	if v >= 0 {
		return number(buf, uint(v), false, s)!;
	}
	
	return number(buf, uint(-(v+1)) + 1, true, s)!;
}

internal func renderUint([]byte buf, uint v, spec.Spec s) !Piece {
	if s.kind == 'c' {
		Piece piece;
		errors.ensure(v < 256, errors.Kind.Range)!;
		buf[0] = byte(v);
		piece.body = string(buf[:1]);
		return piece;
	}
	return number(buf, v, false, s)!;
}

internal func renderPointer([]byte buf, *void v, spec.Spec s) !Piece {
	spec.Spec t = s;
	t.kind = 'x';
	t.alt = true;
	return number(buf, uint(v), false, t)!;
}

internal func renderBool(bool b) Piece {
	return Piece{body: b ? "true" : "false"};
}

internal func renderString(string t, spec.Spec s) Piece {
	Piece piece = Piece{body: t};
	if s.precision >= 0 && s.precision < len(t) {
		piece.body = t[:s.precision];
	}
	return piece;
}

internal func renderFloat([]byte buf, float x, spec.Spec s, bool single) !Piece {
	Piece piece;
	string view;
	int prec = s.precision == -1 ? 6 : s.precision;
	switch s.kind {
		case 0:
			view = s.precision == -1 ? (single ? conv.ftoa32(buf, float32(x))! : conv.ftoa(buf, x)!) : conv.formatFixed(buf, x, s.precision)!;
		case 'f':
			view = conv.formatFixed(buf, x, prec)!;
		case 'e', 'E':
			view = conv.formatExp(buf, x, prec, s.kind == 'E')!;
	}
	
	int start;
	if view[0] == '-' {
		piece.sign = "-";
		start++;
	}
	piece.body = view[start:];
	return piece;
}
