import "std/conv";
import "std/errors";
import "std/io";
import "std/mem";

struct Piece {
	string sign;
	string radix;
	string body;
}

/// Collects the text of one number before it is padded and written.
struct Scratch implements io.Writer {
	[1400]byte room;
	int used;
}

public func (*Scratch c) write([]byte data) !int {
	errors.ensure(len(data) <= len(c.room) - c.used, errors.Kind.NoSpace)!;
	mem.copy(c.room[c.used..], data, len(data));
	c.used += len(data);
	return len(data);
}

inline func (*Scratch c) reset() {
	c.used = 0;
}

inline func (*Scratch c) text() string => string(c.room[..c.used]);

func (*Sink w) number(uint mag, bool neg, Spec s) !Piece {
	Piece piece;
	int base = switch s.kind {
		case 'x', 'X' => 16;
		case 'b' => 2;
		case 'o' => 8;
		default => 10;
	};
	w.scratch.reset();
	conv.writeUint(&w.scratch, mag, base, s.kind == 'X')!;
	piece.body = w.scratch.text();
	piece.sign = neg ? "-" : "";
	if s.alt {
		piece.radix = switch s.kind {
			case 'x' => "0x";
			case 'X' => "0X";
			case 'b' => "0b";
			case 'o' => "0o";
			default => "";
		};
	}
	return piece;
}

func (*Sink w) renderInt(int v, Spec s) !Piece {
	if s.kind == 'c' {
		Piece piece;
		errors.ensure(v in 0..=255, errors.Kind.Range)!;
		w.scratch.reset();
		io.writeByte(&w.scratch, truncate(byte, v))!;
		piece.body = w.scratch.text();
		return piece;
	}

	return w.number(uint(v), false, s)! if v >= 0;

	return w.number(uint(-(v + 1)) + 1, true, s)!;
}

func (*Sink w) renderUint(uint v, Spec s) !Piece {
	if s.kind == 'c' {
		Piece piece;
		errors.ensure(v < 256, errors.Kind.Range)!;
		w.scratch.reset();
		io.writeByte(&w.scratch, truncate(byte, v))!;
		piece.body = w.scratch.text();
		return piece;
	}
	return w.number(v, false, s)!;
}

func (*Sink w) renderPointer(*void v, Spec s) !Piece {
	Spec t = s;
	t.kind = 'x';
	t.alt = true;
	return w.number(uint(v), false, t)!;
}

inline func renderBool(bool b) Piece => Piece { body:b ? "true" : "false" };

func renderString(string t, Spec s) Piece {
	Piece piece = Piece{body: t};
	if s.precision >= 0 && s.precision < len(t) {
		piece.body = t[..s.precision];
	}
	return piece;
}

func (*Sink w) renderFloat(float x, Spec s, bool single) !Piece {
	Piece piece;
	int prec = s.precision == -1 ? 6 : s.precision;
	w.scratch.reset();
	switch s.kind {
		case 0 => {
			if s.precision != -1 {
				conv.writeFixed(&w.scratch, x, s.precision)!;
			} else if single {
				conv.writeFloat32(&w.scratch, float32(x))!;
			} else {
				conv.writeFloat(&w.scratch, x)!;
			}
		}
		case 'f' => conv.writeFixed(&w.scratch, x, prec)!;
		case 'e', 'E' => conv.writeExp(&w.scratch, x, prec, s.kind == 'E')!;
		default => {}
	}
	string view = w.scratch.text();

	int start;
	if view[0] == '-' {
		piece.sign = "-";
		start++;
	}
	piece.body = view[start..];
	return piece;
}
