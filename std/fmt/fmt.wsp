import "std/os";
import "std/fmt/writer";

export writer;

export func fprint(int fd, string text) {
	char[512] buf;
	writer.Writer w = writer.Writer{fd: fd, buf: buf[:], mode: .Full};

	w.write(text) ?? return;
	w.flush() ?? return;
}

export func fprintln(int fd, string text) {
	char[512] buf;
	writer.Writer w = writer.Writer{fd: fd, buf: buf[:], mode: .Full};

	w.write(text) ?? return;
	w.writeByte('\n') ?? return;
	w.flush() ?? return;
}

export func fprintf(int fd, string format, ...args) !int {
	char[512] buf;
	writer.Writer w = writer.Writer{fd: fd, buf: buf[:], mode: .Full};

	let r, p = w.format(format, args...);
	let fp = w.flush();
	if p != null {
		return p;
	}
	if fp != null {
		return fp;
	}
	return r;
}

export func print(string text) {
	char[512] buf;
	writer.Writer w = writer.Writer{fd: os.STDOUT, buf: buf[:], mode: .Full};

	w.write(text) ?? return;
	w.flush() ?? return;
}

export func println(string text) {
	char[512] buf;
	writer.Writer w = writer.Writer{fd: os.STDOUT, buf: buf[:], mode: .Full};

	w.write(text) ?? return;
	w.writeByte('\n') ?? return;
	w.flush() ?? return;
}

export func printf(string format, ...args) {
	fprintf(os.STDOUT, format, args...) ?? return;
}

export func sprint(char[] buf, string text) ! {
	writer.Writer w = writer.Writer{fd: -1, buf: buf, mode: .Full};

	w.write(text) ?? return;
	w.flush() ?? return;
}

export func sprintln(char[] buf, string text) {
	writer.Writer w = writer.Writer{fd: -1, buf: buf, mode: .Full};

	w.write(text) ?? return;
	w.writeByte('\n') ?? return;
	w.flush() ?? return;
}

export func sprintf(char[] buf, string format, ...args) !int {
	writer.Writer w = writer.Writer{fd: -1, buf: buf, mode: .Full};

	let r, p = w.format(format, args...);
	let fp = w.flush();
	if p != null {
		return p;
	}
	if fp != null {
		return fp;
	}
	return r;
}
