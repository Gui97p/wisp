import "std/strings";
import "std/path";
import "std/math";

public func join([]byte buf, string ...parts) !string {
	int total;
	bool seen, firstPassed;

	for _, p in parts {
		if p == "" {
			continue;
		}
		string rest = p;
		if !seen {
			seen = true;
			int v = path.volumeLen(p);
			total += len(strings.copy(buf[total:], p[:v])!);
			if v < len(p) && path.isSep(p[v]) {
				total += len(strings.copy(buf[total:], path.sep)!);
			} else if v > 2 {
				firstPassed = true;
			}
			rest = p[v:];
		}
		let elems = path.elementsAfterVolume(rest);
		loop {
			let n, found = elems.next();
			if !found {
				break;
			}
			if firstPassed {
				total += len(strings.copy(buf[total:], path.sep)!);
			}
			total += len(strings.copy(buf[total:], n)!);
			firstPassed = true;
		}
	}
	return string(buf[:total]);
}

public func clean([]byte buf, string p) !string {	
	int total, depth;
	int v = path.volumeLen(p);
	total += len(strings.copy(buf, p[:v])!);
	bool rooted = v < len(p) && path.isSep(p[v]);
	if rooted {
		total += len(strings.copy(buf[total:], path.sep)!);
	}
	int rootLen = total;

	let elems = path.elementsAfterVolume(p[v:]);
	loop {
		let n, found = elems.next();
		if !found {
			break;
		}

		switch n {
			case ".":
				continue;
			case "..":
				if depth > 0 {
					total = math.max(strings.lastIndexOf(string(buf[:total]), path.sep), rootLen);
					depth--;
					continue;
				} else if rooted {
					continue;
				}
			default:
				depth++;
		}
		
		if total > rootLen {
			total += len(strings.copy(buf[total:], path.sep)!);
		}
		total += len(strings.copy(buf[total:], n)!);
	}

	if total == 0 {
		strings.copy(buf, ".")!;
		total++;
	}

	return string(buf[:total]);
}
