import "std/errors";
import "std/math";

/// Buffer sizes for formatting. `MaxDigits` holds any integer in any base,
/// including the sign. `MaxFloat` holds any float printed by `ftoa`, `ftoa32`,
/// `formatFixed` or `formatExp` for the digit counts the formatter uses.
public const {
	MaxDigits = 65;
	MaxFloat = 1400;
}

func formatUnsigned([]byte buf, uint n, int base, bool upper) !string {
	int i = 0;
	string digits = upper
		? "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"
		: "0123456789abcdefghijklmnopqrstuvwxyz";

	loop n != 0 {
		uint rem = n % uint(base);
		errors.ensure(i < len(buf), errors.Kind.NoSpace)!;
		buf[i] = digits[rem];
		i += 1;
		n /= uint(base);
	}

	if i == 0 {
		errors.ensure(len(buf) > 0, errors.Kind.NoSpace)!;
		buf[i] = '0';
		i += 1;
	}

	int left = 0;
	int right = i - 1;

	loop left < right {
		byte tmp = buf[left];
		buf[left] = buf[right];
		buf[right] = tmp;

		left += 1;
		right -= 1;
	}

	return string(buf[0..i]);
}

/// Writes `n` in `base` (2 to 36) into `buf` and returns the text, which shares
/// memory with `buf`. Negative numbers get a leading `-`. Digits above 9 are
/// lowercase, or uppercase when `upper` is true. Fails with `Invalid` when `base`
/// is out of range and `NoSpace` when `buf` is too small.
public func formatInt([]byte buf, int n, base, bool upper) !string {
	errors.ensure(base in 2..=36, errors.Kind.Invalid)!;
	return formatUnsigned(buf, uint(n), base, upper)! if n >= 0;
	errors.ensure(len(buf) > 1, errors.Kind.NoSpace)!;

	uint mag = uint(-(n + 1)) + 1;
	string digits = formatUnsigned(buf[1..], mag, base, upper)!;
	buf[0] = '-';
	return string(buf[0..len(digits) + 1]);
}

/// Writes `n` in `base` (2 to 36) into `buf` and returns the text, which shares
/// memory with `buf`. Digits above 9 are lowercase, or uppercase when `upper` is
/// true. Fails with `Invalid` when `base` is out of range and `NoSpace` when `buf`
/// is too small.
public func formatUint([]byte buf, uint n, int base, bool upper) !string {
	errors.ensure(base in 2..=36, errors.Kind.Invalid)!;
	return formatUnsigned(buf, n, base, upper)!;
}

/// Writes `n` in base 10 into `buf` and returns the text, which shares memory with
/// `buf`. Fails with `NoSpace` when `buf` is too small.
public func itoa([]byte buf, int n) !string {
	return formatInt(buf, n, 10, false)!;
}

/// Writes `n` in base 10 into `buf` and returns the text, which shares memory with
/// `buf`. Fails with `NoSpace` when `buf` is too small.
public func utoa([]byte buf, uint n) !string {
	return formatUint(buf, n, 10, false)!;
}

func digitValue(byte c) ?int {
	if c >= '0' && c <= '9' {
		return c - '0';
	}

	return c - 'a' + 10 if c >= 'a' && c <= 'z';

	return c - 'A' + 10 if c >= 'A' && c <= 'Z';

	return null;
}

/// Parses `s` as an unsigned number in `base` (2 to 36). Letters of either case
/// are digits above 9. No sign, prefix, underscore or white space is accepted.
/// Fails with `Invalid` for an empty string, a bad base or a byte that is not a
/// digit of `base`, and with `Overflow` when the value does not fit in `uint`.
#must_use
public func parseUint(string s, int base) !uint {
	errors.ensure(base in 2..=36 && len(s) > 0, errors.Kind.Invalid)!;

	uint n = 0;
	uint b = uint(base);

	for i in 0..len(s) {
		int d = digitValue(s[i]) ?? return Error(errors.Kind.Invalid);
		errors.ensure(d < base, errors.Kind.Invalid)!;

		uint digit = uint(d);
		errors.ensure(n <= (math.MAX_UINT - digit) / b, errors.Kind.Overflow)!;

		n = n * b + digit;
	}

	return n;
}

/// Parses `s` as a signed number in `base` (2 to 36), with an optional leading `+`
/// or `-`. Otherwise it follows `parseUint`. Fails with `Invalid` for an empty
/// string, a bad base or a byte that is not a digit of `base`, and with `Overflow`
/// when the value does not fit in `int`.
#must_use
public func parseInt(string s, int base) !int {
	errors.ensure(len(s) > 0, errors.Kind.Invalid)!;

	bool neg = s[0] == '-';

	if neg || s[0] == '+' {
		s = s[1..];
	}

	uint mag = parseUint(s, base)!;

	if neg {
		uint limit = uint(-(math.MIN_INT + 1)) + 1;
		errors.ensure(mag <= limit, errors.Kind.Overflow)!;

		return math.MIN_INT if mag == limit;
		return -int(mag);
	}

	errors.ensure(mag <= uint(math.MAX_INT), errors.Kind.Overflow)!;
	return int(mag);
}

/// Parses `s` as a base 10 `int`. Same as `parseInt(s, 10)`.
public func atoi(string s) !int {
	return parseInt(s, 10)!;
}

/// Parses `s` as a base 10 `uint`. Same as `parseUint(s, 10)`.
public func atou(string s) !uint {
	return parseUint(s, 10)!;
}
