import "std/errors";
import "std/io";
import "std/math";
import "std/mem";
import "std/strings";

const {
	MaxDigits = 65;
	MaxFloat = 1400;
}

func formatUnsigned([]byte buf, uint n, int base, bool upper) !string {
	int i = 0;
	string digits = if upper => "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"
		: "0123456789abcdefghijklmnopqrstuvwxyz";

	loop n != 0 {
		uint rem = n % uint(base);
		errors.ensure(i < len(buf), errors.Kind.NoSpace)!;
		buf[i] = digits[rem];
		i += 1;
		n /= uint(base);
	}

	if i == 0 {
		errors.ensure(len(buf) > 0, errors.Kind.NoSpace)!;
		buf[i] = '0';
		i += 1;
	}

	int left = 0;
	int right = i - 1;

	loop left < right {
		byte tmp = buf[left];
		buf[left] = buf[right];
		buf[right] = tmp;

		left += 1;
		right -= 1;
	}

	return string(buf[0..i]);
}

/// Writes `n` in `base` (2 to 36) into `buf` and returns the text, which shares
/// memory with `buf`. Negative numbers get a leading `-`. Digits above 9 are
/// lowercase, or uppercase when `upper` is true. Fails with `Invalid` when `base`
/// is out of range and `NoSpace` when `buf` is too small.
func intText([]byte buf, int n, base, bool upper) !string {
	errors.ensure(base in 2..=36, errors.Kind.Invalid)!;
	if n >= 0 => return formatUnsigned(buf, uint(n), base, upper)!;
	errors.ensure(len(buf) > 1, errors.Kind.NoSpace)!;

	uint mag = uint(-(n + 1)) + 1;
	string digits = formatUnsigned(buf[1..], mag, base, upper)!;
	buf[0] = '-';
	return string(buf[0..len(digits) + 1]);
}

/// Writes `n` in `base` (2 to 36) into `buf` and returns the text, which shares
/// memory with `buf`. Digits above 9 are lowercase, or uppercase when `upper` is
/// true. Fails with `Invalid` when `base` is out of range and `NoSpace` when `buf`
/// is too small.
func uintText([]byte buf, uint n, int base, bool upper) !string {
	errors.ensure(base in 2..=36, errors.Kind.Invalid)!;
	return formatUnsigned(buf, n, base, upper)!;
}

/// Writes `n` in `base` (2 to 36) to `w`, as `intText` spells it, and returns the
/// number of bytes written. Fails with `Invalid` when `base` is out of range, and
/// with the error of `w`.
public func writeInt(io.Writer w, int n, int base, bool upper) !int {
	[MaxDigits]byte buf;
	string text = intText(buf[..], n, base, upper)!;
	io.writeString(w, text)!;
	return len(text);
}

/// Writes `n` in `base` (2 to 36) to `w`, as `uintText` spells it, and returns
/// the number of bytes written. Fails with `Invalid` when `base` is out of range,
/// and with the error of `w`.
public func writeUint(io.Writer w, uint n, int base, bool upper) !int {
	[MaxDigits]byte buf;
	string text = uintText(buf[..], n, base, upper)!;
	io.writeString(w, text)!;
	return len(text);
}

/// Returns `n` in `base` (2 to 36) as a new string made with `a`. Negative numbers
/// get a leading `-`, and digits above 9 are lowercase, or uppercase when `upper`
/// is true. The caller owns the string and gives it back with `mem.free(a, text)`.
/// Fails with `Invalid` when `base` is out of range, and with the error of `a`.
public func formatInt(mem.Allocator a, int n, int base, bool upper) !string {
	[MaxDigits]byte buf;
	return strings.clone(a, intText(buf[..], n, base, upper)!)!;
}

/// Returns `n` in `base` (2 to 36) as a new string made with `a`, as `formatInt`
/// does. Fails with `Invalid` when `base` is out of range, and with the error of
/// `a`.
public func formatUint(mem.Allocator a, uint n, int base, bool upper) !string {
	[MaxDigits]byte buf;
	return strings.clone(a, uintText(buf[..], n, base, upper)!)!;
}

/// Returns `n` in base 10 as a new string made with `a`. Same as
/// `formatInt(a, n, 10, false)`.
public inline func itoa(mem.Allocator a, int n) !string => formatInt(a, n, 10, false)!;

/// Returns `n` in base 10 as a new string made with `a`. Same as
/// `formatUint(a, n, 10, false)`.
public inline func utoa(mem.Allocator a, uint n) !string => formatUint(a, n, 10, false)!;

func digitValue(byte c) ?int {
	if c >= '0' && c <= '9' => return c - '0';

	if c >= 'a' && c <= 'z' => return c - 'a' + 10;

	if c >= 'A' && c <= 'Z' => return c - 'A' + 10;

	return null;
}

/// Parses `s` as an unsigned number in `base` (2 to 36). Letters of either case
/// are digits above 9. No sign, prefix, underscore or white space is accepted.
/// Fails with `Invalid` for an empty string, a bad base or a byte that is not a
/// digit of `base`, and with `Overflow` when the value does not fit in `uint`.
#must_use
public func parseUint(string s, int base) !uint {
	errors.ensure(base in 2..=36 && len(s) > 0, errors.Kind.Invalid)!;

	uint n = 0;
	uint b = uint(base);

	for i in 0..len(s) {
		int d = digitValue(s[i]) ?? return Error(errors.Kind.Invalid);
		errors.ensure(d < base, errors.Kind.Invalid)!;

		uint digit = uint(d);
		errors.ensure(n <= (math.MAX_UINT - digit) / b, errors.Kind.Overflow)!;

		n = n * b + digit;
	}

	return n;
}

/// Parses `s` as a signed number in `base` (2 to 36), with an optional leading `+`
/// or `-`. Otherwise it follows `parseUint`. Fails with `Invalid` for an empty
/// string, a bad base or a byte that is not a digit of `base`, and with `Overflow`
/// when the value does not fit in `int`.
#must_use
public func parseInt(string s, int base) !int {
	errors.ensure(len(s) > 0, errors.Kind.Invalid)!;

	bool neg = s[0] == '-';

	if neg || s[0] == '+' => s = s[1..];

	uint mag = parseUint(s, base)!;

	if neg {
		uint limit = uint(-(math.MIN_INT + 1)) + 1;
		errors.ensure(mag <= limit, errors.Kind.Overflow)!;

		if mag == limit => return math.MIN_INT;
		return -int(mag);
	}

	errors.ensure(mag <= uint(math.MAX_INT), errors.Kind.Overflow)!;
	return int(mag);
}

/// Parses `s` as a base 10 `int`. Same as `parseInt(s, 10)`.
public inline func atoi(string s) !int => parseInt(s, 10)!;

/// Parses `s` as a base 10 `uint`. Same as `parseUint(s, 10)`.
public inline func atou(string s) !uint => parseUint(s, 10)!;
