import "std/errors";
import "std/math";

public const {
	MaxDigits = 65;
	MaxFloat = 1400;
}

func formatUnsigned([]byte buf, uint n, int base, bool upper) !string {
    int i = 0;
    string digits = upper
        ? "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"
        : "0123456789abcdefghijklmnopqrstuvwxyz";

    loop n != 0 {
        uint rem = n % uint(base);
		errors.ensure(i < len(buf), errors.Kind.NoSpace)!;
        buf[i] = digits[rem];
        i += 1;
        n /= uint(base);
    }

    if i == 0 {
		errors.ensure(len(buf) > 0, errors.Kind.NoSpace)!;
        buf[i] = '0';
        i += 1;
    }

    int left = 0;
    int right = i - 1;

    loop left < right {
        byte tmp = buf[left];
        buf[left] = buf[right];
        buf[right] = tmp;

        left += 1;
        right -= 1;
    }

    return string(buf[0:i]);
}

public func formatInt([]byte buf, int n, base, bool upper) !string {
	errors.ensure(base in 2..36, errors.Kind.Invalid)!;
	if n >= 0 {
		return formatUnsigned(buf, uint(n), base, upper)!;
	}
	errors.ensure(len(buf) > 1, errors.Kind.NoSpace)!;

	uint mag = uint(-(n+1)) + 1;
	string digits = formatUnsigned(buf[1:], mag, base, upper)!;
	buf[0] = '-';
	return string(buf[0:len(digits)+1]);
}

public func formatUint([]byte buf, uint n, int base, bool upper) !string {
	errors.ensure(base in 2..36, errors.Kind.Invalid)!;
	return formatUnsigned(buf, n, base, upper)!;
}

public func itoa([]byte buf, int n) !string {
	return formatInt(buf, n, 10, false)!;
}

public func utoa([]byte buf, uint n) !string {
	return formatUint(buf, n, 10, false)!;
}

func digitValue(byte c) int {
	if c >= '0' && c <= '9' {
        return c - '0';
    }

    if c >= 'a' && c <= 'z' {
        return c - 'a' + 10;
    }

    if c >= 'A' && c <= 'Z' {
        return c - 'A' + 10;
    }

    return -1;
}

public func parseUint(string s, int base) !uint {
	errors.ensure(base in 2..36 && len(s) > 0, errors.Kind.Invalid)!;

	uint n = 0;
	uint b = uint(base);

	for i in 0..len(s)-1 {
		int d = digitValue(s[i]);
		errors.ensure(d in 0..base-1, errors.Kind.Invalid)!;

		uint digit = uint(d);
		errors.ensure(n <= (math.MAX_UINT - digit) / b, errors.Kind.Overflow)!;

		n = n * b + digit;
	}

	return n;
}

public func parseInt(string s, int base) !int {
	errors.ensure(len(s) > 0, errors.Kind.Invalid)!;

	bool neg = s[0] == '-';

	if neg || s[0] == '+' {
		s = s[1:];
	}

	uint mag = parseUint(s, base)!;

	if neg {
		uint limit = uint(-(math.MIN_INT + 1)) + 1;
		errors.ensure(mag <= limit, errors.Kind.Overflow)!;
		
		if mag == limit {
			return math.MIN_INT;
		}
		return -int(mag);
	}
	
	errors.ensure(mag <= uint(math.MAX_INT), errors.Kind.Overflow)!;
	return int(mag);
}

public func atoi(string s) !int {
	return parseInt(s, 10)!;
}

public func atou(string s) !uint {
	return parseUint(s, 10)!;
}
