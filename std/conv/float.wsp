import "std/errors";
import "std/io";
import "std/math";
import "std/mem";
import "std/strings";

/// Converts `x` to `int`, truncating toward zero. Fails with `Invalid` for NaN and
/// with `Overflow` when the truncated value does not fit, including infinities.
public func floatToInt(float x) !int {
	errors.ensure(!math.isNaN(x), errors.Kind.Invalid)!;
	errors.ensure(x < 9223372036854775808.0 && x >= -9223372036854775808.0, errors.Kind.Overflow)!;
	return int(x);
}

/// Converts `x` to `uint`, truncating toward zero, so values in `(-1, 0]` give 0.
/// Fails with `Invalid` for NaN and with `Overflow` when the value is negative
/// below that range or too large, including infinities.
public func floatToUint(float x) !uint {
	errors.ensure(!math.isNaN(x), errors.Kind.Invalid)!;
	errors.ensure(x > -1.0 && x < 18446744073709551616.0, errors.Kind.Overflow)!;
	return uint(x);
}

func special([]byte buf, float x) ?string {
	return string(buf[..match {
		math.isNaN(x) => strings.copy(buf, "NaN");
		math.isInf(x, 1) => strings.copy(buf, "inf");
		math.isInf(x, -1) => strings.copy(buf, "-inf");
		_ => {
			return null;
		};
	}]);
}

func layoutFixed([]byte buf, bool neg, *Decimal dec, int decimals) !string {
	int size = (if neg => 1 : 0) + math.max(1, dec.dp) + (if decimals > 0 => 1 + decimals : 0);
	errors.ensure(len(buf) >= size, errors.Kind.NoSpace)!;
	int i;
	if neg {
		buf[0] = '-';
		i++;
	}
	if dec.dp <= 0 {
		buf[i] = '0';
		i++;
	} else {
		for k in 0..dec.dp {
			buf[i] = byte(dec.digitAt(k) + '0');
			i++;
		}
	}

	if decimals > 0 {
		buf[i] = '.';
		i++;

		for k in 0..decimals {
			buf[i] = byte(dec.digitAt(dec.dp + k) + '0');
			i++;
		}
	}

	return string(buf[..size]);
}

func layoutExp([]byte buf, bool neg, *Decimal dec, int decimals, bool upper) !string {
	int exp = 0;
	if dec.n > 0 => exp = dec.dp - 1;
	int mag = if exp < 0 => -exp : exp;

	int size = (if neg => 1 : 0) + 1 + (if decimals > 0 => 1 + decimals : 0) + 2 + (if mag >= 100 => 3 : 2);
	errors.ensure(len(buf) >= size, errors.Kind.NoSpace)!;
	int i;
	if neg {
		buf[0] = '-';
		i++;
	}
	buf[i] = byte(dec.digitAt(0) + '0');
	i++;

	if decimals > 0 {
		buf[i] = '.';
		i++;

		for k in 1..=decimals {
			buf[i] = byte(dec.digitAt(k) + '0');
			i++;
		}
	}

	buf[i] = if upper => 'E' : 'e';
	i++;

	buf[i] = if exp >= 0 => '+' : '-';
	i++;

	if mag >= 100 {
		buf[i] = byte(mag / 100 + '0');
		i++;
	}
	buf[i] = byte((mag / 10) % 10 + '0');
	i++;
	buf[i] = byte(mag % 10 + '0');
	i++;

	return string(buf[..size]);
}

func shortestText([]byte buf, float x, bool single) !string {
	if special(buf, x) |view| {
		return view;
	}

	bool neg = math.signbit(x);
	Decimal dec;
	if single {
		dec.setShortest32(math.absf(float32(x)));
	} else {
		dec.setShortest(math.fabs(x));
	}

	if dec.dp - 1 in -5..=20 => return layoutFixed(buf, neg, &dec, math.max(0, dec.n - dec.dp))!;
	return layoutExp(buf, neg, &dec, dec.n - 1, false)!;
}

/// Writes the shortest decimal text of `x` that reads back as the same `float` into
/// `buf` and returns it, sharing memory with `buf`. Plain notation is used for
/// exponents from -5 to 20 and `e` notation otherwise. NaN, `inf` and `-inf` are
/// written by name, and negative zero keeps its sign. Fails with `NoSpace` when
/// `buf` is too small; `MaxFloat` bytes always suffice.
inline func floatText([]byte buf, float x) !string => shortestText(buf, x, false)!;

/// Like `floatText`, but the text is the shortest one that reads back as the same
/// `float32`, so it is shorter for values that come from single precision.
inline func float32Text([]byte buf, float32 x) !string => shortestText(buf, x, true)!;

/// Writes `x` with exactly `n` digits after the decimal point into `buf` and
/// returns the text, sharing memory with `buf`. The value is rounded from its exact
/// decimal expansion, with exact ties going to the even digit. With `n` of zero no
/// point is written. NaN, `inf` and `-inf` are written by name. Fails with
/// `NoSpace` when `buf` is too small.
func fixedText([]byte buf, float x, int n) !string {
	if special(buf, x) |view| {
		return view;
	}

	bool neg = math.signbit(x);
	Decimal dec;
	dec.setFixed(math.fabs(x), n);

	return layoutFixed(buf, neg, &dec, n)!;
}

/// Writes `x` in `e` notation with `n` digits after the decimal point, such as
/// `1.50e+03`, into `buf` and returns the text, sharing memory with `buf`. The
/// exponent has at least two digits and `E` replaces `e` when `upper` is true. The
/// value is rounded from its exact decimal expansion, with exact ties going to the
/// even digit. NaN, `inf` and `-inf` are written by name. Fails with `NoSpace` when
/// `buf` is too small.
func expText([]byte buf, float x, int n, bool upper) !string {
	if special(buf, x) |view| {
		return view;
	}

	bool neg = math.signbit(x);
	Decimal dec;
	dec.setSignificant(math.fabs(x), n + 1);

	return layoutExp(buf, neg, &dec, n, upper)!;
}

/// Writes the shortest text of `x`, as `floatText` spells it, to `w` and returns
/// the number of bytes written. Fails with the error of `w`.
public func writeFloat(io.Writer w, float x) !int {
	[MaxFloat]byte buf;
	string text = floatText(buf[..], x)!;
	io.writeString(w, text)!;
	return len(text);
}

/// Writes the shortest text of `x` that reads back as the same `float32` to `w`
/// and returns the number of bytes written. Fails with the error of `w`.
public func writeFloat32(io.Writer w, float32 x) !int {
	[MaxFloat]byte buf;
	string text = float32Text(buf[..], x)!;
	io.writeString(w, text)!;
	return len(text);
}

/// Writes `x` with `n` digits after the point, as `fixedText` spells it, to `w`
/// and returns the number of bytes written. Fails with the error of `w`.
public func writeFixed(io.Writer w, float x, int n) !int {
	[MaxFloat]byte buf;
	string text = fixedText(buf[..], x, n)!;
	io.writeString(w, text)!;
	return len(text);
}

/// Writes `x` in `e` notation with `n` digits after the point, as `expText`
/// spells it, to `w` and returns the number of bytes written. Fails with the error
/// of `w`.
public func writeExp(io.Writer w, float x, int n, bool upper) !int {
	[MaxFloat]byte buf;
	string text = expText(buf[..], x, n, upper)!;
	io.writeString(w, text)!;
	return len(text);
}

/// Returns `x` with exactly `n` digits after the point as a new string made with
/// `a`, as `writeFixed` spells it. The caller owns it and gives it back with
/// `mem.free(a, text)`. Fails with the error of `a`.
public func formatFixed(mem.Allocator a, float x, int n) !string {
	[MaxFloat]byte buf;
	return strings.clone(a, fixedText(buf[..], x, n)!)!;
}

/// Returns `x` in `e` notation with `n` digits after the point as a new string made
/// with `a`, as `writeExp` spells it. The caller owns it and gives it back with
/// `mem.free(a, text)`. Fails with the error of `a`.
public func formatExp(mem.Allocator a, float x, int n, bool upper) !string {
	[MaxFloat]byte buf;
	return strings.clone(a, expText(buf[..], x, n, upper)!)!;
}

/// Returns `x` as the shortest text that reads back as the same `float`, in a new
/// string made with `a`. The caller owns it and gives it back with `mem.free(a,
/// text)`. Fails with the error of `a`.
public func ftoa(mem.Allocator a, float x) !string {
	[MaxFloat]byte buf;
	return strings.clone(a, floatText(buf[..], x)!)!;
}

/// Like `ftoa`, but the text is the shortest one that reads back as the same
/// `float32`.
public func ftoa32(mem.Allocator a, float32 x) !string {
	[MaxFloat]byte buf;
	return strings.clone(a, float32Text(buf[..], x)!)!;
}

func lowerByte(byte c) byte => if c >= 'A' && c <= 'Z' => c + 32 : c;

func sameWord(string s, string word) bool {
	if len(s) != len(word) => return false;
	for i in 0..len(s) {
		if lowerByte(s[i]) != word[i] => return false;
	}
	return true;
}

func parseWith(string s, int mantBits, expBits, bias) !float {
	errors.ensure(len(s) > 0, errors.Kind.Invalid)!;
	int i = 0;
	bool neg = false;
	if s[0] == '-' || s[0] == '+' {
		neg = s[0] == '-';
		i = 1;
	}
	string rest = s[i..];
	if sameWord(rest, "inf") || sameWord(rest, "infinity") => return math.inf(if neg => -1 : 1);
	if sameWord(rest, "nan") => return math.nan();

	Decimal dec;
	int nd = 0;
	int dp = 0;
	bool sawDot = false;
	bool sawDigits = false;
	bool trunc = false;
	loop i < len(s) {
		byte c = s[i];
		if c == '.' {
			errors.ensure(!sawDot, errors.Kind.Invalid)!;
			sawDot = true;
			dp = nd;
			i++;
			continue;
		}
		if c < '0' || c > '9' => break;
		sawDigits = true;
		i++;
		if c == '0' && nd == 0 {
			dp--;
			continue;
		}
		nd++;
		if dec.n < 760 {
			dec.load(uint(c - '0'));
		} else if c != '0' {
			trunc = true;
		}
	}
	errors.ensure(sawDigits, errors.Kind.Invalid)!;
	if !sawDot => dp = nd;

	if i < len(s) && (s[i] == 'e' || s[i] == 'E') {
		i++;
		errors.ensure(i < len(s), errors.Kind.Invalid)!;
		int sign = 1;
		if s[i] == '-' || s[i] == '+' {
			sign = if s[i] == '-' => -1 : 1;
			i++;
		}
		errors.ensure(i < len(s) && s[i] >= '0' && s[i] <= '9', errors.Kind.Invalid)!;
		int e = 0;
		loop i < len(s) && s[i] >= '0' && s[i] <= '9' {
			if e < 10000 => e = e * 10 + int(s[i] - '0');
			i++;
		}
		dp += sign * e;
	}
	errors.ensure(i == len(s), errors.Kind.Invalid)!;

	float zero = if neg => math.copysign(0.0, -1.0) : 0.0;
	if nd == 0 => return zero;

	if trunc && dec.d[dec.n - 1] == 0 => dec.d[dec.n - 1] = 1;
	dec.dp = dp;
	dec.trim();
	float value = dec.toFloat(mantBits, expBits, bias)!;
	return if neg => -value : value;
}

/// Parses `s` as a `float`: an optional sign, digits with at most one point, and
/// an optional exponent (`e` or `E`, a sign, digits), or `inf`, `infinity` or `nan`
/// in any case. The result is the `float` nearest to the decimal value, exactly,
/// with ties going to the even one. Underscores, white space, prefixes and a bare
/// `.` are not accepted. Fails with `Invalid` for text that is not a number and
/// with `Overflow` when the value is too large for a `float`; a value too small
/// rounds to zero.
#must_use
public func parseFloat(string s) !float {
	return parseWith(s, 52, 11, -1023)!;
}

/// Like `parseFloat`, but the result is the `float32` nearest to the value, with
/// `Overflow` when it is too large for a `float32`.
#must_use
public func parseFloat32(string s) !float32 {
	return float32(parseWith(s, 23, 8, -127)!);
}
