import "std/errors";
import "std/math";

struct Decimal {
	[1100]uint d;
	int n, dp;
}

func (*Decimal dec) load(uint digit) {
	dec.d[dec.n] = digit;
	dec.n++;
}

func (*Decimal dec) trim() {
	loop dec.n > 1 && dec.d[dec.n - 1] == 0 {
		dec.n--;
	}
}

func (*Decimal dec) setUint(uint m) {
	dec.n = 0;

	uint tmp = m;
	int counter;

	loop tmp != 0 {
		counter++;
		tmp /= 10;
	}

	if counter == 0 {
		dec.load(0);
		dec.dp = 1;
		return;
	}

	uint divisor = 1;
	loop counter > 1 {
		divisor *= 10;
		counter--;
	}

	loop divisor != 0 {
		uint digit = m / divisor;
		dec.load(digit);

		m %= divisor;
		divisor /= 10;
	}

	dec.dp = dec.n;
	dec.trim();
}

func (*Decimal dec) shiftLeft() {
	uint carry;
	for i in (dec.n - 1..=0).step(-1) {
		uint cur = dec.d[i] * 2 + carry;
		dec.d[i] = cur % 10;
		carry = cur / 10;
	}

	if carry != 0 {
		for i in (dec.n - 1..=0).step(-1) {
			dec.d[i + 1] = dec.d[i];
		}
		dec.n++;
		dec.dp++;
		dec.d[0] = carry;
	}

	dec.trim();
}

func (*Decimal dec) shiftRight() {
	uint carry;
	int write;

	for i in 0..dec.n {
		uint cur = carry * 10 + dec.d[i];
		dec.d[i] = cur / 2;
		carry = cur % 2;
		write++;
	}

	dec.n = write;

	if carry != 0 {
		dec.load(5);
	}

	if dec.d[0] == 0 && dec.n > 1 {
		for i in 1..dec.n {
			dec.d[i - 1] = dec.d[i];
		}

		dec.n--;
		dec.dp--;
	}

	dec.trim();
}

func (*Decimal dec) assign(uint m, int e) {
	dec.setUint(m);
	for e {
		dec.shiftLeft();
	}
	for -e {
		dec.shiftRight();
	}
}

func (*Decimal dec) shouldRoundUp(int nd) bool {
	if nd < 0 || nd >= dec.n {
		return false;
	}

	uint d = dec.d[nd];
	return nd == 0 ? false : dec.d[nd - 1] % 2 == 1 if d == 5 && nd + 1 == dec.n;

	return d >= 5;
}

func (*Decimal dec) roundDown(int nd) {
	dec.n = nd;
	dec.trim();
}

func (*Decimal dec) roundUp(int nd) {
	if nd > 0 {
		for i in (nd - 1..=0).step(-1) {
			if dec.d[i] < 9 {
				dec.d[i]++;
				dec.n = i + 1;
				return;
			}
		}
	}

	dec.d[0] = 1;
	dec.n = 1;
	dec.dp++;
}

func (*Decimal dec) round(int nd) {
	if nd < 0 || nd >= dec.n {
		return;
	}

	if dec.shouldRoundUp(nd) {
		dec.roundUp(nd);
	} else {
		dec.roundDown(nd);
	}
}

inline func (*Decimal dec) digitAt(int i) uint => i < 0 || i >= dec.n ? 0 : dec.d[i];

func (*Decimal dec) roundShortest(*Decimal lower, upper, bool inclusive) {
	int upperDelta;
	for ui in 0..=dec.n {
		int mi = ui - upper.dp + dec.dp;
		break if mi >= dec.n;
		int li = ui - upper.dp + lower.dp;

		uint l = lower.digitAt(li);
		uint m = dec.digitAt(mi);
		uint u = upper.digitAt(ui);

		bool okdown = l != m || (inclusive && li + 1 == lower.n);
		switch {
			case upperDelta == 0 && m + 1 < u, upperDelta == 1 && (m != 9 || u != 0) => upperDelta = 2;
			case upperDelta == 0 && m != u => upperDelta = 1;
		}
		bool okup = upperDelta > 0 && (inclusive || upperDelta > 1 || ui + 1 < upper.n);

		switch {
			case okdown && okup => {
				dec.round(mi + 1);
				return;
			}
			case okdown => {
				dec.roundDown(mi + 1);
				return;
			}
			case okup => {
				dec.roundUp(mi + 1);
				return;
			}
		}
	}
}

func (*Decimal dec) shortest(uint mant, int exp, uint hidden, int minExp) {
	dec.assign(mant, exp);

	uint m = 1;
	if mant == hidden && exp > minExp {
		m = 2;
	}

	Decimal upper, lower;
	upper.assign(m * 2 * mant + m, exp - int(m));
	lower.assign(m * 2 * mant - 1, exp - int(m));

	dec.roundShortest(&lower, &upper, mant % 2 == 0);
}

func (*Decimal dec) setShortest(float x) {
	let mant, exp = math.decompose(x);
	if mant == 0 {
		dec.n = 0;
		dec.dp = 0;
		return;
	}
	dec.shortest(mant, exp, 1 << 52, -1074);
}

func (*Decimal dec) setShortest32(float32 x) {
	let mant, exp = math.decompose(x);
	if mant == 0 {
		dec.n = 0;
		dec.dp = 0;
		return;
	}

	int e24 = math.max(exp + 29, -149);
	uint m24 = mant >> (e24 - exp);

	dec.shortest(m24, e24, 1 << 23, -149);
}

func (*Decimal dec) setFixed(float x, int n) {
	let mant, exp = math.decompose(x);
	if mant == 0 {
		dec.n = 0;
		dec.dp = 0;
		return;
	}
	dec.assign(mant, exp);
	if dec.dp + n < 0 {
		dec.n = 0;
		dec.dp = 0;
		return;
	}
	dec.round(dec.dp + n);
}

func (*Decimal dec) setSignificant(float x, int nd) {
	let mant, exp = math.decompose(x);
	if mant == 0 {
		dec.n = 0;
		dec.dp = 0;
		return;
	}
	dec.assign(mant, exp);
	dec.round(nd);
}

const DIGIT_LIMIT = 1000;

func (*Decimal dec) limit() {
	if dec.n > DIGIT_LIMIT {
		dec.n = DIGIT_LIMIT;
		if dec.d[DIGIT_LIMIT - 1] == 0 {
			dec.d[DIGIT_LIMIT - 1] = 1;
		}
	}
}

func (*Decimal dec) shift(int k) {
	for k {
		dec.shiftLeft();
		dec.limit();
	}
	for -k {
		dec.shiftRight();
		dec.limit();
	}
}

func (*Decimal dec) rounded() uint {
	return 0xFFFFFFFFFFFFFFFF if dec.dp > 20;
	uint n = 0;
	for i in 0..dec.dp {
		n *= 10;
		if i < dec.n {
			n += dec.d[i];
		}
	}
	if dec.dp >= 0 && dec.shouldRoundUp(dec.dp) {
		n++;
	}
	return n;
}

func (*Decimal dec) toFloat(int mantBits, expBits, bias) !float {
	return 0.0 if dec.n == 0;
	int top = (1 << expBits) - 1;
	errors.ensure(dec.dp <= 310, errors.Kind.Overflow)!;
	return 0.0 if dec.dp < -330;

	[9]int table = .{1, 3, 6, 9, 13, 16, 19, 23, 26};
	int exp = 0;
	loop dec.dp > 0 {
		int n = dec.dp >= len(table) ? 27 : table[dec.dp];
		dec.shift(-n);
		exp += n;
	}
	loop dec.dp < 0 || dec.dp == 0 && dec.d[0] < 5 {
		int n = -dec.dp >= len(table) ? 27 : table[-dec.dp];
		dec.shift(n);
		exp -= n;
	}
	exp--;
	if exp < bias + 1 {
		int n = bias + 1 - exp;
		dec.shift(-n);
		exp += n;
	}
	errors.ensure(exp - bias < top, errors.Kind.Overflow)!;

	dec.shift(1 + mantBits);
	uint mant = dec.rounded();
	if mant == uint(2 << mantBits) {
		mant >>= 1;
		exp++;
		errors.ensure(exp - bias < top, errors.Kind.Overflow)!;
	}
	if (mant & uint(1 << mantBits)) == 0 {
		exp = bias;
	}
	int biased = exp - bias;
	return math.ldexp(float(mant), (biased == 0 ? 1 : biased) + bias - mantBits);
}
