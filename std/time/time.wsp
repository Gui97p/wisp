import "std/errors";
import "std/sys";

inline func toNs(int s, ns) int => s * 1_000_000_000 + ns;

/// Returns the wall clock time, in nanoseconds since the Unix epoch. It can jump
/// if the clock of the system is changed, so use `ticks` to measure durations.
public func now() int {
	int s, ns = sys.time(sys.CLOCK_REALTIME);
	return toNs(s, ns);
}

/// Returns a monotonic time in nanoseconds. Only differences between two calls
/// mean anything, and it never goes back.
public func ticks() int {
	int s, ns = sys.time(sys.CLOCK_MONOTONIC);
	return toNs(s, ns);
}

/// Blocks the program for `d`. A zero or negative duration returns at once.
/// Fails with `Interrupted` if a signal ends the wait early.
public func sleep(Duration d) ! {
	if d <= 0 => return;
	int r = sys.sleep(int(d / Second), int(d % Second));
	if r < 0 => return Error(errors.Kind.Interrupted);
}

/// Measures how long something takes, on the monotonic clock. Make one with
/// `stopwatch`, which starts it; a `Stopwatch` declared without it counts from an
/// arbitrary moment.
public struct Stopwatch {
	int began;
}

/// Returns a stopwatch that starts now.
public inline func stopwatch() Stopwatch => .{began: ticks()};

/// The time since the stopwatch started or was last reset.
public inline func (*Stopwatch s) elapsed() Duration => Duration(ticks() - s.began);

/// Starts counting again from now.
public func (*Stopwatch s) reset() {
	s.began = ticks();
}

/// Returns the time since the stopwatch started or was last reset, and starts
/// counting again from the same instant, so laps add up to the whole time.
public func (*Stopwatch s) lap() Duration {
	int now = ticks();
	Duration took = Duration(now - s.began);
	s.began = now;
	return took;
}
