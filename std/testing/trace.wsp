#target x64

native<debug> siteOf(*void f) string s {
	extern __wisp_site;
	mov rdi, f;
	call __wisp_site;
	mov s.ptr, rax;
	mov s.len, rdx;
}

native<debug> parent(*void f) *void g {
	mov rax, f;
	mov rax, [rax];
	mov g, rax;
}

func<debug> callerSite(*void f) string {
	string first = siteOf(f);
	*void at = f;
	loop true {
		string s = siteOf(at);
		return first if len(s) <= 0;
		if len(s) < 4 || s[:4] != "std/" {
			return s;
		}
		at = parent(at);
	}
	return first;
}

public inline func site() string {
	return "";
}

public func<debug> site() string {
	?*void f;
	native {
		mov rax, [rbp];
		mov f, rax;
	}
	return callerSite(f!!);
}
