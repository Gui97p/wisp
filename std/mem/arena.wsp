#target x64

import "std/errors";
import "std/math";
import "std/mem";

const {
	HEADER = 32;
	ARENA_CHUNK_SIZE = 64 * 1024;
}

struct Chunk {
	?*Chunk next;
	int size;
	int used;
}

inline func (*Chunk c) data() *byte {
	return (*byte)(c) + HEADER;
}

func newChunk(mem.Allocator source, int need) !*Chunk {
	int size = math.max(ARENA_CHUNK_SIZE - HEADER, need);
	*Chunk p = source.allocDirty(HEADER + size)!;
	p.size = size;
	p.used = 0;
	p.next = null;
	return p;
}

/// A position in an `Arena`, taken with `mark` and given back to `rewind`. It is
/// only valid for the arena that made it, and only while that arena has not been
/// rewound or reset past it.
public struct Mark {
	internal ?*Chunk chunk;
	internal int used;
}

/// An allocator that hands out memory in a row and frees it all at once. Blocks
/// are 16-byte aligned and are never freed one by one. The memory comes in chunks
/// of 64 KiB (more for a bigger request) from `parent`, or from `mem.heap` when
/// `parent` is null. An arena needs no setup: the zero value is empty and ready.
/// Call `release` when done with it, or the chunks stay allocated.
public struct Arena implements mem.Allocator {
	?mem.Allocator parent;
	internal ?*Chunk head;
}

func (*Arena a) source() mem.Allocator {
	return a.parent ?? mem.heap;
}

/// Allocates `n` zeroed bytes in the arena. Fails with `Invalid` for a negative
/// `n` and with the error of the parent when it cannot give a new chunk.
public func (*Arena a) alloc(int n) !*void {
	*byte p = a.allocDirty(n)!;
	mem.fill(p, 0, n);
	return p;
}

/// Allocates `n` bytes in the arena without clearing them, rounded up to 16.
/// Fails with `Invalid` for a negative `n` and with the error of the parent when
/// it cannot give a new chunk. A request bigger than a chunk gets a chunk of its
/// own.
public func (*Arena a) allocDirty(int n) !*void {
	errors.ensure(n >= 0, errors.Kind.Invalid)!;
	n = (n + 15) & ~15;
	errors.ensure(n >= 0, errors.Kind.Invalid)!;
	if a.head |head| {
		if head.used + n <= head.size {
			defer head.used += n;
			return head.data() + head.used;
		}
	}
	*Chunk p = newChunk(a.source(), n)!;
	if n <= ARENA_CHUNK_SIZE - HEADER {
		p.next = a.head;
		a.head = p;
	} else {
		if a.head |head| {
			p.next = head.next;
			head.next = p;
		} else {
			a.head = p;
		}
	}
	p.used = n;
	return p.data();
}

/// Returns every chunk to the parent. All blocks of the arena become invalid. The
/// arena is empty afterwards and can be used again.
public func (*Arena a) release() {
	mem.Allocator source = a.source();
	?*Chunk c = a.head;
	loop c |chunk| {
		?*Chunk next = chunk.next;
		source.free(chunk);
		c = next;
	}
	a.head = null;
}

/// Does nothing: an arena frees all at once, with `reset`, `rewind` or `release`.
public func (*Arena) free(?*void _p) {}

/// Forgets every block and keeps the newest chunk for reuse; the others go back
/// to the parent. Pointers from before the reset are invalid, and the memory is
/// not cleared.
public func (*Arena a) reset() {
	mem.Allocator source = a.source();
	if a.head |head| {
		?*Chunk c = head.next;
		loop c |chunk| {
			?*Chunk next = chunk.next;
			source.free(chunk);
			c = next;
		}
		head.next = null;
		head.used = 0;
	}
}

/// Remembers the current position of the arena, to go back to it with `rewind`.
public inline func (*Arena a) mark() Mark {
	int used;
	if a.head |head| {
		used = head.used;
	}
	return Mark{chunk: a.head, used: used};
}

/// Frees everything allocated after `m` was taken, returning the extra chunks to
/// the parent. Blocks allocated after the mark are invalid. A mark taken from an
/// empty arena empties it, but keeps no chunk.
public func (*Arena a) rewind(Mark m) {
	mem.Allocator source = a.source();
	?*Chunk c = a.head;
	loop c |chunk| {
		break if c == m.chunk;
		?*Chunk next = chunk.next;
		source.free(chunk);
		c = next;
	}
	a.head = m.chunk;
	if m.chunk |kept| {
		kept.used = m.used;
	}
}

/// Resizes a block. The block of the last allocation grows or shrinks in place;
/// any other block is copied to a new one, and the old one stays in the arena
/// unused. Bytes past `old` are zeroed. Fails with `Invalid` for a negative size.
public func (*Arena a) realloc(?*void p, int old, int n) !*void {
	errors.ensure(old >= 0 && n >= 0, errors.Kind.Invalid)!;
	*void block = p ?? return a.alloc(n)!;
	int was = (old + 15) & ~15;
	int want = (n + 15) & ~15;
	if a.head |head| {
		if (*byte)(block) + was == head.data() + head.used && head.used - was + want <= head.size {
			head.used = head.used - was + want;
			if n > old {
				mem.fill((*byte)(block) + old, 0, n - old);
			}
			return block;
		}
	}
	*void next = a.alloc(n)!;
	mem.copy(next, block, math.min(old, n));
	return next;
}
