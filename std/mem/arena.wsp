#target x64

import "std/math";
import "std/mem";
import "std/errors";

const {
	HEADER = 32;
	ARENA_CHUNK_SIZE = 64 * 1024;
} 

struct Chunk {
	?*Chunk next;
	int size;
	int used;
}

inline func (*Chunk c) data() *byte {
	return (*byte)(c) + HEADER;
}

func newChunk(int need) !*Chunk {
	int size = math.max(ARENA_CHUNK_SIZE - HEADER, need);
	*Chunk p = mem.allocDirty(HEADER + size)!;
	p.size = size;
	p.used = 0;
	p.next = null;
	return p;
}

public struct Mark {
	internal ?*Chunk chunk;
	internal int used;
}

public struct Arena {
	internal ?*Chunk head;
}

public func (*Arena a) alloc(int n) !*void {
	*byte p = a.allocDirty(n)!;
	mem.fill(p, 0, n);
	return p;
}

public func (*Arena a) allocDirty(int n) !*void {
	errors.ensure(n >= 0, errors.Kind.Invalid)!;
	n = (n + 15) & ~15;
	errors.ensure(n >= 0, errors.Kind.Invalid)!;
	if a.head |head| {
		if head.used + n <= head.size {
			defer head.used += n;
			return head.data() + head.used;
		}
	}
	*Chunk p = newChunk(n)!;
	if n <= ARENA_CHUNK_SIZE - HEADER {
		p.next = a.head;
		a.head = p;
	} else {
		if a.head |head| {
			p.next = head.next;
			head.next = p;
		} else {
			a.head = p;
		}
	}
	p.used = n;
	return p.data();
}

public func (*Arena a) free() {
	?*Chunk c = a.head;
	loop c |chunk| {
		?*Chunk next = chunk.next;
		mem.free(chunk);
		c = next;
	}
	a.head = null;
}

public func (*Arena a) reset() {
	if a.head |head| {
		?*Chunk c = head.next;
		loop c |chunk| {
			?*Chunk next = chunk.next;
			mem.free(chunk);
			c = next;
		}
		head.next = null;
		head.used = 0;
	}
}

public inline func (*Arena a) mark() Mark {
	int used;
	if a.head |head| {
		used = head.used;
	}
	return Mark{chunk: a.head, used: used};
}

public func (*Arena a) rewind(Mark m) {
	?*Chunk c = a.head;
	loop c |chunk| {
		if c == m.chunk {
			break;
		}
		?*Chunk next = chunk.next;
		mem.free(chunk);
		c = next;
	}
	a.head = m.chunk;
	if m.chunk |kept| {
		kept.used = m.used;
	}
}
