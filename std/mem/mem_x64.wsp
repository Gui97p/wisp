import "std/sys";

func leadingZeros(uint x) uint {
	if x == 0 {
		return 64;
	}

	uint n;
	loop (x & 0x8000000000000000) == 0 {
		x <<= 1;
		n++;
	}
	return n;
}

struct Class { *void head; }
Class[11] classes;
*char cur, end;

const {
	HEAD_SIZE = 16;
	MIN_BLOCK = 32;
	LOW_LIMIT = 32768;
	CHUNK_SIZE = 1048576;
	PAGE_SIZE = 4096;
	MAX_ALLOC = 1 << 47;
	uint LIVE = 0x57495350414C4956;
	uint DEAD = 0x5749535044454144;
}

func header(*void p) int {
	return (*int)((*char)(p) - 16)@;
}

func setHeader(*void p, int v) {
	(*int)((*char)(p)-16)@ = v;
}

func state(*void p) uint {
	return (*uint)((*char)(p) - 8)@;
}

func setState(*void p, uint v) {
	(*uint)((*char)(p)-8)@ = v;
}

func classOf(int total) int {
	int bits = int(64 - leadingZeros(uint(total - 1)));
	return (bits > 5 ? bits : 5) - 5;
}

func failed(*void r) bool {
	return int(r) in -4095..-1;
}

internal func rawAllocate(int n, bool zero) *void {
	if n < 0 || n > MAX_ALLOC {
		return null;
	}

	int total = n + HEAD_SIZE;
	if total <= LOW_LIMIT {
		int class = classOf(total);
		int size = MIN_BLOCK << class;
		if classes[class].head != null {
			*void p = classes[class].head;
			classes[class].head = ((**void)(p))@;
			if zero {
				rawSet(p, 0, size - HEAD_SIZE);
			}
			setState(p, LIVE);
			return p;
		}
		if cur + size > end {
			*void chunk = sys.mmap(CHUNK_SIZE);
			if failed(chunk) {
				return null;
			}
			cur = chunk;
			end = (*char)(chunk) + CHUNK_SIZE;
		}
		*void p = cur;
		cur += size;
		*void head = (*char)(p) + 16;
		setHeader(head, class);
		setState(head, LIVE);
		return head;
	}

	int mapped = (total + (PAGE_SIZE-1)) / PAGE_SIZE  * PAGE_SIZE;
	*void p = sys.mmap(mapped);
	if failed(p) {
		return null;
	}
	*void head = (*char)(p) + 16;
	setHeader(head, mapped);
	setState(head, LIVE);
	return head;
}

internal func rawFree(*void p) {
	if p == null {
		return;
	}

	switch state(p) {
		case DEAD:
			panic("double free");
		case LIVE:
			setState(p, DEAD);
		default:
			panic("free of an invalid pointer");
	}

	int h = header(p);
	if h < 11 {
		((**void)(p))@ = classes[h].head;
		classes[h].head = p;
	} else {
		sys.munmap((*char)(p)-16, h);
	}
}

internal func rawRealloc(*void p, int n) *void {
	if p == null {
		return rawAllocate(n, true);
	}
	
	int h = header(p);
	int cap = (h < 11 ? (MIN_BLOCK << h) : h) - 16;
	if n <= cap {
		return p;
	}

	*void np = rawAllocate(n, true);
	if np == null {
		return null;
	}
	rawCopy(np, p, cap);
	rawFree(p);
	return np;
}

internal func rawCopy(*void dst, src, int n) {
	native x64(in dst, src, n) "mov rdi, {dst}; mov rsi, {src}; mov rcx, {n}; rep movsb";
}

internal func rawCopyBackward(*void dst, src, int n) {
	native x64(in dst, src, n) "mov rdi, {dst}; add rdi, {n}; dec rdi; mov rsi, {src}; add rsi, {n}; dec rsi; mov rcx, {n}; std; rep movsb; cld";
}

internal func rawSet(*void dst, char value, int n) {
	native x64(in dst, value, n) "mov rdi, {dst}; mov al, {value}; mov rcx, {n}; rep stosb";
}
