#target x64

native<debug> siteOf(*void f) string s {
	extern __wisp_site;
	mov rdi, f;
	call __wisp_site;
	mov s.ptr, rax;
	mov s.len, rdx;
}

native<debug> parent(*void f) *void g {
	mov rax, f;
	mov rax, [rax];
	mov g, rax;
}

func<debug> callerSite(*void f) string {
	string first = siteOf(f);
	*void at = f;
	loop true {
		string s = siteOf(at);
		if len(s) <= 0 => return first;
		if len(s) < 4 || s[..4] != "std/" => return s;
		at = parent(at);
	}
	return first;
}

func<debug> site() string {
	?*void f;
	native {
		mov rax, [rbp];
		mov f, rax;
	}
	return callerSite(f?);
}

native rawCopy(*void dst, src, int n) {
	mov rdi, dst;
	mov rsi, src;
	mov rcx, n;
	rep movsb;
}

native rawCopyBackward(*void dst, src, int n) {
	mov rdi, dst;
	add rdi, n;
	dec rdi;
	mov rsi, src;
	add rsi, n;
	dec rsi;
	mov rcx, n;
	std;
	rep movsb;
	cld;
}

native rawSet(*void dst, byte value, int n) {
	mov rdi, dst;
	mov al, value;
	mov rcx, n;
	rep stosb;
}
