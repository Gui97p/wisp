#target x64

import "std/sys";
import<debug> "std/strings";
import<debug> "std/fmt";

func leadingZeros(uint x) uint {
	if x == 0 {
		return 64;
	}

	uint n;
	loop (x & 0x8000000000000000) == 0 {
		x <<= 1;
		n++;
	}
	return n;
}

[11]*void classes;
*byte cur, end;

var<debug> [1024]*void ring;
var<debug> int ringStart, ringCount;

struct<debug> Entry { *void block; string site, freed; }
var<debug> *Entry table;

const {
	HEAD_SIZE = 16;
	MIN_BLOCK = 32;
	LOW_LIMIT = 32768;
	CHUNK_SIZE = 1048576;
	PAGE_SIZE = 4096;
	MAX_ALLOC = 1 << 47;
	SLOTS = 65536;
	uint LIVE = 0x57495350414C4956;
	uint DEAD = 0x5749535044454144;
}

inline func header(*void p) int {
	return (*int)((*byte)(p) - 16)@;
}

inline func setHeader(*void p, int v) {
	(*int)((*byte)(p)-16)@ = v;
}

inline func state(*void p) uint {
	return (*uint)((*byte)(p) - 8)@;
}

inline func setState(*void p, uint v) {
	(*uint)((*byte)(p)-8)@ = v;
}

inline func classOf(int total) int {
	int bits = int(64 - leadingZeros(uint(total - 1)));
	return (bits > 5 ? bits : 5) - 5;
}

inline func failed(*void r) bool {
	return int(r) in -4095..-1;
}

func<debug> report() {
	if table == null {
		return;
	}

	[64]string sites;
	[64]int counts, bytes;
	int groups, others;

	for i in 0..SLOTS-1 {
		*Entry entry = &table[i];
		if entry.block == null || entry.block == (*void)(1) || state(entry.block) != LIVE {
			continue;
		}

		int h = header(entry.block);
		int size = (h < 11 ? (MIN_BLOCK << h) : h) - 16;

		int j;
		loop j < groups && sites[j] != entry.site {
			j++;
		}
		if j == groups {
			if groups == len(sites) {
				others++;
				continue;
			}
			sites[j] = entry.site;
			groups++;
		}
		counts[j]++;
		bytes[j] += size;
	}

	if groups == 0 && others == 0 {
		return;
	}

	int k;
	loop k < groups {
		fmt.fprintf(2, "leak: {} blocks, {} bytes, allocated at\n", counts[k], bytes[k])!!;
		fmt.fprint(2, sites[k]);
		k++;
	}

	if others > 0 {
		fmt.fprintf(2, "leak: {} more blocks from other places\n", others)!!;
	}
}

func<debug> checkPoison(*void p, int cap) {
	for i in 0..cap-1 {
		if (*uint8)(p)[i] != 0xDD {
			fail(p, "use after free");
		}
	}
}

func<debug> quarantine(*void p, int h) {
	int cap = (MIN_BLOCK << h) - 16;
	rawSet(p, 0xDD, cap);
	if ringCount == len(ring) {
		*void old = ring[ringStart];
		int hOld = header(old);
		int capOld = (MIN_BLOCK << hOld) - 16;
		checkPoison(old, capOld);
		((**void)(old))@ = classes[hOld];
		classes[hOld] = old;
		forget(old);
		ringStart = (ringStart + 1) % 1024;
		ringCount--;
	}
	ring[(ringStart + ringCount) % 1024] = p;
	ringCount++;
}

func<debug> find(*void p) int {
	if table == null {
		return -1;
	}

	int slot = (int(p) >> 4) % SLOTS;
	for i in 0..SLOTS-1 {
		int at = (slot + i) % SLOTS;
		*void block = table[at].block;
		if block == null {
			return -1;
		}
		if block == p {
			return at;
		}
	}
	return -1;
}

func<debug> remember(*void p, string site) {
	if table == null {
		table = sys.mmap(SLOTS * sizeof(Entry));
	}

	forget(p);
	int slot = (int(p) >> 4) % SLOTS;
	for i in 0..SLOTS-1 {
		int at = (slot + i) % SLOTS;
		*Entry entry = &table[at];
		if entry.block == null || entry.block == (*void)(1) {
			entry.block = p;
			entry.site = site;
			break;
		}
	}
}

inline func forget(*void _p) {}
func<debug> forget(*void p) {
	int i = find(p);
	if i >= 0 {
		table[i].block = (*void)(1);
	}
}

inline func<debug> entryOf(*void p) *Entry {
	int i = find(p);
	return i >= 0 ? &table[i] : null;
}

inline func fail(*void _p, string what) {
	panic(what);
}
func<debug> fail(*void p, string what) {
	[2048]byte buf;
	*Entry entry = entryOf(p);
	if entry != null && len(entry.site) > 0 {
		if len(entry.freed) > 0 {
			string both = strings.concat(buf, what, "\nthe block was allocated at ", entry.site, "the block was freed at ", entry.freed[:len(entry.freed)-1]) ?? what;
			panic(both);
        }
        string text = strings.concat(buf, what, "\nthe block was allocated at ", entry.site[:len(entry.site)-1]) ?? what;
        panic(text);
	}
	panic(what);
}

native<debug> setExitHook(() => () hook) => "extern __wisp_exit_hook; mov rax, {hook}; mov [rel __wisp_exit_hook], rax";

let<debug> hookPending = true;
internal inline func track(*void _p) {}
internal func<debug> track(*void p) {
	if hookPending {
		setExitHook(report);
		hookPending = false;
	}
	if p == null {
		return;
	}
	*void f;
	native(out f) "mov rax, [rbp]; mov {f}, rax";
	string site = callerSite(f);
	if len(site) <= 0 {
		site = "";
	}
	remember(p, site);
}

internal inline func trackFree(*void _p) {}
internal func<debug> trackFree(*void p) {
    if p == null || state(p) != LIVE {
        return;
    }
    *void f;
    native(out f) "mov rax, [rbp]; mov {f}, rax";
    int i = find(p);
	if i >= 0 {
		table[i].freed = callerSite(f);
	}
}

native<debug> siteOf(*void f) string s => "extern __wisp_site; mov rdi, {f}; call __wisp_site; mov {s.ptr}, rax; mov {s.len}, rdx";
native<debug> parent(*void f) *void g => "mov rax, {f}; mov rax, [rax]; mov {g}, rax";

func<debug> callerSite(*void f) string {
	string first = siteOf(f);
	*void at = f;
	loop true {
		string s = siteOf(at);
		if len(s) <= 0 {
			return first;
		}
		if len(s) < 4 || s[:4] != "std/" {
			return s;
		}
		at = parent(at);
	}
	return first;
}

internal inline func scrub(*void _p, int _size) {}
internal inline func<debug> scrub(*void p, int size) {
	rawSet(p, 0xCD, size - HEAD_SIZE);
}

internal func rawAllocate(int n, bool zero) *void {
	if n < 0 || n > MAX_ALLOC {
		return null;
	}

	int total = n + HEAD_SIZE;
	if total <= LOW_LIMIT {
		int class = classOf(total);
		int size = MIN_BLOCK << class;
		if classes[class] != null {
			*void p = classes[class];
			classes[class] = ((**void)(p))@;
			if zero {
				rawSet(p, 0, size - HEAD_SIZE);
			} else {
				scrub(p, size - HEAD_SIZE);
			}
			setState(p, LIVE);
			return p;
		}
		if cur + size > end {
			*void chunk = sys.mmap(CHUNK_SIZE);
			if failed(chunk) {
				return null;
			}
			cur = chunk;
			end = (*byte)(chunk) + CHUNK_SIZE;
		}
		*void p = cur;
		cur += size;
		*void head = (*byte)(p) + 16;
		setHeader(head, class);
		setState(head, LIVE);
		return head;
	}

	int mapped = (total + (PAGE_SIZE-1)) / PAGE_SIZE  * PAGE_SIZE;
	*void p = sys.mmap(mapped);
	if failed(p) {
		return null;
	}
	*void head = (*byte)(p) + 16;
	setHeader(head, mapped);
	setState(head, LIVE);
	return head;
}

internal inline func recycle(*void p, int h) {
	((**void)(p))@ = classes[h];
	classes[h] = p;
}
internal inline func<debug> recycle(*void p, int h) {
	quarantine(p, h);
}

internal func rawFree(*void p) {
	if p == null {
		return;
	}

	switch state(p) {
		case DEAD:
			fail(p, "double free");
		case LIVE:
			setState(p, DEAD);
		default:
			panic("free of an invalid pointer");
	}

	int h = header(p);
	if h < 11 {
		recycle(p, h);
	} else {
		forget(p);
		sys.munmap((*byte)(p)-16, h);
	}
}

internal func rawRealloc(*void p, int n) *void {
	if p == null {
		return rawAllocate(n, true);
	}
	
	int h = header(p);
	int cap = (h < 11 ? (MIN_BLOCK << h) : h) - 16;
	if n <= cap {
		return p;
	}

	*void np = rawAllocate(n, true);
	if np == null {
		return null;
	}
	rawCopy(np, p, cap);
	rawFree(p);
	return np;
}

internal native rawCopy(*void dst, src, int n) =>
		"mov rdi, {dst}; mov rsi, {src}; mov rcx, {n}; rep movsb";

internal native rawCopyBackward(*void dst, src, int n) =>
		"mov rdi, {dst}; add rdi, {n}; dec rdi; mov rsi, {src}; add rsi, {n}; dec rsi; mov rcx, {n}; std; rep movsb; cld";

internal native rawSet(*void dst, byte value, int n) =>
		"mov rdi, {dst}; mov al, {value}; mov rcx, {n}; rep stosb";
