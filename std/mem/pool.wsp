import "std/errors";
import "std/math";
const {
	pool_HEADER = 16;
	PER_CHUNK = 32;
}

struct PoolChunk {
	?*PoolChunk next;
}

/// An allocator of blocks that all have the same size, `size` bytes, set when the
/// pool is made. Freed blocks are reused by the next allocation, so a pool suits
/// many objects that come and go. Memory is taken from `parent`, or from
/// `heap` when `parent` is null, 32 blocks at a time, and goes back only with
/// `release`. Blocks are 16-byte aligned. A `size` of zero or less makes every
/// allocation fail.
public struct Pool implements Allocator {
	public int size;
	public ?Allocator parent;
	?*void spare;
	?*PoolChunk chunks;
	int liveBlocks;
}

func (*Pool p) source() Allocator {
	return p.parent ?? heap;
}

func (*Pool p) stride() int {
	return (math.max(p.size, 8) + 15) & ~15;
}

func (*Pool p) grow() ! {
	int stride = p.stride();
	*PoolChunk chunk = p.source().allocDirty(pool_HEADER + stride * PER_CHUNK)!;
	chunk.next = p.chunks;
	p.chunks = chunk;
	for i in 0..PER_CHUNK {
		*void block = (*byte)(chunk) + pool_HEADER + i * stride;
		((*?*void)(block))@ = p.spare;
		p.spare = block;
	}
}

/// Takes a block of the pool without clearing it. `n` must be between 0 and
/// `size`, otherwise it fails with `Invalid`; the block always has `size` bytes.
/// Fails with the error of the parent when it needs memory and cannot get it.
public func (*Pool p) allocDirty(int n) !*void {
	errors.ensure(p.size > 0 && n >= 0 && n <= p.size, errors.Kind.Invalid)!;
	if p.spare == null {
		p.grow()!;
	}
	*void block = p.spare!!;
	p.spare = ((*?*void)(block))@;
	p.liveBlocks++;
	return block;
}

/// Like `allocDirty`, but the whole block is zeroed.
public func (*Pool p) alloc(int n) !*void {
	*void block = p.allocDirty(n)!;
	fill(block, 0, p.stride());
	return block;
}

/// Puts a block back in the pool for reuse. Null is ignored. The block must come
/// from this pool, and freeing it twice corrupts the pool. The pool does not
/// check this.
public func (*Pool p) free(?*void b) {
	*void block = b ?? return;
	((*?*void)(block))@ = p.spare;
	p.spare = block;
	p.liveBlocks--;
}

/// A block cannot change size, so this only checks that `n` fits in `size`, and
/// fails with `Invalid` when it does not or when a size is negative. It returns
/// the same block, with bytes past `old` zeroed. A null `b` allocates.
public func (*Pool p) realloc(?*void b, int old, int n) !*void {
	errors.ensure(old >= 0 && n >= 0, errors.Kind.Invalid)!;
	*void block = b ?? return p.alloc(n)!;
	errors.ensure(n <= p.size, errors.Kind.Invalid)!;
	if n > old {
		fill((*byte)(block) + old, 0, n - old);
	}
	return block;
}

/// Returns all the memory of the pool to the parent, whether its blocks were
/// freed or not. Every block becomes invalid and the pool can be used again.
public func (*Pool p) release() {
	?*PoolChunk c = p.chunks;
	loop c |chunk| {
		c = chunk.next;
		p.source().free(chunk);
	}
	p.chunks = null;
	p.spare = null;
	p.liveBlocks = 0;
}

/// The number of blocks allocated and not freed yet.
public inline func (*Pool p) blocks() int {
	return p.liveBlocks;
}
