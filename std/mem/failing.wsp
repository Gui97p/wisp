import "std/errors";
/// An allocator that fails on purpose, to test the error paths of code that
/// allocates. It counts the calls to `alloc`, `allocDirty` and `realloc`. One made
/// with `failingAfter(parent, limit)` fails the call number `limit + 1` and every
/// later one with `OutOfMemory`; one made with `failing(parent)` never fails and
/// only counts. Calls that pass are forwarded to `parent`, or to `heap` when
/// `parent` is null, and `free` is always forwarded.
public struct Failing implements Allocator {
	public ?Allocator parent;
	?int after;
	int attempts;
}

/// Returns an allocator that forwards to `parent`, never fails, and counts the
/// calls. A `Failing` declared without it forwards to the heap.
public inline func failing(Allocator parent) Failing => .{parent: parent};
/// Returns an allocator that forwards to `parent`, where the allocation call
/// number `limit + 1` and every later one fail with `OutOfMemory`. With a `limit`
/// of zero, every call fails.
public inline func failingAfter(Allocator parent, int limit) Failing => .{parent: parent, after: limit};
inline func (*Failing f) source() Allocator => f.parent ?? heap;

func (*Failing f) permit() ! {
	f.attempts++;
	if f.after |limit| {
		errors.ensure(f.attempts <= limit, errors.Kind.OutOfMemory)!;
	}
}

/// Counts the call, then fails with `OutOfMemory` if the limit is passed;
/// otherwise allocates zeroed bytes from the parent.
public func (*Failing f) alloc(int n) !*void {
	f.permit()!;
	return f.source().alloc(n)!;
}

/// Counts the call, then fails with `OutOfMemory` if the limit is passed;
/// otherwise allocates from the parent without clearing.
public func (*Failing f) allocDirty(int n) !*void {
	f.permit()!;
	return f.source().allocDirty(n)!;
}

/// Counts the call, then fails with `OutOfMemory` if the limit is passed;
/// otherwise resizes through the parent. When it fails the block is unchanged.
public func (*Failing f) realloc(?*void p, int old, int n) !*void {
	f.permit()!;
	return f.source().realloc(p, old, n)!;
}

/// Forwards to the parent. It never fails and is not counted.
public func (*Failing f) free(?*void p) {
	f.source().free(p);
}

/// The number of allocation calls made since the start or the last `reset`,
/// failed ones included.
public inline func (*Failing f) calls() int => f.attempts;

/// Sets the call count back to zero, so the limit of `failingAfter` counts again
/// from the start.
public inline func (*Failing f) reset() {
	f.attempts = 0;
}
