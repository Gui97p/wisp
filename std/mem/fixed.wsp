import "std/errors";
import "std/mem";

public struct Fixed {
	[]byte buffer;
	internal int bUsed;
}

public func (*Fixed f) alloc(int n) !*void {
	*byte p = f.allocDirty(n)!;
	mem.fill(p, 0, n);
	return p;
}

public func (*Fixed f) allocDirty(int n) !*void {
	int base = int((*byte)(f.buffer));
	int start = (base + f.bUsed + 15) & ~15;
	int off = start - base;
	errors.ensure(n >= 0, errors.Kind.Invalid)!;
	n = (n + 15) & ~15;
	errors.ensure(off + n <= len(f.buffer), errors.Kind.NoSpace)!;
	defer f.bUsed = off + n;
	return (*byte)(f.buffer) + off;
}

public inline func (*Fixed f) reset() {
	f.bUsed = 0;
}

public inline func (*Fixed f) remaining() int {
	return len(f.buffer) - f.bUsed;
}

public inline func (*Fixed f) used() int {
	return f.bUsed;
}
