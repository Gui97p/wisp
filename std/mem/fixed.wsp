import "std/errors";
import "std/math";
import "std/mem";

public struct Fixed {
	[]byte buffer;
	internal int bUsed;
}

public func (*Fixed f) alloc(int n) !*void {
	*byte p = f.allocDirty(n)!;
	mem.fill(p, 0, n);
	return p;
}

public func (*Fixed f) allocDirty(int n) !*void {
	int base = int((*byte)(f.buffer));
	int start = (base + f.bUsed + 15) & ~15;
	int off = start - base;
	errors.ensure(n >= 0, errors.Kind.Invalid)!;
	n = (n + 15) & ~15;
	errors.ensure(off + n <= len(f.buffer), errors.Kind.NoSpace)!;
	defer f.bUsed = off + n;
	return (*byte)(f.buffer) + off;
}

public inline func (*Fixed f) reset() {
	f.bUsed = 0;
}

public inline func (*Fixed f) remaining() int {
	return len(f.buffer) - f.bUsed;
}

public inline func (*Fixed f) used() int {
	return f.bUsed;
}

public inline func (*Fixed _f) free(?*void _p) {
}

public func (*Fixed f) realloc(?*void p, int old, int n) !*void {
	errors.ensure(old >= 0 && n >= 0, errors.Kind.Invalid)!;
	*void block = p ?? return f.alloc(n)!;
	int was = (old + 15) & ~15;
	int want = (n + 15) & ~15;
	int base = int((*byte)(f.buffer));
	if int(block) + was == base + f.bUsed && f.bUsed - was + want <= len(f.buffer) {
		f.bUsed = f.bUsed - was + want;
		if n > old {
			mem.fill((*byte)(block) + old, 0, n - old);
		}
		return block;
	}
	*void next = f.alloc(n)!;
	mem.copy(next, block, math.min(old, n));
	return next;
}

public func (*Fixed f) allocator() mem.Allocator {
	return mem.allocator((*void)(f), fixedAlloc, fixedAllocDirty, fixedRealloc, fixedFree);
}

func fixedOf(?*void state) *Fixed {
	return (*Fixed)(state!!);
}

func fixedAlloc(?*void state, int n) !*void {
	return fixedOf(state).alloc(n)!;
}

func fixedAllocDirty(?*void state, int n) !*void {
	return fixedOf(state).allocDirty(n)!;
}

func fixedRealloc(?*void state, ?*void p, int old, int n) !*void {
	return fixedOf(state).realloc(p, old, n)!;
}

func fixedFree(?*void _state, ?*void _p) {
}
