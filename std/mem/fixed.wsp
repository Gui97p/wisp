import "std/errors";
import "std/mem";

public struct Fixed {
	char[] buffer;
	internal int bUsed;
}

public func (*Fixed f) alloc(int n) !*void {
	*char p = f.allocDirty(n)!;
	mem.fill(p, 0, n);
	return p;
}

public func (*Fixed f) allocDirty(int n) !*void {
	int base = int((*char)(f.buffer));
	int start = (base + f.bUsed + 15) & ~15;
	int off = start - base;
	if n < 0 {
		return Error(errors.Kind.Invalid);
	}
	n = (n + 15) & ~15;
	if off + n > len(f.buffer) {
		return Error(errors.Kind.NoSpace);
	}
	defer f.bUsed = off + n;
	return (*char)(f.buffer) + off;
}

public func (*Fixed f) reset() {
	f.bUsed = 0;
}

public func (*Fixed f) remaining() int {
	return len(f.buffer) - f.bUsed;
}

public func (*Fixed f) used() int {
	return f.bUsed;
}
