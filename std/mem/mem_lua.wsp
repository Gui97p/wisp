internal func rawAlloc(int n) *void {
	*void p;
	native lua(in n, out p) "p = (__wisp_alloc(n))";
	return p;
}

internal func rawFree(*void p) {
	native lua(in p) "__wisp_free(p)";
}

internal func rawRealloc(*void p, int n) *void {
	*void new;
	native lua(in p, n, out new) "new = (__wisp_realloc(p, n))";
	return new;
}

internal func rawCopy(*void dst, src, int n) {
	native lua(in dst, src, n) "for i = 0, n - 1 do dst.t[dst.o + i] = src.t[src.o + i] end";
}
