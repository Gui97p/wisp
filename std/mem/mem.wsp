import "std/errors";
import<debug> "std/os";

/// Where blocks of memory come from. A block is a number of bytes: `alloc`
/// gives it zeroed, `allocDirty` leaves it as it was, `realloc` resizes a block
/// given the size it has now (what the new bytes hold is zero), and `free`
/// gives it back. Every function that needs memory takes an allocator, because
/// nothing allocates behind your back.
public interface Allocator {
	func alloc(int n) !*void;
	func allocDirty(int n) !*void;
	func realloc(?*void p, int old, int n) !*void;
	func free(?*void p);
}

struct Raw implements Allocator {}

/// The heap of the process: blocks of any size, freed one by one. It has no
/// state, and `mem.heap` is the value to pass where an allocator is asked for.
/// In a debug build it checks what the program does with its blocks.
public struct Heap implements Allocator {}

Raw rawState;
Heap heapState;

/// The heap of the process, as an allocator.
public Allocator heap = &heapState;

func (*Raw) alloc(int n) !*void {
	*void p = allocate(n, true) ?? return Error(errors.Kind.OutOfMemory);
	return p;
}

func (*Raw) allocDirty(int n) !*void {
	*void p = allocate(n, false) ?? return Error(errors.Kind.OutOfMemory);
	return p;
}

func (*Raw r) realloc(?*void p, int old, int n) !*void {
	*void block = p ?? return r.alloc(n)!;
	*void grown = realloc(block, n) ?? return Error(errors.Kind.OutOfMemory);
	if n > old => fill((*byte)(grown) + old, 0, n - old);
	return grown;
}

func (*Raw) free(?*void p) {
	if p |block| {
		release(block);
	}
}

var<debug> Debug checked;
let<debug> hookPending = true;

func<debug> leakReport() {
	checked.report();
}

func<debug> arm() {
	if hookPending {
		checked.parent = &rawState;
		let _ = os.atExit(leakReport);
		hookPending = false;
	}
}

inline func source() Allocator => &rawState;

func<debug> source() Allocator {
	arm();
	return &checked;
}

/// Allocates `n` zeroed bytes from the process heap. Fails with `OutOfMemory`
/// when the system has no more memory or `n` is too large. In a debug build the
/// block is tracked, with guard bytes around it.
public func (*Heap) alloc(int n) !*void => source().alloc(n)!;

/// Allocates `n` bytes from the process heap without clearing them. In a debug
/// build the bytes start filled with `0xCD`, to make reads before writes visible.
public func (*Heap) allocDirty(int n) !*void => source().allocDirty(n)!;

/// Resizes a block of the process heap, which currently has `old` bytes, to `n`
/// bytes. The block may move, so use the returned pointer and not the old one.
/// Bytes past `old` are zeroed. A null `p` allocates. In a debug build an `old`
/// that is not the real size of the block is a panic.
public func (*Heap) realloc(?*void p, int old, int n) !*void => source().realloc(p, old, n)!;

/// Gives a block back to the process heap. Null is ignored. In a debug build a
/// double free, a pointer into the middle of a block or an overflowed block is a
/// panic, and blocks never freed are reported when the program exits.
public func (*Heap) free(?*void p) => source().free(p);

/// A slice of n zeroed elements of T: `mem.make<int>(mem.heap, 8)!`. It can
/// fail like the allocator does.
public inline func make<T, Allocator A>(A a, int n) ![]T {
	*void p = a.alloc(n * int(sizeof(T)))!;
	return (*T)(p)[0..n];
}

/// Like `make`, for memory you are about to overwrite: the elements are not
/// cleared, so what they hold before you write is not defined.
public inline func makeDirty<T, Allocator A>(A a, int n) ![]T {
	*void p = a.allocDirty(n * int(sizeof(T)))!;
	return (*T)(p)[0..n];
}

/// One zeroed T, as a pointer: `mem.create<Pair>(mem.heap)!`.
public inline func create<T, Allocator A>(A a) !*T {
	*void p = a.alloc(int(sizeof(T)))!;
	return (*T)(p);
}

/// The slice with n elements: it keeps what it had, and the new elements are
/// zeroed. The old size comes from the slice itself.
public inline func resize<T, Allocator A>(A a, []T items, int n) ![]T {
	int size = int(sizeof(T));
	*void p = a.realloc(items, len(items) * size, n * size)!;
	return (*T)(p)[0..n];
}

/// Gives a block back: a pointer, a slice, an array or a string that came from
/// the allocator, or an interface value that holds such a pointer. Null is
/// ignored.
public inline func free<Allocator A>(A a, ?*void p) => a.free(p);

/// Copies n bytes from src to dst. The blocks must not overlap: use `move` when
/// they can.
public inline func copy(*void dst, src, int n) => rawCopy(dst, src, n);

/// Copies n bytes from src to dst, also when they overlap.
public func move(*void dst, src, int n) {
	if dst > src && dst < (*byte)(src) + n {
		rawCopyBackward(dst, src, n);
	} else {
		rawCopy(dst, src, n);
	}
}

/// Sets n bytes from dst to the value.
public inline func fill(*void dst, byte value, int n) => rawSet(dst, value, n);
