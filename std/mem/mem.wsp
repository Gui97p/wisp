import<x64> "std/mem/x64" as impl;
import<lua> "std/mem/lua" as impl;
import "std/errors";

public func alloc(int n) !*void {
	*void p = impl.rawAllocate(n, true);
	errors.ensure(p != null, errors.Kind.OutOfMemory)!;
	impl.track(p);
	return p;
}

public func allocDirty(int n) !*void {
	*void p = impl.rawAllocate(n, false);
	errors.ensure(p != null, errors.Kind.OutOfMemory)!;
	impl.track(p);
	return p;
}

public func free(*void ...p) {
	for _, v in p {
		impl.trackFree(v);
		impl.rawFree(v);
	}
}

public func realloc(*void p, int n) !*void {
	impl.trackFree(p);
	*void new = impl.rawRealloc(p, n);
	errors.ensure(new != null, errors.Kind.OutOfMemory)!;
	impl.track(new);
	return new;
}

public inline func copy(*void dst, src, int n) {
	impl.rawCopy(dst, src, n);
}

public func move(*void dst, src, int n) {
	if dst > src && dst < (*char)(src) + n {
		impl.rawCopyBackward(dst, src, n);
	} else {
		impl.rawCopy(dst, src, n);
	}
}

public inline func fill(*void dst, char value, int n) {
	impl.rawSet(dst, value, n);
}
