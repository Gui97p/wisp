import "std/errors";

public func alloc(int n) !*void {
	*void p = rawAllocate(n, true);
	if p == null {
		return Error(errors.Kind.OutOfMemory);
	}
	return p;
}

public func allocDirty(int n) !*void {
	*void p = rawAllocate(n, false);
	if p == null {
		return Error(errors.Kind.OutOfMemory);
	}
	return p;
}

public func free(*void ...p) {
	for _, v in p {
		rawFree(v);
	}
}

public func realloc(*void p, int n) !*void {
	*void new = rawRealloc(p, n);
	if new == null {
		return Error(errors.Kind.OutOfMemory);
	}
	return new;
}

public func copy(*void dst, src, int n) {
	rawCopy(dst, src, n);
}

public func move(*void dst, src, int n) {
	if dst > src && dst < (*char)(src) + n {
		rawCopyBackward(dst, src, n);
	} else {
		rawCopy(dst, src, n);
	}
}

public func fill(*void dst, char value, int n) {
	rawSet(dst, value, n);
}
