import "std/mem";
import "std/sys";

func leadingZeros(uint x) uint {
	return 64 if x == 0;

	uint n;
	loop (x & 0x8000000000000000) == 0 {
		x <<= 1;
		n++;
	}
	return n;
}

[11]?*void classes;
int cur, end;

const {
	HEAD_SIZE = 16;
	MIN_BLOCK = 32;
	LOW_LIMIT = 32768;
	CHUNK_SIZE = 1048576;
	PAGE_SIZE = 4096;
	MAX_ALLOC = 1 << 47;
	uint LIVE = 0x57495350414C4956;
	uint DEAD = 0x5749535044454144;
}

inline func header(*void p) int {
	return (*int)((*byte)(p) - 16)@;
}

inline func setHeader(*void p, int v) {
	(*int)((*byte)(p)-16)@ = v;
}

inline func state(*void p) uint {
	return (*uint)((*byte)(p) - 8)@;
}

inline func setState(*void p, uint v) {
	(*uint)((*byte)(p)-8)@ = v;
}

inline func classOf(int total) int {
	int bits = int(64 - leadingZeros(uint(total - 1)));
	return (bits > 5 ? bits : 5) - 5;
}

internal func allocate(int n, bool zero) ?*void {
	if n < 0 || n > MAX_ALLOC {
		return null;
	}

	int total = n + HEAD_SIZE;
	if total <= LOW_LIMIT {
		int class = classOf(total);
		int size = MIN_BLOCK << class;
		if classes[class] |p| {
			classes[class] = ((*?*void)(p))@;
			if zero {
				mem.fill(p, 0, size - HEAD_SIZE);
			}
			setState(p, LIVE);
			return p;
		}
		if cur + size > end {
			*void chunk = sys.mmap(CHUNK_SIZE) ?? return null;
			cur = int(chunk);
			end = cur + CHUNK_SIZE;
		}
		*byte p = (*byte)(cur);
		cur += size;
		*void head = (*byte)(p) + 16;
		setHeader(head, class);
		setState(head, LIVE);
		return head;
	}

	int mapped = (total + (PAGE_SIZE-1)) / PAGE_SIZE  * PAGE_SIZE;
	*void p = sys.mmap(mapped) ?? return null;
	*void head = (*byte)(p) + 16;
	setHeader(head, mapped);
	setState(head, LIVE);
	return head;
}

inline func recycle(*void p, int h) {
	((*?*void)(p))@ = classes[h];
	classes[h] = p;
}

internal func release(*void p) {
	switch state(p) {
		case DEAD => panic("double free");
		case LIVE => setState(p, DEAD);
		default => panic("free of an invalid pointer");
	}

	int h = header(p);
	if h < 11 {
		recycle(p, h);
	} else {
		sys.munmap((*byte)(p)-16, h);
	}
}

internal func resize(*void p, int n) ?*void {
	int h = header(p);
	int cap = (h < 11 ? (MIN_BLOCK << h) : h) - 16;
	return p if n <= cap;

	*void np = allocate(n, true) ?? return null;
	mem.copy(np, p, cap);
	release(p);
	return np;
}
