#target debug & x64

import "std/errors";
import "std/fmt";
import "std/io";
import "std/os";
import "std/strings";

const {
	HEAD = 64;
	CANARY = 16;
	MAX_BLOCK = 1 << 47;
	uint EMPTY = 0;
	uint TOMB = 1;
}

struct Header {
	int size;
	string site, freed;
	?*Header prev, next;
}

/// An allocator that finds mistakes in how blocks are used, and forwards the
/// memory to `parent`, or to `heap` when `parent` is null. Every block has a
/// header that records where it was allocated, and guard bytes after it. It
/// panics on a double free, on a free or realloc of a pointer that is not a block
/// of this allocator, on a write past the end of a block, on a write to a freed
/// block, and on a `realloc` given a wrong `old` size. Freed blocks are poisoned
/// with `0xDD` and kept in a ring of the last 256 until they are checked and
/// returned. Dirty blocks start filled with `0xCD`. It is only built with the
/// `debug` profile, and the heap uses it there.
public struct Debug implements Allocator {
	public ?Allocator parent;
	?*Header head;
	[]uint table;
	int entries, tombs;
	int liveBlocks;
	[256]?*Header ring;
	int ringStart, ringCount;
}

/// Returns a checking allocator that forwards to `parent`. A `Debug` declared
/// without it forwards to the heap.
public inline func debug(Allocator parent) Debug => .{parent: parent};

inline func headerOf(*void p) *Header => (*Header)((*byte)(p) - HEAD);

inline func dataOf(*Header h) *byte => (*byte)(h) + HEAD;

inline func (*Debug d) source() Allocator => d.parent ?? heap;

func fail(*Header h, string what) {
	Fixed f = fixed([2048]byte{});
	if len(h.freed) > 0 {
		string both = strings.concat(&f, what, "\nthe block was allocated at ", h.site, "the block was freed at ", h.freed[..len(h.freed) - 1]) ?? what;
		panic(both);
	}
	if len(h.site) > 0 {
		string text = strings.concat(&f, what, "\nthe block was allocated at ", h.site[..len(h.site) - 1]) ?? what;
		panic(text);
	}
	panic(what);
}

func verifyCanary(*Header h) {
	*uint8 p = (*uint8)(dataOf(h));
	for i in 0..CANARY {
		if p[h.size + i] != 0xFD {
			fail(h, "buffer overflow: a block was written past its end");
		}
	}
}

func verifyPoison(*Header h) {
	*uint8 p = (*uint8)(dataOf(h));
	for i in 0..h.size {
		if p[i] != 0xDD {
			fail(h, "use after free: a freed block was written to");
		}
	}
}

inline func mix(uint key) uint {
	uint x = key >> 4;
	x = x ^ (x >> 29);
	x = x *% 0xBF58476D1CE4E5B9;
	return x ^ (x >> 32);
}

func (*Debug d) find(uint key) int {
	int n = len(d.table);
	if n == 0 => return -1;
	int mask = n - 1;
	int i = int(mix(key) & uint(mask));
	for _ in 0..n {
		uint at = d.table[i];
		if at == EMPTY => return -1;
		if at == key => return i;
		i = (i + 1) & mask;
	}
	return -1;
}

func (*Debug d) insert(uint key) {
	int mask = len(d.table) - 1;
	int i = int(mix(key) & uint(mask));
	loop d.table[i] > TOMB {
		i = (i + 1) & mask;
	}
	if d.table[i] == TOMB {
		d.tombs--;
	}
	d.table[i] = key;
	d.entries++;
}

func (*Debug d) rebuild() ! {
	int want = 64;
	loop want < (d.entries + 1) * 4 {
		want *= 2;
	}
	[]uint old = d.table;
	*void block = allocate(want * 8, true) ?? return Error(errors.Kind.OutOfMemory);
	d.table = (*uint)(block)[0..want];
	d.entries = 0;
	d.tombs = 0;
	for key in old {
		if key > TOMB {
			d.insert(key);
		}
	}
	if len(old) > 0 {
		release(old);
	}
}

func (*Debug d) track(*Header h) ! {
	if (d.entries + d.tombs + 1) * 2 > len(d.table) {
		d.rebuild()!;
	}
	d.insert(uint(h));
}

func (*Debug d) untrack(uint key) {
	int i = d.find(key);
	d.table[i] = TOMB;
	d.entries--;
	d.tombs++;
}

func (*Debug d) reject(*void p, string ifFreed, string ifInside, string ifForeign) {
	uint at = uint(p) - HEAD;
	for i in 0..d.ringCount {
		*Header dead = d.ring[(d.ringStart + i) % len(d.ring)].?;
		if uint(dead) == at {
			fail(dead, ifFreed);
		}
	}
	?*Header c = d.head;
	loop c |h| {
		c = h.next;
		uint start = uint(dataOf(h));
		if uint(p) > start && uint(p) < start + uint(h.size) {
			fail(h, ifInside);
		}
	}
	panic(ifForeign);
}

func (*Debug d) obtain(int n, bool zero) !*void {
	errors.ensure(n >= 0 && n <= MAX_BLOCK, errors.Kind.OutOfMemory)!;
	int total = HEAD + n + CANARY;
	*void raw = d.source().allocDirty(total)!;
	if zero {
		fill(raw, 0, total);
	}
	*Header h = (*Header)(raw);
	h.size = n;
	h.site = site();
	h.freed = "";
	h.prev = null;
	h.next = d.head;
	d.track(h) ?? {
		d.source().free(raw);
		return Error(errors.Kind.OutOfMemory);
	};
	if d.head |first| {
		first.prev = h;
	}
	d.head = h;
	if !zero {
		fill(dataOf(h), 0xCD, n);
	}
	fill(dataOf(h) + n, 0xFD, CANARY);
	d.liveBlocks++;
	return dataOf(h);
}

/// Allocates `n` zeroed bytes with a header and guard bytes. Fails with
/// `OutOfMemory` for a negative `n`, for more than 2^47 bytes, or when the
/// bookkeeping cannot grow, and with the error of the parent.
public func (*Debug d) alloc(int n) !*void {
	return d.obtain(n, true)!;
}

/// Like `alloc`, but the bytes start filled with `0xCD`.
public func (*Debug d) allocDirty(int n) !*void {
	return d.obtain(n, false)!;
}

func (*Debug d) evict() {
	*Header old = d.ring[d.ringStart].?;
	verifyPoison(old);
	d.ringStart = (d.ringStart + 1) % len(d.ring);
	d.ringCount--;
	d.source().free(old);
}

/// Gives a block back. Null is ignored. The guard bytes are checked first, then
/// the block is filled with `0xDD` and kept in the ring of freed blocks; when the
/// ring is full, the oldest one is checked for writes and returned to the parent.
/// Panics on a double free, on a pointer into the middle of a block, and on a
/// pointer that is not a block of this allocator.
public func (*Debug d) free(?*void p) {
	*void block = p ?? return;
	uint at = uint(block) - HEAD;
	if d.find(at) < 0 {
		d.reject(block, "double free", "free of a pointer into the middle of a block: free the pointer the allocator gave", "free of a pointer that is not a block of this allocator: a stack or global address, or a block of another allocator");
	}
	*Header h = headerOf(block);
	verifyCanary(h);
	if h.prev |before| {
		before.next = h.next;
	} else {
		d.head = h.next;
	}
	if h.next |after| {
		after.prev = h.prev;
	}
	d.untrack(at);
	h.freed = site();
	fill(dataOf(h), 0xDD, h.size);
	d.liveBlocks--;
	if d.ringCount == len(d.ring) {
		d.evict();
	}
	d.ring[(d.ringStart + d.ringCount) % len(d.ring)] = h;
	d.ringCount++;
}

/// Resizes a block by allocating a new one, copying and freeing the old one, so
/// the address always changes unless `n` equals `old`. Bytes past `old` are
/// zeroed. A null `p` allocates. Panics when `p` is not a live block of this
/// allocator or when `old` is not its size. When it fails the block is unchanged.
public func (*Debug d) realloc(?*void p, int old, int n) !*void {
	*void block = p ?? return d.obtain(n, true)!;
	if d.find(uint(block) - HEAD) < 0 {
		d.reject(block, "realloc of a freed block", "realloc of a pointer into the middle of a block: use the pointer the allocator gave", "realloc of a pointer that is not a block of this allocator: a stack or global address, or a block of another allocator");
	}
	*Header h = headerOf(block);
	if h.size != old {
		fail(h, "realloc with a size that is not the size of the block");
	}
	if n == old => return block;
	*void next = d.obtain(n, true)!;
	copy(next, block, old < n ? old : n);
	d.free(block);
	return next;
}

/// Checks the guard bytes of every live block and the poison of every block in
/// the ring of freed ones. Panics at the first one that was written to, naming
/// where the block was allocated and, if freed, where.
public func (*Debug d) check() {
	for i in 0..d.ringCount {
		verifyPoison(d.ring[(d.ringStart + i) % len(d.ring)].?);
	}
	?*Header c = d.head;
	loop c |h| {
		c = h.next;
		verifyCanary(h);
	}
}

/// Checks and returns the freed blocks held in the ring, and frees the tables
/// used for tracking. Live blocks are not touched, and they stay checked if the
/// allocator is used again.
public func (*Debug d) release() {
	loop d.ringCount > 0 {
		d.evict();
	}
	if len(d.table) > 0 {
		release(d.table);
		d.table = .{};
		d.entries = 0;
		d.tombs = 0;
	}
}

func (*Debug d) sizeOf(*void p) int {
	if d.find(uint(p) - HEAD) < 0 {
		d.reject(p, "use of a freed block", "a pointer into the middle of a block", "a pointer that is not a block of this allocator");
	}
	return headerOf(p).size;
}

/// The number of blocks allocated and not freed yet.
public inline func (*Debug d) blocks() int => d.liveBlocks;

/// Runs `check`, then prints to standard error the live blocks grouped by the
/// place that allocated them, as leaks, up to 64 places and a count of the rest.
/// Returns the number of live blocks, so zero means no leaks.
public func (*Debug d) report() int {
	d.check();

	[64]string sites;
	[64]int counts, bytes;
	int groups, others;

	?*Header c = d.head;
	loop c |h| {
		c = h.next;
		int j;
		loop j < groups && sites[j] != h.site {
			j++;
		}
		if j == groups {
			if groups == len(sites) {
				others++;
				continue;
			}
			sites[j] = h.site;
			groups++;
		}
		counts[j]++;
		bytes[j] += h.size;
	}

	int k;
	loop k < groups {
		fmt.fprintln(&os.stderr, "leak: {counts[k]} blocks, {bytes[k]} bytes, allocated at")!!;
		io.writeString(&os.stderr, sites[k])!!;
		k++;
	}
	if others > 0 {
		fmt.fprintln(&os.stderr, "leak: {others} more blocks from other places")!!;
	}
	return d.liveBlocks;
}
