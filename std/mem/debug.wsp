#target x64

import "std/errors";
import "std/fmt";
import "std/mem";
import "std/mem/heap" as raw;
import "std/mem/x64" as impl;
import "std/strings";

const {
	HEAD = 64;
	CANARY = 16;
	MAX_BLOCK = 1 << 47;
	uint EMPTY = 0;
	uint TOMB = 1;
}

struct Header {
	int size;
	string site, freed;
	?*Header prev, next;
}

public struct Debug implements mem.Allocator {
	?mem.Allocator parent;
	internal ?*Header head;
	internal []uint table;
	internal int entries, tombs;
	internal int liveBlocks;
	internal [256]?*Header ring;
	internal int ringStart, ringCount;
}

inline func headerOf(*void p) *Header {
	return (*Header)((*byte)(p) - HEAD);
}

inline func dataOf(*Header h) *byte {
	return (*byte)(h) + HEAD;
}

func (*Debug d) source() mem.Allocator {
	return d.parent ?? mem.heap;
}

func fail(*Header h, string what) {
	[2048]byte buf;
	if len(h.freed) > 0 {
		string both = strings.concat(buf, what, "\nthe block was allocated at ", h.site, "the block was freed at ", h.freed[:len(h.freed) - 1]) ?? what;
		panic(both);
	}
	if len(h.site) > 0 {
		string text = strings.concat(buf, what, "\nthe block was allocated at ", h.site[:len(h.site) - 1]) ?? what;
		panic(text);
	}
	panic(what);
}

func verifyCanary(*Header h) {
	*uint8 p = (*uint8)(dataOf(h));
	for i in 0..CANARY - 1 {
		if p[h.size + i] != 0xFD {
			fail(h, "buffer overflow: a block was written past its end");
		}
	}
}

func verifyPoison(*Header h) {
	*uint8 p = (*uint8)(dataOf(h));
	for i in 0..h.size - 1 {
		if p[i] != 0xDD {
			fail(h, "use after free: a freed block was written to");
		}
	}
}

inline func mix(uint key) uint {
	uint x = key >> 4;
	x = x ^ (x >> 29);
	x = x *% 0xBF58476D1CE4E5B9;
	return x ^ (x >> 32);
}

func (*Debug d) find(uint key) int {
	int n = len(d.table);
	return -1 if n == 0;
	int mask = n - 1;
	int i = int(mix(key) & uint(mask));
	for _ in 0..n - 1 {
		uint at = d.table[i];
		return -1 if at == EMPTY;
		return i if at == key;
		i = (i + 1) & mask;
	}
	return -1;
}

func (*Debug d) insert(uint key) {
	int mask = len(d.table) - 1;
	int i = int(mix(key) & uint(mask));
	loop d.table[i] > TOMB {
		i = (i + 1) & mask;
	}
	if d.table[i] == TOMB {
		d.tombs--;
	}
	d.table[i] = key;
	d.entries++;
}

func (*Debug d) rebuild() ! {
	int want = 64;
	loop want < (d.entries + 1) * 4 {
		want *= 2;
	}
	[]uint old = d.table;
	*void block = raw.allocate(want * 8, true) ?? return Error(errors.Kind.OutOfMemory);
	d.table = (*uint)(block)[0:want];
	d.entries = 0;
	d.tombs = 0;
	for key in old {
		if key > TOMB {
			d.insert(key);
		}
	}
	if len(old) > 0 {
		raw.release(old);
	}
}

func (*Debug d) track(*Header h) ! {
	if (d.entries + d.tombs + 1) * 2 > len(d.table) {
		d.rebuild()!;
	}
	d.insert(uint(h));
}

func (*Debug d) untrack(uint key) {
	int i = d.find(key);
	d.table[i] = TOMB;
	d.entries--;
	d.tombs++;
}

func (*Debug d) reject(*void p, string ifFreed, string ifInside, string ifForeign) {
	uint at = uint(p) - HEAD;
	for i in 0..d.ringCount - 1 {
		*Header dead = d.ring[(d.ringStart + i) % len(d.ring)]!!;
		if uint(dead) == at {
			fail(dead, ifFreed);
		}
	}
	?*Header c = d.head;
	loop c |h| {
		c = h.next;
		uint start = uint(dataOf(h));
		if uint(p) > start && uint(p) < start + uint(h.size) {
			fail(h, ifInside);
		}
	}
	panic(ifForeign);
}

func (*Debug d) obtain(int n, bool zero) !*void {
	errors.ensure(n >= 0 && n <= MAX_BLOCK, errors.Kind.OutOfMemory)!;
	int total = HEAD + n + CANARY;
	*void raw = d.source().allocDirty(total)!;
	if zero {
		mem.fill(raw, 0, total);
	}
	*Header h = (*Header)(raw);
	h.size = n;
	h.site = impl.site();
	h.freed = "";
	h.prev = null;
	h.next = d.head;
	d.track(h) ?? {
		d.source().free(raw);
		return Error(errors.Kind.OutOfMemory);
	};
	if d.head |first| {
		first.prev = h;
	}
	d.head = h;
	if !zero {
		mem.fill(dataOf(h), 0xCD, n);
	}
	mem.fill(dataOf(h) + n, 0xFD, CANARY);
	d.liveBlocks++;
	return dataOf(h);
}

public func (*Debug d) alloc(int n) !*void {
	return d.obtain(n, true)!;
}

public func (*Debug d) allocDirty(int n) !*void {
	return d.obtain(n, false)!;
}

func (*Debug d) evict() {
	*Header old = d.ring[d.ringStart]!!;
	verifyPoison(old);
	d.ringStart = (d.ringStart + 1) % len(d.ring);
	d.ringCount--;
	d.source().free(old);
}

public func (*Debug d) free(?*void p) {
	*void block = p ?? return;
	uint at = uint(block) - HEAD;
	if d.find(at) < 0 {
		d.reject(block, "double free", "free of a pointer into the middle of a block: free the pointer the allocator gave", "free of a pointer that is not a block of this allocator: a stack or global address, or a block of another allocator");
	}
	*Header h = headerOf(block);
	verifyCanary(h);
	if h.prev |before| {
		before.next = h.next;
	} else {
		d.head = h.next;
	}
	if h.next |after| {
		after.prev = h.prev;
	}
	d.untrack(at);
	h.freed = impl.site();
	mem.fill(dataOf(h), 0xDD, h.size);
	d.liveBlocks--;
	if d.ringCount == len(d.ring) {
		d.evict();
	}
	d.ring[(d.ringStart + d.ringCount) % len(d.ring)] = h;
	d.ringCount++;
}

public func (*Debug d) realloc(?*void p, int old, int n) !*void {
	*void block = p ?? return d.obtain(n, true)!;
	if d.find(uint(block) - HEAD) < 0 {
		d.reject(block, "realloc of a freed block", "realloc of a pointer into the middle of a block: use the pointer the allocator gave", "realloc of a pointer that is not a block of this allocator: a stack or global address, or a block of another allocator");
	}
	*Header h = headerOf(block);
	if h.size != old {
		fail(h, "realloc with a size that is not the size of the block");
	}
	return block if n == old;
	*void next = d.obtain(n, true)!;
	mem.copy(next, block, old < n ? old : n);
	d.free(block);
	return next;
}

public func (*Debug d) check() {
	for i in 0..d.ringCount - 1 {
		verifyPoison(d.ring[(d.ringStart + i) % len(d.ring)]!!);
	}
	?*Header c = d.head;
	loop c |h| {
		c = h.next;
		verifyCanary(h);
	}
}

public func (*Debug d) release() {
	loop d.ringCount > 0 {
		d.evict();
	}
	if len(d.table) > 0 {
		raw.release(d.table);
		d.table = .{};
		d.entries = 0;
		d.tombs = 0;
	}
}

internal func (*Debug d) sizeOf(*void p) int {
	if d.find(uint(p) - HEAD) < 0 {
		d.reject(p, "use of a freed block", "a pointer into the middle of a block", "a pointer that is not a block of this allocator");
	}
	return headerOf(p).size;
}

public inline func (*Debug d) blocks() int {
	return d.liveBlocks;
}

public func (*Debug d) report() int {
	d.check();

	[64]string sites;
	[64]int counts, bytes;
	int groups, others;

	?*Header c = d.head;
	loop c |h| {
		c = h.next;
		int j;
		loop j < groups && sites[j] != h.site {
			j++;
		}
		if j == groups {
			if groups == len(sites) {
				others++;
				continue;
			}
			sites[j] = h.site;
			groups++;
		}
		counts[j]++;
		bytes[j] += h.size;
	}

	int k;
	loop k < groups {
		fmt.fprintf(2, "leak: {} blocks, {} bytes, allocated at\n", counts[k], bytes[k])!!;
		fmt.fprint(2, sites[k]);
		k++;
	}
	if others > 0 {
		fmt.fprintf(2, "leak: {} more blocks from other places\n", others)!!;
	}
	return d.liveBlocks;
}
