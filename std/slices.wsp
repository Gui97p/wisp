#standalone
import "std/math";

/// The position of the first element equal to `want`, or -1 when there is none.
/// The elements are compared with ==: numbers, strings, enums, pointers, and
/// structs that have an eq method.
#must_use
public func indexOf<Comparable T>([]T items, T want) ?int {
	for i, item in items {
		if item == want => return i;
	}
	return null;
}

/// Whether some element is equal to `want`.
public inline func contains<Comparable T>([]T items, T want) bool => (indexOf(items, want) ?? -1) >= 0;

func siftDown<Orderable T>([]T items, int start, int end) {
	int root = start;
	loop {
		int child = root * 2 + 1;
		if child > end => return;
		if child + 1 <= end && items[child] < items[child + 1] => child++;
		if !(items[root] < items[child]) => return;
		items[root], items[child] = items[child], items[root];
		root = child;
	}
}

/// Puts the elements in ascending order, in place. The elements are compared
/// with <: numbers, strings, and structs that have a less method. Equal elements
/// can end up in any order, and the time is n log n whatever the input.
public func sort<Orderable T>([]T items) {
	int n = len(items);
	if n < 2 => return;

	for start in (n / 2 - 1..=0).step(-1) {
		siftDown(items, start, n - 1);
	}
	for end in (n - 1..=1).step(-1) {
		items[0], items[end] = items[end], items[0];
		siftDown(items, 0, end - 1);
	}
}

/// Reverses the order of the elements, in place.
public func reverse<T>([]T items) {
	int n = len(items);
	if n < 2 => return;
	for i in 0..n / 2 {
		items[i], items[n - i - 1] = items[n - i - 1], items[i];
	}
}

/// Sets every element to `item`.
public func fill<T>([]T items, T item) {
	for k in &items {
		k@ = item;
	}
}

/// Copies elements from `src` into `dst` and gives how many were copied: the
/// smaller of the two lengths. The slices should not overlap.
public func copy<T>([]T dst, src) int {
	if len(dst) == 0 || len(src) == 0 => return 0;
	int count = math.min(len(dst), len(src));
	for i in 0..count {
		dst[i] = src[i];
	}
	return count;
}

/// Whether the two slices have the same length and equal elements, compared
/// with ==.
public func equal<Comparable T>([]T a, b) bool {
	if len(a) != len(b) => return false;
	for i in 0..len(a) {
		if a[i] != b[i] => return false;
	}
	return true;
}

/// The position of an element equal to `want` in a slice that is already in
/// ascending order (see `sort`), or null when there is none. With several equal
/// elements it can be any of them. The elements are compared with <.
public func binarySearch<Orderable T>([]T sorted, T want) ?int {
	int low = 0;
	int high = len(sorted) - 1;
	loop low <= high {
		int middle = low + (high - low) / 2;
		if sorted[middle] < want {
			low = middle + 1;
		} else if want < sorted[middle] {
			high = middle - 1;
		} else {
			return middle;
		}
	}
	return null;
}

/// The smallest element, or null when the slice is empty. The elements are
/// compared with <.
public func min<Orderable T>([]T items) ?T {
	if len(items) == 0 => return null;
	T m = items[0];
	for v in items[1..] {
		if v < m => m = v;
	}
	return m;
}

/// The largest element, or null when the slice is empty. The elements are
/// compared with <.
public func max<Orderable T>([]T items) ?T {
	if len(items) == 0 => return null;
	T m = items[0];
	for v in items[1..] {
		if v > m => m = v;
	}
	return m;
}
