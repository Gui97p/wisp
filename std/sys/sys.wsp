export const STDIN = 0;
export const STDOUT = 1;
export const STDERR = 2;

export func read(int fd, *char buf, int n) int {
	int r;
	native linux_x64(in fd, buf, n, out r) "mov rax, 0; mov rdi, {fd}; mov rsi, {buf}; mov rdx, {n}; syscall; mov {r}, rax";
	return r;
}

export func write(int fd, *char buf, int n) int {
    int r;
    native linux_x64(in fd, buf, n, out r) "mov rax, 1; mov rdi, {fd}; mov rsi, {buf}; mov rdx, {n}; syscall; mov {r}, rax";
	return r;
}

export func exit(int code) {
    native linux_x64(in code) "mov rax, 231; mov rdi, {code}; syscall";
    native lua(in code) "os.exit(code)";
}
