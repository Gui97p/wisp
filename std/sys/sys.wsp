internal const {
	O_RDONLY = 0;
	O_WRONLY = 1;
	O_RDWR = 2;
	O_CREAT = 64;
	O_EXCL = 128;
	O_TRUNC = 512;
	O_APPEND = 1024;

	SEEK_SET = 0;
	SEEK_CUR = 1;
	SEEK_END = 2;

	CLOCK_REALTIME = 0;
	CLOCK_MONOTONIC = 1;

	KIND_FILE = 0;
	KIND_DIR = 1;
	KIND_LINK = 2;
	KIND_PIPE = 3;
	KIND_SOCKET = 4;
	KIND_DEVICE = 5;
	KIND_OTHER = 6;

	EPERM = 1;
	ENOENT = 2;
	EINTR = 4;
	EIO = 5;
	EBADF = 9;
	ENOMEM = 12;
	EACCES = 13;
	EBUSY = 16;
	EEXIST = 17;
	ENOTDIR = 20;
	EISDIR = 21;
	EINVAL = 22;
	ENOTTY = 25;
	ENOSPC = 28;
	EPIPE = 32;
	ERANGE = 34;
	ENAMETOOLONG = 36;
	ENOSYS = 38;
	ENOTEMPTY = 39;
}

internal struct Timespec {
	internal int tv_sec;
	internal int tv_nsec;
}

internal struct Stat {
	internal int kind;
	internal int size;
	internal int modified;
	internal int mode;
}

internal struct Entry {
	internal int kind;
	internal int len;
	internal [1024]byte name;
}

internal func errno(int raw) int {
	return -raw if raw < 0 && raw >= -4095;
	return 0;
}

internal native setExitHook(() => () hook) {
	extern __wisp_exit_hook;
	mov rax, hook;
	mov [rel __wisp_exit_hook], rax;
}
