shared const {
	O_RDONLY = 0;
	O_WRONLY = 1;
	O_RDWR = 2;
	O_CREAT = 64;
	O_EXCL = 128;
	O_TRUNC = 512;
	O_APPEND = 1024;

	SEEK_SET = 0;
	SEEK_CUR = 1;
	SEEK_END = 2;

	CLOCK_REALTIME = 0;
	CLOCK_MONOTONIC = 1;

	KIND_FILE = 0;
	KIND_DIR = 1;
	KIND_LINK = 2;
	KIND_OTHER = 3;

	EPERM = 1;
	ENOENT = 2;
	EINTR = 4;
	EIO = 5;
	EBADF = 9;
	ENOMEM = 12;
	EACCES = 13;
	EBUSY = 16;
	EEXIST = 17;
	ENOTDIR = 20;
	EISDIR = 21;
	EINVAL = 22;
	ENOTTY = 25;
	ENOSPC = 28;
	EPIPE = 32;
	ERANGE = 34;
	ENAMETOOLONG = 36;
	ENOSYS = 38;
	ENOTEMPTY = 39;
}

shared struct Timespec {
	int tv_sec;
	int tv_nsec;
}

shared struct Stat {
	int kind;
	int size;
	int modified;
	int mode;
}

shared struct Entry {
	int kind;
	int len;
	[1024]byte name;
}

shared func errno(int raw) int {
	if raw < 0 && raw >= -4095 {
		return -raw;
	}
	return 0;
}
