#target windows & x64

extern func GetStdHandle(int32 which) *void;
extern func ReadFile(*void file, *byte buf, uint32 n, *void read, ?*void overlapped) int32;
extern func ReadConsoleW(*void console, *uint16 text, uint32 n, *void read, ?*void control) int32;
extern func WriteConsoleW(*void console, *uint16 text, uint32 n, *void written, ?*void reserved) int32;
extern func WriteFile(*void file, *byte buf, uint32 n, *void written, ?*void overlapped) int32;
extern func CreateFileW(*uint16 name, uint32 access, uint32 share, ?*void security, uint32 disposition, uint32 flags, ?*void template) *void;
extern func CloseHandle(*void handle) int32;
extern func SetFilePointerEx(*void file, int64 distance, *void position, uint32 method) int32;
extern func FlushFileBuffers(*void file) int32;
extern func GetFileSizeEx(*void file, *void size) int32;
extern func GetFileType(*void file) uint32;
extern func DeleteFileW(*uint16 name) int32;
extern func RemoveDirectoryW(*uint16 name) int32;
extern func CreateDirectoryW(*uint16 name, ?*void security) int32;
extern func MoveFileExW(*uint16 from, *uint16 to, uint32 flags) int32;
extern func GetFileAttributesW(*uint16 name) uint32;
extern func GetFileAttributesExW(*uint16 name, int32 level, *void data) int32;
extern func FindFirstFileW(*uint16 pattern, *void data) *void;
extern func FindNextFileW(*void find, *void data) int32;
extern func FindClose(*void find) int32;
extern func GetCurrentDirectoryW(uint32 n, *uint16 buf) uint32;
extern func GetFullPathNameW(*uint16 name, uint32 n, *uint16 buf, ?*void part) uint32;
extern func GetEnvironmentStringsW() ?*void;
extern func FreeEnvironmentStringsW(*void block) int32;
extern func GetEnvironmentVariableW(*uint16 name, *uint16 buf, uint32 n) uint32;
extern func SetLastError(uint32 code);
extern func GetLastError() uint32;
extern func VirtualAlloc(?*void address, int64 size, uint32 kind, uint32 protect) ?*void;
extern func VirtualFree(*void address, int64 size, uint32 kind) int32;
extern func GetSystemTimePreciseAsFileTime(*void time);
extern func QueryPerformanceCounter(*void count) int32;
extern func QueryPerformanceFrequency(*void frequency) int32;
extern func Sleep(uint32 ms);
extern func GetConsoleMode(*void console, *void mode) int32;
extern func ExitProcess(uint32 code);
extern func BCryptGenRandom(?*void algorithm, *void buf, uint32 n, uint32 flags) int32;
extern func MultiByteToWideChar(uint32 page, uint32 flags, *byte text, int32 n, *uint16 wide, int32 room) int32;
extern func WideCharToMultiByte(uint32 page, uint32 flags, *uint16 wide, int32 n, *byte text, int32 room, ?*byte fallback, ?*void used) int32;

const {
	GENERIC_READ = 0x80000000;
	GENERIC_WRITE = 0x40000000;
	FILE_APPEND_DATA = 4;
	SHARE_ALL = 7;

	CREATE_NEW = 1;
	CREATE_ALWAYS = 2;
	OPEN_EXISTING = 3;
	OPEN_ALWAYS = 4;
	TRUNCATE_EXISTING = 5;

	ATTRIBUTE_READONLY = 1;
	ATTRIBUTE_DIRECTORY = 16;
	ATTRIBUTE_NORMAL = 128;
	ATTRIBUTE_REPARSE_POINT = 1024;
	INVALID_ATTRIBUTES = 0xFFFFFFFF;

	REPLACE_EXISTING = 1;
	CP_UTF8 = 65001;
	WIDE_MAX = 32768;
	LONG_PATH = 247;
	ENV_BYTES = 98304;
	CONV_BYTES = 16384;
	READ_UNITS = 4096;
	EPOCH_DIFFERENCE = 116444736000000000;

	MEM_COMMIT_RESERVE = 0x3000;
	MEM_RELEASE = 0x8000;
	PAGE_READWRITE = 4;
	RANDOM_SYSTEM = 2;

	ERROR_NO_MORE_FILES = 18;
	ERROR_BROKEN_PIPE = 109;
	ERROR_ENVVAR_NOT_FOUND = 203;
}

struct AttributeData {
	uint32 attributes;
	uint32 creationLow, creationHigh;
	uint32 accessLow, accessHigh;
	uint32 writeLow, writeHigh;
	uint32 sizeHigh, sizeLow;
}

struct FindData {
	uint32 attributes;
	uint32 creationLow, creationHigh;
	uint32 accessLow, accessHigh;
	uint32 writeLow, writeHigh;
	uint32 sizeHigh, sizeLow;
	uint32 reserved0, reserved1;
	[260]uint16 name;
	[14]uint16 alternate;
}

internal struct Env {
	internal ?*void block;
	internal ?*uint16 cursor;
}

internal struct Dir {
	internal int handle;
	internal int started;
	internal FindData data;
}

var ?*uint16 wideAp;
internal inline func wideA() *uint16 => wideAp.?;
var ?*uint16 wideBp;
internal inline func wideB() *uint16 => wideBp.?;
var ?*uint16 wideScratchp;
internal inline func wideScratch() *uint16 => wideScratchp.?;
var ?*uint16 wideValuep;
internal inline func wideValue() *uint16 => wideValuep.?;
var ?*byte envBufferp;
internal inline func envBuffer() *byte => envBufferp.?;
var [12]byte pendingBytes;
var [3]int pendingCount;
var ?*byte iterBufferp;
internal inline func iterBuffer() *byte => iterBufferp.?;
var ?*byte convBufferp;
internal inline func convBuffer() *byte => convBufferp.?;
var [8]byte inBytes;
var int inLeft;
var int inHigh;
var int inReturn;

internal func winerr(int code) int {
	return match code {
		2, 3, 15 => ENOENT;
		5, 19, 33 => EACCES;
		6 => EBADF;
		8, 14 => ENOMEM;
		32 => EBUSY;
		80, 183 => EEXIST;
		87, 123, 161 => EINVAL;
		109, 232, 233 => EPIPE;
		112 => ENOSPC;
		145 => ENOTEMPTY;
		206 => ENAMETOOLONG;
		267 => ENOTDIR;
		1314 => EPERM;
		_ => EIO;
	};
}

internal func lastError() int {
	return -winerr(int(GetLastError()));
}

internal func handleError() int {
	int code = int(GetLastError());
	return -EBADF if code == 5;
	return -winerr(code);
}

internal func handleOf(int fd) *void {
	return GetStdHandle(int32(-10 - fd)) if fd >= 0 && fd <= 2;
	return (*void)(fd);
}

internal func buffers() int {
	return 0 if wideAp != null;
	int unit = WIDE_MAX * 2;
	*void block = VirtualAlloc(null, int64(unit * 4 + ENV_BYTES * 2 + CONV_BYTES), MEM_COMMIT_RESERVE, PAGE_READWRITE) ?? return -ENOMEM;
	*byte base = (*byte)(block);
	wideAp = (*uint16)(base);
	wideBp = (*uint16)(base + unit);
	wideScratchp = (*uint16)(base + unit * 2);
	wideValuep = (*uint16)(base + unit * 3);
	envBufferp = base + unit * 4;
	iterBufferp = base + unit * 4 + ENV_BYTES;
	convBufferp = base + unit * 4 + ENV_BYTES * 2;
	return 0;
}

internal func widePath(string path) int {
	int fault = buffers();
	return fault if fault < 0;
	return towide(path, wideA());
}

internal func isDevicePath(*uint16 p) bool {
	return p[0] == 92 && p[1] == 92 && (p[2] == 63 || p[2] == 46) && p[3] == 92;
}

internal func towide(string s, *uint16 dst) int {
	return -ENOENT if len(s) == 0;
	return -ENAMETOOLONG if len(s) >= WIDE_MAX - 16;
	int n = MultiByteToWideChar(CP_UTF8, 0, (*byte)(s), int32(len(s)), dst, int32(WIDE_MAX - 16));
	return -EINVAL if n <= 0;
	dst[n] = 0;
	return n if isDevicePath(dst);

	int room = WIDE_MAX - 16;
	int m = int(GetFullPathNameW(dst, uint32(room), wideScratch(), null));
	if m == 0 || m < LONG_PATH {
		return n;
	}
	return -ENAMETOOLONG if m >= room;

	int total;
	if wideScratch()[0] == 92 && wideScratch()[1] == 92 {
		dst[0] = 92;
		dst[1] = 92;
		dst[2] = 63;
		dst[3] = 92;
		dst[4] = 85;
		dst[5] = 78;
		dst[6] = 67;
		dst[7] = 92;
		for i in 2..m {
			dst[8 + i - 2] = wideScratch()[i];
		}
		total = 8 + m - 2;
	} else {
		dst[0] = 92;
		dst[1] = 92;
		dst[2] = 63;
		dst[3] = 92;
		for i in 0..m {
			dst[4 + i] = wideScratch()[i];
		}
		total = 4 + m;
	}
	dst[total] = 0;
	return total;
}

internal func isDirectory(*uint16 path) bool {
	uint32 attributes = GetFileAttributesW(path);
	return attributes != INVALID_ATTRIBUTES && (attributes & ATTRIBUTE_DIRECTORY) != 0;
}

internal func kindOf(uint32 attributes) int {
	return KIND_LINK if (attributes & ATTRIBUTE_REPARSE_POINT) != 0;
	return KIND_DIR if (attributes & ATTRIBUTE_DIRECTORY) != 0;
	return KIND_FILE;
}

internal func readConsole(*byte buf, int n) int {
	return 0 if n == 0;
	if inLeft > 0 {
		int k;
		loop k < inLeft && k < n {
			buf[k] = inBytes[k];
			k++;
		}
		int rest = inLeft - k;
		if rest > 0 {
			for i in 0..rest {
				inBytes[i] = inBytes[k + i];
			}
		}
		inLeft = rest;
		return k;
	}
	return -ENOMEM if buffers() < 0;

	loop {
		int want = n / 3;
		if want < 1 {
			want = 1;
		}
		if want > READ_UNITS {
			want = READ_UNITS;
		}
		int off;
		if inHigh != 0 {
			wideScratch()[0] = uint16(inHigh);
			inHigh = 0;
			off = 1;
		}
		uint32 got;
		*uint16 into = (*uint16)((*byte)(wideScratch()) + off * 2);
		return lastError() if ReadConsoleW(handleOf(0), into, uint32(want), &got, null) == 0;
		return 0 if got == 0;
		return 0 if off == 0 && wideScratch()[0] == 26;

		int count = off + int(got);
		int kept;
		for i in 0..count {
			int u = wideScratch()[i];
			if u == 13 {
				wideScratch()[kept] = 10;
				kept++;
				inReturn = 1;
			} else if u == 10 && inReturn == 1 {
				inReturn = 0;
			} else {
				wideScratch()[kept] = uint16(u);
				kept++;
				inReturn = 0;
			}
		}
		if kept > 0 {
			int last = wideScratch()[kept - 1];
			if last >= 0xD800 && last < 0xDC00 {
				inHigh = last;
				kept--;
			}
		}
		continue if kept == 0;

		int m = WideCharToMultiByte(CP_UTF8, 0, wideScratch(), int32(kept), convBuffer(), int32(CONV_BYTES), null, null);
		return -EINVAL if m <= 0;
		int copied = m > n ? n : m;
		for i in 0..copied {
			buf[i] = convBuffer()[i];
		}
		int rest = m - copied;
		for i in 0..rest {
			inBytes[i] = convBuffer()[copied + i];
		}
		inLeft = rest > 0 ? rest : 0;
		return copied;
	}
}

internal func read(int fd, *byte buf, int n) int {
	return readConsole(buf, n) if fd == 0 && isConsole(0);
	uint32 got;
	if ReadFile(handleOf(fd), buf, uint32(n), &got, null) == 0 {
		return 0 if int(GetLastError()) == ERROR_BROKEN_PIPE;
		return handleError();
	}
	return int(got);
}

internal func isConsole(int fd) bool {
	uint32 mode;
	return GetConsoleMode(handleOf(fd), &mode) != 0;
}

internal func sequenceLength(byte lead) int {
	return 4 if lead >= 0xF0 && lead < 0xF8;
	return 3 if lead >= 0xE0 && lead < 0xF0;
	return 2 if lead >= 0xC0 && lead < 0xE0;
	return 1;
}

internal func emitWide(int fd, *byte p, int n) int {
	return 0 if n == 0;
	return -ENOMEM if buffers() < 0;
	int m = MultiByteToWideChar(CP_UTF8, 0, p, int32(n), wideScratch(), int32(WIDE_MAX - 16));
	return -EINVAL if m <= 0;
	uint32 done;
	return lastError() if WriteConsoleW(handleOf(fd), wideScratch(), uint32(m), &done, null) == 0;
	return 0;
}

internal func writeConsole(int fd, *byte buf, int n) int {
	int i;
	int held = pendingCount[fd];
	if held > 0 {
		[4]byte joined;
		for k in 0..held {
			joined[k] = pendingBytes[fd * 4 + k];
		}
		int need = sequenceLength(joined[0]);
		loop held < need && i < n {
			joined[held] = buf[i];
			held++;
			i++;
		}
		if held < need {
			for k in 0..held {
				pendingBytes[fd * 4 + k] = joined[k];
			}
			pendingCount[fd] = held;
			return n;
		}
		pendingCount[fd] = 0;
		int r = emitWide(fd, (*byte)(joined), held);
		return r if r < 0;
	}

	int tail = n;
	int j = n - 1;
	loop j >= i && n - j <= 3 && (buf[j] & 0xC0) == 0x80 {
		j--;
	}
	if j >= i && buf[j] >= 0xC0 && n - j < sequenceLength(buf[j]) {
		tail = j;
	}

	int pos = i;
	loop pos < tail {
		int end = tail;
		if end - pos > 16384 {
			end = pos + 16384;
			loop end > pos && (buf[end] & 0xC0) == 0x80 {
				end--;
			}
			if end == pos {
				end = pos + 16384;
			}
		}
		int r = emitWide(fd, buf + pos, end - pos);
		return r if r < 0;
		pos = end;
	}

	int rest = n - tail;
	if rest > 0 {
		for k in 0..rest {
			pendingBytes[fd * 4 + k] = buf[tail + k];
		}
	}
	pendingCount[fd] = rest;
	return n;
}

internal func write(int fd, *byte buf, int n) int {
	if (fd == 1 || fd == 2) && isConsole(fd) {
		return writeConsole(fd, buf, n);
	}
	uint32 done;
	return handleError() if WriteFile(handleOf(fd), buf, uint32(n), &done, null) == 0;
	return int(done);
}

internal func open(string path, int flags) int {
	int n = widePath(path);
	return n if n < 0;

	int mode = flags & 3;
	int access = 0;
	if mode == O_RDONLY || mode == O_RDWR {
		access |= GENERIC_READ;
	}
	if mode == O_WRONLY || mode == O_RDWR {
		access |= GENERIC_WRITE;
	}
	if (flags & O_APPEND) != 0 && mode != O_RDONLY {
		access = (access & ~GENERIC_WRITE) | FILE_APPEND_DATA;
	}

	bool create = (flags & O_CREAT) != 0;
	bool truncate = (flags & O_TRUNC) != 0;
	int disposition = OPEN_EXISTING;
	if create && (flags & O_EXCL) != 0 {
		disposition = CREATE_NEW;
	} else if create && truncate {
		disposition = CREATE_ALWAYS;
	} else if create {
		disposition = OPEN_ALWAYS;
	} else if truncate {
		disposition = TRUNCATE_EXISTING;
	}

	*void h = CreateFileW(wideA(), uint32(access), SHARE_ALL, null, uint32(disposition), ATTRIBUTE_NORMAL, null);
	if int(h) == -1 {
		int code = int(GetLastError());
		return -EISDIR if code == 5 && isDirectory(wideA());
		return -winerr(code);
	}
	return int(h);
}

internal func close(int fd) int {
	return 0 if fd >= 0 && fd <= 2;
	return lastError() if CloseHandle((*void)(fd)) == 0;
	return 0;
}

internal func seek(int fd, offset, whence) int {
	int position;
	return lastError() if SetFilePointerEx(handleOf(fd), int64(offset), &position, uint32(whence)) == 0;
	return position;
}

internal func sync(int fd) int {
	return lastError() if FlushFileBuffers(handleOf(fd)) == 0;
	return 0;
}

internal func size(int fd) int {
	int total;
	return lastError() if GetFileSizeEx(handleOf(fd), &total) == 0;
	return total;
}

internal func kind(int fd) int {
	return match GetFileType(handleOf(fd)) {
		1 => KIND_FILE;
		2 => KIND_DEVICE;
		3 => KIND_PIPE;
		_ => KIND_OTHER;
	};
}

internal func remove(string path) int {
	int n = widePath(path);
	return n if n < 0;
	if DeleteFileW(wideA()) == 0 {
		int code = int(GetLastError());
		return -EISDIR if code == 5 && isDirectory(wideA());
		return -winerr(code);
	}
	return 0;
}

internal func rmdir(string path) int {
	int n = widePath(path);
	return n if n < 0;
	return lastError() if RemoveDirectoryW(wideA()) == 0;
	return 0;
}

internal func mkdir(string path) int {
	int n = widePath(path);
	return n if n < 0;
	return lastError() if CreateDirectoryW(wideA(), null) == 0;
	return 0;
}

internal func rename(string from, string to) int {
	int n = widePath(from);
	return n if n < 0;
	n = towide(to, wideB());
	return n if n < 0;
	return lastError() if MoveFileExW(wideA(), wideB(), REPLACE_EXISTING) == 0;
	return 0;
}

internal func stat(string path, *Stat out) int {
	int n = widePath(path);
	return n if n < 0;
	AttributeData d;
	return lastError() if GetFileAttributesExW(wideA(), 0, &d) == 0;
	out.kind = kindOf(d.attributes);
	out.size = (int(d.sizeHigh) << 32) | int(d.sizeLow);
	int written = ((int(d.writeHigh) << 32) | int(d.writeLow)) - EPOCH_DIFFERENCE;
	out.modified = written * 100;
	if out.kind == KIND_DIR {
		out.mode = 0o755;
	} else if (d.attributes & ATTRIBUTE_READONLY) != 0 {
		out.mode = 0o444;
	} else {
		out.mode = 0o644;
	}
	return 0;
}

internal func dirOpen(string path, *Dir d) int {
	int n = widePath(path);
	return n if n < 0;
	uint32 attributes = GetFileAttributesW(wideA());
	return lastError() if attributes == INVALID_ATTRIBUTES;
	return -ENOTDIR if (attributes & ATTRIBUTE_DIRECTORY) == 0;
	return -ENAMETOOLONG if n + 2 >= WIDE_MAX;
	if wideA()[n - 1] != 92 && wideA()[n - 1] != 47 {
		wideA()[n] = 92;
		n++;
	}
	wideA()[n] = 42;
	wideA()[n + 1] = 0;

	*void h = FindFirstFileW(wideA(), &d.data);
	return lastError() if int(h) == -1;
	d.handle = int(h);
	d.started = 0;
	return 0;
}

internal func dirNext(*Dir d, *Entry e) int {
	loop {
		if d.started == 0 {
			d.started = 1;
		} else if FindNextFileW((*void)(d.handle), &d.data) == 0 {
			int code = int(GetLastError());
			return code == ERROR_NO_MORE_FILES ? 0 : -winerr(code);
		}

		int n = WideCharToMultiByte(CP_UTF8, 0, (*uint16)(d.data.name), -1, (*byte)(e.name), 1024, null, null);
		return -EIO if n <= 0;
		int size = n - 1;
		continue if size == 1 && e.name[0] == '.';
		continue if size == 2 && e.name[0] == '.' && e.name[1] == '.';

		e.len = size;
		e.kind = kindOf(d.data.attributes);
		return 1;
	}
}

internal func dirClose(*Dir d) int {
	return lastError() if FindClose((*void)(d.handle)) == 0;
	return 0;
}

internal func getcwd([]byte buf) int {
	int fault = buffers();
	return fault if fault < 0;
	int n = int(GetCurrentDirectoryW(uint32(WIDE_MAX), wideA()));
	return lastError() if n == 0;
	return -ERANGE if n >= WIDE_MAX;
	int r = WideCharToMultiByte(CP_UTF8, 0, wideA(), int32(n), (*byte)(buf), int32(len(buf)), null, null);
	return -ERANGE if r == 0;
	return r;
}

internal func getenv(string name) ?string {
	return null if widePath(name) < 0;
	SetLastError(0);
	int n = int(GetEnvironmentVariableW(wideA(), wideValue(), uint32(WIDE_MAX)));
	if n == 0 {
		return "" if int(GetLastError()) != ERROR_ENVVAR_NOT_FOUND;
		return null;
	}
	return null if n >= WIDE_MAX;
	int r = WideCharToMultiByte(CP_UTF8, 0, wideValue(), int32(n), envBuffer(), ENV_BYTES, null, null);
	return null if r == 0;
	return string(envBuffer()[..r]);
}

internal native args() []string s {
	extern __wisp_args_ptr;
	extern __wisp_args_len;
	mov rax, [rel __wisp_args_ptr];
	mov s.ptr, rax;
	mov rax, [rel __wisp_args_len];
	mov s.len, rax;
}

internal func time(int clock) (int, int) {
	if clock == CLOCK_REALTIME {
		int ft;
		GetSystemTimePreciseAsFileTime(&ft);
		int t = ft - EPOCH_DIFFERENCE;
		return t / 10_000_000, (t % 10_000_000) * 100;
	}
	int frequency, count;
	QueryPerformanceFrequency(&frequency);
	QueryPerformanceCounter(&count);
	return count / frequency, (count % frequency) * 1_000_000_000 / frequency;
}

internal func sleep(int sec, nsec) int {
	int ms = sec * 1000 + (nsec + 999_999) / 1_000_000;
	loop ms > 0 {
		int step = ms > 0x7fffffff ? 0x7fffffff : ms;
		Sleep(uint32(step));
		ms -= step;
	}
	return 0;
}

internal func random(*void buf, int n) int {
	return -EIO if BCryptGenRandom(null, buf, uint32(n), RANDOM_SYSTEM) != 0;
	return n;
}

internal func isatty(int fd) bool {
	uint32 mode;
	return GetConsoleMode(handleOf(fd), &mode) != 0;
}

internal func exit(int code) {
	ExitProcess(uint32(code));
}

internal func mmap(int n) ?*void {
	return VirtualAlloc(null, int64(n), MEM_COMMIT_RESERVE, PAGE_READWRITE);
}

internal func munmap(*void addr, int _n) int {
	return -EINVAL if VirtualFree(addr, 0, MEM_RELEASE) == 0;
	return 0;
}

internal func envOpen(*Env e) {
	e.block = GetEnvironmentStringsW();
	e.cursor = (?*uint16)(e.block);
}

internal func envNext(*Env e) ?string {
	*uint16 cursor = e.cursor ?? return null;
	return null if buffers() < 0;
	loop {
		if cursor[0] == 0 {
			e.cursor = cursor;
			return null;
		}
		int n;
		loop cursor[n] != 0 {
			n++;
		}
		*uint16 entry = cursor;
		cursor = (*uint16)((*byte)(cursor) + (n + 1) * 2);
		e.cursor = cursor;
		continue if entry[0] == 61;
		int r = WideCharToMultiByte(CP_UTF8, 0, entry, int32(n), iterBuffer(), ENV_BYTES, null, null);
		continue if r == 0;
		return string(iterBuffer()[..r]);
	}
}

internal func envClose(*Env e) {
	if e.block |block| {
		FreeEnvironmentStringsW(block);
	}
	e.block = null;
	e.cursor = null;
}
