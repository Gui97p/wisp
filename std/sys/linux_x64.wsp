#target linux && x64

import "std/sys";

const {
	SYS_READ = 0;
	SYS_WRITE = 1;
	SYS_CLOSE = 3;
	SYS_FSTAT = 5;
	SYS_LSEEK = 8;
	SYS_MMAP = 9;
	SYS_MUNMAP = 11;
	SYS_IOCTL = 16;
	SYS_NANOSLEEP = 35;
	SYS_GETDENTS64 = 217;
	SYS_GETCWD = 79;
	SYS_FSYNC = 74;
	SYS_EXIT_GROUP = 231;
	SYS_OPENAT = 257;
	SYS_MKDIRAT = 258;
	SYS_NEWFSTATAT = 262;
	SYS_UNLINKAT = 263;
	SYS_RENAMEAT = 264;
	SYS_CLOCK_GETTIME = 228;
	SYS_GETRANDOM = 318;

	AT_FDCWD = -100;

	PROT_READ = 1;
	PROT_WRITE = 2;
	PROT_RW = PROT_READ | PROT_WRITE;

	MAP_PRIVATE = 2;
	MAP_ANONYMOUS = 32;
	MAP_PRIVATE_ANON = MAP_PRIVATE | MAP_ANONYMOUS;

	TCGETS = 0x5401;

	O_DIRECTORY = 65536;
	O_CLOEXEC = 524288;
	AT_REMOVEDIR = 512;

	S_IFMT = 0o170000;
	S_IFREG = 0o100000;
	S_IFDIR = 0o040000;
	S_IFLNK = 0o120000;

	DT_DIR = 4;
	DT_REG = 8;
	DT_LNK = 10;
	PATH_MAX = 4096;

	NO_FD = -1;
}

struct StatBuf {
	uint64 st_dev;
	uint64 st_ino;
	uint64 st_nlink;

	uint32 st_mode;
	uint32 st_uid;
	uint32 st_gid;
	uint32 pad0;

	uint64 st_rdev;
	int st_size;
	int st_blksize;
	int st_blocks;

	sys.Timespec st_atim;
	sys.Timespec st_mtim;
	sys.Timespec st_ctim;

	int __reserved0;
	int __reserved1;
	int __reserved2;
}

shared struct Dir {
	int fd;
	int pos, len;
	[4096]byte buf;
}

shared native read(int fd, *byte buf, int n) int r =>
		"mov eax, {SYS_READ}; mov rdi, {fd}; mov rsi, {buf}; mov rdx, {n}; syscall; mov {r}, rax";

shared native write(int fd, *byte buf, int n) int r =>
		"mov eax, {SYS_WRITE}; mov rdi, {fd}; mov rsi, {buf}; mov rdx, {n}; syscall; mov {r}, rax";

internal native rawOpen(*byte path, int flags, int mode) int fd =>
		"mov eax, {SYS_OPENAT}; mov rdi, {AT_FDCWD}; mov rsi, {path}; mov rdx, {flags}; mov r10, {mode}; syscall; mov {fd}, rax";

shared native close(int fd) int r =>
		"mov eax, {SYS_CLOSE}; mov rdi, {fd}; syscall; mov {r}, rax";

shared native seek(int fd, offset, whence) int off =>
		"mov eax, {SYS_LSEEK}; mov rdi, {fd}; mov rsi, {offset}; mov rdx, {whence}; syscall; mov {off}, rax";

shared native sync(int fd) int r =>
		"mov eax, {SYS_FSYNC}; mov rdi, {fd}; syscall; mov {r}, rax";

shared func size(int fd) int {
	StatBuf stat;
	int r;
	native(in fd, stat, out r) "mov eax, {SYS_FSTAT}; mov rdi, {fd}; lea rsi, {&stat}; syscall; mov {r}, rax";
	return r < 0 ? r : stat.st_size;
}

internal native rawRemove(*byte path, int flags) int r =>
		"mov eax, {SYS_UNLINKAT}; mov rdi, {AT_FDCWD}; mov rsi, {path}; mov rdx, {flags}; syscall; mov {r}, rax";

shared native mmap(int len) *void r =>
		"mov eax, {SYS_MMAP}; xor edi, edi; mov rsi, {len}; mov rdx, {PROT_RW}; mov r10, {MAP_PRIVATE_ANON}; mov r8, {NO_FD}; xor r9d, r9d; syscall; mov {r}, rax";

shared native munmap(*void addr, int len) int r =>
		"mov eax, {SYS_MUNMAP}; mov rdi, {addr}; mov rsi, {len}; syscall; mov {r}, rax";

shared func time(int clock) (int, int) {
	sys.Timespec ts;
	native(in clock, ts) "mov eax, {SYS_CLOCK_GETTIME}; mov rdi, {clock}; lea rsi, {&ts}; syscall";
	return ts.tv_sec, ts.tv_nsec;
}

shared func sleep(int sec, nsec) int {
	sys.Timespec req = sys.Timespec{tv_sec: sec, tv_nsec: nsec};
	int r;
	native(in req, out r) "mov eax, {SYS_NANOSLEEP}; lea rdi, {&req}; xor esi, esi; syscall; mov {r}, rax";
	return r;
}

shared native random(*void buf, int n) int r =>
		"mov eax, {SYS_GETRANDOM}; mov rdi, {buf}; mov rsi, {n}; xor edx, edx; syscall; mov {r}, rax";

shared func isatty(int fd) bool {
	[64]byte termios;
	int r;
	native(in fd, termios, out r) "mov eax, {SYS_IOCTL}; mov rdi, {fd}; mov rsi, {TCGETS}; lea rdx, {&termios}; syscall; mov {r}, rax";
	return r == 0;
}

shared native exit(int code) => "mov eax, {SYS_EXIT_GROUP}; mov rdi, {code}; syscall";

internal native rawMkdir(*byte path, int mode) int r =>
		"mov eax, {SYS_MKDIRAT}; mov rdi, {AT_FDCWD}; mov rsi, {path}; mov rdx, {mode}; syscall; mov {r}, rax";

internal native rawRename(*byte from, to) int r =>
		"mov eax, {SYS_RENAMEAT}; mov rdi, {AT_FDCWD}; mov rsi, {from}; mov rdx, {AT_FDCWD}; mov r10, {to}; syscall; mov {r}, rax";

internal native rawStat(*byte path, *void buf) int r =>
		"mov eax, {SYS_NEWFSTATAT}; mov rdi, {AT_FDCWD}; mov rsi, {path}; mov rdx, {buf}; xor r10, r10; syscall; mov {r}, rax";

internal native getdents(int fd, *byte buf, int n) int r =>
		"mov eax, {SYS_GETDENTS64}; mov rdi, {fd}; mov rsi, {buf}; mov rdx, {n}; syscall; mov {r}, rax";

internal native rawGetcwd(*byte buf, int n) int r =>
		"mov eax, {SYS_GETCWD}; mov rdi, {buf}; mov rsi, {n}; syscall; mov {r}, rax";

internal native environ() **byte r =>
		"extern __wisp_envp; mov rax, [rel __wisp_envp]; mov {r}, rax";

shared native args() []string s =>
	"extern __wisp_args_ptr; extern __wisp_args_len; mov rax, [rel __wisp_args_ptr]; mov {s.ptr}, rax; mov rax, [rel __wisp_args_len]; mov {s.len}, rax";

internal func cpath(*byte buf, string p) int {
	if len(p) >= PATH_MAX {
		return -sys.ENAMETOOLONG;
	}
	for i, c in p {
		buf[i] = c;
	}
	buf[len(p)] = '\0';
	return 0;
}

shared func open(string path, int flags) int {
	[4096]byte buf;
	int r = cpath((*byte)(buf), path);
	if r < 0 {
		return r;
	}
	return rawOpen((*byte)(buf), flags | O_CLOEXEC, 0o644);
}

shared func remove(string path) int {
	[4096]byte buf;
	int r = cpath((*byte)(buf), path);
	if r < 0 {
		return r;
	}
	return rawRemove((*byte)(buf), 0);
}

shared func rmdir(string path) int {
	[4096]byte buf;
	int r = cpath((*byte)(buf), path);
	if r < 0 {
		return r;
	}
	return rawRemove((*byte)(buf), AT_REMOVEDIR);
}

shared func mkdir(string path) int {
	[4096]byte buf;
	int r = cpath((*byte)(buf), path);
	if r < 0 {
		return r;
	}
	return rawMkdir((*byte)(buf), 0o755);
}

shared func rename(string from, string to) int {
	[4096]byte fromBuf, toBuf;
	int r = cpath((*byte)(fromBuf), from);
	if r < 0 {
		return r;
	}
	r = cpath((*byte)(toBuf), to);
	if r < 0 {
		return r;
	}
	return rawRename((*byte)(fromBuf), (*byte)(toBuf));
}

shared func stat(string path, *sys.Stat out) int {
	[4096]byte buf;
	int r = cpath((*byte)(buf), path);
	if r < 0 {
		return r;
	}
	StatBuf s;
	r = rawStat((*byte)(buf), &s);
	if r < 0 {
		return r;
	}
	out.kind = switch int(s.st_mode) & S_IFMT {
		case S_IFREG => sys.KIND_FILE;
		case S_IFDIR => sys.KIND_DIR;
		case S_IFLNK => sys.KIND_LINK;
		default => sys.KIND_OTHER;
	};
	out.size = s.st_size;
	out.modified = s.st_mtim.tv_sec * 1_000_000_000 + s.st_mtim.tv_nsec;
	out.mode = int(s.st_mode) & 0o7777;
	return 0;
}

shared func dirOpen(string path, *Dir d) int {
	int fd = open(path, sys.O_RDONLY | O_DIRECTORY);
	if fd < 0 {
		return fd;
	}
	d.fd = fd;
	d.pos = 0;
	d.len = 0;
	return 0;
}

shared func dirNext(*Dir d, *sys.Entry e) int {
	loop {
		if d.pos >= d.len {
			int r = getdents(d.fd, (*byte)(d.buf), len(d.buf));
			if r <= 0 {
				return r;
			}
			d.len = r;
			d.pos = 0;
		}

		int pos = d.pos;
		int start = pos + 19;
		int end = start;
		loop d.buf[end] != '\0' {
			end++;
		}
		int kind = d.buf[pos + 18];
		d.pos = pos + (int(d.buf[pos + 16]) | int(d.buf[pos + 17]) << 8);

		int n = end - start;
		if n == 1 && d.buf[start] == '.' {
			continue;
		}
		if n == 2 && d.buf[start] == '.' && d.buf[start + 1] == '.' {
			continue;
		}

		for i in 0..n {
			e.name[i] = d.buf[start + i];
		}
		e.len = n;
		e.kind = switch kind {
			case DT_REG => sys.KIND_FILE;
			case DT_DIR => sys.KIND_DIR;
			case DT_LNK => sys.KIND_LINK;
			default => sys.KIND_OTHER;
		};
		return 1;
	}
}

shared func dirClose(*Dir d) {
	close(d.fd);
}

shared func getcwd([]byte buf) int {
	int r = rawGetcwd((*byte)(buf), len(buf));
	return r < 0 ? r : r - 1;
}

shared func getenv(string name) (string, bool) {
	**byte env = environ();
	if env == null {
		return "", false;
	}
	for i in 0..1000000 {
		*byte entry = env[i];
		if entry == null {
			break;
		}
		int n;
		loop entry[n] != '\0' {
			n++;
		}
		string line = string(entry[:n]);
		if len(line) > len(name) && line[len(name)] == '=' && line[:len(name)] == name {
			return line[len(name)+1:], true;
		}
	}
	return "", false;
}
