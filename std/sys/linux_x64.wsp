#target linux & x64

const {
	SYS_READ = 0;
	SYS_WRITE = 1;
	SYS_CLOSE = 3;
	SYS_FSTAT = 5;
	SYS_LSEEK = 8;
	SYS_MMAP = 9;
	SYS_MUNMAP = 11;
	SYS_IOCTL = 16;
	SYS_NANOSLEEP = 35;
	SYS_GETDENTS64 = 217;
	SYS_GETCWD = 79;
	SYS_FSYNC = 74;
	SYS_EXIT_GROUP = 231;
	SYS_OPENAT = 257;
	SYS_MKDIRAT = 258;
	SYS_NEWFSTATAT = 262;
	SYS_UNLINKAT = 263;
	SYS_RENAMEAT = 264;
	SYS_CLOCK_GETTIME = 228;
	SYS_GETRANDOM = 318;

	AT_FDCWD = -100;

	PROT_READ = 1;
	PROT_WRITE = 2;
	PROT_RW = PROT_READ | PROT_WRITE;

	MAP_PRIVATE = 2;
	MAP_ANONYMOUS = 32;
	MAP_PRIVATE_ANON = MAP_PRIVATE | MAP_ANONYMOUS;

	TCGETS = 0x5401;

	O_DIRECTORY = 65536;
	O_CLOEXEC = 524288;
	AT_REMOVEDIR = 512;

	S_IFMT = 0o170000;
	S_IFREG = 0o100000;
	S_IFDIR = 0o040000;
	S_IFLNK = 0o120000;
	S_IFIFO = 0o010000;
	S_IFCHR = 0o020000;
	S_IFBLK = 0o060000;
	S_IFSOCK = 0o140000;

	DT_FIFO = 1;
	DT_CHR = 2;
	DT_DIR = 4;
	DT_BLK = 6;
	DT_REG = 8;
	DT_LNK = 10;
	DT_SOCK = 12;
	PATH_MAX = 4096;

	NO_FD = -1;
}

struct StatBuf {
	uint64 st_dev;
	uint64 st_ino;
	uint64 st_nlink;

	uint32 st_mode;
	uint32 st_uid;
	uint32 st_gid;
	uint32 pad0;

	uint64 st_rdev;
	int st_size;
	int st_blksize;
	int st_blocks;

	Timespec st_atim;
	Timespec st_mtim;
	Timespec st_ctim;

	int __reserved0;
	int __reserved1;
	int __reserved2;
}

internal struct Env {
	internal int index;
}

internal struct Dir {
	internal int fd;
	internal int pos, len;
	internal [4096]byte buf;
}

internal native read(int fd, *byte buf, int n) int r {
	mov eax, SYS_READ;
	mov rdi, fd;
	mov rsi, buf;
	mov rdx, n;
	syscall;
	mov r, rax;
}

internal native write(int fd, *byte buf, int n) int r {
	mov eax, SYS_WRITE;
	mov rdi, fd;
	mov rsi, buf;
	mov rdx, n;
	syscall;
	mov r, rax;
}

internal native rawOpen(*byte path, int flags, int mode) int fd {
	mov eax, SYS_OPENAT;
	mov rdi, AT_FDCWD;
	mov rsi, path;
	mov rdx, flags;
	mov r10, mode;
	syscall;
	mov fd, rax;
}

internal native close(int fd) int r {
	mov eax, SYS_CLOSE;
	mov rdi, fd;
	syscall;
	mov r, rax;
}

internal native seek(int fd, offset, whence) int off {
	mov eax, SYS_LSEEK;
	mov rdi, fd;
	mov rsi, offset;
	mov rdx, whence;
	syscall;
	mov off, rax;
}

internal native sync(int fd) int r {
	mov eax, SYS_FSYNC;
	mov rdi, fd;
	syscall;
	mov r, rax;
}

internal native fstat(int fd, *StatBuf out) int r {
	mov eax, SYS_FSTAT;
	mov rdi, fd;
	mov rsi, out;
	syscall;
	mov r, rax;
}

internal func size(int fd) int {
	StatBuf stat;
	int r = fstat(fd, &stat);
	return if r < 0 => r : stat.st_size;
}

internal func kind(int fd) int {
	StatBuf stat;
	int r = fstat(fd, &stat);
	return if r < 0 => r : kindOfMode(int(stat.st_mode));
}

func kindOfMode(int mode) int {
	return match mode & S_IFMT {
		S_IFREG => KIND_FILE;
		S_IFDIR => KIND_DIR;
		S_IFLNK => KIND_LINK;
		S_IFIFO => KIND_PIPE;
		S_IFSOCK => KIND_SOCKET;
		S_IFCHR, S_IFBLK => KIND_DEVICE;
		_ => KIND_OTHER;
	};
}

internal native rawRemove(*byte path, int flags) int r {
	mov eax, SYS_UNLINKAT;
	mov rdi, AT_FDCWD;
	mov rsi, path;
	mov rdx, flags;
	syscall;
	mov r, rax;
}

internal native rawMmap(int len) *void r {
	mov eax, SYS_MMAP;
	xor edi, edi;
	mov rsi, len;
	mov rdx, PROT_RW;
	mov r10, MAP_PRIVATE_ANON;
	mov r8, NO_FD;
	xor r9d, r9d;
	syscall;
	mov r, rax;
}

internal func mmap(int len) ?*void {
	*void r = rawMmap(len);
	if int(r) in -4095..=-1 => return null;
	return r;
}

internal native munmap(*void addr, int len) int r {
	mov eax, SYS_MUNMAP;
	mov rdi, addr;
	mov rsi, len;
	syscall;
	mov r, rax;
}

internal func time(int clock) (int, int) {
	Timespec ts;
	native {
		mov eax, SYS_CLOCK_GETTIME;
		mov rdi, clock;
		lea rsi, &ts;
		syscall;
	}
	return ts.tv_sec, ts.tv_nsec;
}

internal func sleep(int sec, nsec) int {
	Timespec req = Timespec{tv_sec: sec, tv_nsec: nsec};
	int r;
	native {
		mov eax, SYS_NANOSLEEP;
		lea rdi, &req;
		xor esi, esi;
		syscall;
		mov r, rax;
	}
	return r;
}

internal native random(*void buf, int n) int r {
	mov eax, SYS_GETRANDOM;
	mov rdi, buf;
	mov rsi, n;
	xor edx, edx;
	syscall;
	mov r, rax;
}

internal func isatty(int fd) bool {
	[64]byte termios;
	int r;
	native {
		mov eax, SYS_IOCTL;
		mov rdi, fd;
		mov rsi, TCGETS;
		lea rdx, &termios;
		syscall;
		mov r, rax;
	}
	return r == 0;
}

internal native exit(int code) {
	mov eax, SYS_EXIT_GROUP;
	mov rdi, code;
	syscall;
}

internal native rawMkdir(*byte path, int mode) int r {
	mov eax, SYS_MKDIRAT;
	mov rdi, AT_FDCWD;
	mov rsi, path;
	mov rdx, mode;
	syscall;
	mov r, rax;
}

internal native rawRename(*byte from, to) int r {
	mov eax, SYS_RENAMEAT;
	mov rdi, AT_FDCWD;
	mov rsi, from;
	mov rdx, AT_FDCWD;
	mov r10, to;
	syscall;
	mov r, rax;
}

internal native rawStat(*byte path, *void buf) int r {
	mov eax, SYS_NEWFSTATAT;
	mov rdi, AT_FDCWD;
	mov rsi, path;
	mov rdx, buf;
	xor r10, r10;
	syscall;
	mov r, rax;
}

internal native getdents(int fd, *byte buf, int n) int r {
	mov eax, SYS_GETDENTS64;
	mov rdi, fd;
	mov rsi, buf;
	mov rdx, n;
	syscall;
	mov r, rax;
}

internal native rawGetcwd(*byte buf, int n) int r {
	mov eax, SYS_GETCWD;
	mov rdi, buf;
	mov rsi, n;
	syscall;
	mov r, rax;
}

internal native environ() ?*?*byte r {
	extern __wisp_envp;
	mov rax, [rel __wisp_envp];
	mov r, rax;
}

internal native args() []string s {
	extern __wisp_args_ptr;
	extern __wisp_args_len;
	mov rax, [rel __wisp_args_ptr];
	mov s.ptr, rax;
	mov rax, [rel __wisp_args_len];
	mov s.len, rax;
}

internal func cpath(*byte buf, string p) int {
	if len(p) >= PATH_MAX => return -ENAMETOOLONG;
	for i, c in p {
		buf[i] = c;
	}
	buf[len(p)] = '\0';
	return 0;
}

internal func open(string path, int flags) int {
	[4096]byte buf;
	int r = cpath((*byte)(buf), path);
	if r < 0 => return r;
	return rawOpen((*byte)(buf), flags | O_CLOEXEC, 0o644);
}

internal func remove(string path) int {
	[4096]byte buf;
	int r = cpath((*byte)(buf), path);
	if r < 0 => return r;
	return rawRemove((*byte)(buf), 0);
}

internal func rmdir(string path) int {
	[4096]byte buf;
	int r = cpath((*byte)(buf), path);
	if r < 0 => return r;
	return rawRemove((*byte)(buf), AT_REMOVEDIR);
}

internal func mkdir(string path) int {
	[4096]byte buf;
	int r = cpath((*byte)(buf), path);
	if r < 0 => return r;
	return rawMkdir((*byte)(buf), 0o755);
}

internal func rename(string from, string to) int {
	[4096]byte fromBuf, toBuf;
	int r = cpath((*byte)(fromBuf), from);
	if r < 0 => return r;
	r = cpath((*byte)(toBuf), to);
	if r < 0 => return r;
	return rawRename((*byte)(fromBuf), (*byte)(toBuf));
}

internal func stat(string path, *Stat out) int {
	[4096]byte buf;
	int r = cpath((*byte)(buf), path);
	if r < 0 => return r;
	StatBuf s;
	r = rawStat((*byte)(buf), &s);
	if r < 0 => return r;
	out.kind = kindOfMode(int(s.st_mode));
	out.size = s.st_size;
	out.modified = s.st_mtim.tv_sec * 1_000_000_000 + s.st_mtim.tv_nsec;
	out.mode = int(s.st_mode) & 0o7777;
	return 0;
}

internal func dirOpen(string path, *Dir d) int {
	int fd = open(path, O_RDONLY | O_DIRECTORY);
	if fd < 0 => return fd;
	d.fd = fd;
	d.pos = 0;
	d.len = 0;
	return 0;
}

internal func dirNext(*Dir d, *Entry e) int {
	loop {
		if d.pos >= d.len {
			int r = getdents(d.fd, (*byte)(d.buf), len(d.buf));
			if r <= 0 => return r;
			d.len = r;
			d.pos = 0;
		}

		int pos = d.pos;
		int start = pos + 19;
		int end = start;
		loop d.buf[end] != '\0' {
			end++;
		}
		int kind = d.buf[pos + 18];
		d.pos = pos + (int(d.buf[pos + 16]) | int(d.buf[pos + 17]) << 8);

		int n = end - start;
		if n == 1 && d.buf[start] == '.' => continue;
		if n == 2 && d.buf[start] == '.' && d.buf[start + 1] == '.' => continue;

		for i in 0..=n {
			e.name[i] = d.buf[start + i];
		}
		e.len = n;
		e.kind = match kind {
			DT_REG => KIND_FILE;
			DT_DIR => KIND_DIR;
			DT_LNK => KIND_LINK;
			DT_FIFO => KIND_PIPE;
			DT_SOCK => KIND_SOCKET;
			DT_CHR, DT_BLK => KIND_DEVICE;
			_ => KIND_OTHER;
		};
		return 1;
	}
}

internal inline func dirClose(*Dir d) int => close(d.fd);

internal func getcwd([]byte buf) int {
	int r = rawGetcwd((*byte)(buf), len(buf));
	return if r < 0 => r : r - 1;
}

internal func getenv(string name) ?string {
	if environ() |env| {
		for i in 0..=1000000 {
			if env[i] |entry| {
				int n;
				loop entry[n] != '\0' {
					n++;
				}
				string line = string(entry[..n]);
				if len(line) > len(name) && line[len(name)] == '=' && line[..len(name)] == name => return line[len(name) + 1..];
			} else {
				break;
			}
		}
	}
	return null;
}

internal func envOpen(*Env e) {
	e.index = 0;
}

internal func envNext(*Env e) ?string {
	if environ() |env| {
		if env[e.index] |entry| {
			e.index++;
			int n;
			loop entry[n] != '\0' {
				n++;
			}
			return string(entry[..n]);
		}
	}
	return null;
}

internal func envClose(*Env _e) {
}
