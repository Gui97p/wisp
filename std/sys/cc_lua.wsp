#target cc && lua

import "std/sys";

native pathKind(*byte path) int kind =>
		"local p = __wisp_cstr(path); if not __lua_fs.exists(p) then kind = 0 elseif __lua_fs.isDir(p) then kind = 2 else kind = 1 end";

native parentKind(*byte path) int kind =>
		"local d = __lua_fs.getDir(__wisp_cstr(path)); if d == '' then kind = 2 elseif not __lua_fs.exists(d) then kind = 0 elseif __lua_fs.isDir(d) then kind = 2 else kind = 1 end";

native pathSize(*byte path) int size =>
		"size = __lua_fs.getSize(__wisp_cstr(path))";

native pathModified(*byte path) int ms =>
		"local a = __lua_fs.attributes(__wisp_cstr(path)); ms = __lua_math.floor(a.modified or 0)";

native dirEmpty(*byte path) bool empty =>
		"empty = #__lua_fs.list(__wisp_cstr(path)) == 0";

native pathDelete(*byte path) int r =>
		"r = 0; local ok = pcall(__lua_fs.delete, __wisp_cstr(path)); if not ok then r = -13 end";

native pathMakeDir(*byte path) int r =>
		"r = 0; local ok = pcall(__lua_fs.makeDir, __wisp_cstr(path)); if not ok then r = -13 end";

native pathMove(*byte from, to) int r =>
		"r = 0; local ok = pcall(__lua_fs.move, __wisp_cstr(from), __wisp_cstr(to)); if not ok then r = -13 end";

native samePath(*byte from, to) bool same =>
		"same = __lua_fs.combine(__wisp_cstr(from)) == __lua_fs.combine(__wisp_cstr(to))";

native pathInside(*byte dir, path) bool inside =>
		"local d = __lua_fs.combine(__wisp_cstr(dir)); inside = __lua_string.sub(__lua_fs.combine(__wisp_cstr(path)), 1, #d + 1) == d .. '/'";

native fdKind(int fd) int kind =>
		"local e = __wisp_fds[fd]; if fd >= 0 and fd <= 2 then kind = 3 elseif e == nil then kind = 0 elseif e.names then kind = 2 else kind = 1 end";

native openFile(*byte path, string fsMode) int fd =>
		"local h, err = __lua_fs.open(__wisp_cstr(path), fsMode); if h == nil then fd = (err and __lua_string.find(err, 'ccess')) and -13 or -2 else local n = 3; while __wisp_fds[n] ~= nil do n = n + 1 end; __wisp_fds[n] = {h = h}; fd = n end";

native dirOpen(*byte path) int fd =>
		"local p = __wisp_cstr(path); local names = __lua_fs.list(p); __lua_table.sort(names); local n = 3; while __wisp_fds[n] ~= nil do n = n + 1 end; __wisp_fds[n] = {names = names, pos = 1, path = p}; fd = n";

native dirName(int fd) string name =>
		"local e = __wisp_fds[fd]; name = e and e.names and e.names[e.pos] or ''";

native dirKind(int fd) int kind =>
		"local e = __wisp_fds[fd]; kind = __lua_fs.isDir(__lua_fs.combine(e.path, e.names[e.pos])) and 4 or 8";

native dirSkip(int fd) => "local e = __wisp_fds[fd]; e.pos = e.pos + 1";

func fill(*sys.Stat s, int kind, int size, int ms) {
	s.st_mode = uint32(kind == 2 ? sys.S_IFDIR | 0o755 : sys.S_IFREG | 0o644);
	s.st_size = size;
	s.st_mtim.tv_sec = ms / 1000;
	s.st_mtim.tv_nsec = (ms % 1000) * 1_000_000;
}

shared native read(int fd, *byte buf, int n) int r =>
		"local e = __wisp_fds[fd]; local s; if fd == 0 then s = __lua_io.read(n) elseif e == nil then r = -9 elseif e.h == nil then r = -21 else s = e.h:read(n) end; if r >= 0 then if s == nil then r = 0 else for i = 1, #s do buf.t[buf.o + i - 1] = __lua_string.byte(s, i) end; r = #s end end";

shared native write(int fd, *byte buf, int n) int r =>
		"local e = __wisp_fds[fd]; if fd == 1 or fd == 2 then local f = fd == 2 and (__lua_io.stderr or __lua_io.stdout) or __lua_io.stdout; f:write(__wisp_pstr(buf, n)); r = n elseif e == nil or fd == 0 then r = -9 elseif e.h == nil then r = -21 else e.h:write(__wisp_pstr(buf, n)); r = n end";

shared func open(*byte path, int flags, int _mode) int {
	if path[0] == '\0' {
		return -sys.ENOENT;
	}
	int kind = pathKind(path);
	int access = flags & 3;
	bool create = (flags & sys.O_CREAT) != 0;

	if (flags & sys.O_DIRECTORY) != 0 {
		if kind == 0 {
			return -sys.ENOENT;
		}
		if kind != 2 {
			return -sys.ENOTDIR;
		}
		return dirOpen(path);
	}

	if kind == 2 {
		if access != sys.O_RDONLY {
			return -sys.EISDIR;
		}
		return dirOpen(path);
	}

	if kind == 0 && !create {
		return -sys.ENOENT;
	}
	if kind != 0 && create && (flags & sys.O_EXCL) != 0 {
		return -sys.EEXIST;
	}
	if kind == 0 && access == sys.O_RDONLY {
		int made = openFile(path, "wb");
		if made < 0 {
			return made;
		}
		close(made);
	}

	bool truncate = kind == 0 || (flags & sys.O_TRUNC) != 0;
	bool append = (flags & sys.O_APPEND) != 0;
	string fsMode = switch access {
		case sys.O_RDONLY => "rb";
		case sys.O_WRONLY => append ? "ab" : (truncate ? "wb" : "r+b");
		default => truncate ? "w+b" : "r+b";
	};
	return openFile(path, fsMode);
}

shared native close(int fd) int r =>
		"local e = __wisp_fds[fd]; if fd >= 0 and fd <= 2 then r = 0 elseif e == nil then r = -9 else if e.h then e.h:close() end; __wisp_fds[fd] = nil; r = 0 end";

shared native seek(int fd, offset, whence) int off =>
		"local e = __wisp_fds[fd]; if e == nil or fd <= 2 then off = -9 elseif e.h == nil then off = -21 else off = e.h:seek(({'set', 'cur', 'end'})[whence + 1], offset) or -22 end";

shared native sync(int fd) int r =>
		"local e = __wisp_fds[fd]; r = 0; if fd > 2 and e == nil then r = -9 elseif e and e.h then e.h:flush() end";

shared native size(int fd) int r =>
		"local e = __wisp_fds[fd]; if e == nil or fd <= 2 then r = -9 elseif e.h == nil then r = -21 else local pos = e.h:seek('cur'); r = e.h:seek('end'); e.h:seek('set', pos) end";

shared func remove(*byte path, int flags) int {
	int kind = pathKind(path);
	if kind == 0 {
		return -sys.ENOENT;
	}
	if (flags & sys.AT_REMOVEDIR) != 0 {
		if kind != 2 {
			return -sys.ENOTDIR;
		}
		if !dirEmpty(path) {
			return -sys.ENOTEMPTY;
		}
	} else if kind == 2 {
		return -sys.EISDIR;
	}
	return pathDelete(path);
}

shared func mkdir(*byte path, int _mode) int {
	if path[0] == '\0' {
		return -sys.ENOENT;
	}
	if pathKind(path) != 0 {
		return -sys.EEXIST;
	}
	int parent = parentKind(path);
	if parent != 2 {
		return parent == 0 ? -sys.ENOENT : -sys.ENOTDIR;
	}
	return pathMakeDir(path);
}

shared func rename(*byte from, to) int {
	if from[0] == '\0' || to[0] == '\0' {
		return -sys.ENOENT;
	}
	int source = pathKind(from);
	if source == 0 {
		return -sys.ENOENT;
	}
	int parent = parentKind(to);
	if parent != 2 {
		return parent == 0 ? -sys.ENOENT : -sys.ENOTDIR;
	}
	if samePath(from, to) {
		return 0;
	}
	if source == 2 && pathInside(from, to) {
		return -sys.EINVAL;
	}

	int target = pathKind(to);
	if target != 0 {
		if source == 2 && target != 2 {
			return -sys.ENOTDIR;
		}
		if source != 2 && target == 2 {
			return -sys.EISDIR;
		}
		if target == 2 && !dirEmpty(to) {
			return -sys.ENOTEMPTY;
		}
		int r = pathDelete(to);
		if r < 0 {
			return r;
		}
	}
	return pathMove(from, to);
}

shared func stat(*byte path, *void buf) int {
	int kind = pathKind(path);
	if kind == 0 {
		return -sys.ENOENT;
	}
	fill((*sys.Stat)(buf), kind, pathSize(path), pathModified(path));
	return 0;
}

shared func getdents(int fd, *byte buf, int n) int {
	int kind = fdKind(fd);
	if kind == 0 || kind == 3 {
		return -sys.EBADF;
	}
	if kind != 2 {
		return -sys.ENOTDIR;
	}

	int w;
	loop {
		string name = dirName(fd);
		if name == "" {
			break;
		}
		int need = len(name) + 2;
		if w + need > n {
			return w == 0 ? -sys.EINVAL : w;
		}
		buf[w] = byte(dirKind(fd));
		for i, c in name {
			buf[w + 1 + i] = c;
		}
		buf[w + 1 + len(name)] = '\0';
		w += need;
		dirSkip(fd);
	}
	return w;
}

shared func parseDirent(*byte buf, int pos) (string, int, int) {
	int start = pos + 1;
	int stop = start;
	loop buf[stop] != '\0' {
		stop++;
	}
	return string(buf[start:stop]), int(buf[pos]), stop + 1;
}

shared func getcwd(*byte buf, int n) int {
	string dir;
	native(out dir) "dir = '/' .. (__lua_shell and __lua_shell.dir() or '')";
	if len(dir) + 1 > n {
		return -sys.ERANGE;
	}
	for i, c in dir {
		buf[i] = c;
	}
	buf[len(dir)] = '\0';
	return len(dir) + 1;
}

shared native environ() **byte r => "r = nil";
shared native args() []string s => "s = __wisp_pack(table.unpack(arg, 0, #arg))";

shared func time(int clock) (int, int) {
	sys.Timespec ts;
	native(in clock, ts) "if clock == 0 then local ms = __lua_os.epoch and __lua_os.epoch('utc') or __lua_os.time() * 1000; ts.tv_sec = __lua_math.floor(ms / 1000); ts.tv_nsec = __lua_math.floor(ms % 1000) * 1000000 else local c = __lua_os.clock(); ts.tv_sec = __lua_math.floor(c); ts.tv_nsec = __lua_math.floor((c - ts.tv_sec) * 1000000000) end";
	return ts.tv_sec, ts.tv_nsec;
}

shared func sleep(int sec, nsec) int {
	native(in sec, nsec) "local t = sec + nsec / 1000000000; if __lua_os.sleep then __lua_os.sleep(t) else __lua_os.execute('sleep ' .. t) end";
	return 0;
}

shared native random(*void buf, int n) int r => "for i = 0, n - 1 do buf.t[buf.o + i] = __lua_math.random(0, 255) end; r = n";

shared func isatty(int fd) bool {
	return fd >= 0 && fd <= 2;
}

shared native exit(int code) => "if __lua_os.exit then __lua_os.exit(code) else error('exit ' .. code, 0) end";
