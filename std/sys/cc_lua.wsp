#target cc && lua

import "std/sys";

shared struct Dir {
	int fd;
}

shared struct Env {
	int index;
}

native pathKind(string path) int kind =>
		"if not __lua_fs.exists(path) then kind = 0 elseif __lua_fs.isDir(path) then kind = 2 else kind = 1 end";

native parentKind(string path) int kind =>
		"local d = __lua_fs.getDir(path); if d == '' then kind = 2 elseif not __lua_fs.exists(d) then kind = 0 elseif __lua_fs.isDir(d) then kind = 2 else kind = 1 end";

native pathSize(string path) int size =>
		"size = __lua_fs.getSize(path)";

native pathModified(string path) int ms =>
		"local a = __lua_fs.attributes(path); ms = __lua_math.floor(a.modified or 0)";

native dirEmpty(string path) bool empty =>
		"empty = #__lua_fs.list(path) == 0";

native pathDelete(string path) int r =>
		"r = 0; local ok = pcall(__lua_fs.delete, path); if not ok then r = -13 end";

native pathMakeDir(string path) int r =>
		"r = 0; local ok = pcall(__lua_fs.makeDir, path); if not ok then r = -13 end";

native pathMove(string from, to) int r =>
		"r = 0; local ok = pcall(__lua_fs.move, from, to); if not ok then r = -13 end";

native samePath(string from, to) bool same =>
		"same = __lua_fs.combine(from) == __lua_fs.combine(to)";

native pathInside(string dir, path) bool inside =>
		"local d = __lua_fs.combine(dir); inside = __lua_string.sub(__lua_fs.combine(path), 1, #d + 1) == d .. '/'";

native openFile(string path, string fsMode) int fd =>
		"local h, err = __lua_fs.open(path, fsMode); if h == nil then fd = (err and __lua_string.find(err, 'ccess')) and -13 or -2 else local n = 3; while __wisp_fds[n] ~= nil do n = n + 1 end; __wisp_fds[n] = {h = h}; fd = n end";

native listDir(string path) int fd =>
		"local names = __lua_fs.list(path); __lua_table.sort(names); local n = 3; while __wisp_fds[n] ~= nil do n = n + 1 end; __wisp_fds[n] = {names = names, pos = 1, path = path}; fd = n";

native dirName(int fd) string name =>
		"local e = __wisp_fds[fd]; name = e and e.names and e.names[e.pos] or ''";

native dirKind(int fd) int kind =>
		"local e = __wisp_fds[fd]; kind = __lua_fs.isDir(__lua_fs.combine(e.path, e.names[e.pos])) and 1 or 0";

native dirSkip(int fd) => "local e = __wisp_fds[fd]; e.pos = e.pos + 1";

shared native read(int fd, *byte buf, int n) int r =>
		"local e = __wisp_fds[fd]; local s; if fd == 0 then s = __lua_io.read(n) elseif e == nil then r = -9 elseif e.h == nil then r = -21 else s = e.h:read(n) end; if r >= 0 then if s == nil then r = 0 else for i = 1, #s do buf.t[buf.o + i - 1] = __lua_string.byte(s, i) end; r = #s end end";

shared native write(int fd, *byte buf, int n) int r =>
		"local e = __wisp_fds[fd]; if fd == 1 or fd == 2 then local f = fd == 2 and (__lua_io.stderr or __lua_io.stdout) or __lua_io.stdout; f:write(__wisp_pstr(buf, n)); r = n elseif e == nil or fd == 0 then r = -9 elseif e.h == nil then r = -21 else e.h:write(__wisp_pstr(buf, n)); r = n end";

shared func open(string path, int flags) int {
	if len(path) == 0 {
		return -sys.ENOENT;
	}
	int kind = pathKind(path);
	int access = flags & 3;
	bool create = (flags & sys.O_CREAT) != 0;

	if kind == 2 {
		if access != sys.O_RDONLY {
			return -sys.EISDIR;
		}
		return listDir(path);
	}

	if kind == 0 && !create {
		return -sys.ENOENT;
	}
	if kind != 0 && create && (flags & sys.O_EXCL) != 0 {
		return -sys.EEXIST;
	}
	if kind == 0 && access == sys.O_RDONLY {
		int made = openFile(path, "wb");
		if made < 0 {
			return made;
		}
		close(made);
	}

	bool truncate = kind == 0 || (flags & sys.O_TRUNC) != 0;
	bool append = (flags & sys.O_APPEND) != 0;
	string fsMode = switch access {
		case sys.O_RDONLY => "rb";
		case sys.O_WRONLY => append ? "ab" : (truncate ? "wb" : "r+b");
		default => truncate ? "w+b" : "r+b";
	};
	return openFile(path, fsMode);
}

shared native close(int fd) int r =>
		"local e = __wisp_fds[fd]; if fd >= 0 and fd <= 2 then r = 0 elseif e == nil then r = -9 else if e.h then e.h:close() end; __wisp_fds[fd] = nil; r = 0 end";

shared native seek(int fd, offset, whence) int off =>
		"local e = __wisp_fds[fd]; if e == nil or fd <= 2 then off = -9 elseif e.h == nil then off = -21 else off = e.h:seek(({'set', 'cur', 'end'})[whence + 1], offset) or -22 end";

shared native sync(int fd) int r =>
		"local e = __wisp_fds[fd]; r = 0; if fd > 2 and e == nil then r = -9 elseif e and e.h then e.h:flush() end";

shared native size(int fd) int r =>
		"local e = __wisp_fds[fd]; if e == nil or fd <= 2 then r = -9 elseif e.h == nil then r = -21 else local pos = e.h:seek('cur'); r = e.h:seek('end'); e.h:seek('set', pos) end";

shared func remove(string path) int {
	int kind = pathKind(path);
	if kind == 0 {
		return -sys.ENOENT;
	}
	if kind == 2 {
		return -sys.EISDIR;
	}
	return pathDelete(path);
}

shared func rmdir(string path) int {
	int kind = pathKind(path);
	if kind == 0 {
		return -sys.ENOENT;
	}
	if kind != 2 {
		return -sys.ENOTDIR;
	}
	if !dirEmpty(path) {
		return -sys.ENOTEMPTY;
	}
	return pathDelete(path);
}

shared func mkdir(string path) int {
	if len(path) == 0 {
		return -sys.ENOENT;
	}
	if pathKind(path) != 0 {
		return -sys.EEXIST;
	}
	int parent = parentKind(path);
	if parent != 2 {
		return parent == 0 ? -sys.ENOENT : -sys.ENOTDIR;
	}
	return pathMakeDir(path);
}

shared func rename(string from, string to) int {
	if len(from) == 0 || len(to) == 0 {
		return -sys.ENOENT;
	}
	int source = pathKind(from);
	if source == 0 {
		return -sys.ENOENT;
	}
	int parent = parentKind(to);
	if parent != 2 {
		return parent == 0 ? -sys.ENOENT : -sys.ENOTDIR;
	}
	if samePath(from, to) {
		return 0;
	}
	if source == 2 && pathInside(from, to) {
		return -sys.EINVAL;
	}

	int target = pathKind(to);
	if target != 0 {
		if source == 2 && target != 2 {
			return -sys.ENOTDIR;
		}
		if source != 2 && target == 2 {
			return -sys.EISDIR;
		}
		if target == 2 && !dirEmpty(to) {
			return -sys.ENOTEMPTY;
		}
		int r = pathDelete(to);
		if r < 0 {
			return r;
		}
	}
	return pathMove(from, to);
}

shared func stat(string path, *sys.Stat out) int {
	int kind = pathKind(path);
	if kind == 0 {
		return -sys.ENOENT;
	}
	out.kind = kind == 2 ? sys.KIND_DIR : sys.KIND_FILE;
	out.size = pathSize(path);
	out.modified = pathModified(path) * 1_000_000;
	out.mode = kind == 2 ? 0o755 : 0o644;
	return 0;
}

shared func dirOpen(string path, *Dir d) int {
	int kind = pathKind(path);
	if kind == 0 {
		return -sys.ENOENT;
	}
	if kind != 2 {
		return -sys.ENOTDIR;
	}
	d.fd = listDir(path);
	return 0;
}

shared func dirNext(*Dir d, *sys.Entry e) int {
	string name = dirName(d.fd);
	if name == "" {
		return 0;
	}
	for i, c in name {
		e.name[i] = c;
	}
	e.len = len(name);
	e.kind = dirKind(d.fd);
	dirSkip(d.fd);
	return 1;
}

shared func dirClose(*Dir d) {
	close(d.fd);
}

shared func getcwd([]byte buf) int {
	string dir;
	native(out dir) "dir = '/' .. (__lua_shell and __lua_shell.dir() or '')";
	if len(dir) > len(buf) {
		return -sys.ERANGE;
	}
	for i, c in dir {
		buf[i] = c;
	}
	return len(dir);
}

shared func getenv(string name) (string, bool) {
	return "", false;
}

shared native args() []string s => "s = __wisp_pack(table.unpack(arg, 0, #arg))";

shared func time(int clock) (int, int) {
	sys.Timespec ts;
	native(in clock, ts) "if clock == 0 then local ms = __lua_os.epoch and __lua_os.epoch('utc') or __lua_os.time() * 1000; ts.tv_sec = __lua_math.floor(ms / 1000); ts.tv_nsec = __lua_math.floor(ms % 1000) * 1000000 else local c = __lua_os.clock(); ts.tv_sec = __lua_math.floor(c); ts.tv_nsec = __lua_math.floor((c - ts.tv_sec) * 1000000000) end";
	return ts.tv_sec, ts.tv_nsec;
}

shared func sleep(int sec, nsec) int {
	native(in sec, nsec) "local t = sec + nsec / 1000000000; if __lua_os.sleep then __lua_os.sleep(t) else __lua_os.execute('sleep ' .. t) end";
	return 0;
}

shared native random(*void buf, int n) int r => "for i = 0, n - 1 do buf.t[buf.o + i] = __lua_math.random(0, 255) end; r = n";

shared func isatty(int fd) bool {
	return fd >= 0 && fd <= 2;
}

shared native exit(int code) => "if __lua_os.exit then __lua_os.exit(code) else error('exit ' .. code, 0) end";

shared func envOpen(*Env e) {
	e.index = 0;
}

shared func envNext(*Env _e) (string, bool) {
	return "", false;
}

shared func envClose(*Env _e) {
}
