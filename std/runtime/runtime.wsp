export func emit(string s) {
    native lua(in s) "print(s)";
    native sine_x64(in s) "mov rax, 5; mov rdi, 1; mov rsi, {s.ptr}; mov rdx, {s.len}; syscall; push 10; mov rsi, rsp; mov edx, 1; mov eax, 5; mov edi, 1; syscall; pop rax";
    native linux_x64(in s) "mov rax, 1; mov rdi, 1; mov rsi, {s.ptr}; mov rdx, {s.len}; syscall; push 10; mov rsi, rsp; mov edx, 1; mov eax, 1; mov edi, 1; syscall; pop rax";
}
