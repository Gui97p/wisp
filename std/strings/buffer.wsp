import "std/errors";
import "std/mem";
import "std/strings";
import "std/strings/character";

/// Copies `s` into the start of `buf` and returns the copied bytes as a string.
/// The result shares memory with `buf`, so it changes when `buf` does. Fails with
/// `NoSpace` when `buf` is shorter than `s`.
public func copy([]byte buf, string s) !string {
	errors.ensure(len(s) <= len(buf), errors.Kind.NoSpace)!;
	for i, c in s {
		buf[i] = c;
	}
	return string(buf[:len(s)]);
}

/// Writes `parts` one after another into `buf` and returns the joined bytes. The
/// result shares memory with `buf`. Fails with `NoSpace` when `buf` is too short;
/// `buf` may then hold part of the output. With no parts the result is empty.
public func concat([]byte buf, string ...parts) !string {
	int total;
	for _, part in parts {
		copy(buf[total:], part)!;
		total += len(part);
	}
	return string(buf[:total]);
}

/// Writes `parts` into `buf` separated by `sep` and returns the joined bytes. The
/// result shares memory with `buf`. An empty `parts` gives an empty string and a
/// single part is copied alone. Fails with `NoSpace` when `buf` is too short;
/// `buf` may then hold part of the output.
public func join([]byte buf, []string parts, string sep) !string {
	return "" if len(parts) == 0;
	int total = len(parts[0]);
	copy(buf, parts[0])!;
	for _, p in parts[1:] {
		if sep == "" {
			total += len(copy(buf[total:], p)!);
		} else {
			total += len(concat(buf[total:], sep, p)!);
		}
	}
	return string(buf[:total]);
}

/// Writes `n` copies of `s` into `buf` and returns the bytes. The result shares
/// memory with `buf`. It is empty when `n` is zero or negative. Fails with
/// `NoSpace`, before writing anything, when `buf` is shorter than `len(s) * n`.
public func rep([]byte buf, string s, int n) !string {
	return "" if n <= 0;
	errors.ensure(len(s) * n <= len(buf), errors.Kind.NoSpace)!;

	int total;
	for n {
		copy(buf[total:], s)!;
		total += len(s);
	}

	return string(buf[:total]);
}

/// Writes `s` into `buf` with occurrences of `old` replaced by `new` and returns
/// the bytes. Occurrences are non-overlapping and found from the left. Only the
/// first `n` are replaced, and all of them when `n` is negative. An empty `old`
/// replaces nothing and `s` is copied as is. The result shares memory with `buf`.
/// Fails with `NoSpace` when `buf` is too short; `buf` may then hold part of the
/// output.
public func replace([]byte buf, string s, old, new, int n) !string {
	if old == "" {
		copy(buf, s)!;
		return string(buf[:len(s)]);
	}

	strings.Splitter sp = strings.splitter(s, old);
	int total, count;
	loop sp.next() |next| {
		if count > 0 {
			string chosen = count > n && n >= 0 ? old : new;
			copy(buf[total:], chosen)!;
			total += len(chosen);
		}

		copy(buf[total:], next)!;
		total += len(next);
		count++;
	}

	return string(buf[:total]);
}

/// Writes `s` into `buf` with ASCII lowercase letters made uppercase and returns
/// the bytes. Other bytes are copied unchanged. The result shares memory with
/// `buf`. Fails with `NoSpace` when `buf` is shorter than `s`.
public func upper([]byte buf, string s) !string {
	errors.ensure(len(s) <= len(buf), errors.Kind.NoSpace)!;
	for i, c in s {
		buf[i] = character.upperByte(c);
	}
	return string(buf[:len(s)]);
}
/// Makes the ASCII lowercase letters in `buf` uppercase, in place.
public func toUpper([]byte buf) {
	upper(buf, string(buf))!!;
}

/// Writes `s` into `buf` with ASCII uppercase letters made lowercase and returns
/// the bytes. Other bytes are copied unchanged. The result shares memory with
/// `buf`. Fails with `NoSpace` when `buf` is shorter than `s`.
public func lower([]byte buf, string s) !string {
	errors.ensure(len(s) <= len(buf), errors.Kind.NoSpace)!;
	for i, c in s {
		buf[i] = character.lowerByte(c);
	}
	return string(buf[:len(s)]);
}
/// Makes the ASCII uppercase letters in `buf` lowercase, in place.
public func toLower([]byte buf) {
	lower(buf, string(buf))!!;
}

/// Returns a copy of `s` as a new byte slice allocated from `mem.heap`. The caller
/// must free it with `mem.free`. An empty `s` gives an empty slice and allocates
/// nothing. Fails with the allocator error when memory runs out.
public func clone(string s) ![]byte {
	return .{} if len(s) == 0;
	[]byte buf = mem.make<byte>(mem.heap, len(s))!;
	copy(buf, s)!;
	return buf;
}
