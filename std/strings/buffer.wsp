import "std/mem";

/// Copies `p` to the start of `buf` and returns how many bytes that is. The room
/// is the caller's business: the producers below always allocate enough.
internal inline func copy([]byte buf, string p) int {
	mem.copy(buf, (*byte)(p), len(p));
	return len(p);
}

/// Joins `parts` one after another into a new string, allocated from `a`. The
/// caller frees it with `mem.free`, or leaves it to an arena or a `Fixed`. With no
/// parts, or only empty ones, the result is empty and nothing is allocated. Fails
/// with the error of the allocator.
public func concat(mem.Allocator a, string ...parts) !string {
	int total;
	for part in parts {
		total += len(part);
	}
	return "" if total == 0;
	[]byte buf = mem.makeDirty<byte>(a, total)!;
	total = 0;
	for part in parts {
		total += copy(buf[total..], part);
	}
	return string(buf);
}

/// Joins `parts` into a new string with `sep` between them, allocated from `a`.
/// The caller frees it with `mem.free`, or leaves it to an arena or a `Fixed`. An
/// empty `parts` gives an empty string, a single part is copied alone, and
/// nothing is allocated when the result is empty. Fails with the error of the
/// allocator.
public func join(mem.Allocator a, []string parts, string sep) !string {
	return "" if len(parts) == 0;
	int total = len(sep) * (len(parts) - 1);
	for p in parts {
		total += len(p);
	}
	return "" if total == 0;
	[]byte buf = mem.makeDirty<byte>(a, total)!;
	int at = copy(buf, parts[0]);
	for p in parts[1..] {
		at += copy(buf[at..], sep);
		at += copy(buf[at..], p);
	}
	return string(buf);
}

/// Makes a new string of `n` copies of `s`, allocated from `a`. The caller frees
/// it with `mem.free`, or leaves it to an arena or a `Fixed`. It is empty when `n`
/// is zero or negative, and nothing is allocated then. Fails with the error of
/// the allocator.
public func rep(mem.Allocator a, string s, int n) !string {
	return "" if n <= 0;
	[]byte buf = mem.makeDirty<byte>(a, len(s) * n)!;

	int total;
	for n {
		total += copy(buf[total..], s);
	}

	return string(buf);
}

/// Makes a new string from `s` with occurrences of `old` replaced by `new`,
/// allocated from `a`. Occurrences are non-overlapping and found from the left.
/// Only the first `n` are replaced, and all of them when `n` is negative. An empty
/// `old`, or an `n` of zero, replaces nothing and `s` is copied as is. The caller
/// frees the result with `mem.free`, or leaves it to an arena or a `Fixed`. Fails
/// with the error of the allocator.
public func replace(mem.Allocator a, string s, old, new, int n) !string {
	int found;
	if old != "" && n != 0 {
		found = count(s, old);
		if n > 0 && found > n {
			found = n;
		}
	}
	if found == 0 {
		return string(clone(a, s)!);
	}

	int size = len(s) + found * (len(new) - len(old));
	return "" if size == 0;
	[]byte buf = mem.makeDirty<byte>(a, size)!;

	Splitter sp = splitter(s, old);
	int total, seen;
	loop sp.next() |piece| {
		if seen > 0 {
			string chosen = seen <= found ? new : old;
			total += copy(buf[total..], chosen);
		}
		total += copy(buf[total..], piece);
		seen++;
	}
	return string(buf);
}

/// Makes a new string from `s` with the ASCII lowercase letters made uppercase,
/// allocated from `a`. Other bytes are copied unchanged. The caller frees it with
/// `mem.free`, or leaves it to an arena or a `Fixed`. Fails with the error of the
/// allocator.
public func upper(mem.Allocator a, string s) !string {
	[]byte buf = mem.makeDirty<byte>(a, len(s))!;
	for i, c in s {
		buf[i] = upperByte(c);
	}
	return string(buf);
}
/// Makes the ASCII lowercase letters in `buf` uppercase, in place, and returns
/// the bytes as a string that shares memory with `buf`.
public inline func toUpper([]byte buf) string {
	for i, c in buf {
		buf[i] = upperByte(c);
	}
	return string(buf);
}

/// Makes a new string from `s` with the ASCII uppercase letters made lowercase,
/// allocated from `a`. Other bytes are copied unchanged. The caller frees it with
/// `mem.free`, or leaves it to an arena or a `Fixed`. Fails with the error of the
/// allocator.
public func lower(mem.Allocator a, string s) !string {
	[]byte buf = mem.makeDirty<byte>(a, len(s))!;
	for i, c in s {
		buf[i] = lowerByte(c);
	}
	return string(buf[..len(s)]);
}
/// Makes the ASCII uppercase letters in `buf` lowercase, in place, and returns
/// the bytes as a string that shares memory with `buf`.
public inline func toLower([]byte buf) string {
	for i, c in buf {
		buf[i] = lowerByte(c);
	}
	return string(buf);
}

/// Returns a copy of `s` as a new string, allocated from `a`. The caller frees it
/// with `mem.free`, or leaves it to an arena or a `Fixed`. An empty `s` gives an
/// empty string and allocates nothing. Fails with the error of the allocator.
public func clone(mem.Allocator a, string s) !string {
	return "" if len(s) == 0;
	[]byte buf = mem.makeDirty<byte>(a, len(s))!;
	mem.copy(buf, (*byte)(s), len(s));
	return string(buf);
}
