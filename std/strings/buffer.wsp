import "std/strings";
import "std/strings/character";
import "std/mem";
import "std/errors";

public func copy([]byte buf, string s) !string {
	errors.ensure(len(s) <= len(buf), errors.Kind.NoSpace)!;
	for i, c in s {
		buf[i] = c;
	}
	return string(buf[:len(s)]);
}

public func concat([]byte buf, string ...parts) !string {
	int total;
	for _, part in parts {
		copy(buf[total:], part)!;
		total += len(part);
	}
	return string(buf[:total]);
}

public func join([]byte buf, []string parts, string sep) !string {
	if len(parts) == 0 {
		return "";
	}
	int total = len(parts[0]);
	copy(buf, parts[0])!;
	for _, p in parts[1:] {
		if sep == "" {
			total += len(copy(buf[total:], p)!);
		} else {
			total += len(concat(buf[total:], sep, p)!);
		}
	}
	return string(buf[:total]);
}

public func rep([]byte buf, string s, int n) !string {
	if n <= 0 {
		return "";
	}
	errors.ensure(len(s) * n <= len(buf), errors.Kind.NoSpace)!;

	int total;
	for n {
		copy(buf[total:], s)!;
		total += len(s);
	}

	return string(buf[:total]);
}

public func replace([]byte buf, string s, old, new, int n) !string {
	if old == "" {
		copy(buf, s)!;
		return string(buf[:len(s)]);
	}

	strings.Splitter sp = strings.splitter(s, old);
	int total, count;
	loop {
		let next, found = sp.next();
		if !found {
			break;
		}
		
		if count > 0 {
			string chosen = count > n && n >= 0 ? old : new;
			copy(buf[total:], chosen)!;
			total += len(chosen);
		}
		
		copy(buf[total:], next)!;
		total += len(next);
		count++;
	}

	return string(buf[:total]);
}

public func upper([]byte buf, string s) !string {
	errors.ensure(len(s) <= len(buf), errors.Kind.NoSpace)!;
	for i, c in s {
		buf[i] = character.upperByte(c);
	}
	return string(buf[:len(s)]);
}
public func toUpper([]byte buf) {
	upper(buf, string(buf))!!;
}

public func lower([]byte buf, string s) !string {
	errors.ensure(len(s) <= len(buf), errors.Kind.NoSpace)!;
	for i, c in s {
		buf[i] = character.lowerByte(c);
	}
	return string(buf[:len(s)]);
}
public func toLower([]byte buf) {
	lower(buf, string(buf))!!;
}

public func reverse([]byte buf) {
	int n = len(buf);
	if n < 2 {
		return;
	}
	for i in 0..n/2-1 {
		buf[i], buf[n-i-1] = buf[n-i-1], buf[i];
	}
}

public func clone(string s) ![]byte {
	if len(s) == 0 {
		return [];
	}
	[]byte buf = (*byte)(mem.alloc(sizeof(byte) * len(s))!)[:len(s)];
	copy(buf, s)!;
	return buf;
}
