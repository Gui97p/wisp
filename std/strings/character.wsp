public inline func isDigit(byte c) bool {
	return c in '0'..'9';
}

public inline func isHex(byte c) bool {
	return c in '0'..'9' || lowerByte(c) in 'a'..'f';
}

public inline func isAlpha(byte c) bool {
	return lowerByte(c) in 'a'..'z';
}

public inline func isAlphaNumeric(byte c) bool {
	return isAlpha(c) || isDigit(c);
}

public inline func isUpper(byte c) bool {
	return c in 'A'..'Z';
}

public inline func isLower(byte c) bool {
	return c in 'a'..'z';
}

public inline func isSpace(byte c) bool {
	return c in " \t\n\r\v\f";
}

public inline func isPrint(byte c) bool {
	return c >= ' ' && c <= '~';
}

public inline func upperByte(byte c) byte {
	return c in 'a'..'z' ? c-32 : c;
}

public inline func lowerByte(byte c) byte {
	return c in 'A'..'Z' ? c+32 : c;
}

public func digitValue(byte c, int base) (int, bool) {
	if !(base in 2..36) {
		return 0, false;
	}

	if c in '0'..'9' {
		int v = c - '0';

		if v < base {
			return v, true;
		}

		return 0, false;
	}

	if c in 'a'..'z' {
		c -= 32;
	}

	if c in 'A'..'Z' {
		int v = c - 'A' + 10;

		if v < base {
			return v, true;
		}
	}

	return 0, false;
}
