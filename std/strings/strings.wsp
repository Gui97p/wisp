import "std/strings/search";

const spaceCharset = " \t\n\r\v\f";

#must_use
public func trim(string s, charset) string {
    return trimLeft(trimRight(s, charset), charset);
}
#must_use
public func trimLeft(string s, charset) string {
    return "" if s == "";

    loop s != "" && s[0] in charset {
        s = s[1:];
    }

    return s;
}
#must_use
public func trimRight(string s, charset) string {
    return "" if s == "";

    loop s != "" && s[len(s)-1] in charset {
        s = s[:len(s)-1];
    }

    return s;
}
#must_use
public func trimSpace(string s) string {
	return "" if s == "";
	return trim(s, spaceCharset);
}
#must_use
public func trimPrefix(string s, prefix) string {
    return s if !search.startsWith(s, prefix);

    return s[len(prefix):];
}
#must_use
public func trimSuffix(string s, suffix) string {
    return s if !search.endsWith(s, suffix);

    return s[:len(s)-len(suffix)];
}

#must_use
public func cut(string s, sep) ?Cut {
	int idx = search.indexOf(s, sep) ?? return null;

	return Cut{before: s[:idx], after: s[idx+len(sep):]};
}

public struct Cut {
	string before, after;
}

public struct Splitter {
	internal string s, sep;
	internal bool done, skipEmpty;
}

internal func (*Splitter s) nextStep() ?string {
	return null if s.done;

	if s.sep == "" {
		if s.s == "" {
			s.done = true;
			return null;
		}

		string r = string(s.s[0]);
		s.s = s.s[1:];
		return r;
	}
	
	if cut(s.s, s.sep) |c| {
		s.s = c.after;
		return c.before;
	}
	s.done = true;
	return s.s;
}

public func (*Splitter s) next() ?string {
	loop {
		string str = s.nextStep() ?? return null;
		return str if !s.skipEmpty || str != "";
	}
}

public func (*Splitter s) rest() string {
	return s.s;
}

public func splitter(string s, sep) Splitter {
	return Splitter{s: s, sep: sep};
}

public func tokens(string s, sep) Splitter {
	return Splitter{s: s, sep: sep, skipEmpty: true};
}
