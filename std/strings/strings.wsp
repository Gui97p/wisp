import "std/strings/search";

const spaceCharset = " \t\n\r\v\f";

public func trim(string s, charset) string {
    return trimLeft(trimRight(s, charset), charset);
}
public func trimLeft(string s, charset) string {
    if s == "" {
        return "";
    }

    loop s != "" && s[0] in charset {
        s = s[1:];
    }

    return s;
}
public func trimRight(string s, charset) string {
    if s == "" {
        return "";
    }

    loop s != "" && s[len(s)-1] in charset {
        s = s[:len(s)-1];
    }

    return s;
}
public func trimSpace(string s) string {
	if s == "" {
		return "";
	}
	return trim(s, spaceCharset);
}
public func trimPrefix(string s, prefix) string {
    if !search.startsWith(s, prefix) {
        return s;
    }

    return s[len(prefix):];
}
public func trimSuffix(string s, suffix) string {
    if !search.endsWith(s, suffix) {
        return s;
    }

    return s[:len(s)-len(suffix)];
}

public func cut(string s, sep) (string, string, bool) {
	int idx = search.indexOf(s, sep);
	if idx == -1 {
		return s, "", false;
	}

	return s[:idx], s[idx+len(sep):], true;
}

public struct Splitter {
	internal string s, sep;
	internal bool done;
}

public func (*Splitter s) next() (string, bool) {
	if s.done {
		return "", false;
	}

	if s.sep == "" {
		if s.s == "" {
			s.done = true;
			return "", false;
		}

		string r = string(s.s[0]);
		s.s = s.s[1:];
		return r, true;
	}
	
	let left, right, found = cut(s.s, s.sep);
	if found {
		s.s = right;
	} else {
		s.done = true;
	}
	return left, true;
}

public func (*Splitter s) rest() string {
	return s.s;
}

public func splitter(string s, sep) Splitter {
	return Splitter{s: s, sep: sep};
}
