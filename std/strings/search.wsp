import "std/math";
import "std/strings/character";

/// Returns the byte index of the first occurrence of `sub` in `s`, or null when
/// there is none. An empty `sub` is found at index 0.
#must_use
public func indexOf(string s, sub) ?int {
	if sub == "" {
		return 0;
	}

	if len(sub) > len(s) {
		return null;
	}

	int subLen = len(sub);
	int limit = len(s) - subLen;

	for i in 0..limit {
		return i if s[i:i + len(sub)] == sub;
	}

	return null;
}

/// Returns the byte index of the last occurrence of `sub` in `s`, or null when
/// there is none. An empty `sub` is found at `len(s)`.
#must_use
public func lastIndexOf(string s, sub) ?int {
	return len(s) if sub == "";

	if len(sub) > len(s) {
		return null;
	}

	int subLen = len(sub);
	int limit = len(s) - subLen;

	?int last = null;
	for i in 0..limit {
		if s[i:i + len(sub)] == sub {
			last = i;
		}
	}

	return last;
}

/// Returns the index of the first byte equal to `c` in `s`, or null when there is
/// none.
#must_use
public func indexOfByte(string s, byte c) ?int {
	for i, ch in s {
		return i if c == ch;
	}
	return null;
}
/// Returns the index of the last byte equal to `c` in `s`, or null when there is
/// none.
#must_use
public func lastIndexOfByte(string s, byte c) ?int {
	?int last = null;
	for i, ch in s {
		if c == ch {
			last = i;
		}
	}
	return last;
}

/// Returns the number of non-overlapping occurrences of `sub` in `s`, counted from
/// the left. An empty `sub` counts `len(s) + 1`.
#must_use
public func count(string s, sub) int {
	return len(s) + 1 if sub == "";

	int total;
	loop {
		int idx = indexOf(s, sub) ?? break;

		total++;
		int nIdx = idx + len(sub);
		break if nIdx >= len(s);

		s = s[nIdx:];
	}

	return total;
}

/// Reports whether `s` begins with `prefix`. An empty `prefix` always matches.
#must_use
public func startsWith(string s, prefix) bool {
	return false if len(prefix) > len(s);
	return s[:len(prefix)] == prefix;
}
/// Reports whether `s` ends with `suffix`. An empty `suffix` always matches.
#must_use
public func endsWith(string s, suffix) bool {
	return false if len(suffix) > len(s);
	return s[len(s) - len(suffix):] == suffix;
}

/// Compares `a` and `b` byte by byte and returns -1, 0 or 1 when `a` is less than,
/// equal to or greater than `b`. A string that is a prefix of another is the
/// smaller one.
#must_use
public func compare(string a, b) int {
	int lenA = len(a);
	int lenB = len(b);
	int n = math.min(lenA, lenB);

	for i, c in a[:n] {
		return -1 if c < b[i];

		return 1 if c > b[i];
	}

	return -1 if lenA < lenB;

	return 1 if lenA > lenB;

	return 0;
}

/// Reports whether `a` and `b` are equal when ASCII letters are compared without
/// regard to case. Bytes above 127 must match exactly.
public func equalFold(string a, b) bool {
	return false if len(a) != len(b);

	for i, c in a {
		return false if character.lowerByte(c) != character.lowerByte(b[i]);
	}

	return true;
}
