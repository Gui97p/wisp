/// Returns an `Error` of kind `k` if `condition` is false, and nothing
/// otherwise. Meant for use as `ensure(ok, kind)!`.
public inline func ensure(bool condition, const Kind k) ! {
	return Error(k) if !condition;
}

/// Like `ensure`, with `message` attached to the error. The message must be a
/// constant.
public inline func ensureMessage(bool condition, const Kind k, const string message) ! {
	return Error(k, message) if !condition;
}

/// Panics with `message` if `condition` is false. In a build that is not
/// `debug` the call does nothing and `condition` is not evaluated.
public inline func assert(bool condition, const string message) {
	if !condition {
		panic(message);
	}
}
public inline func<!debug> assert(bool _condition, const string _message) {}

/// Panics with `message`. Marks a place that the program should never reach.
public inline func unreachable(const string message) {
	panic(message);
}

/// Panics with `message`. Marks code that is not written yet.
public inline func todo(const string message) {
	panic(message);
}

/// Reports whether `e` is an error that may go away if the operation is tried
/// again: `Interrupted`, `WouldBlock` or `Busy`. A null error gives `false`.
public inline func temporary(Error e) bool {
	return e == null ? false : match e.code {
		Kind.Interrupted, Kind.WouldBlock, Kind.Busy => true;
		_ => false;
	};
}

/// Reports whether `e` is a `NotFound` error. A null error gives `false`.
public inline func missing(Error e) bool => e == null ? false : e.code == Kind.NotFound;
