import "std/math/constants";

#must_use
public func checkedAdd(int a, b) ?int {
	int r = a +% b;
	return null if ((a ^ r) & (b ^ r)) < 0;
	return r;
}

#must_use
public func checkedSub(int a, b) ?int {
	int r = a -% b;
	return null if ((a ^ b) & (a ^ r)) < 0;
	return r;
}

#must_use
public func checkedMul(int a, b) ?int {
	return 0 if a == 0 || b == 0;
	return null if (a == -1 && b == constants.MIN_INT) || (b == -1 && a == constants.MIN_INT);
	int r = a *% b;
	return null if r / b != a;
	return r;
}

#must_use
public inline func checkedAbs(int x) ?int {
	return null if x == constants.MIN_INT;
	return x < 0 ? -x : x;
}

#must_use
public func checkedAddUnsigned(uint a, b) ?uint {
	uint r = a +% b;
	return null if r < a;
	return r;
}

#must_use
public func checkedSubUnsigned(uint a, b) ?uint {
	return null if b > a;
	return a -% b;
}

#must_use
public func checkedMulUnsigned(uint a, b) ?uint {
	return 0 if a == 0 || b == 0;
	uint r = a *% b;
	return null if r / b != a;
	return r;
}

public inline func abs(int x) int {
	return x < 0 ? -x : x;
}

public func min(int ...args) int {
	return 0 if len(args) == 0;
	int m = args[0];

	for _, n in args[1:] {
		if n < m {
			m = n;
		}
	}

	return m;
}

public func max(int ...args) int {
	return 0 if len(args) == 0;
	int m = args[0];

	for _, n in args[1:] {
		if n > m {
			m = n;
		}
	}

	return m;
}

public inline func clamp(int x, low, high) int {
	return x < low ? low : (x > high ? high : x);
}

public func mod(int a, b) int {
	int r = a % b;

	if r < 0 {
		if b < 0 {
			r -= b;
		} else {
			r += b;
		}
	}

	return r;
}

public func gcd(int a, b) int {
	loop b != 0 {
		a, b = b, a % b;
	}
	return abs(a);
}

public func lcm(int a, b) ?int {
	return 0 if a == 0 || b == 0;
	return abs(checkedMul(a / gcd(a, b), b) ?? return null);
}

public func pow(int base, uint exp) ?int {
	return 1 if exp == 0;

	int r = 1;
	loop exp > 0 {
		if (exp & 1) == 1 {
			r = checkedMul(r, base) ?? return null;
		}
		exp >>= 1;
		if exp > 0 {
			base = checkedMul(base, base) ?? return null;
		}
	}

	return r;
}

public func sqrt(int n) int {
	return max(0, n) if n <= 1;

	int lo, hi = 0, min(n, 3037000499);
	for hi {
		int mid = (lo + hi + 1) / 2;
		if mid * mid <= n {
			lo = mid;
		} else {
			hi = mid - 1;
		}
		return hi if hi == lo;
	}
	return 0;
}

public func popCount(uint x) uint {
	uint n;
	loop x != 0 {
		x &= x - 1;
		n++;
	}
	return n;
}

public func trailingZeros(uint x) uint {
	return x == 0 ? 64 : popCount((x & (~x + 1)) - 1);
}

public func leadingZeros(uint x) uint {
	return 64 if x == 0;

	uint n;
	loop (x & 0x8000000000000000) == 0 {
		x <<= 1;
		n++;
	}
	return n;
}
