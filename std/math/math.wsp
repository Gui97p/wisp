import "std/errors";
import "std/math/constants";

public inline func checkedAdd(int a, b) !int {
	errors.ensure((b <= 0 || a <= constants.MAX_INT - b) && (b >= 0 || a >= constants.MIN_INT - b), errors.Kind.Overflow)!;
	return a + b;
}

public inline func checkedSub(int a, b) !int {
	errors.ensure((b <= 0 || a >= constants.MIN_INT + b) && (b >= 0 || a <= constants.MAX_INT + b), errors.Kind.Overflow)!;
	return a - b;
}

public func checkedMul(int a, b) !int {
    if a == 0 || b == 0 {
        return 0;
    }
	const kind = errors.Kind.Overflow;

	switch {
		case a == -1:
			errors.ensure(b != constants.MIN_INT, kind)!;
		case b == -1:
			errors.ensure(a != constants.MIN_INT, kind)!;
	}

    if a > 0 {
        if b > 0 {
			errors.ensure(a <= constants.MAX_INT / b, kind)!;
        } else {
			errors.ensure(b <= constants.MAX_INT / a, kind)!;
        }
    } else {
		errors.ensure(a >= (b > 0 ? constants.MIN_INT : constants.MAX_INT) / b, kind)!;
    }

    return a * b;
}

public inline func checkedAbs(int x) !int {
	errors.ensure(x != constants.MIN_INT, errors.Kind.Overflow)!;
	return x < 0 ? -x : x;
}

public inline func abs(int x) int {
    return x < 0 ? -x : x;
}

public func min(int ...args) int {
	if len(args) == 0 {
		return 0;
	}
	int m = args[0];

	for _, n in args[1:] {
		if n < m {
			m = n;
		}
	}

	return m;
}

public func max(int ...args) int {
	if len(args) == 0 {
		return 0;
	}
	int m = args[0];

	for _, n in args[1:] {
		if n > m {
			m = n;
		}
	}
	
	return m;
}

public inline func clamp(int x, low, high) int {
	return x < low ? low : (x > high ? high : x);
}

public func mod(int a, b) int {
	int r = a % b;

    if r < 0 {
        if b < 0 {
            r -= b;
        } else {
            r += b;
        }
    }

    return r;
}

public func gcd(int a, b) int {
	loop b != 0 {
		a, b = b, a % b;
	}
	return abs(a);
}

public func lcm(int a, b) !int {
	if a == 0 || b == 0 {
		return 0;
	}
	return abs(checkedMul(a / gcd(a, b), b)!);
}

public func pow(int base, exp) !int {
	errors.ensure(exp >= 0, errors.Kind.Invalid)!;
	if exp == 0 {
		return 1;
	}

	int r = 1;
	loop exp > 0 {
		if (exp & 1) == 1 {
			r = checkedMul(r, base)!;
		}
		exp >>= 1;
		if exp > 0 {
			base = checkedMul(base, base)!;
		}
	}

	return r;
}

public func sqrt(int n) int {
	if n <= 1 {
		return max(0, n);
	}

	int lo, hi = 0, min(n, 3037000499);
	for hi {
		int mid = (lo + hi + 1) / 2;
		if mid * mid <= n {
			lo = mid;
		} else {
			hi = mid-1;
		}
		if hi == lo {
			return hi;
		}
	}
	return 0;
}

public func popCount(uint x) uint {
	uint n;
	loop x != 0 {
		x &= x - 1;
		n++;
	}
	return n;
}

public func trailingZeros(uint x) uint {
	return x == 0 ? 64 : popCount((x & (~x + 1)) - 1);
}

public func leadingZeros(uint x) uint {
	if x == 0 {
		return 64;
	}

	uint n;
	loop (x & 0x8000000000000000) == 0 {
		x <<= 1;
		n++;
	}
	return n;
}
