public func abs(int x) int {
    return x < 0 ? -x : x;
}
public func fabs(float64 x) float64 {
    float64 r;
    native lua(in x) "r = math.abs(x)";
    return r;
}

public func min(int ...args) int {
    int l = len(args);

	if len(args) == 0 {
		return 0;
	}
	int m = args[0];

	for i in 1..l-1 {
		int n = args[i];
		if n < m {
			m = n;
		}
	}

	return m;
}
public func fmin(float64 a, float64 b) float64 {
    float64 r;
    native lua(in a, b) "r = math.min(a, b)";
    return r;
}

public func max(int ...args) int {
    int l = len(args);

	if len(args) == 0 {
		return 0;
	}
	int m = args[0];

	for i in 1..l-1 {
		int n = args[i];
		if n > m {
			m = n;
		}
	}
	
	return m;
}
public func fmax(float64 a, float64 b) float64 {
    float64 r;
    native lua(in a, b) "r = math.max(a, b)";
    return r;
}

public func floor(float64 x) float64 {
    float64 r;
    native lua(in x) "r = math.floor(x)";
    return r;
}
public func ceil(float64 x) float64 {
    float64 r;
    native lua(in x) "r = math.ceil(x)";
    return r;
}
public func round(float64 x) float64 {
    float64 r;
    native lua(in x) "r = math.floor(x + 0.5)";
    return r;
}

public func sqrt(float64 x) float64 {
    float64 r;
    native lua(in x) "r = math.sqrt(x)";
    return r;
}
public func pow(float64 base, float64 exp) float64 {
    float64 r;
    native lua(in base, exp) "r = base ^ exp";
    return r;
}

public func sin(float64 x) float64 {
    float64 r;
    native lua(in x) "r = math.sin(x)";
    return r;
}
public func cos(float64 x) float64 {
    float64 r;
    native lua(in x) "r = math.cos(x)";
    return r;
}
public func tan(float64 x) float64 {
    float64 r;
    native lua(in x) "r = math.tan(x)";
    return r;
}

public func log(float64 x) float64 {
    float64 r;
    native lua(in x) "r = math.log(x)";
    return r;
}
public func exp(float64 x) float64 {
    float64 r;
    native lua(in x) "r = math.exp(x)";
    return r;
}
