import "std/math/ieee";

const {
	zero = 0.00000000000000000000e+00;
	half = 5.00000000000000000000e-01;
	two24 = 1.67772160000000000000e+07;
	twon24 = 5.96046447753906250000e-08;
	invpio2 = 6.36619772367581382433e-01;
	pio2_1 = 1.57079632673412561417e+00;
	pio2_1t = 6.07710050650619224932e-11;
	pio2_2 = 6.07710050630396597660e-11;
	pio2_2t = 2.02226624879595063154e-21;
	pio2_3 = 2.02226624871116645580e-21;
	pio2_3t = 8.47842766036889956997e-32;
	one = 1.0;
}

[8]float PIo2 = [1.57079625129699707031e+00, 7.54978941586159635335e-08, 5.39030252995776476554e-15, 3.28200341580791294123e-22, 1.27065575308067607349e-29, 1.22933308981111328932e-36, 2.73370053816464559624e-44, 2.16741683877804819444e-51];
[66]uint two_over_pi = [0xA2F983, 0x6E4E44, 0x1529FC, 0x2757D1, 0xF534DD, 0xC0DB62, 0x95993C, 0x439041, 0xFE5163, 0xABDEBB, 0xC561B7, 0x246E3A, 0x424DD2, 0xE00649, 0x2EEA09, 0xD1921C, 0xFE1DEB, 0x1CB129, 0xA73EE8, 0x8235F5, 0x2EBB44, 0x84E99C, 0x7026B4, 0x5F7E41, 0x3991D6, 0x398353, 0x39F49C, 0x845F8B, 0xBDF928, 0x3B1FF8, 0x97FFDE, 0x05980F, 0xEF2F11, 0x8B5A0A, 0x6D1F6D, 0x367ECF, 0x27CB09, 0xB74F46, 0x3F669E, 0x5FEA2D, 0x7527BA, 0xC7EBE5, 0xF17B3D, 0x0739F7, 0x8A5292, 0xEA6BFB, 0x5FB11F, 0x8D5D08, 0x560330, 0x46FC7B, 0x6BABF0, 0xCFBC20, 0x9AF436, 0x1DA9E3, 0x91615E, 0xE61B08, 0x659985, 0x5F14A0, 0x68408D, 0xFFD880, 0x4D7327, 0x310606, 0x1556CA, 0x73A8C9, 0x60E27B, 0xC08C6B];
[32]uint npio2_hw = [0x3FF921FB, 0x400921FB, 0x4012D97C, 0x401921FB, 0x401F6A7A, 0x4022D97C, 0x4025FDBB, 0x402921FB, 0x402C463A, 0x402F6A7A, 0x4031475C, 0x4032D97C, 0x40346B9C, 0x4035FDBB, 0x40378FDB, 0x403921FB, 0x403AB41B, 0x403C463A, 0x403DD85A, 0x403F6A7A, 0x40407E4C, 0x4041475C, 0x4042106C, 0x4042D97C, 0x4043A28C, 0x40446B9C, 0x404534AC, 0x4045FDBB, 0x4046C6CB, 0x40478FDB, 0x404858EB, 0x404921FB];

func kernelRemPio2([]float x, []float y, int e0, int nx) int {
	int jk = 4;
	int jp = jk;
	int jx = nx - 1;
	int jv = (e0 - 3) / 24;
	if jv < 0 {
		jv = 0;
	}
	int q0 = e0 - 24 * (jv + 1);
	int j = jv - jx;
	int m = jx + jk;

	[20]float f;
	[20]float fq;
	[20]float q;
	[20]int iq;

	for i in 0..m {
		if j < 0 {
			f[i] = zero;
		} else {
			f[i] = float(two_over_pi[j]);
		}
		j += 1;
	}

	for i in 0..jk {
		float fw = 0.0;
		for jj in 0..jx {
			fw += x[jj] * f[jx + i - jj];
		}
		q[i] = fw;
	}

	int jz = jk;
	float z;
	int n;
	int ih;
	loop {
		z = q[jz];
		int top = jz;
		int idx = 0;
		loop top > 0 {
			float fw = float(int(twon24 * z));
			iq[idx] = int(z - two24 * fw);
			z = q[top - 1] + fw;
			idx += 1;
			top -= 1;
		}

		z = ieee.ldexp(z, q0);
		z -= 8.0 * ieee.floor(z * 0.125);
		n = int(z);
		z -= float(n);
		ih = 0;
		if q0 > 0 {
			int i = iq[jz - 1] >> (24 - q0);
			n += i;
			iq[jz - 1] -= i << (24 - q0);
			ih = iq[jz - 1] >> (23 - q0);
		} else if q0 == 0 {
			ih = iq[jz - 1] >> 23;
		} else if z >= 0.5 {
			ih = 2;
		}

		if ih > 0 {
			n += 1;
			int carry = 0;
			for i in 0..jz - 1 {
				int jq = iq[i];
				if carry == 0 {
					if jq != 0 {
						carry = 1;
						iq[i] = 0x1000000 - jq;
					}
				} else {
					iq[i] = 0xffffff - jq;
				}
			}
			if q0 > 0 {
				if q0 == 1 {
					iq[jz - 1] = iq[jz - 1] & 0x7fffff;
				} else if q0 == 2 {
					iq[jz - 1] = iq[jz - 1] & 0x3fffff;
				}
			}
			if ih == 2 {
				z = one - z;
				if carry != 0 {
					z -= ieee.ldexp(one, q0);
				}
			}
		}

		if z == zero {
			int acc = 0;
			int i = jz - 1;
			loop i >= jk {
				acc = acc | iq[i];
				i -= 1;
			}
			if acc == 0 {
				int k = 1;
				loop iq[jk - k] == 0 {
					k += 1;
				}
				for ii in jz + 1..jz + k {
					f[jx + ii] = float(two_over_pi[jv + ii]);
					float fw = 0.0;
					for jj in 0..jx {
						fw += x[jj] * f[jx + ii - jj];
					}
					q[ii] = fw;
				}
				jz += k;
				continue;
			}
		}
		break;
	}

	if z == 0.0 {
		jz -= 1;
		q0 -= 24;
		loop iq[jz] == 0 {
			jz -= 1;
			q0 -= 24;
		}
	} else {
		z = ieee.ldexp(z, -q0);
		if z >= two24 {
			float fw = float(int(twon24 * z));
			iq[jz] = int(z - two24 * fw);
			jz += 1;
			q0 += 24;
			iq[jz] = int(fw);
		} else {
			iq[jz] = int(z);
		}
	}

	float fw = ieee.ldexp(one, q0);
	int i = jz;
	loop i >= 0 {
		q[i] = fw * float(iq[i]);
		fw *= twon24;
		i -= 1;
	}

	i = jz;
	loop i >= 0 {
		float acc = 0.0;
		int k = 0;
		loop k <= jp && k <= jz - i {
			acc += PIo2[k] * q[i + k];
			k += 1;
		}
		fq[jz - i] = acc;
		i -= 1;
	}

	fw = 0.0;
	i = jz;
	loop i >= 0 {
		fw += fq[i];
		i -= 1;
	}
	if ih == 0 {
		y[0] = fw;
	} else {
		y[0] = -fw;
	}
	fw = fq[0] - fw;
	for ii in 1..jz {
		fw += fq[ii];
	}
	if ih == 0 {
		y[1] = fw;
	} else {
		y[1] = -fw;
	}
	return n & 7;
}

internal func remPio2(float x, []float y) int {
	uint uhx = ieee.highWord(x);
	int hx = ieee.signed32(uhx);
	int ix = int(uhx & 0x7fffffff);

	if ix <= 0x3fe921fb {
		y[0] = x;
		y[1] = 0.0;
		return 0;
	}

	if ix < 0x4002d97c {
		if hx > 0 {
			float z = x - pio2_1;
			if ix != 0x3ff921fb {
				y[0] = z - pio2_1t;
				y[1] = (z - y[0]) - pio2_1t;
			} else {
				z -= pio2_2;
				y[0] = z - pio2_2t;
				y[1] = (z - y[0]) - pio2_2t;
			}
			return 1;
		}
		float z = x + pio2_1;
		if ix != 0x3ff921fb {
			y[0] = z + pio2_1t;
			y[1] = (z - y[0]) + pio2_1t;
		} else {
			z += pio2_2;
			y[0] = z + pio2_2t;
			y[1] = (z - y[0]) + pio2_2t;
		}
		return -1;
	}

	if ix <= 0x413921fb {
		float t = ieee.fabs(x);
		int n = int(t * invpio2 + half);
		float fn = float(n);
		float r = t - fn * pio2_1;
		float w = fn * pio2_1t;
		if n < 32 && ix != int(npio2_hw[n - 1]) {
			y[0] = r - w;
		} else {
			int j = ix >> 20;
			y[0] = r - w;
			int i = j - int((ieee.highWord(y[0]) >> 20) & 0x7ff);
			if i > 16 {
				t = r;
				w = fn * pio2_2;
				r = t - w;
				w = fn * pio2_2t - ((t - r) - w);
				y[0] = r - w;
				i = j - int((ieee.highWord(y[0]) >> 20) & 0x7ff);
				if i > 49 {
					t = r;
					w = fn * pio2_3;
					r = t - w;
					w = fn * pio2_3t - ((t - r) - w);
					y[0] = r - w;
				}
			}
		}
		y[1] = (r - y[0]) - w;
		if hx < 0 {
			y[0] = -y[0];
			y[1] = -y[1];
			return -n;
		}
		return n;
	}

	if ix >= 0x7ff00000 {
		y[0] = x - x;
		y[1] = x - x;
		return 0;
	}

	int e0 = (ix >> 20) - 1046;
	float z = ieee.fromWords(uint(ix - (e0 << 20)), ieee.lowWord(x));
	[3]float tx;
	for i in 0..1 {
		tx[i] = float(int(z));
		z = (z - tx[i]) * two24;
	}
	tx[2] = z;
	int nx = 3;
	loop tx[nx - 1] == zero {
		nx -= 1;
	}
	int n = kernelRemPio2(tx[:], y, e0, nx);
	if hx < 0 {
		y[0] = -y[0];
		y[1] = -y[1];
		return -n;
	}
	return n;
}
