/// Computes in `float` and rounds the result to `float32`, so special cases
/// follow `exp`.
public inline func expf(float32 x) float32 => float32(exp(x));

/// Computes in `float` and rounds the result to `float32`, so special cases
/// follow `expm1`.
public inline func expm1f(float32 x) float32 => float32(expm1(x));

/// Computes in `float` and rounds the result to `float32`, so special cases
/// follow `exp2`.
public inline func exp2f(float32 x) float32 => float32(exp2(x));

/// Computes in `float` and rounds the result to `float32`, so special cases
/// follow `log`.
public inline func logf(float32 x) float32 => float32(log(x));

/// Computes in `float` and rounds the result to `float32`, so special cases
/// follow `log1p`.
public inline func log1pf(float32 x) float32 => float32(log1p(x));

/// Computes in `float` and rounds the result to `float32`, so special cases
/// follow `log2`.
public inline func log2f(float32 x) float32 => float32(log2(x));

/// Computes in `float` and rounds the result to `float32`, so special cases
/// follow `log10`.
public inline func log10f(float32 x) float32 => float32(log10(x));

/// Computes in `float` and rounds the result to `float32`, so special cases
/// follow `sin`.
public inline func sinf(float32 x) float32 => float32(sin(x));

/// Computes in `float` and rounds the result to `float32`, so special cases
/// follow `cos`.
public inline func cosf(float32 x) float32 => float32(cos(x));

/// Computes in `float` and rounds the result to `float32`, so special cases
/// follow `tan`.
public inline func tanf(float32 x) float32 => float32(tan(x));

/// Computes in `float` and rounds the result to `float32`, so special cases
/// follow `asin`.
public inline func asinf(float32 x) float32 => float32(asin(x));

/// Computes in `float` and rounds the result to `float32`, so special cases
/// follow `acos`.
public inline func acosf(float32 x) float32 => float32(acos(x));

/// Computes in `float` and rounds the result to `float32`, so special cases
/// follow `atan`.
public inline func atanf(float32 x) float32 => float32(atan(x));

/// Computes in `float` and rounds the result to `float32`, so special cases
/// follow `sinh`.
public inline func sinhf(float32 x) float32 => float32(sinh(x));

/// Computes in `float` and rounds the result to `float32`, so special cases
/// follow `cosh`.
public inline func coshf(float32 x) float32 => float32(cosh(x));

/// Computes in `float` and rounds the result to `float32`, so special cases
/// follow `tanh`.
public inline func tanhf(float32 x) float32 => float32(tanh(x));

/// Computes in `float` and rounds the result to `float32`, so special cases
/// follow `cbrt`.
public inline func cbrtf(float32 x) float32 => float32(cbrt(x));

/// Computes in `float` and rounds the result to `float32`, so special cases
/// follow `fabs`.
public inline func fabsf(float32 x) float32 => float32(fabs(x));

/// Computes in `float` and rounds the result to `float32`, so special cases
/// follow `floor`.
public inline func floorf(float32 x) float32 => float32(floor(x));

/// Computes in `float` and rounds the result to `float32`, so special cases
/// follow `ceil`.
public inline func ceilf(float32 x) float32 => float32(ceil(x));

/// Computes in `float` and rounds the result to `float32`, so special cases
/// follow `trunc`.
public inline func truncf(float32 x) float32 => float32(trunc(x));

/// Computes in `float` and rounds the result to `float32`, so special cases
/// follow `round`.
public inline func roundf(float32 x) float32 => float32(round(x));

/// Computes in `float` and rounds the result to `float32`, so special cases
/// follow `roundEven`.
public inline func roundEvenf(float32 x) float32 => float32(roundEven(x));

/// Computes in `float` and rounds the result to `float32`, so special cases
/// follow `fsqrt`.
public inline func fsqrtf(float32 x) float32 => float32(fsqrt(x));

/// Computes in `float` and rounds the result to `float32`, so special cases
/// follow `fpow`.
public inline func fpowf(float32 x, y) float32 => float32(fpow(x, y));

/// Computes in `float` and rounds the result to `float32`, so special cases follow
/// `atan2`. The first parameter is the y coordinate and the second is x, even
/// though they are named the other way round.
public inline func atan2f(float32 x, y) float32 => float32(atan2(x, y));

/// Computes in `float` and rounds the result to `float32`, so special cases
/// follow `hypot`.
public inline func hypotf(float32 x, y) float32 => float32(hypot(x, y));

/// Computes in `float` and rounds the result to `float32`, so special cases
/// follow `fmod`.
public inline func fmodf(float32 x, y) float32 => float32(fmod(x, y));

/// Computes in `float` and rounds the result to `float32`, so special cases
/// follow `copysign`.
public inline func copysignf(float32 x, y) float32 => float32(copysign(x, y));

/// Same as `fabsf`.
public inline func absf(float32 x) float32 => float32(fabs(x));

/// Computes in `float` and rounds the result to `float32`, so special cases
/// follow `fmin`.
public inline func fminf(float32 x, y) float32 => float32(fmin(x, y));

/// Computes in `float` and rounds the result to `float32`, so special cases
/// follow `fmax`.
public inline func fmaxf(float32 x, y) float32 => float32(fmax(x, y));

/// Computes in `float` and rounds the result to `float32`, so special cases
/// follow `fclamp`.
public inline func fclampf(float32 x, low, high) float32 => float32(fclamp(x, low, high));
