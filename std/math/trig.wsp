import "std/math/ieee";
import "std/math/rempio2";

const {
	half = 5.00000000000000000000e-01;
	S1 = -1.66666666666666324348e-01;
	S2 = 8.33333333332248946124e-03;
	S3 = -1.98412698298579493134e-04;
	S4 = 2.75573137070700676789e-06;
	S5 = -2.50507602534068634195e-08;
	S6 = 1.58969099521155010221e-10;
	one = 1.00000000000000000000e+00;
	C1 = 4.16666666666666019037e-02;
	C2 = -1.38888888888741095749e-03;
	C3 = 2.48015872894767294178e-05;
	C4 = -2.75573143513906633035e-07;
	C5 = 2.08757232129817482790e-09;
	C6 = -1.13596475577881948265e-11;
	pio4 = 7.85398163397448278999e-01;
	pio4lo = 3.06161699786838301793e-17;
}

[13]float T = [3.33333333333334091986e-01, 1.33333333333201242699e-01, 5.39682539762260521377e-02, 2.18694882948595424599e-02, 8.86323982359930005737e-03, 3.59207910759131235356e-03, 1.45620945432529025516e-03, 5.88041240820264096874e-04, 2.46463134818469906812e-04, 7.81794442939557092300e-05, 7.14072491382608190305e-05, -1.85586374855275456654e-05, 2.59073051863633712884e-05];

func kernelSin(float x, float y, int iy) float {
	int ix = int(ieee.highWord(x) & 0x7fffffff);
	if ix < 0x3e400000 {
		if int(x) == 0 {
			return x;
		}
	}
	float z = x * x;
	float v = z * x;
	float r = S2 + z * (S3 + z * (S4 + z * (S5 + z * S6)));
	if iy == 0 {
		return x + v * (S1 + z * r);
	}
	return x - ((z * (half * y - v * r) - y) - v * S1);
}

func kernelCos(float x, float y) float {
	int ix = int(ieee.highWord(x) & 0x7fffffff);
	if ix < 0x3e400000 {
		if int(x) == 0 {
			return one;
		}
	}
	float z = x * x;
	float r = z * (C1 + z * (C2 + z * (C3 + z * (C4 + z * (C5 + z * C6)))));
	if ix < 0x3FD33333 {
		return one - (0.5 * z - (z * r - x * y));
	}
	float qx;
	if ix > 0x3fe90000 {
		qx = 0.28125;
	} else {
		qx = ieee.fromWords(uint(ix - 0x00200000), 0);
	}
	float hz = 0.5 * z - qx;
	float a = one - qx;
	return a - (hz - (z * r - x * y));
}

func kernelTan(float x, float y, int iy) float {
	uint uhx = ieee.highWord(x);
	int hx = ieee.signed32(uhx);
	int ix = hx & 0x7fffffff;
	if ix < 0x3e300000 {
		if int(x) == 0 {
			if (uint(ix) | ieee.lowWord(x) | uint(iy + 1)) == 0 {
				return one / ieee.fabs(x);
			}
			if iy == 1 {
				return x;
			}
			float w = x + y;
			float z = ieee.setLowWord(w, 0);
			float v = y - (z - x);
			float a = -one / w;
			float t = ieee.setLowWord(a, 0);
			float s = one + t * z;
			return t + a * (s + t * v);
		}
	}
	if ix >= 0x3FE59428 {
		if hx < 0 {
			x = -x;
			y = -y;
		}
		float z = pio4 - x;
		float w = pio4lo - y;
		x = z + w;
		y = 0.0;
	}
	float z = x * x;
	float w = z * z;
	float r = T[1] + w * (T[3] + w * (T[5] + w * (T[7] + w * (T[9] + w * T[11]))));
	float v = z * (T[2] + w * (T[4] + w * (T[6] + w * (T[8] + w * (T[10] + w * T[12])))));
	float s = z * x;
	r = y + z * (s * (r + v) + y);
	r += T[0] * s;
	w = x + r;
	if ix >= 0x3FE59428 {
		v = float(iy);
		float sign = 1.0;
		if hx < 0 {
			sign = -1.0;
		}
		return sign * (v - 2.0 * (x - (w * w / (w + v) - r)));
	}
	if iy == 1 {
		return w;
	}
	z = ieee.setLowWord(w, 0);
	v = r - (z - x);
	float a = -1.0 / w;
	float t = ieee.setLowWord(a, 0);
	s = 1.0 + t * z;
	return t + a * (s + t * v);
}

public func sin(float x) float {
	int ix = int(ieee.highWord(x) & 0x7fffffff);
	if ix <= 0x3fe921fb {
		return kernelSin(x, 0.0, 0);
	}
	if ix >= 0x7ff00000 {
		return x - x;
	}
	[2]float y;
	int n = rempio2.remPio2(x, y[:]);
	int quadrant = n & 3;
	if quadrant == 0 {
		return kernelSin(y[0], y[1], 1);
	}
	if quadrant == 1 {
		return kernelCos(y[0], y[1]);
	}
	if quadrant == 2 {
		return -kernelSin(y[0], y[1], 1);
	}
	return -kernelCos(y[0], y[1]);
}

public func cos(float x) float {
	int ix = int(ieee.highWord(x) & 0x7fffffff);
	if ix <= 0x3fe921fb {
		return kernelCos(x, 0.0);
	}
	if ix >= 0x7ff00000 {
		return x - x;
	}
	[2]float y;
	int n = rempio2.remPio2(x, y[:]);
	int quadrant = n & 3;
	if quadrant == 0 {
		return kernelCos(y[0], y[1]);
	}
	if quadrant == 1 {
		return -kernelSin(y[0], y[1], 1);
	}
	if quadrant == 2 {
		return -kernelCos(y[0], y[1]);
	}
	return kernelSin(y[0], y[1], 1);
}

public func tan(float x) float {
	int ix = int(ieee.highWord(x) & 0x7fffffff);
	if ix <= 0x3fe921fb {
		return kernelTan(x, 0.0, 1);
	}
	if ix >= 0x7ff00000 {
		return x - x;
	}
	[2]float y;
	int n = rempio2.remPio2(x, y[:]);
	return kernelTan(y[0], y[1], 1 - ((n & 1) << 1));
}
