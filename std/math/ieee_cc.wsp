internal func words(float x) (uint, uint) {
	uint high, low;
	native lua(in x, out high, low) "low, high = __lua_string.unpack('<I4I4', __lua_string.pack('<d', x))";
	return high, low;
}

internal func fromWords(uint high, low) float {
	float f;
	native lua(in high, low, out f)  "f = __lua_string.unpack('<d', __lua_string.pack('<I4I4', low, high))";
	return f;
}

public func floor(float x) float {
    float r;
    native lua(in x, out r) "r = math.floor(x)";
    return r;
}
public func ceil(float x) float {
    float r;
    native lua(in x, out r) "r = math.ceil(x)";
    return r;
}
public func trunc(float x) float {
	float r;
	native lua(in x, out r) "r, _ = math.modf(x)";
	return r;
}

public func fsqrt(float x) float {
	float r;
	native lua(in x, out r) "r = math.sqrt(x)";
	return r;
}