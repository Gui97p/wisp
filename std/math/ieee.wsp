internal func words(float x) (uint, uint) {
	uint64 bits = (*uint64)(&x)@;
	uint high = bits >> 32;
	uint low = bits & 0xFFFFFFFF;

	return high, low;
}

internal func fromWords(uint high, low) float {
	float f;
	(*uint64)(&f)@ = (high << 32) | low;
	return f;
}

/// Returns the largest whole number not greater than `x`. The sign of zero is kept,
/// and NaN and infinities are returned unchanged.
public native<x64> floor(float x) float r {
	roundsd xmm0, x, 1;
	movsd r, xmm0;
}

/// Returns the smallest whole number not less than `x`. The sign of zero is kept
/// (`ceil(-0.5)` is -0), and NaN and infinities are returned unchanged.
public native<x64> ceil(float x) float r {
	roundsd xmm0, x, 2;
	movsd r, xmm0;
}

/// Returns `x` with the fractional part removed, rounding toward zero. The sign of
/// zero is kept, and NaN and infinities are returned unchanged.
public native<x64> trunc(float x) float r {
	roundsd xmm0, x, 3;
	movsd r, xmm0;
}

/// Returns the square root of `x`, using the hardware instruction. It is NaN for
/// negative `x` and for NaN, and `fsqrt(-0.0)` is -0.
public native<x64> fsqrt(float x) float r {
	sqrtsd xmm0, x;
	movsd r, xmm0;
}

/// Returns the smaller of `x` and `y`. It is NaN when either is NaN, and -0 is
/// treated as smaller than +0.
public func fmin(float x, y) float {
	if (isNaN(x) || isNaN(y)) {
		return nan();
	}

	if (x == 0.0 && y == 0.0) {
		if (signbit(x) || signbit(y)) {
			return -0.0;
		}
		return 0.0;
	}

	if (x < y) {
		return x;
	}
	return y;
}

/// Returns the larger of `x` and `y`. It is NaN when either is NaN, and +0 is
/// treated as larger than -0.
public func fmax(float x, y) float {
	if (isNaN(x) || isNaN(y)) {
		return nan();
	}

	if (x == 0.0 && y == 0.0) {
		if (!signbit(x) || !signbit(y)) {
			return 0.0;
		}
		return -0.0;
	}

	if (x > y) {
		return x;
	}
	return y;
}

/// Returns `x` rounded to the nearest whole number, with halves rounded away from
/// zero (`round(2.5)` is 3 and `round(-2.5)` is -3). See `roundEven` for the other
/// tie rule.
public func round(float x) float {
	float r = trunc(x);
	if fabs(x - r) >= .5 {
		r += copysign(1, x);
	}
	return r;
}
/// Returns `x` rounded to the nearest whole number, with halves rounded to the even
/// neighbor (`roundEven(2.5)` is 2 and `roundEven(3.5)` is 4).
public func roundEven(float x) float {
	float t = floor(x);
	float d = x - t;
	return d < .5 ? t : (d == .5 && fmod(t, 2) == 0 ? t : t + 1);
}
/// Returns `x` limited to the range `low` to `high`, using `fmin` and `fmax`. It is
/// NaN when any argument is NaN.
public inline func fclamp(float x, low, high) float {
	return fmin(fmax(x, low), high);
}

const FLOAT64_SIGN_MASK = 0x80000000;
const FLOAT64_EXP_MASK = 0x7FF00000;
const FLOAT64_FRAC_MASK = 0x000FFFFF;

/// Reports whether `x` is NaN. This is the only reliable test, since NaN is not
/// equal to itself.
public inline func isNaN(float x) bool {
	uint high, low = words(x);
	return (high & FLOAT64_EXP_MASK) == FLOAT64_EXP_MASK &&
		((high & FLOAT64_FRAC_MASK) != 0 || low != 0);
}

/// Reports whether `x` is an infinity. A positive `sign` matches only +infinity, a
/// negative one matches only -infinity, and 0 matches either.
public func isInf(float x, int sign) bool {
	uint high, low = words(x);

	if ((high & 0x7FFFFFFF) != FLOAT64_EXP_MASK || low != 0) {
		return false;
	}

	if (sign > 0) {
		return (high & FLOAT64_SIGN_MASK) == 0;
	}
	if (sign < 0) {
		return (high & FLOAT64_SIGN_MASK) != 0;
	}
	return true;
}

/// Reports whether `x` is neither an infinity nor NaN.
public inline func isFinite(float x) bool {
	uint high, _ = words(x);
	return (high & FLOAT64_EXP_MASK) != FLOAT64_EXP_MASK;
}

/// Reports whether the sign bit of `x` is set. It is true for -0 and for negative
/// NaNs, which `x < 0` is not.
public inline func signbit(float x) bool {
	uint high, _ = words(x);
	return (high & FLOAT64_SIGN_MASK) != 0;
}

/// Reports whether `x` is finite and has no fractional part.
public inline func isInteger(float x) bool {
	return isFinite(x) && x == trunc(x);
}

/// Returns -infinity when `sign` is negative and +infinity otherwise.
public func inf(int sign) float {
	uint high = FLOAT64_EXP_MASK;
	if (sign < 0) {
		high |= FLOAT64_SIGN_MASK;
	}
	return fromWords(high, 0);
}

/// Returns a quiet NaN.
public inline func nan() float {
	return fromWords(0x7FF80000, 0);
}

/// Returns the absolute value of `x` by clearing its sign bit, so `fabs(-0.0)` is 0
/// and the sign of NaN is cleared too.
public inline func fabs(float x) float {
	uint high, low = words(x);
	high &= 0x7FFFFFFF;
	return fromWords(high, low);
}

/// Returns the magnitude of `x` with the sign of `y`, taking the sign bit of `y`
/// even when it is zero or NaN.
public inline func copysign(float x, y) float {
	uint xhigh, xlow = words(x);
	uint yhigh, _ = words(y);

	xhigh = (xhigh & 0x7FFFFFFF) | (yhigh & FLOAT64_SIGN_MASK);
	return fromWords(xhigh, xlow);
}

/// Splits `x` into its whole part and its fractional part, both with the sign of
/// `x`, so that they add up to `x`. `modf(-1.5)` is (-1, -0.5).
public func modf(float x) (float, float) {
	float integer = trunc(x);
	float fraction = x - integer;

	if (fraction == 0.0) {
		fraction = copysign(0.0, x);
	}

	return integer, fraction;
}

const {
	two54 = 1.80143985094819840000e+16;
	twom54 = 5.55111512312578270212e-17;
	huge = 1.0e+300;
	tiny = 1.0e-300;
}

/// Returns `x` times 2 raised to `n`. It overflows to an infinity of the sign of
/// `x`, underflows to a zero of that sign, and returns zero, infinities and NaN
/// unchanged.
public func ldexp(float x, int n) float {
	uint hx, lx = words(x);
	int k = int((hx & 0x7ff00000) >> 20);

	if k == 0 {
		if (lx | (hx & 0x7fffffff)) == 0 {
			return x;
		}
		x *= two54;
		hx, lx = words(x);
		k = int((hx & 0x7ff00000) >> 20) - 54;
		if n < -50000 {
			return tiny * x;
		}
	}

	if k == 0x7ff {
		return x + x;
	}

	k = k + n;
	if k > 0x7fe {
		return huge * copysign(huge, x);
	}

	if k > 0 {
		hx = (hx & 0x800fffff) | (uint(k) << 20);
		return fromWords(hx, lx);
	}

	if k <= -54 {
		if n > 50000 {
			return huge * copysign(huge, x);
		}
		return tiny * copysign(tiny, x);
	}

	k += 54;
	hx = (hx & 0x800fffff) | (uint(k) << 20);
	return fromWords(hx, lx) * twom54;
}

/// Splits `x` into a fraction `f` and an exponent `e` so that `x` is `f * 2^e`,
/// with the magnitude of `f` in 0.5 up to but not including 1. Zero, infinities and
/// NaN return `x` and an exponent of 0. `ldexp` is the inverse.
public func frexp(float x) (float, int) {
	uint hx, lx = words(x);
	int ix = int(hx & 0x7fffffff);
	int e;

	if ix >= 0x7ff00000 || (ix | int(lx)) == 0 {
		return x, e;
	}

	if ix < 0x00100000 {
		x *= two54;
		hx, lx = words(x);
		ix = int(hx & 0x7fffffff);
		e = -54;
	}

	e += int(ix >> 20) - 1022;
	hx = (hx & 0x800fffff) | 0x3fe00000;
	return fromWords(hx, lx), e;
}

/// Splits the magnitude of `x` into an integer mantissa and an exponent so that
/// `abs(x)` is `mantissa * 2^exponent`; the sign is dropped. Normal numbers have
/// bit 52 set in the mantissa, subnormals use the exponent -1074, and zero returns
/// (0, 0). For infinities and NaN the mantissa is the raw fraction bits and the
/// exponent is 0, so check with `isFinite` first.
public func decompose(float x) (uint, int) {
	uint hx, lx = words(x);
	int biased = int((hx >> 20) & 0x7ff);
	uint fraction = ((hx & 0xfffff) << 32) | lx;

	if biased == 0x7ff {
		return fraction, 0;
	}
	if biased == 0 {
		if fraction == 0 {
			return 0, 0;
		}
		return fraction, -1074;
	}
	return fraction | (1 << 52), biased - 1075;
}

internal inline func highWord(float x) uint {
	uint h, _ = words(x);
	return h;
}

internal inline func lowWord(float x) uint {
	uint _, l = words(x);
	return l;
}

internal inline func setHighWord(float x, uint h) float {
	uint _, l = words(x);
	return fromWords(h & 0xffffffff, l);
}

internal inline func setLowWord(float x, uint l) float {
	uint h, _ = words(x);
	return fromWords(h, l & 0xffffffff);
}

internal inline func signed32(uint w) int {
	if w >= 0x80000000 {
		return int(w) - 0x100000000;
	}
	return int(w);
}

internal inline func addExponent(float x, int k) float {
	uint h, l = words(x);
	return fromWords(uint(int(h) + (k << 20)) & 0xffffffff, l);
}

internal func exponentOf(uint h, l) int {
	if h >= 0x00100000 {
		return int(h >> 20) - 1023;
	}

	int e;
	uint i;
	if h == 0 {
		e = -1043;
		i = l;
	} else {
		e = -1022;
		i = (h << 11) & 0xffffffff;
	}
	loop (i & 0x80000000) == 0 {
		i = (i << 1) & 0xffffffff;
		e -= 1;
	}
	return e;
}

/// Returns the remainder of `x` divided by `y`, computed exactly, with the sign of
/// `x` and a magnitude below `abs(y)`. It is NaN when `y` is 0, when `x` is
/// infinite and when either is NaN, and `x` when `y` is infinite.
public func fmod(float x, y) float {
	uint hx, lx = words(x);
	uint hy, ly = words(y);

	uint sx = hx & 0x80000000;
	hx = hx ^ sx;
	hy = hy & 0x7fffffff;

	if y == 0.0 || !isFinite(x) || isNaN(y) {
		return nan();
	}

	if hx <= hy {
		if hx < hy || lx < ly {
			return x;
		}
		if lx == ly {
			return copysign(0.0, x);
		}
	}

	int ix = exponentOf(hx, lx);
	int iy = exponentOf(hy, ly);

	if ix >= -1022 {
		hx = 0x00100000 | (0x000fffff & hx);
	} else {
		int shift = -1022 - ix;
		if shift <= 31 {
			hx = ((hx << shift) | (lx >> (32 - shift))) & 0xffffffff;
			lx = (lx << shift) & 0xffffffff;
		} else {
			hx = (lx << (shift - 32)) & 0xffffffff;
			lx = 0;
		}
	}

	if iy >= -1022 {
		hy = 0x00100000 | (0x000fffff & hy);
	} else {
		int shift = -1022 - iy;
		if shift <= 31 {
			hy = ((hy << shift) | (ly >> (32 - shift))) & 0xffffffff;
			ly = (ly << shift) & 0xffffffff;
		} else {
			hy = (ly << (shift - 32)) & 0xffffffff;
			ly = 0;
		}
	}

	int n = ix - iy;
	loop n > 0 {
		n -= 1;
		int hz = int(hx) - int(hy);
		uint lz = (lx -% ly) & 0xffffffff;
		if lx < ly {
			hz -= 1;
		}
		if hz < 0 {
			hx = hx + hx + (lx >> 31);
			lx = (lx + lx) & 0xffffffff;
		} else {
			if (uint(hz) | lz) == 0 {
				return copysign(0.0, x);
			}
			hx = uint(hz) + uint(hz) + (lz >> 31);
			lx = (lz + lz) & 0xffffffff;
		}
	}

	int hz = int(hx) - int(hy);
	uint lz = (lx -% ly) & 0xffffffff;
	if lx < ly {
		hz -= 1;
	}
	if hz >= 0 {
		hx = uint(hz);
		lx = lz;
	}

	if (hx | lx) == 0 {
		return copysign(0.0, x);
	}
	loop hx < 0x00100000 {
		hx = hx + hx + (lx >> 31);
		lx = (lx + lx) & 0xffffffff;
		iy -= 1;
	}

	if iy >= -1022 {
		hx = (hx - 0x00100000) | (uint(iy + 1023) << 20);
		return fromWords(hx | sx, lx);
	}

	int shift = -1022 - iy;
	if shift <= 20 {
		lx = ((lx >> shift) | (hx << (32 - shift))) & 0xffffffff;
		hx = hx >> shift;
	} else if shift <= 31 {
		lx = ((hx << (32 - shift)) | (lx >> shift)) & 0xffffffff;
		hx = 0;
	} else {
		lx = hx >> (shift - 32);
		hx = 0;
	}
	return fromWords(hx | sx, lx);
}
