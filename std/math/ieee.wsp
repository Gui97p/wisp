public func fmin(float x, y) float {
    if (isNaN(x) || isNaN(y)) {
        return nan();
    }

    if (x == 0.0 && y == 0.0) {
        if (signbit(x) || signbit(y)) {
            return -0.0;
        }
        return 0.0;
    }

    if (x < y) {
        return x;
    }
    return y;
}

public func fmax(float x, y) float {
    if (isNaN(x) || isNaN(y)) {
        return nan();
    }

    if (x == 0.0 && y == 0.0) {
        if (!signbit(x) || !signbit(y)) {
            return 0.0;
        }
        return -0.0;
    }

    if (x > y) {
        return x;
    }
    return y;
}

public func round(float x) float {
	float r = trunc(x);
	if fabs(x - r) >= .5 {
		r += copysign(1, x);
	}
	return r;
}
public func roundEven(float x) float {
	float t = floor(x);
	float d = x - t;
	return d < .5 ? t : (d == .5 && fmod(t, 2) == 0 ? t : t+1);
}
public func fclamp(float x, low, high) float {
    return fmin(fmax(x, low), high);
}

const FLOAT64_SIGN_MASK = 0x80000000;
const FLOAT64_EXP_MASK  = 0x7FF00000;
const FLOAT64_FRAC_MASK = 0x000FFFFF;

public func isNaN(float x) bool {
	uint high, low = words(x);
    return (high & FLOAT64_EXP_MASK) == FLOAT64_EXP_MASK &&
        ((high & FLOAT64_FRAC_MASK) != 0 || low != 0);
}

public func isInf(float x, int sign) bool {
    uint high, low = words(x);

    if ((high & 0x7FFFFFFF) != FLOAT64_EXP_MASK || low != 0) {
        return false;
    }

    if (sign > 0) {
        return (high & FLOAT64_SIGN_MASK) == 0;
    }
    if (sign < 0) {
        return (high & FLOAT64_SIGN_MASK) != 0;
    }
    return true;
}

public func isFinite(float x) bool {
    uint high, _ = words(x);
    return (high & FLOAT64_EXP_MASK) != FLOAT64_EXP_MASK;
}

public func signbit(float x) bool {
    uint high, _ = words(x);
    return (high & FLOAT64_SIGN_MASK) != 0;
}

public func isInteger(float x) bool {
    return isFinite(x) && x == trunc(x);
}

public func inf(int sign) float {
    uint high = FLOAT64_EXP_MASK;
    if (sign < 0) {
        high |= FLOAT64_SIGN_MASK;
    }
    return fromWords(high, 0);
}

public func nan() float {
    return fromWords(0x7FF80000, 0);
}

public func fabs(float x) float {
    uint high, low = words(x);
    high &= 0x7FFFFFFF;
    return fromWords(high, low);
}

public func copysign(float x, y) float {
    uint xhigh, xlow = words(x);
    uint yhigh, _ = words(y);

    xhigh = (xhigh & 0x7FFFFFFF) | (yhigh & FLOAT64_SIGN_MASK);
    return fromWords(xhigh, xlow);
}

public func modf(float x) (float, float) {
    float integer = trunc(x);
    float fraction = x - integer;

    if (fraction == 0.0) {
        fraction = copysign(0.0, x);
    }

    return integer, fraction;
}

const {
	two54 = 1.80143985094819840000e+16;
	twom54 = 5.55111512312578270212e-17;
	huge = 1.0e+300;
	tiny = 1.0e-300;
}

public func ldexp(float x, int n) float {
	uint hx, lx = words(x);
	int k = int((hx & 0x7ff00000) >> 20);

	if k == 0 {
		if (lx | (hx & 0x7fffffff)) == 0 {
			return x;
		}
		x *= two54;
		hx, lx = words(x);
		k = int((hx & 0x7ff00000) >> 20) - 54;
		if n < -50000 {
			return tiny * x;
		}
	}

	if k == 0x7ff {
		return x + x;
	}

	k = k + n;
	if k > 0x7fe {
		return huge * copysign(huge, x);
	}

	if k > 0 {
		hx = (hx & 0x800fffff) | (uint(k) << 20);
		return fromWords(hx, lx);
	}

	if k <= -54 {
		if n > 50000 {
			return huge * copysign(huge, x);
		}
		return tiny * copysign(tiny, x);
	}

	k += 54;
	hx = (hx & 0x800fffff) | (uint(k) << 20);
	return fromWords(hx, lx) * twom54;
}

public func frexp(float x) (float, int) {
	uint hx, lx = words(x);
	int ix = int(hx & 0x7fffffff);
	int e;

	if ix >= 0x7ff00000 || (ix | int(lx)) == 0 {
		return x, e;
	}

	if ix < 0x00100000 {
		x *= two54;
		hx, lx = words(x);
		ix = int(hx & 0x7fffffff);
		e = -54;
	}

	e += int(ix >> 20) - 1022;
	hx = (hx & 0x800fffff) | 0x3fe00000;
	return fromWords(hx, lx), e;
}

internal func highWord(float x) uint {
	uint h, _ = words(x);
	return h;
}

internal func lowWord(float x) uint {
	uint _, l = words(x);
	return l;
}

internal func setHighWord(float x, uint h) float {
	uint _, l = words(x);
	return fromWords(h & 0xffffffff, l);
}

internal func setLowWord(float x, uint l) float {
	uint h, _ = words(x);
	return fromWords(h, l & 0xffffffff);
}

internal func signed32(uint w) int {
	if w >= 0x80000000 {
		return int(w) - 0x100000000;
	}
	return int(w);
}

internal func addExponent(float x, int k) float {
	uint h, l = words(x);
	return fromWords(uint(int(h) + (k << 20)) & 0xffffffff, l);
}

internal func exponentOf(uint h, l) int {
	if h >= 0x00100000 {
		return int(h >> 20) - 1023;
	}

	int e;
	uint i;
	if h == 0 {
		e = -1043;
		i = l;
	} else {
		e = -1022;
		i = (h << 11) & 0xffffffff;
	}
	loop (i & 0x80000000) == 0 {
		i = (i << 1) & 0xffffffff;
		e -= 1;
	}
	return e;
}

public func fmod(float x, y) float {
	uint hx, lx = words(x);
	uint hy, ly = words(y);

	uint sx = hx & 0x80000000;
	hx = hx ^ sx;
	hy = hy & 0x7fffffff;

	if y == 0.0 || !isFinite(x) || isNaN(y) {
		return nan();
	}

	if hx <= hy {
		if hx < hy || lx < ly {
			return x;
		}
		if lx == ly {
			return copysign(0.0, x);
		}
	}

	int ix = exponentOf(hx, lx);
	int iy = exponentOf(hy, ly);

	if ix >= -1022 {
		hx = 0x00100000 | (0x000fffff & hx);
	} else {
		int shift = -1022 - ix;
		if shift <= 31 {
			hx = ((hx << shift) | (lx >> (32 - shift))) & 0xffffffff;
			lx = (lx << shift) & 0xffffffff;
		} else {
			hx = (lx << (shift - 32)) & 0xffffffff;
			lx = 0;
		}
	}

	if iy >= -1022 {
		hy = 0x00100000 | (0x000fffff & hy);
	} else {
		int shift = -1022 - iy;
		if shift <= 31 {
			hy = ((hy << shift) | (ly >> (32 - shift))) & 0xffffffff;
			ly = (ly << shift) & 0xffffffff;
		} else {
			hy = (ly << (shift - 32)) & 0xffffffff;
			ly = 0;
		}
	}

	int n = ix - iy;
	loop n > 0 {
		n -= 1;
		int hz = int(hx) - int(hy);
		uint lz = (lx - ly) & 0xffffffff;
		if lx < ly {
			hz -= 1;
		}
		if hz < 0 {
			hx = hx + hx + (lx >> 31);
			lx = (lx + lx) & 0xffffffff;
		} else {
			if (uint(hz) | lz) == 0 {
				return copysign(0.0, x);
			}
			hx = uint(hz) + uint(hz) + (lz >> 31);
			lx = (lz + lz) & 0xffffffff;
		}
	}

	int hz = int(hx) - int(hy);
	uint lz = (lx - ly) & 0xffffffff;
	if lx < ly {
		hz -= 1;
	}
	if hz >= 0 {
		hx = uint(hz);
		lx = lz;
	}

	if (hx | lx) == 0 {
		return copysign(0.0, x);
	}
	loop hx < 0x00100000 {
		hx = hx + hx + (lx >> 31);
		lx = (lx + lx) & 0xffffffff;
		iy -= 1;
	}

	if iy >= -1022 {
		hx = (hx - 0x00100000) | (uint(iy + 1023) << 20);
		return fromWords(hx | sx, lx);
	}

	int shift = -1022 - iy;
	if shift <= 20 {
		lx = ((lx >> shift) | (hx << (32 - shift))) & 0xffffffff;
		hx = hx >> shift;
	} else if shift <= 31 {
		lx = ((hx << (32 - shift)) | (lx >> shift)) & 0xffffffff;
		hx = 0;
	} else {
		lx = hx >> (shift - 32);
		hx = 0;
	}
	return fromWords(hx | sx, lx);
}
