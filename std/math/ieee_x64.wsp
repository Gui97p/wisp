internal func words(float x) (uint, uint) {
	uint64 bits = (*uint64)(&x)@;
	uint high = bits >> 32;
	uint low = bits & 0xFFFFFFFF;

	return high, low;
}

internal func fromWords(uint high, low) float {
	float f;
	(*uint64)(&f)@ = (high << 32) | low;
	return f;
}

public func floor(float x) float {
    float r;
    native<x64>(in x, out r) "roundsd xmm0, {x}, 1; movsd {r}, xmm0";
    return r;
}
public func ceil(float x) float {
    float r;
    native<x64>(in x, out r) "roundsd xmm0, {x}, 2; movsd {r}, xmm0";
    return r;
}
public func trunc(float x) float {
    float r;
    native<x64>(in x, out r) "roundsd xmm0, {x}, 3; movsd {r}, xmm0";
    return r;
}

public func fsqrt(float x) float {
	float r;
	native<x64>(in x, out r) "sqrtsd xmm0, {x}; movsd {r}, xmm0";
	return r;
}
