import "std/math/ieee";
import "std/math/exp";

const {
	one = 1.0;
	shuge = 1.0e307;
	half = 0.5;
	huge = 1.0e300;
	two = 2.0;
	tiny = 1.0e-300;
}

public func sinh(float x) float {
	uint ujx = ieee.highWord(x);
	int jx = ieee.signed32(ujx);
	int ix = int(ujx & 0x7fffffff);
	if ix >= 0x7ff00000 {
		return x + x;
	}

	float h = 0.5;
	if jx < 0 {
		h = -h;
	}
	if ix < 0x40360000 {
		if ix < 0x3e300000 {
			if shuge + x > one {
				return x;
			}
		}
		float t = exp.expm1(ieee.fabs(x));
		if ix < 0x3ff00000 {
			return h * (2.0 * t - t * t / (t + one));
		}
		return h * (t + t / (t + one));
	}
	if ix < 0x40862E42 {
		return h * exp.exp(ieee.fabs(x));
	}

	uint lx = ieee.lowWord(x);
	if ix < 0x408633CE || (ix == 0x408633ce && lx <= 0x8fb9f87d) {
		float w = exp.exp(0.5 * ieee.fabs(x));
		float t = h * w;
		return t * w;
	}
	return x * shuge;
}

public func cosh(float x) float {
	int ix = int(ieee.highWord(x) & 0x7fffffff);
	if ix >= 0x7ff00000 {
		return x * x;
	}

	if ix < 0x3fd62e43 {
		float t = exp.expm1(ieee.fabs(x));
		float w = one + t;
		if ix < 0x3c800000 {
			return w;
		}
		return one + (t * t) / (w + w);
	}
	if ix < 0x40360000 {
		float t = exp.exp(ieee.fabs(x));
		return half * t + half / t;
	}
	if ix < 0x40862E42 {
		return half * exp.exp(ieee.fabs(x));
	}

	uint lx = ieee.lowWord(x);
	if ix < 0x408633CE || (ix == 0x408633ce && lx <= 0x8fb9f87d) {
		float w = exp.exp(half * ieee.fabs(x));
		float t = half * w;
		return t * w;
	}
	return huge * huge;
}

public func tanh(float x) float {
	uint ujx = ieee.highWord(x);
	int jx = ieee.signed32(ujx);
	int ix = int(ujx & 0x7fffffff);

	if ix >= 0x7ff00000 {
		if jx >= 0 {
			return one / x + one;
		}
		return one / x - one;
	}

	float z;
	if ix < 0x40360000 {
		if ix < 0x3c800000 {
			return x * (one + x);
		}
		if ix >= 0x3ff00000 {
			float t = exp.expm1(two * ieee.fabs(x));
			z = one - two / (t + two);
		} else {
			float t = exp.expm1(-two * ieee.fabs(x));
			z = -t / (t + two);
		}
	} else {
		z = one - tiny;
	}
	if jx >= 0 {
		return z;
	}
	return -z;
}
