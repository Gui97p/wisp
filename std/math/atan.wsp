import "std/math/ieee";

const {
	one = 1.0;
	huge = 1.0e300;
	tiny = 1.0e-300;
	zero = 0.0;
	pi_o_4 = 7.8539816339744827900E-01;
	pi_o_2 = 1.5707963267948965580E+00;
	pi = 3.1415926535897931160E+00;
	pi_lo = 1.2246467991473531772E-16;
	pio2_hi = 1.57079632679489655800e+00;
	pio2_lo = 6.12323399573676603587e-17;
	pio4_hi = 7.85398163397448278999e-01;
	pS0 = 1.66666666666666657415e-01;
	pS1 = -3.25565818622400915405e-01;
	pS2 = 2.01212532134862925881e-01;
	pS3 = -4.00555345006794114027e-02;
	pS4 = 7.91534994289814532176e-04;
	pS5 = 3.47933107596021167570e-05;
	qS1 = -2.40339491173441421878e+00;
	qS2 = 2.02094576023350569471e+00;
	qS3 = -6.88283971605453293030e-01;
	qS4 = 7.70381505559019352791e-02;
}

[4]float atanhi = [4.63647609000806093515e-01, 7.85398163397448278999e-01, 9.82793723247329054082e-01, 1.57079632679489655800e+00];
[4]float atanlo = [2.26987774529616870924e-17, 3.06161699786838301793e-17, 1.39033110312309984516e-17, 6.12323399573676603587e-17];
[11]float aT = [3.33333333333329318027e-01, -1.99999999998764832476e-01, 1.42857142725034663711e-01, -1.11111104054623557880e-01, 9.09088713343650656196e-02, -7.69187620504482999495e-02, 6.66107313738753120669e-02, -5.83357013379057348645e-02, 4.97687799461593236017e-02, -3.65315727442169155270e-02, 1.62858201153657823623e-02];

public func atan(float x) float {
	uint uhx = ieee.highWord(x);
	int hx = ieee.signed32(uhx);
	int ix = int(uhx & 0x7fffffff);
	int id;

	if ix >= 0x44100000 {
		if ix > 0x7ff00000 || (ix == 0x7ff00000 && ieee.lowWord(x) != 0) {
			return x + x;
		}
		if hx > 0 {
			return atanhi[3] + atanlo[3];
		}
		return -atanhi[3] - atanlo[3];
	}

	if ix < 0x3fdc0000 {
		if ix < 0x3e200000 {
			if huge + x > one {
				return x;
			}
		}
		id = -1;
	} else {
		x = ieee.fabs(x);
		if ix < 0x3ff30000 {
			if ix < 0x3fe60000 {
				id = 0;
				x = (2.0 * x - one) / (2.0 + x);
			} else {
				id = 1;
				x = (x - one) / (x + one);
			}
		} else {
			if ix < 0x40038000 {
				id = 2;
				x = (x - 1.5) / (one + 1.5 * x);
			} else {
				id = 3;
				x = -1.0 / x;
			}
		}
	}

	float z = x * x;
	float w = z * z;
	float s1 = z * (aT[0] + w * (aT[2] + w * (aT[4] + w * (aT[6] + w * (aT[8] + w * aT[10])))));
	float s2 = w * (aT[1] + w * (aT[3] + w * (aT[5] + w * (aT[7] + w * aT[9]))));
	if id < 0 {
		return x - x * (s1 + s2);
	}
	z = atanhi[id] - ((x * (s1 + s2) - atanlo[id]) - x);
	if hx < 0 {
		return -z;
	}
	return z;
}

public func atan2(float y, float x) float {
	uint uhx = ieee.highWord(x);
	int hx = ieee.signed32(uhx);
	int ix = int(uhx & 0x7fffffff);
	uint lx = ieee.lowWord(x);
	uint uhy = ieee.highWord(y);
	int hy = ieee.signed32(uhy);
	int iy = int(uhy & 0x7fffffff);
	uint ly = ieee.lowWord(y);

	if ieee.isNaN(x) || ieee.isNaN(y) {
		return x + y;
	}
	if hx == 0x3ff00000 && lx == 0 {
		return atan(y);
	}

	int m = 0;
	if hy < 0 {
		m = 1;
	}
	if hx < 0 {
		m = m | 2;
	}

	if (uint(iy) | ly) == 0 {
		if m == 0 || m == 1 {
			return y;
		}
		if m == 2 {
			return pi + tiny;
		}
		return -pi - tiny;
	}
	if (uint(ix) | lx) == 0 {
		if hy < 0 {
			return -pi_o_2 - tiny;
		}
		return pi_o_2 + tiny;
	}

	if ix == 0x7ff00000 {
		if iy == 0x7ff00000 {
			if m == 0 {
				return pi_o_4 + tiny;
			}
			if m == 1 {
				return -pi_o_4 - tiny;
			}
			if m == 2 {
				return 3.0 * pi_o_4 + tiny;
			}
			return -3.0 * pi_o_4 - tiny;
		}
		if m == 0 {
			return zero;
		}
		if m == 1 {
			return -zero;
		}
		if m == 2 {
			return pi + tiny;
		}
		return -pi - tiny;
	}
	if iy == 0x7ff00000 {
		if hy < 0 {
			return -pi_o_2 - tiny;
		}
		return pi_o_2 + tiny;
	}

	int k = (iy - ix) >> 20;
	float z;
	if k > 60 {
		z = pi_o_2 + 0.5 * pi_lo;
	} else if hx < 0 && k < -60 {
		z = 0.0;
	} else {
		z = atan(ieee.fabs(y / x));
	}

	if m == 0 {
		return z;
	}
	if m == 1 {
		return -z;
	}
	if m == 2 {
		return pi - (z - pi_lo);
	}
	return (z - pi_lo) - pi;
}

public func asin(float x) float {
	uint uhx = ieee.highWord(x);
	int hx = ieee.signed32(uhx);
	int ix = int(uhx & 0x7fffffff);

	if ix >= 0x3ff00000 {
		if ix == 0x3ff00000 && ieee.lowWord(x) == 0 {
			return x * pio2_hi + x * pio2_lo;
		}
		return ieee.nan();
	}
	if ix < 0x3fe00000 {
		if ix < 0x3e400000 {
			if huge + x > one {
				return x;
			}
		}
		float t = x * x;
		float p = t * (pS0 + t * (pS1 + t * (pS2 + t * (pS3 + t * (pS4 + t * pS5)))));
		float q = one + t * (qS1 + t * (qS2 + t * (qS3 + t * qS4)));
		float w = p / q;
		return x + x * w;
	}

	float w = one - ieee.fabs(x);
	float t = w * 0.5;
	float p = t * (pS0 + t * (pS1 + t * (pS2 + t * (pS3 + t * (pS4 + t * pS5)))));
	float q = one + t * (qS1 + t * (qS2 + t * (qS3 + t * qS4)));
	float s = ieee.fsqrt(t);
	if ix >= 0x3FEF3333 {
		w = p / q;
		t = pio2_hi - (2.0 * (s + s * w) - pio2_lo);
	} else {
		w = ieee.setLowWord(s, 0);
		float c = (t - w * w) / (s + w);
		float r = p / q;
		p = 2.0 * s * r - (pio2_lo - 2.0 * c);
		q = pio4_hi - 2.0 * w;
		t = pio4_hi - (p - q);
	}
	if hx > 0 {
		return t;
	}
	return -t;
}

public func acos(float x) float {
	uint uhx = ieee.highWord(x);
	int hx = ieee.signed32(uhx);
	int ix = int(uhx & 0x7fffffff);

	if ix >= 0x3ff00000 {
		if ix == 0x3ff00000 && ieee.lowWord(x) == 0 {
			if hx > 0 {
				return 0.0;
			}
			return pi + 2.0 * pio2_lo;
		}
		return ieee.nan();
	}
	if ix < 0x3fe00000 {
		if ix <= 0x3c600000 {
			return pio2_hi + pio2_lo;
		}
		float z = x * x;
		float p = z * (pS0 + z * (pS1 + z * (pS2 + z * (pS3 + z * (pS4 + z * pS5)))));
		float q = one + z * (qS1 + z * (qS2 + z * (qS3 + z * qS4)));
		float r = p / q;
		return pio2_hi - (x - (pio2_lo - x * r));
	}
	if hx < 0 {
		float z = (one + x) * 0.5;
		float p = z * (pS0 + z * (pS1 + z * (pS2 + z * (pS3 + z * (pS4 + z * pS5)))));
		float q = one + z * (qS1 + z * (qS2 + z * (qS3 + z * qS4)));
		float s = ieee.fsqrt(z);
		float r = p / q;
		float w = r * s - pio2_lo;
		return pi - 2.0 * (s + w);
	}
	float z = (one - x) * 0.5;
	float s = ieee.fsqrt(z);
	float df = ieee.setLowWord(s, 0);
	float c = (z - df * df) / (s + df);
	float p = z * (pS0 + z * (pS1 + z * (pS2 + z * (pS3 + z * (pS4 + z * pS5)))));
	float q = one + z * (qS1 + z * (qS2 + z * (qS3 + z * qS4)));
	float r = p / q;
	float w = r * s + c;
	return 2.0 * (df + w);
}
