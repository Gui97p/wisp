import "std/strings";

const<windows> sep = "\\";
const<!windows> sep = "/";

inline func<windows> isSep(byte c) bool => c == '\\' || c == '/';
inline func<!windows> isSep(byte c) bool => c == '/';

func<windows> isLetter(byte c) bool {
	return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
}

func<windows> volumeLen(string p) int {
	int l = len(p);
	if l >= 2 && p[1] == ':' && isLetter(p[0]) => return 2;
	if l >= 5 && isSep(p[0]) && isSep(p[1]) && !isSep(p[2]) && p[2] != '.' {
		int n = 3;
		loop n < l - 1 {
			if isSep(p[n]) {
				n++;
				if !isSep(p[n]) {
					if p[n] == '.' => break;
					loop n < l && !isSep(p[n]) {
						n++;
					}
					return n;
				}
				break;
			}
			n++;
		}
	}
	return 0;
}

inline func<!windows> volumeLen(string _p) int => 0;

/// Reports whether `p` is absolute. On Windows that means a drive letter
/// followed by a separator, or a UNC path.
public func<windows> isAbs(string p) bool {
	int v = volumeLen(p);
	if v == 0 => return false;
	if v > 2 => return true;
	return v < len(p) && isSep(p[v]);
}

/// Reports whether `p` is absolute, which is when it starts with `/`.
public inline func<!windows> isAbs(string p) bool {
	return len(p) > 0 && p[0] == '/';
}

/// An iterator over the elements of a path, made by `elements`.
public struct Elements {
	string rest;
}

/// Returns the next element of the path, or null at the end. Separators are
/// skipped, so no element is empty. The string points into the original path.
public func (*Elements e) next() ?string {
	string s = e.rest;
	loop s != "" && isSep(s[0]) {
		s = s[1..];
	}
	if s == "" {
		e.rest = "";
		return null;
	}
	int i;
	loop i < len(s) && !isSep(s[i]) {
		i++;
	}
	e.rest = s[i..];
	return s[..i];
}

/// Starts an iteration over the elements of `p`, without any volume name. `.`
/// and `..` are returned as they are.
public inline func elements(string p) Elements => Elements { rest:p[volumeLen(p)..] };

inline func elementsAfterVolume(string s) Elements => Elements { rest:s };

/// Returns the last element of `p`, without trailing separators. An empty path
/// gives `.`, and a path of only separators gives the separator. The result
/// points into `p`.
#must_use
public func base(string p) string {
	if p == "" => return ".";
	int v = volumeLen(p);
	int end = len(p);
	loop end > 0 && isSep(p[end - 1]) {
		end--;
	}
	if end <= v => return sep;
	int i = end - 1;
	loop i >= v && !isSep(p[i]) {
		i--;
	}
	return p[i + 1..end];
}

/// Returns everything but the last element of `p`, without trailing separators.
/// An empty path or one with no directory part gives `.`, and a root stays the
/// root. The result points into `p` and is not cleaned.
#must_use
public func dir(string p) string {
	if p == "" => return ".";
	int v = volumeLen(p);
	if v > 2 && len(p) == v => return p;
	int end = len(p);
	loop end > v && isSep(p[end - 1]) {
		end--;
	}
	if end == v => return len(p) > v ? p[..v + 1] : (v == 0 ? "." : p[..v]);
	int i = end - 1;
	loop i >= v && !isSep(p[i]) {
		i--;
	}
	if i < v => return v == 0 ? "." : p[..v];
	int head = i;
	loop head > v && isSep(p[head - 1]) {
		head--;
	}
	if head == v => return p[..v + 1];
	return p[..head];
}

/// Returns the extension of the last element of `p`, with its dot, or an empty
/// string. A name that only starts with a dot, or ends with one, has none.
#must_use
public func ext(string p) string {
	p = base(p);

	int idx = strings.lastIndexOfByte(p, '.') ?? return "";
	return idx == 0 || idx == len(p) - 1 ? "" : p[idx..];
}

/// Returns the last element of `p` without its extension.
#must_use
public inline func stem(string p) string => strings.trimSuffix(base(p), ext(p));
