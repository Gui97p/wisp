import "std/math";
import "std/mem";
import "std/strings";

/// Joins the `parts` with the separator of the platform into a new string,
/// allocated from `a`. Empty parts are skipped, repeated separators collapse, and
/// a part that starts with a root keeps it only if it is the first. The result is
/// not cleaned of `.` and `..`. The caller frees it with `mem.free`, or leaves it
/// to an arena or a `Fixed`. Fails with the error of the allocator.
public func join(mem.Allocator a, string ...parts) !string {
	int room = len(sep) * (len(parts) + 1);
	for _, p in parts {
		room += len(p);
	}
	[]byte buf = mem.makeDirty<byte>(a, room)!;

	int total;
	bool seen, firstPassed;

	for _, p in parts {
		if p == "" => continue;
		string rest = p;
		if !seen {
			seen = true;
			int v = volumeLen(p);
			total += strings.copy(buf[total..], p[..v]);
			if v < len(p) && isSep(p[v]) {
				total += strings.copy(buf[total..], sep);
			} else if v > 2 {
				firstPassed = true;
			}
			rest = p[v..];
		}
		let elems = elementsAfterVolume(rest);
		loop elems.next() |n| {
			if firstPassed => total += strings.copy(buf[total..], sep);
			total += strings.copy(buf[total..], n);
			firstPassed = true;
		}
	}
	return string(buf[..total]);
}

/// Makes a new string with the shortest form of `p` that names the same place,
/// allocated from `a`: repeated separators and `.` are dropped, and `..` cancels
/// the element before it. A `..` at the root is dropped, and one at the start of a
/// relative path is kept. An empty result becomes `.`. It always allocates, even
/// when `p` is already clean, so the result is always yours to free with
/// `mem.free`, or to leave to an arena or a `Fixed`. Fails with the error of the
/// allocator.
public func clean(mem.Allocator a, string p) !string {
	[]byte buf = mem.makeDirty<byte>(a, len(p) + len(sep) + 1)!;

	int total, depth;
	int v = volumeLen(p);
	total += strings.copy(buf, p[..v]);
	bool rooted = v < len(p) && isSep(p[v]);
	if rooted => total += strings.copy(buf[total..], sep);
	int rootLen = total;

	let elems = elementsAfterVolume(p[v..]);
	loop elems.next() |n| {
		match n {
			"." => continue;
			".." => {
				if depth > 0 {
					total = math.max(strings.lastIndexOf(string(buf[..total]), sep) ?? rootLen, rootLen);
					depth--;
					continue;
				} else if rooted {
					continue;
				}
			}
			_ => depth++;
		}

		if total > rootLen => total += strings.copy(buf[total..], sep);
		total += strings.copy(buf[total..], n);
	}

	if total == 0 {
		strings.copy(buf, ".");
		total++;
	}

	return string(buf[..total]);
}
