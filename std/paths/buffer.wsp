import "std/math";
import "std/mem";
import "std/strings";

/// Joins the `parts` with the separator of the platform into `buf` and returns
/// the result, which points into `buf`. Empty parts are skipped, repeated
/// separators collapse, and a part that starts with a root keeps it only if it
/// is the first. The result is not cleaned of `.` and `..`. Fails with `NoSpace` if
/// `buf` is too small.
public func join([]byte buf, string ...parts) !string {
	int total;
	bool seen, firstPassed;

	for _, p in parts {
		continue if p == "";
		string rest = p;
		if !seen {
			seen = true;
			int v = volumeLen(p);
			total += len(strings.copy(buf[total..], p[..v])!);
			if v < len(p) && isSep(p[v]) {
				total += len(strings.copy(buf[total..], sep)!);
			} else if v > 2 {
				firstPassed = true;
			}
			rest = p[v..];
		}
		let elems = elementsAfterVolume(rest);
		loop elems.next() |n| {
			if firstPassed {
				total += len(strings.copy(buf[total..], sep)!);
			}
			total += len(strings.copy(buf[total..], n)!);
			firstPassed = true;
		}
	}
	return string(buf[..total]);
}

/// Writes into `buf` the shortest form of `p` that names the same place:
/// repeated separators and `.` are dropped, and `..` cancels the element before
/// it. A `..` at the root is dropped, and one at the start of a relative path is
/// kept. An empty result becomes `.`. The result points into `buf`. Fails with
/// `NoSpace` if `buf` is too small.
public func clean([]byte buf, string p) !string {
	int total, depth;
	int v = volumeLen(p);
	total += len(strings.copy(buf, p[..v])!);
	bool rooted = v < len(p) && isSep(p[v]);
	if rooted {
		total += len(strings.copy(buf[total..], sep)!);
	}
	int rootLen = total;

	let elems = elementsAfterVolume(p[v..]);
	loop elems.next() |n| {
		switch n {
			case "." => continue;
			case ".." => {
				if depth > 0 {
					total = math.max(strings.lastIndexOf(string(buf[..total]), sep) ?? rootLen, rootLen);
					depth--;
					continue;
				} else if rooted {
					continue;
				}
			}
			default => depth++;
		}

		if total > rootLen {
			total += len(strings.copy(buf[total..], sep)!);
		}
		total += len(strings.copy(buf[total..], n)!);
	}

	if total == 0 {
		strings.copy(buf, ".")!;
		total++;
	}

	return string(buf[..total]);
}

/// Like `join`, into a new byte slice allocated from `a`. The caller frees it with `mem.free`. An empty result
/// allocates nothing. Fails with the allocator error when memory runs out.
public func joinIn(mem.Allocator a, string ...parts) ![]byte {
	int room = len(sep) * (len(parts) + 1);
	for _, p in parts {
		room += len(p);
	}
	[]byte buf = mem.makeDirty<byte>(a, room)!;
	string joined = join(buf, parts...)!;
	return .{} if len(joined) == 0;
	return buf[..len(joined)];
}

/// Like `clean`, into a new byte slice allocated from `a`. The caller frees it with `mem.free`. Fails with the
/// allocator error when memory runs out.
public func cleanIn(mem.Allocator a, string p) ![]byte {
	[]byte buf = mem.makeDirty<byte>(a, len(p) + len(sep) + 1)!;
	string cleaned = clean(buf, p)!;
	return buf[..len(cleaned)];
}
