import "std/errors";
import "std/math";
import "std/mem";
import "std/slices";

/// A `Reader` with a buffer in front of another one, so many small reads cost
/// one read of the source. It also reads bytes and lines. Build one with
/// `bufReader`, and call `release` when done with it. For a buffer on the stack,
/// give it a `mem.Fixed` over an array.
public struct BufReader implements Reader {
	Reader inp;
	[]byte buf;
	int start;
	int end;
	mem.Allocator source;
}

/// Returns a reader over `inp` with a buffer of `size` bytes allocated from `a`.
/// The size of the buffer is the longest line `readLine` can hold. Give the
/// buffer back with `release`. Fails with the error of the allocator.
public inline func bufReader(mem.Allocator a, Reader inp, int size) !BufReader => .{inp: inp, buf: mem.make<byte>(a, size)!, source: a};

func (*BufReader r) fill() !?int {
	if r.start > 0 {
		mem.move(r.buf, r.buf[r.start..r.end], r.end - r.start);
		r.end -= r.start;
		r.start = 0;
	}
	if r.end == len(r.buf) => return Error(errors.Kind.NoSpace);
	int n = r.inp.read(r.buf[r.end..])! ?? return null;
	r.end += n;
	return n;
}

/// Reads into `out` what is buffered, or from the source when the buffer is
/// empty. A read at least as big as the buffer goes straight to the source.
/// Returns null at the end of the stream, and zero for an empty `out`.
public func (*BufReader r) read([]byte out) !?int {
	if len(out) == 0 => return 0;
	if r.start < r.end {
		int n = math.min(len(out), r.end - r.start);
		mem.copy(out, r.buf[r.start..], n);
		r.start += n;
		return n;
	}

	if len(out) >= len(r.buf) => return r.inp.read(out)!;
	int n = math.min(len(out), r.fill()! ?? return null);
	mem.copy(out, r.buf[r.start..], n);
	r.start += n;
	return n;
}

/// Reads one byte, or returns null at the end of the stream.
public func (*BufReader r) readByte() !?byte {
	if r.start == r.end {
		r.fill()! ?? return null;
	}
	defer r.start++;
	return r.buf[r.start];
}

/// Reads up to the next newline and returns the line without the `\n`, nor the
/// `\r` before it. The string points into the buffer and is valid until the next
/// read. The last line is returned even without a newline, and the end of the
/// stream gives null. Fails with `NoSpace` when a line does not fit in the
/// buffer.
public func (*BufReader r) readLine() !?string {
	int scanned;
	loop {
		int from = r.start + scanned;
		if slices.indexOf(r.buf[from..r.end], '\n') |i| {
			[]byte line = r.buf[r.start..from + i];
			if len(line) > 0 && line[len(line) - 1] == '\r' {
				line = line[..len(line) - 1];
			}
			defer r.start = from + i + 1;
			return string(line);
		}
		scanned = r.end - r.start;
		r.fill()! ?? {
			if r.end > r.start {
				defer r.start = r.end;
				return string(r.buf[r.start..r.end]);
			}
			return null;
		};
	}
}

/// Gives the buffer back to the allocator it came from, and empties the reader.
public func (*BufReader r) release() {
	mem.free(r.source, r.buf);
	r.start, r.end = 0, 0;
	r.buf = .{};
}
