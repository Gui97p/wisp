import "std/errors";
import "std/math";
import "std/mem";
import "std/strings";

/// How a `Scanner` cuts its input: into lines, or into words separated by spaces.
public enum Split { Lines, Words }

/// Reads its input piece by piece, a line or a word at a time. The pieces point
/// into the buffer and are valid until the next call to `next`. Build one with
/// `newScanner`, over a buffer you own, or `newScannerIn`, whose buffer grows up
/// to a limit when a piece is longer than it. Call `release` when done with one
/// made by `newScannerIn`.
public struct Scanner {
	BufReader reader;
	Split by;
	int limit;
}

/// Returns a scanner over `inp` that cuts lines, through `buf`, which stays
/// yours. A piece longer than `buf` fails with `NoSpace`.
public inline func newScanner(Reader inp, []byte buf) Scanner => .{reader: newBufReader(inp, buf)};
/// Like `newScanner`, with a buffer allocated from `a` that starts at `size`
/// bytes and doubles, up to `limit`, when a piece does not fit. A piece longer
/// than `limit` fails with `NoSpace`. Give the buffer back with `release`. Fails
/// with the allocator error.
public inline func newScannerIn(mem.Allocator a, Reader inp, int size, int limit) !Scanner => .{reader: newBufReaderIn(a, inp, size)!, limit: math.max(limit, size)};

/// Makes the scanner cut words instead of lines, and returns it.
public func (*Scanner s) words() *Scanner {
	s.by = .Words;
	return s;
}
/// Returns the next line, or the next word, or null at the end of the input. A
/// line has no `\n` nor `\r`, the last one may have no newline, and empty lines
/// are returned. Words are separated by any run of spaces, tabs and newlines.
/// Fails with `NoSpace` for a piece longer than the buffer can grow to, or with
/// the error of the input.
public func (*Scanner s) next() !?string {
	let r = &s.reader;
	if s.by == .Words {
		loop {
			loop r.start < r.end && strings.isSpace(r.buf[r.start]) {
				r.start++;
			}
			break if r.start < r.end;
			s.fill()! ?? return null;
		}
		int scanned;
		loop {
			for i in r.start + scanned..r.end {
				if strings.isSpace(r.buf[i]) {
					defer r.start = i;
					return string(r.buf[r.start..i]);
				}
			}
			scanned = r.end - r.start;
			s.fill()! ?? {
				defer r.start = r.end;
				return string(r.buf[r.start..r.end]);
			};
		}
	}
	loop {
		return r.readLine() ?? |e| switch e {
			case errors.Kind.NoSpace => {
				continue if s.grow()!;
				return e;
			}
			default => return e;
		};
	}
}

/// Gives back the buffer that `newScannerIn` allocated.
public inline func (*Scanner s) release() => s.reader.release();

func (*Scanner s) grow() !bool {
	let r = &s.reader;
	return false if r.source == null || len(r.buf) >= s.limit;
	r.buf = mem.resize(r.source.?, r.buf, math.min(len(r.buf) * 2, s.limit))!;
	return true;
}

func (*Scanner s) fill() !?int {
	let r = &s.reader;
	return Error(errors.Kind.NoSpace) if r.start == 0 && r.end == len(r.buf) && !(s.grow()!);
	return r.fill()!;
}
