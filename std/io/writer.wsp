import "std/mem";

/// A `Writer` with a buffer in front of another one, so many small writes cost
/// one write to the destination. Nothing reaches it until the buffer fills or
/// `flush` is called, so always `flush` at the end. Build one with `bufWriter`,
/// and call `release` when done with it. For a buffer on the stack, give it a
/// `mem.Fixed` over an array.
public struct BufWriter implements Writer {
	Writer out;
	[]byte buf;
	int count;
	mem.Allocator source;
}

/// Returns a writer over `out` with a buffer of `size` bytes allocated from `a`.
/// Give the buffer back with `release`. Fails with the error of the allocator.
public func bufWriter(mem.Allocator a, Writer out, int size) !BufWriter => .{out: out, buf: mem.make<byte>(a, size)!, source: a};

/// Buffers `data`, sending what is buffered first when it would not fit. A write
/// as big as the whole buffer goes straight to the destination. Returns the
/// length of `data`, or fails with the error of the destination.
public func (*BufWriter w) write([]byte data) !int {
	int need = len(data) + w.count;
	if need > len(w.buf) {
		w.flush()!;
	}

	if len(data) >= len(w.buf) {
		w.out.write(data)!;
		return len(data);
	}

	mem.copy(w.buf[w.count..], data, len(data));
	w.count += len(data);
	return len(data);
}

/// Sends everything buffered to the destination. Fails with its error.
public func (*BufWriter w) flush() ! {
	if w.count == 0 => return;
	w.out.write(w.buf[..w.count])!;
	w.count = 0;
}

/// The number of bytes waiting in the buffer.
public inline func (*BufWriter w) buffered() int => w.count;
/// Gives the buffer back to the allocator it came from, and empties the writer.
/// It does not flush: call `flush` first.
public func (*BufWriter w) release() {
	mem.free(w.source, w.buf);
	w.count = 0;
	w.buf = .{};
}
