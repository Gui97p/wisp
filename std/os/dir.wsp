import "std/os/global";
import "std/os/files";
import "std/sys";
import "std/os";
import "std/path";
import "std/errors";

public inline func isDir(string p) bool {
	let s = files.stat(p) ?? return false;
	return s.kind == .Dir;
}

public func removeDir(string p) ! {
	int r = sys.rmdir(p);
	if r < 0 {
		return global.errorIO(sys.errno(r));
	}
}

public func mkdir(string p) ! {
	int r = sys.mkdir(p);
	if r < 0 {
		return global.errorIO(sys.errno(r));
	}
}

public func mkdirAll(string p) ! {
	let s = os.stat(p) ?? |e| {
		if e != errors.Kind.NotFound {
			return e;
		}
		mkdirAll(path.dir(p))!;
		mkdir(p) ?? |err| return isDir(p) ? null : err;
		return;
	};

	if s.kind != .Dir {
		return Error(global.IOError.NotDir);
	}
}

public struct Dir {
	internal sys.Dir state;
	internal sys.Entry entry;
}

public func (*Dir d) next() !(string, global.FileKind, bool) {
	int r = sys.dirNext(&d.state, &d.entry);
	if r < 0 {
		return global.errorIO(sys.errno(r));
	}
	if r == 0 {
		return "", .Other, false;
	}
	global.FileKind kind = switch d.entry.kind {
		case sys.KIND_FILE => .File;
		case sys.KIND_DIR => .Dir;
		case sys.KIND_LINK => .Link;
		default => .Other;
	};
	return string(d.entry.name[:d.entry.len]), kind, true;
}

public func (*Dir d) close() {
	sys.dirClose(&d.state);
}

public func openDir(string p) !Dir {
	Dir d;
	int r = sys.dirOpen(p, &d.state);
	if r < 0 {
		return global.errorIO(sys.errno(r));
	}
	return d;
}
