import "std/errors";
import "std/io";
import "std/paths";
import "std/sys";

/// Removes the directory at `path`, which has to be empty. Fails with `NotEmpty` or
/// `NotDir` from `IOError`, or `NotFound` and `Permission` from `errors.Kind`.
public func removeDir(string path) ! {
	int r = sys.rmdir(path);
	return errorIO(sys.errno(r)) if r < 0;
}

/// Creates the directory at `path` and any missing parents. It is not an error if
/// `path` is already a directory. Fails with `NotDir` from `IOError` if `path` exists
/// as something else, or with the error of the first directory that could not be
/// created.
public func createDir(string path) ! {
	let s = stat(path) ?? |e| {
		return e if e != errors.Kind.NotFound;
		createDir(paths.dir(path))!;
		int r = sys.mkdir(path);
		if r < 0 {
			return isDir(path) ? null : errorIO(sys.errno(r));
		}
		return;
	};

	return Error(IOError.NotDir) if s.kind != .Dir;
}

/// An open directory, read one entry at a time with `next`. Get one from
/// `openDir` and call `close` when done.
public struct Dir implements io.Closer {
	sys.Dir state;
	sys.Entry entry;
}

/// One item of a directory. `name` is only the last component, not a path, and
/// it points into the buffer of the `Dir`, so it is valid until the next call to
/// `next` or `close`.
public struct Entry {
	public string name;
	public FileKind kind;
}

/// Returns the next entry of the directory, or null when there are no more. The
/// entries `.` and `..` are not skipped, and the order is up to the system.
/// Fails with the error of the system if reading fails.
public func (*Dir d) next() !?Entry {
	int r = sys.dirNext(&d.state, &d.entry);
	return errorIO(sys.errno(r)) if r < 0;
	return null if r == 0;
	FileKind kind = kindOf(d.entry.kind);
	return Entry{name: string(d.entry.name[..d.entry.len]), kind: kind};
}

/// Closes the directory. It must not be used afterwards. Fails with the error of
/// the system.
public func (*Dir d) close() ! {
	int r = sys.dirClose(&d.state);
	return errorIO(sys.errno(r)) if r < 0;
}

/// Opens the directory at `path` for reading its entries. Fails with `NotFound`,
/// `Permission` or `NotDir` from `IOError`. The result has to be closed with
/// `close`.
public func openDir(string path) !Dir {
	Dir d;
	int r = sys.dirOpen(path, &d.state);
	return errorIO(sys.errno(r)) if r < 0;
	return d;
}
