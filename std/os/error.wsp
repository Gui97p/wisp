import "std/errors";

/// Kinds of error of the file system that `errors.Kind` has no name for. `IO` is
/// any error the system reports that has no kind of its own.
public enum IOError {
	NotDir = 1,
	IsDir,
	NotEmpty,
	IO
}

/// Turns an error number of the system (as returned by `sys.errno`) into an
/// `Error`. Known numbers become a kind of `errors.Kind` or `IOError`, and any
/// other becomes `IOError.IO`.
func errorIO(int code) Error {
	return match code {
		1, 13 => Error(errors.Kind.Permission);
		2 => Error(errors.Kind.NotFound);
		11 => Error(errors.Kind.WouldBlock);
		12 => Error(errors.Kind.OutOfMemory);
		16 => Error(errors.Kind.Busy);
		17 => Error(errors.Kind.Exists);
		4 => Error(errors.Kind.Interrupted);
		9, 22, 36 => Error(errors.Kind.Invalid);
		20 => Error(IOError.NotDir);
		21 => Error(IOError.IsDir);
		28 => Error(errors.Kind.NoSpace);
		32 => Error(errors.Kind.BrokenPipe);
		34 => Error(errors.Kind.Overflow);
		38, 95 => Error(errors.Kind.Unsupported);
		39 => Error(IOError.NotEmpty);
		_ => Error(IOError.IO);
	};
}
