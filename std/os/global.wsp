import "std/sys";
import "std/errors";

public const STDIN = 0;
public const STDOUT = 1;
public const STDERR = 2;

public const READ = sys.O_RDONLY;
public const WRITE = sys.O_WRONLY;
public const READ_WRITE = sys.O_RDWR;
public const CREATE = sys.O_CREAT;
public const EXCLUSIVE = sys.O_EXCL;
public const TRUNCATE = sys.O_TRUNC;
public const APPEND = sys.O_APPEND;

public const SEEK_START = sys.SEEK_SET;
public const SEEK_CURRENT = sys.SEEK_CUR;
public const SEEK_END = sys.SEEK_END;

public enum FileKind { File, Dir, Link, Other }
public struct Stat {
	FileKind kind;
	int size, modified, mode;
}

public enum IOError {
	NotDir = 1,
	IsDir,
	NotEmpty,
	IO
}

public func errorIO(int code) Error {
	return switch code {
		case 1, 13 => Error(errors.Kind.Permission);
		case 2 => Error(errors.Kind.NotFound);
		case 11 => Error(errors.Kind.WouldBlock);
		case 12 => Error(errors.Kind.OutOfMemory);
		case 16 => Error(errors.Kind.Busy);
		case 17 => Error(errors.Kind.Exists);
		case 4 => Error(errors.Kind.Interrupted);
		case 22, 36 => Error(errors.Kind.Invalid);
		case 20 => Error(IOError.NotDir);
		case 21 => Error(IOError.IsDir);
		case 28 => Error(errors.Kind.NoSpace);
		case 32 => Error(errors.Kind.BrokenPipe);
		case 34 => Error(errors.Kind.Overflow);
		case 38, 95 => Error(errors.Kind.Unsupported);
		case 39 => Error(IOError.NotEmpty);
		default => Error(IOError.IO);
	};
}

internal func copypath(*byte buf, string p) {
	for i, c in p {
		buf[i] = c;
	}
	buf[len(p)] = '\0';
}
