import "std/sys";

export const STDIN = 0;
export const STDOUT = 1;
export const STDERR = 2;

export const READ = sys.O_RDONLY;
export const WRITE = sys.O_WRONLY;
export const READ_WRITE = sys.O_RDWR;
export const CREATE = sys.O_CREAT;
export const EXCLUSIVE = sys.O_EXCL;
export const TRUNCATE = sys.O_TRUNC;
export const APPEND = sys.O_APPEND;

export const SEEK_START = sys.SEEK_SET;
export const SEEK_CURRENT = sys.SEEK_CUR;
export const SEEK_END = sys.SEEK_END;

export enum IOError {
	Ok,
	NotFound,
	Denied,
	Exists,
	Interrupted,
	Invalid,
	IO
}

export func errorIO(int code) Error {
	return switch code {
		case 2 => Error(IOError.NotFound),
		case 1, 13 => Error(IOError.Denied),
		case 17 => Error(IOError.Exists),
		case 4 => Error(IOError.Interrupted),
		case 22, 36 => Error(IOError.Invalid),
		default => Error(IOError.IO)
	};
}