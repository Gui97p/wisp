import "std/errors";
import "std/sys";

/// The descriptor of standard input.
public const STDIN = 0;
/// The descriptor of standard output.
public const STDOUT = 1;
/// The descriptor of standard error.
public const STDERR = 2;

/// Flag for `files.open`: open for reading only.
public const READ = sys.O_RDONLY;
/// Flag for `files.open`: open for writing only.
public const WRITE = sys.O_WRONLY;
/// Flag for `files.open`: open for reading and writing.
public const READ_WRITE = sys.O_RDWR;
/// Flag for `files.open`: create the file if it does not exist.
public const CREATE = sys.O_CREAT;
/// Flag for `files.open`: with `CREATE`, fail with `Exists` if the file is
/// already there.
public const EXCLUSIVE = sys.O_EXCL;
/// Flag for `files.open`: empty the file when it is opened for writing.
public const TRUNCATE = sys.O_TRUNC;
/// Flag for `files.open`: every write goes to the end of the file.
public const APPEND = sys.O_APPEND;

/// Origin for `os.seek`: the offset counts from the start of the file.
public const SEEK_START = sys.SEEK_SET;
/// Origin for `os.seek`: the offset counts from the current position.
public const SEEK_CURRENT = sys.SEEK_CUR;
/// Origin for `os.seek`: the offset counts from the end of the file.
public const SEEK_END = sys.SEEK_END;

/// What a path is. `Other` covers everything that is not a regular file, a
/// directory or a link.
public enum FileKind { File, Dir, Link, Other }
/// What `files.stat` knows about a path. `size` is in bytes, `modified` is the
/// last modification time as the system gives it, and `mode` holds the permission
/// bits.
public struct Stat {
	FileKind kind;
	int size, modified, mode;
}

/// Kinds of error of the file system that `errors.Kind` has no name for. `IO` is
/// any error the system reports that has no kind of its own.
public enum IOError {
	NotDir = 1,
	IsDir,
	NotEmpty,
	IO
}

/// Turns an error number of the system (as returned by `sys.errno`) into an
/// `Error`. Known numbers become a kind of `errors.Kind` or `IOError`, and any
/// other becomes `IOError.IO`.
public func errorIO(int code) Error {
	return switch code {
		case 1, 13 => Error(errors.Kind.Permission);
		case 2 => Error(errors.Kind.NotFound);
		case 11 => Error(errors.Kind.WouldBlock);
		case 12 => Error(errors.Kind.OutOfMemory);
		case 16 => Error(errors.Kind.Busy);
		case 17 => Error(errors.Kind.Exists);
		case 4 => Error(errors.Kind.Interrupted);
		case 22, 36 => Error(errors.Kind.Invalid);
		case 20 => Error(IOError.NotDir);
		case 21 => Error(IOError.IsDir);
		case 28 => Error(errors.Kind.NoSpace);
		case 32 => Error(errors.Kind.BrokenPipe);
		case 34 => Error(errors.Kind.Overflow);
		case 38, 95 => Error(errors.Kind.Unsupported);
		case 39 => Error(IOError.NotEmpty);
		default => Error(IOError.IO);
	};
}
