import "std/sys";
import "std/errors";

public const STDIN = 0;
public const STDOUT = 1;
public const STDERR = 2;

public const READ = sys.O_RDONLY;
public const WRITE = sys.O_WRONLY;
public const READ_WRITE = sys.O_RDWR;
public const CREATE = sys.O_CREAT;
public const EXCLUSIVE = sys.O_EXCL;
public const TRUNCATE = sys.O_TRUNC;
public const APPEND = sys.O_APPEND;

public const SEEK_START = sys.SEEK_SET;
public const SEEK_CURRENT = sys.SEEK_CUR;
public const SEEK_END = sys.SEEK_END;

public enum FileKind { File, Dir, Link, Other }
public struct Stat {
	FileKind kind;
	int size, modified, mode;
}

public enum IOError {
	NotFound = 1,
	Denied,
	Exists,
	Interrupted,
	NotDir,
	IsDir,
	NotEmpty,
	IO
}

public func errorIO(int code) Error {
	return switch code {
		case 2 => Error(IOError.NotFound);
		case 1, 13 => Error(IOError.Denied);
		case 17 => Error(IOError.Exists);
		case 4 => Error(IOError.Interrupted);
		case 22, 34, 36 => Error(errors.Kind.Invalid);
		case 20 => Error(IOError.NotDir);
		case 21 => Error(IOError.IsDir);
		case 39 => Error(IOError.NotEmpty);
		default => Error(IOError.IO);
	};
}

internal func copypath(*char buf, string p) {
	for i, c in p {
		buf[i] = c;
	}
	buf[len(p)] = '\0';
}
