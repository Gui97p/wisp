import "std/sys";

func writeRaw(int fd, *byte buf, int n) !int {
	int total;
	loop total < n {
		int r = sys.write(fd, buf + total, n - total);
		continue if r == -4;
		return errorIO(sys.errno(r)) if r <= 0;
		total += r;
	}
	return total;
}

/// Writes the string `s` to the descriptor `fd` and returns the number of bytes
/// written. It keeps going until all of `s` is written, retrying if interrupted,
/// so a count smaller than `len(s)` is not returned. Fails with the error of
/// the system, such as `BrokenPipe` or `NoSpace`.
public func write(int fd, string s) !int {
	return writeRaw(fd, (*byte)(s), len(s))!;
}

/// Like `write`, for a slice of bytes.
public func writeBytes(int fd, []byte buf) !int {
	return writeRaw(fd, (*byte)(buf), len(buf))!;
}

/// Reads at most `len(buf)` bytes from `fd` into `buf` and returns how many were
/// read. Zero means the end of the file. Retries if interrupted, and fails with
/// the error of the system otherwise.
public func read(int fd, []byte buf) !int {
	int r;
	loop {
		r = sys.read(fd, (*byte)(buf), len(buf));
	} until r != -4;
	return errorIO(sys.errno(r)) if r < 0;
	return r;
}

/// Closes the descriptor `fd`. Errors from closing are ignored.
public func close(int fd) {
	sys.close(fd);
}

/// Moves the position of `fd` by `offset` from `whence` (`SEEK_START`,
/// `SEEK_CURRENT` or `SEEK_END` of `os/global`) and returns the new position from
/// the start. Fails with `Invalid` or `Unsupported` for a descriptor that cannot
/// seek.
public func seek(int fd, offset, whence) !int {
	int r = sys.seek(fd, offset, whence);
	return errorIO(sys.errno(r)) if r < 0;
	return r;
}

/// Returns the size in bytes of the file open as `fd`. Fails with the error of
/// the system.
public func size(int fd) !int {
	int r = sys.size(fd);
	return errorIO(sys.errno(r)) if r < 0;
	return r;
}

/// Flushes what was written to `fd` to the storage device. Fails with the error
/// of the system.
public func sync(int fd) ! {
	int r = sys.sync(fd);
	return errorIO(sys.errno(r)) if r < 0;
}

/// Reports whether `fd` is a terminal.
public func isatty(int fd) bool {
	return sys.isatty(fd);
}

/// Returns the value of the environment variable `name`, or null if it is not
/// set. The string belongs to the environment and must not be freed.
public inline func env(string name) ?string => sys.getenv(name);

/// Returns the arguments of the program, with the name of the program first.
/// The strings belong to the runtime and must not be freed.
public inline func args() []string => sys.args();

/// An iterator over the environment variables. Get one from `environ`, read it
/// with `next` and call `close` when done.
public struct Environ {
	sys.Env state;
}

/// Starts an iteration over the environment variables of the process.
public func environ() Environ {
	Environ e;
	sys.envOpen(&e.state);
	return e;
}

/// One environment variable. Both strings point into the environment and must
/// not be freed.
public struct Variable {
	public string name;
	public string value;
}

/// Returns the next variable, or null when there are no more. Entries without a
/// name or without an `=` are skipped.
public func (*Environ e) next() ?Variable {
	loop {
		string entry = sys.envNext(&e.state) ?? return null;
		int eq;
		loop eq < len(entry) && entry[eq] != '=' {
			eq++;
		}
		continue if eq == 0 || eq == len(entry);
		return Variable{name: entry[..eq], value: entry[eq + 1..]};
	}
}

/// Ends the iteration. The `Environ` must not be used afterwards.
public func (*Environ e) close() {
	sys.envClose(&e.state);
}
