import "std/sys";
import "std/os/global";

func writeRaw(int fd, *byte buf, int n) !int {
	int total;
	loop total < n {
		int r = sys.write(fd, buf + total, n - total);
		if r == -4 {
			continue;
		}
		if r <= 0 {
			return global.errorIO(sys.errno(r));
		}
		total += r;
	}
	return total;
}

public func write(int fd, string s) !int {
	return writeRaw(fd, (*byte)(s), len(s))!;
}

public func writeBytes(int fd, []byte buf) !int {
	return writeRaw(fd, (*byte)(buf), len(buf))!;
}

public func read(int fd, []byte buf) !int {
	int r;
	loop {
		r = sys.read(fd, (*byte)(buf), len(buf));
	} until r != -4;
	if r < 0 {
		return global.errorIO(sys.errno(r));
	}
	return r;
}

public func close(int fd) {
	sys.close(fd);
}

public func seek(int fd, offset, whence) !int {
	int r = sys.seek(fd, offset, whence);
	if r < 0 {
		return global.errorIO(sys.errno(r));
	}
	return r;
}

public func size(int fd) !int {
	int r = sys.size(fd);
	if r < 0 {
		return global.errorIO(sys.errno(r));
	}
	return r;
}

public func sync(int fd) ! {
	int r = sys.sync(fd);
	if r < 0 {
		return global.errorIO(sys.errno(r));
	}
}

public func isatty(int fd) bool {
	return sys.isatty(fd);
}

public inline func getenv(string name) (string, bool) => sys.getenv(name);

public inline func args() []string => sys.args();

public struct Environ {
	internal sys.Env state;
}

public func environ() Environ {
	Environ e;
	sys.envOpen(&e.state);
	return e;
}

public func (*Environ e) next() (string, string, bool) {
	loop {
		let entry, ok = sys.envNext(&e.state);
		if !ok {
			return "", "", false;
		}
		int eq;
		loop eq < len(entry) && entry[eq] != '=' {
			eq++;
		}
		if eq == 0 || eq == len(entry) {
			continue;
		}
		return entry[:eq], entry[eq+1:], true;
	}
}

public func (*Environ e) close() {
	sys.envClose(&e.state);
}
