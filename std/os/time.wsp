import "std/sys";
import "std/os/global";

public func now() int {
	int s, ns = sys.time(sys.CLOCK_REALTIME);
	return s * 1_000_000_000 + ns;
}

public func ticks() int {
	int s, ns = sys.time(sys.CLOCK_MONOTONIC);
	return s * 1_000_000_000 + ns;
}

public func sleep(int ms) ! {
	int r = sys.sleep(ms/1000, (ms % 1000) * 1_000_000);
	if r < 0 {
		return global.errorIO(sys.errno(r));
	}
}
