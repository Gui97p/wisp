import "std/sys";
import "std/os/global";
import "std/os";
import "std/errors";
import "std/mem";

public func open(string p, int flags) !int {
	char[4096] buf;
	if len(p) > 4095 {
		return Error(errors.Kind.Invalid);
	}
	global.copypath((*char)(buf), p);
	int r = sys.open((*char)(buf), flags | sys.O_CLOEXEC, 0o644);
	if r < 0 {
		return global.errorIO(sys.errno(r));
	}
	return r;
}

public func create(string p) !int {
	return open(p, global.WRITE | global.CREATE | global.TRUNCATE)!;
}

public func remove(string p) ! {
	char[4096] buf;
	if len(p) > 4095 {
		return Error(errors.Kind.Invalid);
	}
	global.copypath((*char)(buf), p);
	int r = sys.remove((*char)(buf), 0);
	if r < 0 {
		return global.errorIO(sys.errno(r));
	}
}

public func readFile(string p) !char[] {
	int fd = open(p, global.READ)!;
	defer os.close(fd);
	int size = os.size(fd)!;
	if size == 0 {
		return [];
	}
	*char alloc = mem.alloc(size)!;
	defer! mem.free(alloc);
	char[] buf = alloc[0:size];
	int total;
	loop {
		int r = os.read(fd, buf[total:])!;
		total += r;
	} until r == 0 || total >= size;
	return buf[:total];
}

public func rename(string from, to) ! {
	if len(from) > 4095 {
		return Error(errors.Kind.Invalid);
	}
	if len(to) > 4095 {
		return Error(errors.Kind.Invalid);
	}
	char[4096] fromBuf, toBuf;
	global.copypath((*char)(fromBuf), from);
	global.copypath((*char)(toBuf), to);
	int r = sys.rename((*char)(fromBuf), (*char)(toBuf));
	if r < 0 {
		return global.errorIO(sys.errno(r));
	}
}

public func stat(string p) !global.Stat {
	if len(p) > 4095 {
		return Error(errors.Kind.Invalid);
	}
	char[4096] buf;
	global.copypath((*char)(buf), p);
	
	sys.Stat s;
	int r = sys.stat((*char)(buf), &s);
	if r < 0 {
		return global.errorIO(sys.errno(r));
	}
	int mode = s.st_mode & sys.S_IFMT;
	global.FileKind kind = switch mode {
		case sys.S_IFREG => .File;
		case sys.S_IFLNK => .Link;
		case sys.S_IFDIR => .Dir;
		default => .Other;
	};
	return global.Stat{mode: s.st_mode, kind: kind, modified: os.toNs(s.st_mtim.tv_sec, s.st_mtim.tv_nsec), size: s.st_size};
}

public func exists(string p) bool {
	stat(p) ?? return false;
	return true;
}

public func cwd(char[] buf) !string {
	int r = sys.getcwd((*char)(buf), len(buf));
	if r < 0 {
		return global.errorIO(sys.errno(r));
	}
	return string(buf[:r-1]);
}

public func getenv(string name) (string, bool) {
	**char env = sys.environ();
	if env == null {
		return "", false;
	}
	for i in 0..1000000 {
		*char entry = env[i];
		if entry == null {
			break;
		}
		int n;
		loop entry[n] != '\0' {
			n++;
		}
		string line = string(entry[:n]);
		if len(line) > len(name) && line[len(name)] == '=' && line[:len(name)] == name {
			return line[len(name)+1:], true;
		}
	}
	return "", false;
}
