import "std/sys";
import "std/os/global";
import "std/os";
import "std/errors";
import "std/mem";

public func open(string p, int flags) !int {
	[4096]byte buf;
	errors.ensure(len(p) <= 4095, errors.Kind.Invalid)!;
	global.copypath((*byte)(buf), p);
	int r = sys.open((*byte)(buf), flags | sys.O_CLOEXEC, 0o644);
	if r < 0 {
		return global.errorIO(sys.errno(r));
	}
	return r;
}

public func create(string p) !int {
	return open(p, global.WRITE | global.CREATE | global.TRUNCATE)!;
}

public func remove(string p) ! {
	[4096]byte buf;
	errors.ensure(len(p) <= 4095, errors.Kind.Invalid)!;
	global.copypath((*byte)(buf), p);
	int r = sys.remove((*byte)(buf), 0);
	if r < 0 {
		return global.errorIO(sys.errno(r));
	}
}

public func readFile(string p) ![]byte {
	int fd = open(p, global.READ)!;
	defer os.close(fd);
	int size = os.size(fd)!;
	if size == 0 {
		return [];
	}
	*byte alloc = mem.alloc(size)!;
	defer! mem.free(alloc);
	[]byte buf = alloc[0:size];
	int total;
	loop {
		int r = os.read(fd, buf[total:])!;
		total += r;
	} until r == 0 || total >= size;
	return buf[:total];
}

public func rename(string from, to) ! {
	errors.ensure(len(from) <= 4095, errors.Kind.Invalid)!;
	errors.ensure(len(to) <= 4095, errors.Kind.Invalid)!;
	[4096]byte fromBuf, toBuf;
	global.copypath((*byte)(fromBuf), from);
	global.copypath((*byte)(toBuf), to);
	int r = sys.rename((*byte)(fromBuf), (*byte)(toBuf));
	if r < 0 {
		return global.errorIO(sys.errno(r));
	}
}

public func stat(string p) !global.Stat {
	errors.ensure(len(p) <= 4095, errors.Kind.Invalid)!;
	[4096]byte buf;
	global.copypath((*byte)(buf), p);
	
	sys.Stat s;
	int r = sys.stat((*byte)(buf), &s);
	if r < 0 {
		return global.errorIO(sys.errno(r));
	}
	int mode = s.st_mode & sys.S_IFMT;
	global.FileKind kind = switch mode {
		case sys.S_IFREG => .File;
		case sys.S_IFLNK => .Link;
		case sys.S_IFDIR => .Dir;
		default => .Other;
	};
	return global.Stat{mode: s.st_mode, kind: kind, modified: os.toNs(s.st_mtim.tv_sec, s.st_mtim.tv_nsec), size: s.st_size};
}

public inline func exists(string p) bool {
	stat(p) ?? return false;
	return true;
}

public func cwd([]byte buf) !string {
	int r = sys.getcwd((*byte)(buf), len(buf));
	if r < 0 {
		return global.errorIO(sys.errno(r));
	}
	return string(buf[:r-1]);
}

public func getenv(string name) (string, bool) {
	**byte env = sys.environ();
	if env == null {
		return "", false;
	}
	for i in 0..1000000 {
		*byte entry = env[i];
		if entry == null {
			break;
		}
		int n;
		loop entry[n] != '\0' {
			n++;
		}
		string line = string(entry[:n]);
		if len(line) > len(name) && line[len(name)] == '=' && line[:len(name)] == name {
			return line[len(name)+1:], true;
		}
	}
	return "", false;
}
