#standalone
import "std/fmt";
import "std/math";
import "std/mem";
import "std/os";

/// The errors that the test helpers return: `Failed` when an expectation does not
/// hold, and `Leaked` when `finish` finds memory that was not freed.
public enum Kind {
	Failed = 1,
	Leaked
}

/// The exit status of a test that called `skip`, which the test runner reads as
/// skipped.
public const SKIP_CODE = 77;

mem.Arena store;
mem.Debug tracker;
bool tracking;

#format
func warn(string format, ...args) {
	fmt.fprint(&os.stderr, format, args...) ?? return;
}

/// Prints a message to standard error. The first argument is a format string,
/// used with the others as in `fmt.fprint`, and a newline is added. Does
/// nothing if there are no arguments or the first is not a string.
public func report(...args) {
	if len(args) == 0 => return;

	match type args[0] {
		string format => {
			warn(format, args[1..]...);
			warn("\n");
		}
	}
}

/// Returns `ok`. If it is false, prints the message given by `args` as `report`
/// does. It does not stop the test.
public func holds(bool ok, ...args) bool {
	if ok => return true;

	report(args...);
	return false;
}

/// Reports whether `e` is an error whose `code` is `kind`, and prints what was
/// expected and what was found if not. A null error never matches.
public func sameKind(Error e, int kind) bool {
	if e == null {
		warn("expected an error of kind {}, got no error\n", kind);
		return false;
	}
	if e.code == kind => return true;

	warn("expected an error of kind {}, got {}\n", kind, e.code);
	return false;
}

/// Reports whether `want` and `got` differ by at most `tolerance`, and prints
/// the values and the difference if not.
public func isClose(float want, float got, float tolerance) bool {
	float diff = want > got ? want - got : got - want;
	if diff <= tolerance => return true;

	warn("expected {}, got {}: the difference {} is more than {}\n", want, got, diff, tolerance);
	return false;
}

func firstDifference(string a, string b) int {
	int n = math.min(len(a), len(b));
	for i in 0..n {
		if a[i] != b[i] => return i;
	}
	return n;
}

/// Reports whether the two strings are equal, and prints both and the position
/// of the first differing byte if not.
public func sameText(string want, string got) bool {
	if want == got => return true;

	warn("strings differ at byte {}\n  want: \"{}\"\n   got: \"{}\"\n", firstDifference(want, got), want, got);
	return false;
}

/// Fails the test if `ok` is false, printing the message given by `args` as
/// `report` does. Returns an error of kind `Failed`, so use it as `expect(...)!`.
public inline func expect(bool ok, ...args) ! {
	if !holds(ok, args...) => return Error(Kind.Failed, "expectation failed");
}

/// Prints the message given by `args` as `report` does and returns an error of
/// kind `Failed`.
public inline func fail(...args) ! {
	report(args...);
	return Error(Kind.Failed, "test failed");
}

/// Fails the test with `Failed` unless `e` is an error whose `code` is `kind`.
public inline func expectKind(Error e, int kind) ! {
	if !sameKind(e, kind) => return Error(Kind.Failed, "wrong kind of error");
}

/// Fails the test with `Failed` unless `want` and `got` differ by at most
/// `tolerance`.
public inline func expectApprox(float want, float got, float tolerance) ! {
	if !isClose(want, got, tolerance) => return Error(Kind.Failed, "values are not close");
}

/// Fails the test with `Failed` unless the two strings are equal.
public inline func expectEqualStrings(string want, string got) ! {
	if !sameText(want, got) => return Error(Kind.Failed, "strings differ");
}

/// Prints the message given by `args` as `report` does and ends the program
/// with `SKIP_CODE`, marking the test as skipped.
public func skip(...args) {
	report(args...);
	os.exit(SKIP_CODE);
}

/// Returns the allocator a test should use. It tracks every block so `finish`
/// can find leaks, and it takes its memory from an arena that `finish` releases.
public func allocator() mem.Allocator {
	if !tracking {
		tracker.parent = &store;
		tracking = true;
	}
	return &tracker;
}

/// Checks the allocator of `allocator` at the end of a test. Prints a report and
/// returns an error of kind `Leaked` if blocks were not freed, and releases the
/// memory either way. Does nothing if `allocator` was never called.
public func finish() ! {
	if !tracking => return;

	tracker.check();
	int leaked = tracker.blocks();
	if leaked > 0 {
		tracker.report();
	}
	tracker.release();
	store.release();
	if leaked == 0 => return;

	return Error(Kind.Leaked, "memory leaked");
}
