import "std/fmt";
import "std/mem";
import "std/strings";

const SIZE = 4194304;
const REPEAT = 16;

func main() {
	*char buf = mem.alloc(SIZE)!!;
	uint64 x = 88172645463325252;
	for i in 0..SIZE-1 {
		x ^= x << 13;
		x ^= x >> 7;
		x ^= x << 17;
		buf[i] = char(x);
	}
	int digits = 0;
	int alpha = 0;
	int spaces = 0;
	int upper = 0;
	int hex = 0;
	for _ in 0..REPEAT-1 {
		for i in 0..SIZE-1 {
			char c = buf[i];
			if strings.isDigit(c) {
				digits++;
			}
			if strings.isAlpha(c) {
				alpha++;
			}
			if strings.isSpace(c) {
				spaces++;
			}
			if strings.isUpper(c) {
				upper++;
			}
			if strings.isHex(c) {
				hex++;
			}
		}
	}
	fmt.printf("{} {} {} {} {}\n", digits, alpha, spaces, upper, hex);
	mem.free(buf);
}
