import "std/fmt";
import "std/mem";

const N = 300;

func main() {
	*float a = mem.alloc(N * N * sizeof(float))!!;
	*float b = mem.alloc(N * N * sizeof(float))!!;
	*float c = mem.alloc(N * N * sizeof(float))!!;
	for i in 0..N-1 {
		for j in 0..N-1 {
			a[i * N + j] = float((i + j) % 10);
			b[i * N + j] = float((i * j) % 10);
		}
	}
	for i in 0..N-1 {
		for j in 0..N-1 {
			float sum = 0.0;
			for k in 0..N-1 {
				sum += a[i * N + k] * b[k * N + j];
			}
			c[i * N + j] = sum;
		}
	}
	float total = 0.0;
	for i in 0..N*N-1 {
		total += c[i];
	}
	fmt.printf("{}\n", int(total));
	mem.free(a, b, c);
}
