import "std/conv";
import "std/fmt";
import "std/strings";

const ROUNDS = 1000000;

func main() {
	[64]byte buf;
	int width = 0;
	int sum = 0;
	for i in 1..=ROUNDS {
		string s = conv.itoa(buf[..], i * 7919 - 1000000)!!;
		width += len(s);
		sum += conv.atoi(s)!!;
	}
	int written = 0;
	strings.Builder line;
	for i in 1..=ROUNDS {
		line.reset();
		written += fmt.format(&line, "{} {}", i, i * 3)!!;
	}
	line.release();
	fmt.println("{} {} {}", width, sum, written);
}
