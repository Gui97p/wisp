import "std/conv";
import "std/fmt";
import "std/strings";

const ROUNDS = 1000000;

func main() {
	int width = 0;
	int sum = 0;
	strings.Builder line;
	for i in 1..=ROUNDS {
		line.reset();
		conv.writeInt(&line, i * 7919 - 1000000, 10, false)!!;
		width += line.len();
		sum += conv.atoi(line.text())!!;
	}
	int written = 0;
	for i in 1..=ROUNDS {
		line.reset();
		written += fmt.format(&line, "{} {}", i, i * 3)!!;
	}
	line.release();
	fmt.println("{} {} {}", width, sum, written);
}
