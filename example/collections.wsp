// Tour - Arrays, slices and strings.
//
// Maps are part of the language too, but the x86-64 backend does not
// generate them yet: see _pending/maps.wsp.

import "expect";

export func demo() {
  // A fixed-size array: the size is part of the type.
  int[5] nums = [124, 512, 1, 5, 2];

  // A partial literal fills the rest with zero values.
  int[5] partial = [7, 8];
  expect.expect(partial[0] == 7 && partial[1] == 8 && partial[2] == 0, "a partial array literal");

  // Elements can be assigned, incremented and updated in place.
  nums[0] = 999;
  nums[1]++;
  nums[2] += 10;
  expect.expect(nums[0] == 999 && nums[1] == 513 && nums[2] == 11, "assign, increment and update an element");

  // `len` works on arrays, slices and strings.
  expect.expect(len(nums) == 5, "len of an array");

  // Slicing is [start:end]. The end is exclusive and both ends are optional.
  // A slice is a view: it shares the elements of the array.
  int[] middle = nums[1:3];
  int[] head = nums[:2];
  int[] tail = nums[3:];
  expect.expect(len(middle) == 2 && middle[0] == 513, "a slice");
  expect.expect(head[1] == 513 && tail[0] == 5, "a slice with an open end");

  middle[0] = 1;
  expect.expect(nums[1] == 1, "a slice writes through to its array");

  // Strings slice the same way, and compare in dictionary order.
  string greeting = "hello world";
  expect.expect(greeting[:5] == "hello" && greeting[6:] == "world", "strings slice");
  expect.expect(len(greeting) == 11, "len of a string");
  expect.expect(greeting[0] == 'h', "indexing a string gives a char");
  expect.expect("apple" < "apricot" && "b" > "abc", "strings compare in dictionary order");

  // `in` asks whether a string holds another, or whether a collection holds
  // an element.
  expect.expect("ell" in greeting, "a string in a string");
  expect.expect(512 in nums == false, "a value that is not in the array");

  // Indexing is checked: going outside an array, slice or string stops the
  // program with a panic that names the line.
}
