// Tour - Functions.

import "expect";

// The parameter type comes first. `a, b` share the type written before them.
func add(int a, b) int {
  return a + b;
}

// A function made of a single expression can use `=>`.
func square(int x) int => x * x;

// Multiple return values.
func minmax(int a, b) (int, int) {
  if a < b {
    return a, b;
  }
  return b, a;
}

// A function can be declared after the code that calls it.
func later() int => 7;

export func demo() {
  expect.expect(add(2, 3) == 5, "a function with two parameters");
  expect.expect(square(7) == 49, "a function made of one expression");

  let low, high = minmax(9, 4);
  expect.expect(low == 4 && high == 9, "multiple return values");

  expect.expect(later() == 7, "order of declaration does not matter");

  // Variadic parameters and function values exist in the language, but the
  // x86-64 backend does not generate them yet: see _pending/variadics.wsp
  // and _pending/lambdas.wsp.
}
