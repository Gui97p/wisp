// Tour - Calling C, and being called from C.
//
// This folder is a project of its own (it has its own wisp.toml), skipped by
// the main tour because its name starts with `_`. Build the C object first,
// then run it from here:
//
//     cc -c -O1 -fno-stack-protector -fno-pic -ffreestanding lib.c -o lib.o
//     wisp run
//
// `extern func` declares a function defined in C. It has no body, and the
// linker finds it in the objects listed under `link` in wisp.toml (or given
// with --link). The name is the C symbol; `as` gives it another name in
// Wisp, the same way `import "x" as y` renames a module: what is on the left
// exists already, the name on the right is the new one.
//
// C only understands integers, bool, char, floats and pointers, so those are
// the only types allowed in an extern signature, with at most one return
// value and no `!`. A Wisp `int` is 64 bits wide; use the sized types
// (`int32`, `uint8`, ...) to match what C declares.

extern func add(int32 a, int32 b) int32;
extern func twice(int32 x) int32 as c_twice;
extern func sum_bytes(*int8 bytes, int32 count) int32;
extern func scale_by_three(int32 value) int32;

// The other direction: `export func ... as name` gives an exported function
// a C-visible name that does not depend on the module's path. lib.c declares
// `wisp_scale` and calls it.
export func scale(int32 value, int32 factor) int32 as wisp_scale => value * factor;

// A string gives the address of its bytes with `*int8(text)`. C expects a
// zero byte at the end, which string literals have and slices of them do not.
func check(bool holds, string what) {
  if holds {
    emit(what);
  } else {
    emit("FAIL");
    emit(what);
  }
}

func main() int {
  check(add(2, 3) == 5, "C adds two numbers");
  check(c_twice(21) == 42, "an extern function renamed with as");
  check(sum_bytes(*int8("abc"), 3) == 294, "C reads the bytes of a string");
  check(scale_by_three(7) == 21, "C calls back into Wisp");
  return 0;
}

// Calling the C library itself (printf, strlen, ...) needs it to be set up
// before main runs, which the Wisp start stub does not do. Build with --libc
// (or `libc = true` in wisp.toml) to use the system's startup code instead,
// and a C variadic is declared with a trailing `...`:
//
//     extern func printf(*int8 format, ...) int32;
//
// A panic ends the program straight away without flushing C's buffered
// output, the same way C's abort() does.
