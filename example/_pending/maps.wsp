// Tour - Maps.
//
// Maps are part of the language and the analyser checks this file, but the
// x86-64 backend does not generate them yet. They run on the Lua backend:
// copy this file and expect.wsp into a project of its own and use
// `wisp run --target lua`.

import "expect";

export func demo() {
  // Maps infer their key and value types from the literal.
  map[string]int scores = {"alice": 10, "bob": 7};
  scores["carol"] = 3;
  expect.expect(scores["alice"] == 10 && scores["carol"] == 3, "a map literal and an assignment");

  // Iterating a map gives the key and the value. The order is not specified.
  int total;
  for name, score in scores {
    total += score;
  }
  expect.expect(total == 20, "iterating a map");
}

func main() {
  demo();
}
