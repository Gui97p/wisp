// top-level const and a nominal type alias (distinct from its underlying type)
const MaxScore = 100;
type UserID int;

// enum desugars to a nominal type + typed consts: Color is its own type,
// not just int, so mixing it with plain int still requires an explicit cast
enum Color {
  Red,
  Green,
  Blue,
  Alpha = 10 // explicit value; auto-increment continues from here (11, 12, ...)
}

// error handling: `!T` marks a fallible return; the error branch must be
// an Error{} (a builtin struct with code+message), the success branch the
// declared payload type. Error sets are just enums, reused as-is.
enum DivError {
  DivByZero
}

func divide(int a, int b) !int {
  if b == 0 {
    return Error{code: DivByZero as int, message: "cannot divide by zero"};
  }
  return a / b;
}

// propagate (`!expr`) only compiles inside another fallible function --
// it forwards the error up instead of handling it here
func doubleDivide(int a, int b) !int {
  let half = !divide(a, b);
  return half * 2;
}

func add(int a, b) int => a + b;

func addVerbose(int a, b) (int, bool) {
  return a + b, true;
}

func sum(int ...nums) int {
  return 1;
}

// Struct declarations
struct Point {
  int x, y;
}

// methods: receiver comes before the name, same *Type syntax as everywhere else
func (*Point p) pos() (int, int) {
  return p.x, p.y;
}

func (*Point p) scale(int factor) {
  p.x = p.x * factor;
  p.y = p.y * factor;
}

/*
This is a
multiline comment
before program startpoint:
*/
func main() {
  // Implicit and Explicit type declarations
  let total = add(2, 3);
  int limit = 10;
  limit += 2; // Assign operators

  // Bitwise operators: & | ^ ~ << >>, plus their compound-assign forms.
  // Integer-only (not float) -- `~` is unary bitwise-not, so `~=` doesn't
  // exist, there's no binary meaning to compound-assign with it.
  int bitsA = 6;
  int bitsB = 3;
  emitf("bitsA&bitsB=%d bitsA|bitsB=%d bitsA^bitsB=%d ~bitsA=%d bitsA<<1=%d bitsA>>1=%d",
    bitsA & bitsB, bitsA | bitsB, bitsA ^ bitsB, ~bitsA, bitsA << 1, bitsA >> 1);

  int flags = 6; // 0110
  flags &= 2;    // 0010
  flags |= 8;    // 1000
  flags ^= 1;    // 0001
  flags <<= 1;
  flags >>= 1;
  emitf("flags=%d", flags);

  // Zero-value declarations: no initializer -> zeroed
  int zeroed;
  int[3] zeroArr;
  emitf("zeroed=%d zeroArr0=%d", zeroed, zeroArr[0]);

  if total >= limit {
    emit("greater than or equal");
  } else {
    emit("less than");
  }

  for i in 1..10:2 { // :2 is optional here, step definition
    emitf("n: %d", i);
  }

  for 10 { // It's possible to omit the variable to only loop a certain amount of times
    emit("This message will be emitted 10 times");
  }

  loop total != limit {
    emitf("%d more to go", limit - total);
    total++; // Increment operator
  } // while

  loop {
    emit("hi");
  } until random() == 0.5; // do while

  loop {
    emit("never stopping until a break statement");
  } // while true

  :outer loop { // labels!
    loop {
      if random() == .3 {
        break outer;
      }
      continue; // continue accepts labels too
    }
  }

  // switch as a statement: cases use `:`, ranges reuse `..`, no fallthrough
  switch limit {
    case 10:
      emit("limit is ten");
    case 11..20:
      emit("limit is in the teens/twenties");
    default:
      emit("limit is something else");
  }

  // switch as an expression: cases use `=>`, default is required since it
  // must always produce a value; only valid as the direct RHS of let/const/
  // return/assignment (Wisp has no general block-expressions)
  let sizeLabel = switch limit {
    case 10 => "ten",
    default => "other",
  };
  emit(sizeLabel);

  // ...and it also works as the RHS of a plain assignment
  int doubled;
  doubled = switch limit {
    case 10 => 20,
    default => 0,
  };
  emitf("doubled=%d", doubled);

  // error handling: `!` propagates the error up (only legal inside another
  // fallible function), `??` unwraps with a default value or a handler block
  int safeDiv = divide(10, 0) ?? -1;
  emitf("safeDiv=%d", safeDiv);

  int handledDiv = divide(10, 0) ?? |e| {
    emitf("division failed: %s (code=%d)", e.message, e.code);
    return -1;
  };
  emitf("handledDiv=%d", handledDiv);

  int propagated = doubleDivide(10, 0) ?? -1;
  emitf("propagated=%d", propagated);

  int[5] nums = [124, 512, 1, 5, 2]; // fixed array
  int[5] partial = [7, 8]; // partial fill: remaining slots are zero-valued

  // let's create some points with it
  Point p = Point{x: nums[0], y: nums[1]};
  let p2 = Point{x: nums[3], y: 2};

  let posX, posY = p.pos();
  emitf("p.pos()=%d,%d", posX, posY);
  p.scale(2);
  emitf("p scaled=%d,%d", p.x, p.y);

  emitf("p: x=%d y=%d", p.x, p.y);

  // Pointers, including multiple levels of indirection
  // pointer star is a prefix on the type (*int, **int, *Point, ...),
  // never postfix -- this is what lets pointer-to-custom-type also be
  // declared explicitly, unlike the old "Point *pp" style which was
  // ambiguous with multiplication.
  int x = 1 > 2 ? 42 : 21;
  *int px = &x;      // pointer to int
  **int ppx = &px;   // pointer to pointer to int

  emitf("x=%d *px=%d **ppx=%d", x, *px, **ppx);

  *Point pp = &p;    // pointer to a struct, explicit type
  emitf("pp.x=%d pp.y=%d", pp.x, pp.y);

  // null and manual heap allocation
  *int maybeNull = null;
  if maybeNull == null {
    emit("pointer is null");
  }

  *int heapInt = malloc(8);
  *heapInt = 99;
  emitf("heapInt=%d", *heapInt);
  free(heapInt);

  // maps: key/value type inferred from the {} literal, no need to repeat map[K]V
  map[string]int scores = {"alice": 10, "bob": 7};
  emitf("alice score=%d", scores["alice"]);

  map[*Point]string names = {pp: "origin"};
  emit(names[pp]);

  // mutating through index, member and pointer targets, not just plain variables
  nums[0] = 999;
  p.x += 5;
  *heapInt = 1;
  nums[1]++;

  let a, b = 1, 2;
  let sum2, ok = addVerbose(a, b);

  emitf("variadic sum=%d", sum(1, 2, 3));

  // iterating: same "in" for numeric ranges (above) and any collection
  for i, v in nums {
    emitf("nums[%d]=%d", i, v);
  }

  for k, v in scores {
    emitf("scores[%s]=%d", k, v);
  }

  emitf("spanSum=%d", spanSum(1, 2, 3));

  // const also works as a statement, not just top-level
  const Greeting = "hi";
  emit(Greeting);

  // type aliases are nominal: UserID and int don't mix without an explicit cast,
  // but an untyped literal adapts to the alias directly
  UserID uid = 42;
  int rawId = uid as int;
  emitf("uid=%d rawId=%d", uid as int, rawId);

  // enum members are typed constants of the enum's own type, not plain int
  Color favorite = Green;
  emitf("Red=%d Green=%d Blue=%d Alpha=%d favorite=%d", Red as int, Green as int, Blue as int, Alpha as int, favorite as int);

  // slicing: [start:end], both ends optional; works on arrays, spans and strings
  int[] sliceMid = nums[1:3];
  int[] sliceHead = nums[:2];
  int[] sliceTail = nums[3:];
  int[] sliceAll = nums[:];
  emitf("mid0=%d mid1=%d", sliceMid[0], sliceMid[1]);

  string greeting = "hello world";
  string firstWord = greeting[:5];
  string secondWord = greeting[6:];
  emitf("firstWord=%s secondWord=%s", firstWord, secondWord);

  // len works on arrays, spans and strings
  emitf("len(nums)=%d len(sliceMid)=%d len(greeting)=%d", len(nums), len(sliceMid), len(greeting));
}

// a variadic parameter is a real Span[] inside the body, indexable and iterable
func spanSum(int ...values) int {
  int total;
  for i, v in values {
    total += v;
  }
  return total;
}
