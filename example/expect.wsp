// Tour - A tiny helper shared by the other files.
//
// The language has no number-to-text conversion in the box yet (that belongs
// to the standard library), and `emit` only prints strings. So each file
// states what it just demonstrated and `expect` prints the sentence when it
// holds. A sentence that does not hold prints FAIL before it, which makes a
// regression in the tour impossible to miss.

export func expect(bool holds, string what) {
  if holds {
    emit(what);
  } else {
    emit("FAIL");
    emit(what);
  }
}
